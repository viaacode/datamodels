# REVIEW ALIGN: this shared rdf:langString rule and EventNameShape, PersonShape
# and the shared brand-name rule conflict with hasName's RDFS xsd:string range.
# If names are multilingual, update that range instead of discarding language tags.
# With the hierarchy loaded, ThingShape also requires a name on annotations,
# quantitative measurements and contribution roles; keep that broad requirement
# only if all those operational resources are meant to have names.
ha:DescriptionNameShape a sh:PropertyShape ;
    rdfs:label "description name shape"@en ;
    sh:datatype rdf:langString ;
    sh:message "schema:name is missing or not of type string "@en, "schema:name est manquant ou n'est pas de type string"@fr, "schema:name ontbreekt of is niet van het type string"@nl ;
    sh:minCount 1 ;
    sh:name "description name shape"@en, "nom"@fr, "naam"@nl ;
    sh:nodeKind sh:Literal ;
    sh:path ha:hasName ;
    sh:severity sh:Violation ;
    sh:uniqueLang true ;
     .

# REVIEW: this datatype agrees with RDFS hasDescription. Keep it; max one text
# per language is an extra profile rule, not implied by the RDFS range.
ha:DescriptionShape a sh:PropertyShape ;
    rdfs:label "description shape"@en ;
    sh:datatype rdf:langString ;
    sh:message "schema:description is missing or not of type string "@en, "schema:description est manquant ou n'est pas de type string"@fr, "schema:description ontbreekt of is niet van het type string"@nl ;
    sh:minCount 0 ;
    sh:name "description shape"@en, "description"@fr, "omschrijving"@nl ;
    sh:nodeKind sh:Literal ;
    sh:path ha:hasDescription ;
    sh:severity sh:Violation ;
    sh:uniqueLang true ;
     .

