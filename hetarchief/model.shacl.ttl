ha:NewspaperIssuePageShape a sh:NodeShape ;
    rdfs:label "newspaper issue page shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class ha:NewspaperIssue ;
        sh:description "Indicates the newspaper issue that a specific page is part of."@en, "Indique l'édition de journal dont fait partie une page spécifique."@fr, "Geeft de kranteneditie aan waar een specifieke pagina deel van uitmaakt."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of rel:isp is not of type haDes:NewspaperIssue, is missing or occurs more than once"@en ;
        sh:minCount 1 ;
