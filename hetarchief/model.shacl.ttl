        sh:path ha:isStructuralPartOf ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:description "Indicates the serial number of a page within the greater object it is part of."@en, "Indique le numéro de série d'une page dans l'objet plus grand dont elle fait partie."@fr, "Geeft het volgnummer aan van een pagina binnen het grotere object waarvan het deel uitmaakt."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of haDes:pageNumber is not of type xsd:nonNegativeInteger,or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "page number"@en, "numéro de page"@fr, "paginanummer"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasPageNumber ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:NewspaperIssuePage ;
     .

# REVIEW ALIGN: hasIssuance should check ha:Issuance if its RDFS range is intended;
# the current skos:Concept check accepts any concept. hasEdition already agrees
# with the RDFS skos:Concept range; the closed edition list is a profile choice.
ha:NewspaperIssueShape a sh:NodeShape ;
    rdfs:label "newspaper issue shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:description "Indicates how many pages a certain bibliographic object contains."@en, "Indique le nombre de pages qu'un certain objet bibliographique contient."@fr, "Geeft aan uit hoeveel pagina's een bepaald bibliografisch object bestaat."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of haDes:numberOfPages is not of type xsd:nonNegativeInteger, or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "number of pages"@en, "nombre de pages"@fr, "aantal pagina's"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasNumberOfPages ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:description "Indicates the specific publication type of a newspaper edition (e.g. morning, evening, weekend newspaper edition, etc.)."@en, "Indique le type de publication spécifique d'une édition de journal (par exemple, édition du journal du matin, du soir, du week-end, etc.)."@fr, "Geeft het specifieke uitgavetype aan van een kranteneditie (bv. ochtend-, avond-, weekendkranteneditie etc.)."@nl ;
        sh:in (
            <https://data.hetarchief.be/id/edition-type/morning-edition>
            <https://data.hetarchief.be/id/edition-type/afternoon-edition>
            <https://data.hetarchief.be/id/edition-type/evening-edition>
            <https://data.hetarchief.be/id/edition-type/weekend-edition>
        ) ;
        sh:maxCount 1 ;
        sh:message "the object of bf:edition is not of type skos:Concept, or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "publication type"@en, "type de publication"@fr, "uitgavetype"@nl ;
        sh:path ha:hasEdition ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:WrittenWorkCarrierRepresentation ;
        sh:description "The representation stored on a physical carrier."@en, "La représentation stockée sur un porteur physique."@fr, "De representatie opgeslagen op een fysieke drager."@nl ;
        sh:maxCount 1 ;
        sh:message "haObj:hasCarrierCopy has more than 1 value or is not a haDes:WrittenWorkCarrierRepresentation"@en ;
        sh:name "has carrier copy"@en, "est copie sur porteur"@fr, "heeft dragerkopie"@nl ;
        sh:path ha:hasCarrierCopy ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:description "Indicates how frequent a newspaper is issued, e.g. twice a day, daily, weekly etc."@en, "Indique la fréquence de parution d'un journal, par ex. deux fois par jour, quotidiennement, hebdomadairement, etc."@fr, "Geeft aan hoe vaak een krant verschijnt, b.v. tweemaal per dag, dagelijks, wekelijks etc."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of bf:issuance is not of type skos:Concept, or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "frequency of issuance"@en, "fréquence d'émission"@fr, "uitgavefrequentie"@nl ;
        sh:path ha:hasIssuance ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:Newspaper ;
        sh:description "Indicates the newspaper series that a specific newspaper edition is part of."@en, "Indique la série de journaux dont fait partie une édition spécifique."@fr, "Geeft de krantenserie aan waar een specifieke kranteneditie deel van uitmaakt."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of schema:isPartOf is not of type schema:Newspaper, or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "is part of"@en, "fait partie de"@fr, "maakt deel uit van"@nl ;
        sh:path ha:isPartOf ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "Indicates the serial number of a newspaper edition within the greater newspaper series it is part of."@en, "Indique le numéro de série d'une édition de journal dans la série de journaux plus grande dont elle fait partie."@fr, "Geeft het volgnummer aan van een kranteneditie binnen de grotere krantenserie waarvan het deel uitmaakt."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of schema:issueNumber is not of type xsd:string, or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "issue number"@en, "numéro de l'édition"@fr, "editienummer"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasIssueNumber ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:NewspaperIssue ;
     .

# REVIEW FIX: hasSchemaStartDate/hasSchemaEndDate are now ha:hasStartDate/
# ha:hasEndDate, and hasCreationLocation is now ha:hasCreationPlace. These optional
# old paths silently skip values written with the new vocabulary.
# REVIEW ALIGN: isPrecededBy expects a Newspaper here, but RDFS gives it a
# PublicationIssue domain AND range. Decide whether the relation links newspaper
# titles or issues, then align both files; the current definition suggests issues.
ha:NewspaperShape a sh:NodeShape ;
    rdfs:label "newspaper shape"@en ;
    sh:property _:cb565174abd99c7b8739313b91e807bc53b6ba79dcca7f43eaa1b4e97f93f22e96e, [
        a sh:PropertyShape ;
        sh:class ha:Role ;
        sh:description "Publisher of the newspaper."@en, "Uitgever van de krant."@fr, "Éditeur du journal."@nl ;
        sh:maxCount 1 ;
        sh:message "schema:publisher is not of class schema:Role, or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "publisher"@en, "éditeur"@fr, "uitgever"@nl ;
        sh:path ha:hasPublisher ;
        sh:severity sh:Violation ;
    ], _:cb6234d08acc08b31eaabdb962452ad572d98f5426a885c865d4d4204165373e1c7, [
        a sh:PropertyShape ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:message "schema:endDate is not of type xsd:dateTime."@en, "schema:endDate n'est pas de type xsd:dateTime."@fr, "schema:endDate is niet van het type xsd:dateTime."@nl ;
        sh:minCount 0 ;
        sh:name "end date"@en, "date de fin"@fr, "einddatum"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasSchemaEndDate ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:Newspaper ;
        sh:description "Newspaper that is updated or otherwise complemented by the augmenting newspaper."@en, "Journal qui est mis à jour ou autrement complété par le journal augmentant."@fr, "Krant die wordt bijgewerkt of anderszins wordt aangevuld met de aanvullende krant."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of bf:supplementTo is not of type schema:Newspaper, or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "supplement to"@en, "compléter"@fr, "supplement aan"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path ha:isSupplementTo ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:Newspaper ;
        sh:description "Newspaper that updates or otherwise complements the predominant newspaper."@en, "Journal qui met à jour ou complète autrement le journal prédominant."@fr, "Krant die de overheersende krant bijwerkt of anderszins aanvult."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of bf:supplement is not of type schema:Newspaper, or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "supplement"@en, "supplément"@fr, "supplement"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path ha:hasSupplement ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "schema:identifier is missing or not of type string "@en, "schema:identifier est manquant ou n'est pas de type string"@fr, "schema:identifier ontbreekt of is niet van het type string"@nl ;
        sh:minCount 1 ;
        sh:name "abraham identifier"@en, "abraham identifier"@fr, "abraham identifier"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasIdentifier ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:message "schema:startDate is not of type xsd:dateTime."@en, "schema:startDate n'est pas de type xsd:dateTime."@fr, "schema:startDate is niet van het type xsd:dateTime."@nl ;
        sh:minCount 0 ;
        sh:name "start date"@en, "date de début"@fr, "begindatum"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasSchemaStartDate ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:Place ;
        sh:description "The location where the Newspaper was created."@en, "L'emplacement où le journal a été créé."@fr, "De locatie waar de krant is gemaakt."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of schema:locationCreated is not of type schema:locationCreated,or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "location created"@en, "lieu de création"@fr, "plaats van creatie"@nl ;
        sh:path ha:hasCreationLocation ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        skos:definition "Newspaper that succeeds the newspaper being described, e.g., later in time or after in a narrative."@en, "Journal qui succède à la journal décrite, par exemple, plus tard dans le temps ou après dans un récit."@fr, "Krant die de krant die wordt beschreven opvolgt, bijvoorbeeld later in de tijd of daarna in een verhaal."@nl ;
        sh:class ha:Newspaper ;
        sh:maxCount 1 ;
        sh:message "the object of bf:succeededBy is not of type schema:Newspaper, or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "succeeded by"@en, "succédé par"@fr, "opgevolgd door"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path ha:isSucceededBy ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:Newspaper ;
        sh:description "Newspaper that precedes the newspaper being described, e.g., is earlier in time or before in narrative."@en, "Le journal qui précède le journal décrit, par exemple, est plus tôt dans le temps ou avant dans le récit."@fr, "Krant die voorafgaat aan de beschreven krant, bijvoorbeeld, is eerder in de tijd of eerder in het verhaal."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of bf:precededBy is not of type schema:Newspaper, or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "preceded by"@en, "précédé par"@fr, "voorafgegaan door"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path ha:isPrecededBy ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:Newspaper ;
     .

ha:ObjectCarrierRepresentationShape a sh:NodeShape ;
    rdfs:label "object carrier representation shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class ha:PhysicalCarrier ;
        sh:description "The pysical carrier where the representation is stored."@en, "Le porteur physique où la représentation est stocké."@fr, "De fysieke drager waarop de representatie is opgeslagen."@nl ;
        sh:message "premis:storedAt has more than one value, no values or not a haObj:PhysicalCarrier"@en, "premis:storedAt a plus d'une valeur, pas de valeur ou n'est pas une haObj:PhysicalCarrier"@fr, "premis:storedAt heeft meer dan één of geen waarde of is geen haObj:PhysicalCarrier"@nl ;
        sh:minCount 1 ;
        sh:name "stored at"@en, "stocké à"@fr, "opgeslagen op"@nl ;
        sh:path premis:storedAt ;
        sh:severity sh:Violation ;
    ], [
        sh:class premis:IntellectualEntity ;
        sh:description "The intellectual entity that is represented by this carrier copy."@en, "L'entité intellectuelle représentée par cette copie sur un porteur."@fr, "De intellectuele entiteit waarvan deze dragerkopie een representatie is."@nl ;
        sh:maxCount 1 ;
        sh:message "haObj:isCarrierCopyOf has more than one value or not a premis:IntellectualEntity"@en ;
        sh:name "is carrier copy of"@en, "est un copie sur porteur de"@fr, "is dragerkopie van"@nl ;
        sh:path ha:isCarrierCopyOf ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:CarrierRepresentation ;
     .

# REVIEW FIX: migrate all isNextInSequence paths (also File/IntellectualEntity)
# to ha:immediatelyFollows. RDFS defines subject -> preceding item, while the
# current descriptions say the following item. Check producer direction before
# renaming; otherwise the sequence meaning will be reversed.
# REVIEW ALIGN: isAccessCopyOf correctly points from a representation to an
# IntellectualEntity here. Its RDFS domain/range are reversed relative to its
# own definition, inverse and sibling copy properties; fix RDFS, not this shape.
# REVIEW PROFILE: includes and hasRenderingRoot are separately required. SHACL
# Core does not infer includes from the rendering-root subproperty. Materialize
# that link or change the requirement; decide whether the root must be included.
ha:ObjectDigitalRepresentationShape a sh:NodeShape ;
    rdfs:label "object digital representation shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class premis:IntellectualEntity ;
        sh:description "The intellectual entity of which this digital representation is a transcription access copy."@en, "L'entité intellectuelle dont cette représentation digitale est la copie d'accès transcription."@fr, "De intellectuele entiteit waarvan deze digitale representatie een transcriptietoegangskopie is."@nl ;
        sh:maxCount 1 ;
        sh:message "haObj:isTranscriptionCopyOf has more than one value or is not a premis:IntellectualEntity"@en ;
        sh:name "is transcription copy of"@en, "est copie transcription de"@fr, "is transcriptiekopie van"@nl ;
        sh:path ha:isTranscriptionCopyOf ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:IntellectualEntity ;
        sh:description "The intellectual entity of which this digital representation is the mezzanine copy."@en, "L'entité intellectuelle dont cette représentation est la copie de mezzanine."@fr, "De intellectuele entiteit waarvan deze digitale representatie de mezzanine kopie is."@nl ;
        sh:maxCount 1 ;
        sh:message "haObj:isMezzanineCopyOf has more than one value or not a premis:IntellectualEntity"@en, "haObj:isMezzanineCopyOf a plus d'une valeur ou n'est pas une premis:IntellectualEntity"@fr, "haObj:isMezzanineCopyOf heeft meer dan één waarde of is geen premis:IntellectualEntity"@nl ;
        sh:name "is Mezzanine Of"@en, "est mezzanine de"@fr, "is mezzanine van"@nl ;
        sh:path ha:isMezzanineCopyOf ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:Representation ;
        sh:description "The physical carrier from which this digital representation originates from."@en, "Le porteur physique dont vient cette représentation numérique."@fr, "De fysieke drager waarvan deze digitale representatie afkomstig is."@nl ;
        sh:message "rel:hss is not a premis:Representation"@en, "rel:hss n'est pas un premis:Representation"@fr, "rel:hss is geen premis:Representation"@nl ;
        sh:name "has Source"@en, "a source"@fr, "heeft bron"@nl ;
        sh:path ha:hasDerivationSource ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:IntellectualEntity ;
        sh:description "The intellectual entity of which this digital representation is the IIIF access copy."@en, "L'entité intellectuelle dont cette représentation digital est l'accès IIIF."@fr, "De intellectuele entiteit waarvan deze digitale representatie de IIIF toegangskopie is."@nl ;
        sh:maxCount 1 ;
        sh:message "haObj:isIIIFCopyOf has more than one value or is not a premis:IntellectualEntity"@en, "haObj:isIIIFCopyOf a plus d'une valeur ou n'est pas une premis:IntellectualEntity"@fr, "haObj:isIIIFCopyOf heeft meer dan één waarde of is geen premis:IntellectualEntity"@nl ;
        sh:name "is IIIF copy of"@en, "est copie IIIF de"@fr, "is IIIF-kopie van"@nl ;
        sh:path ha:isIIIFCopyOf ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:IntellectualEntity ;
        sh:description "The intellectual entity of which this representation is the archive master."@en, "L'entité intellectuelle dont cette représentation est le maître des archives."@fr, "De intellectuele entiteit waarvan deze representatie de archiefmaster is."@nl ;
        sh:maxCount 1 ;
        sh:message "haObj:isMasterCopyOf has more than one value or not a premis:IntellectualEntity"@en, "haObj:isMasterCopyOf a plus d'une valeur ou n'est pas une premis:IntellectualEntity"@fr, "haObj:isMasterCopyOf heeft meer dan één waarde of is geen premis:IntellectualEntity"@nl ;
        sh:name "is Master Of"@en, "est maître de"@fr, "is master van"@nl ;
        sh:path ha:isMasterCopyOf ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:DigitalRepresentation ;
        sh:description "The digital representation that follows on this digital representation."@en, "La représentation numérique qui suit sur cette représentation numérique."@fr, "De digitale representatie dat op deze digitale representatie volgt."@nl ;
        sh:maxCount 1 ;
        sh:message "edm:isNextInSequence has more than one value or is not a haObj:DigitalRepresentation"@en, "edm:isNextInSequence a plus d'une valeur ou n'est pas un haObj:DigitalRepresentation"@fr, "edm:isNextInSequence heeft meer dan één waarde of is geen haObj:DigitalRepresentation"@nl ;
        sh:name "next digital representation in sequence"@en, "la représentation numérique suivante dans l'ordre"@fr, "volgende digitale representatie in volgorde"@nl ;
        sh:path ha:isNextInSequence ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:File ;
        sh:description "A file that is part of this digital representation."@en, "Un fichier qui fait partie de cette représentation digital."@fr, "Een bestand dat deel uitmaakt van deze digitale representatie."@nl ;
        sh:message "rel:inc is missing or not a premis:File"@en, "rel:inc manque ou n'est pas une premis:File"@fr, "rel:inc ontbreekt of is geen premis:File"@nl ;
        sh:minCount 1 ;
        sh:name "includes"@en, "comprend"@fr, "bevat"@nl ;
        sh:path ha:includes ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:File ;
        sh:description "The file that must be processed first."@en, "Le fichier qui doit être traité en premier."@fr, "Het bestand dat eerst verwerkt moet worden."@nl ;
        sh:message "rel:hsr is missing or not a premis:File"@en, "rel:hsr manque ou n'est pas une premis:File"@fr, "rel:hsr ontbreekt of is geen premis:File"@nl ;
        sh:minCount 1 ;
        sh:name "has Root"@en, "a racine"@fr, "heeft root"@nl ;
        sh:path ha:hasRenderingRoot ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:IntellectualEntity ;
        sh:description "The intellectual entity of which this digital representation is the access or browse copy."@en, "L'entité intellectuelle dont cette représentation digital est l'accès ou la copie de vue."@fr, "De intellectuele entiteit waarvan deze digitale representatie de toegangs- of inkijkkopie is."@nl ;
        sh:maxCount 1 ;
        sh:message "haObj:isAccessCopyOf has more than one value or not a premis:IntellectualEntity"@en, "haObj:isAccessCopyOf a plus d'une valeur ou n'est pas une premis:IntellectualEntity"@fr, "haObj:isAccessCopyOf heeft meer dan één waarde of is geen premis:IntellectualEntity"@nl ;
        sh:name "is Access Copy Of"@en, "est copie d'accès de"@fr, "is toegangskopie van"@nl ;
        sh:path ha:isAccessCopyOf ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:DigitalRepresentation ;
     .

# REVIEW PROFILE: exactly one Mediahaven provenance source is required here,
# on every IntellectualEntity and on every Representation (including physical
# carrier representations). Records from another source fail even when otherwise
# valid. Move this rule into a Mediahaven import profile if other origins are used.
# The required storedAt, MIME type and size remain useful for a complete-file
# profile; confirm whether streaming/remote or partial records must pass it.
ha:ObjectFileShape a sh:NodeShape ;
    rdfs:label "object file shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class ha:MediahavenFragment ;
        sh:description "The Mediahaven record from which this file was derived."@en, "L'enregistrement Mediahaven à partir duquel ce fichier est dérivé."@fr, "Het Mediahaven record waarvan dit bestand afgeleid werd."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of prov:wasDerivedFrom is no mh:Fragment, is absent or occurs more than once"@en ;
        sh:minCount 1 ;
        sh:name "was derived from"@en, "était dérivé de"@fr, "werd afgeleid van"@nl ;
        sh:path prov:wasDerivedFrom ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "The MIME type or IANA media type of the file."@en, "Le type MIME ou le type de média IANA du fichier."@fr, "Het MIME type of IANA media type van het bestand."@nl ;
        sh:maxCount 1 ;
        sh:message "ebucore:hasMimeType is missing, has more than one value or not of type string"@en, "ebucore:hasMimeType manque, a plus d'une valeur ou n'est pas de type string"@fr, "ebucore:hasMimeType ontbreekt, heeft meer dan één waarde of is niet van het type string"@nl ;
        sh:minCount 1 ;
        sh:name "mime type"@en, "mime type"@fr, "mime type"@nl ;
        sh:path ha:hasMimeType ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:MediaFragment ;
        sh:description "A fragment from this file."@en, "Un fragment de ce fichier."@fr, "Een fragment uit dit bestand."@nl ;
        sh:message "ha:hasMediaFragment must point to a media fragment."@en ;
        sh:name "has media fragment"@en, "a le fragment des médias"@fr, "heeft media fragment"@nl ;
        sh:path ha:hasMediaFragment ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:File ;
        sh:description "The file that replaces or succeeds this file."@en, "Le fichier qui remplace ou succède à ce fichier."@fr, "Het bestand dat dit bestand vervangt."@nl ;
        sh:message "rel:sup is not a premis:File"@en, "rel:sup n'est pas un premis:File"@fr, "rel:sup is geen premis:File"@nl ;
        sh:name "supersedes"@en, "remplace"@fr, "vervangt"@nl ;
        sh:path ha:supersedes ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:StorageLocation ;
        sh:description "The location where the file is stored."@en, "L'emplacement où le fichier est stocké."@fr, "De (fysieke) locatie waar het bestand is opgeslagen."@nl ;
        sh:maxCount 1 ;
        sh:message "premis:storedAt is missing or not a premis:StorageLocation"@en, "premis:storedAt manque ou n'est pas une premis:StorageLocation"@fr, "premis:storedAt ontbreekt of is geen premis:StorageLocation"@nl ;
        sh:minCount 1 ;
        sh:name "stored at"@en, "stocké à"@fr, "opgeslagen op"@nl ;
        sh:path premis:storedAt ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:File ;
        sh:description "The file that follows on this file."@en, "Le fichier qui suit sur ce fichier."@fr, "Het bestand dat op dit bestand volgt."@nl ;
        sh:maxCount 1 ;
        sh:message "edm:isNextInSequence has more than one value or is not a premis:File"@en, "edm:isNextInSequence a plus d'une valeur ou n'est pas un premis:File"@fr, "edm:isNextInSequence heeft meer dan één waarde of is geen premis:File"@nl ;
        sh:name "next file in sequence"@en, "fichier suivant dans l'ordre"@fr, "volgende bestand in volgorde"@nl ;
        sh:path ha:isNextInSequence ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:QuantitativeValue ;
        sh:description "The height of a file"@en, "La hauteur d'un fichier"@fr, "De hoogte van een bestand."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of schema:height is no xsd:nonNegativeInteger or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "height"@en, "hauteur"@fr, "hoogte"@nl ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:path ha:hasHeight ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:File ;
        sh:description "The file that describes or documents this file."@en, "Le fichier qui décrit ou documente ce fichier."@fr, "Het bestand dat dit bestand beschrijft of documenteert."@nl ;
        sh:message "rel:doc is not a premis:File"@en, "rel:doc n'est pas un premis:File"@fr, "rel:doc is geen premis:File"@nl ;
        sh:name "documents"@en, "document"@fr, "documenteert"@nl ;
        # REVIEW FIX: the description reverses the relationship. RDFS says the
        # subject documents the object; here the text says the object documents this
        # file. Correct the description and check producer direction before migration.
        sh:path ha:documents ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:DigitalRepresentation ;
        sh:description "The digital representation this file is part of."@en, "La représentation digital dans ce fichier fait partie."@fr, "De digitale representatie waarvan dit bestand deel uitmaakt."@nl ;
        sh:message "rel:isi is missing or not a haObj:DigitalRepresentation"@en, "rel:isi manque ou n'est pas une haObj:DigitalRepresentation"@fr, "rel:isi ontbreekt of is geen haObj:DigitalRepresentation"@nl ;
        sh:name "is Included In"@en, "est inclus dans"@fr, "is opgenomen in"@nl ;
        sh:path ha:isIncludedIn ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:QuantitativeValue ;
        sh:description "The width of a file"@en, "La largeur d'un fichier."@fr, "De breedte van een bestand."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of schema:width is no xsd:nonNegativeInteger or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "width"@en, "largeur"@fr, "breedte"@nl ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:path ha:hasWidth ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:Fixity ;
        sh:description "The calculated fixity checksum of the file."@en, "La somme de contrôle de fixité calculée du fichier."@fr, "De berekende fixity checksum van het bestand."@nl ;
        sh:maxCount 1 ;
        sh:message "premis:fixity is missing or not a premis:Fixity"@en ;
        sh:minCount 0 ;
        sh:name "fixity"@en, "fixity"@fr, "fixity"@nl ;
        sh:path premis:fixity ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "The original name of this file."@en, "Le nom d'origine de ce fichier."@fr, "De oorspronkelijke naam van dit bestand."@nl ;
        sh:maxCount 1 ;
        sh:message "premis:originalName has more than one value or not of type string"@en, "premis:originalName a plus d'une valeur ou n'est pas de type string"@fr, "premis:originalName heeft meer dan één waarde of is niet van het type string"@nl ;
        sh:minCount 0 ;
        sh:name "has original name"@en, "porte le nom d'origine"@fr, "heeft originele naam"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path premis:originalName ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:FileFormat ;
        sh:description "The file format of the file."@en, "Le format de fichier du fichier."@fr, "Het bestandsformaat van het bestand."@nl ;
        sh:maxCount 1 ;
        sh:message "dct:format is missing or not a dct:FileFormat"@en, "dct:format manque ou n'est pas une dct:FileFormat"@fr, "dct:format ontbreekt of is geen dct:FileFormat"@nl ;
        sh:minCount 0 ;
        sh:name "format"@en, "format"@fr, "formaat"@nl ;
        sh:path ha:hasFormat ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:description "The size of this file."@en, "La taille de ce fichier."@fr, "De grootte van dit bestand."@nl ;
        sh:maxCount 1 ;
        sh:message "premis:size is missing, has more than one value or not of type nonNegativeInteger"@en, "premis:size manque, a plus d'une valeur ou n'est pas de type nonNegativeInteger"@fr, "premis:size ontbreekt, heeft meer dan één waarde of is niet van het type nonNegativeInteger"@nl ;
        sh:minCount 1 ;
        sh:name "filesize"@en, "taille de fichier"@fr, "bestandsgrootte"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path premis:size ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass premis:File ;
     .

ha:ObjectIntellectualEntityShape a sh:NodeShape ;
    rdfs:label "object intellectual entity shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class premis:IntellectualEntity ;
        sh:description "The intellectual entity of which this intellectual entity is part of."@en, "L'entité intellectuelle dont cette entité intellectuelle fait partie de."@fr, "De intellectuele entiteit waarvan deze intellectuele entiteit deel uit maakt."@nl ;
        sh:message "rel:isp is not a premis:IntellectualEntity"@en ;
        sh:name "is Part Of"@en, "est partie de"@fr, "is deel van"@nl ;
        sh:path ha:isStructuralPartOf ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:DigitalRepresentation ;
        sh:description "A textual access or browse copy of the intellectual entity made by automatic or manual transcription of another digital representation."@en, "Une copie d'accès textuelle ou de visualisation de l'entité intellectuelle créée par transcription automatique ou manuelle à partir d'une autre représentation numérique."@fr, "Een tekstuele toegangs- of inkijkkopie van de intellectuele entiteit gemaakt door automatische of manuele transcriptie van een andere digitale representatie."@nl ;
        sh:message "haObj:hasTranscriptionCopy is not a haObj:DigitalRepresentation"@en ;
        sh:name "has transcription copy"@en, "a copie de transcription"@fr, "heeft transcriptiekopie"@nl ;
        sh:path ha:hasTranscriptionCopy ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:IntellectualEntity ;
        sh:description "An intellectual entity that is part of this intellectual entity."@en, "Une entité intellectuelle qui fait partie de cette entité intellectuelle."@fr, "Een intellectuele entiteit die deel uitmaakt van deze intellectuele entiteit."@nl ;
        sh:message "rel:hsp is not a premis:IntellectualEntity"@en ;
        sh:name "has Part"@en, "a partie"@fr, "heeft deel"@nl ;
        sh:path ha:hasStructuralPart ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:MediaFragment ;
        sh:description "A representation which incorporates a file fragment."@en, "Une représentation qui inclut une partie d'un fichier."@fr, "Een representatie dat een bestandsfragment bevat."@nl ;
        sh:message "ha:hasFragmentRepresentation must point to a media fragment."@en ;
        sh:name "has fragment"@en, "a fragment"@fr, "heeft fragment"@nl ;
        sh:path ha:hasFragmentRepresentation ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:DigitalRepresentation ;
        sh:description "The mezzanine copy of the intellectual entity."@en, "La copie mezzanine de l'entité intellectuelle."@fr, "De mezzanine kopie van de intellectuele entiteit."@nl ;
        sh:message "haObj:hasMezzanineCopy not a haObj:DigitalRepresentation"@en, "haObj:hasMezzanineCopy n'est pas un haObj:DigitalRepresentation"@fr, "haObj:hasMezzanineCopy is geen haObj:DigitalRepresentation"@nl ;
        sh:name "has Mezzanine"@en, "a mezzanine"@fr, "heeft mezzanine"@nl ;
        sh:path ha:hasMezzanineCopy ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:DigitalRepresentation ;
        sh:description "The archive master of the intellectual entity."@en, "Le maître des archives de l'entité intellectuelle."@fr, "De archiefmaster van de intellectuele entiteit."@nl ;
        sh:message "haObj:hasMasterCopy not a haObj:DigitalRepresentation"@en ;
        sh:name "has Master"@en, "a maître"@fr, "heeft master"@nl ;
        sh:path ha:hasMasterCopy ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:DigitalRepresentation ;
        sh:description "The access or browse copy of the intellectual entity."@en, "L'accès ou la copie de l'entité intellectuelle d'accès."@fr, "De toegangs- of inkijkkopie van de intellectuele entiteit."@nl ;
        sh:message "haObj:hasAccessCopy not a haObj:DigitalRepresentation"@en, "haObj:hasAccessCopy n'est pas un haObj:DigitalRepresentation"@fr, "haObj:hasAccessCopy is geen haObj:DigitalRepresentation"@nl ;
        sh:name "has Access Copy"@en, "a copie d'accès"@fr, "heeft toegangskopie"@nl ;
        sh:path ha:hasAccessCopy ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:CarrierRepresentation ;
        sh:description "The representation stored on a physical carrier."@en, "La représentation stockée sur un porteur physique."@fr, "De representatie opgeslagen op een fysieke drager."@nl ;
        sh:maxCount 1 ;
        sh:message "haObj:hasCarrierCopy has more than 1 value or is not a haObj:CarrierRepresentation"@en ;
        sh:name "has carrier copy"@en, "est copie sur porteur"@fr, "heeft dragerkopie"@nl ;
        sh:path ha:hasCarrierCopy ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:DigitalRepresentation ;
        sh:description "The access or browse copy of the intellectual entity available via IIIF Image API."@en, "L'accès ou la copie de l'entité intellectuelle d'accès qui est disponible via IIIF Image API."@fr, "De toegangs- of inkijkkopie van de intellectuele entiteit die beschikbaar is via de IIIF Image API."@nl ;
        sh:message "haObj:hasIIIFCopy is not a haObj:DigitalRepresentation"@en, "haObj:hasIIIFCopy n'est pas un haObj:DigitalRepresentation"@fr, "haObj:hasIIIFCopy is geen haObj:DigitalRepresentation"@nl ;
        sh:name "has IIIF Copy"@en, "a copie de IIIF"@fr, "heeft IIIF-kopie"@nl ;
        sh:path ha:hasIIIFCopy ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:MediahavenFragment ;
        sh:description "The Mediahaven record from which this intellectual entity was derived."@en, "L'enregistrement Mediahaven à partir duquel cette entité intellectuelle est dérivée."@fr, "Het Mediahaven record waarvan deze intellectuele entiteit afgeleid werd."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of prov:wasDerivedFrom is no mh:Fragment, is absent or occurs more than once"@en ;
        sh:minCount 1 ;
        sh:name "was derived from"@en, "était dérivé de"@fr, "werd afgeleid van"@nl ;
        sh:path prov:wasDerivedFrom ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:LocalIdentifier ;
        sh:description "The primary local identifier for the intellectual entity."@en, "Un identificateur local principal pour l'entité intellectuelle."@fr, "De primaire lokale identifier voor de intellectuele entiteit."@nl ;
        sh:message "haObj:primaryIdentifier is not a LocalIdentifier"@en ;
        sh:name "primary local identifier"@en, "identificateur local principal"@fr, "primaire lokale identifier"@nl ;
        # REVIEW FIX: this property is now ha:hasPrimaryLocalIdentifier in RDFS.
        sh:path ha:hasPrimaryIdentifier ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:LocalIdentifier ;
        sh:description "A local identifier for the intellectual entity."@en, "Un identificateur local pour l'entité intellectuelle."@fr, "Een lokale identifier voor de intellectuele entiteit."@nl ;
        sh:message "premis:identifier is not a LocalIdentifier"@en ;
        sh:name "local identifier"@en, "identificateur local"@fr, "lokale identifier"@nl ;
        sh:path premis:identifier ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:IntellectualEntity ;
        sh:description "The intellectual entity that follows on this intellectual entity."@en, "L'entité intellectuelle qui suit sur cette entité intellectuelle."@fr, "De intellectuele entiteit die op deze intellectuele entiteit volgt."@nl ;
        sh:maxCount 1 ;
        sh:message "edm:isNextInSequence has more than one value or is not a premis:File"@en, "edm:isNextInSequence a plus d'une valeur ou n'est pas un premis:File"@fr, "edm:isNextInSequence heeft meer dan één waarde of is geen premis:File"@nl ;
        sh:name "next intellectual entity in sequence"@en, "l'entité intellectuelle suivante dans l'ordre"@fr, "volgende intellectuele entiteit in volgorde"@nl ;
        sh:path ha:isNextInSequence ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:or ( [ sh:class premis:Representation ] [ sh:class ha:MediaFragment ] ) ;
        sh:description "A representation of the intellectual entity."@en, "Une représentation de l'entité intellectuelle."@fr, "Een representatie van de intellectuele entiteit."@nl ;
        sh:message "ha:isRepresentedBy must point to a representation or media fragment."@en ;
        sh:minCount 1 ;
        sh:name "is Represented By"@en, "est représenté par"@fr, "wordt gerepresenteerd door"@nl ;
        sh:path ha:isRepresentedBy ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass premis:IntellectualEntity ;
     .

ha:ObjectObjectShape a sh:NodeShape ;
    rdfs:label "object object shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class premis:Object ;
        sh:description "A generic relationship between intellectual entities, files, or representations."@en, "Une relation générique entre les entités intellectuelles, les fichiers ou les représentations."@fr, "Een generieke relatie tussen intellectuele entiteiten, bestanden of representaties."@nl ;
        sh:message "premis:relationship is not a premis:Object"@en, "premis:relationship n'est pas de la classe premis:Object"@fr, "premis:relationship is niet van de klasse premis:Object"@nl ;
        sh:name "relationship"@en, "relation"@fr, "relatie"@nl ;
        sh:path premis:relationship ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass premis:Object ;
     .

ha:ObjectPhysicalCarrierShape a sh:NodeShape ;
    rdfs:label "object physical carrier shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class premis:StorageMedium ;
        sh:description "The type of storage medium of the physical carrier."@en, "Le type de milieu de stockage du porteur physique."@fr, "Het type opslagmedium van de fysieke drager."@nl ;
        sh:maxCount 1 ;
        sh:message "premis:medium has more than one value, no value or not a premis:StorageMedium"@en, "premis:medium a plus d'une valeur, pas de valeur ou n'est pas une premis:StorageMedium"@fr, "premis:medium heeft meer dan één of geen waarde of is geen premis:StorageMedium"@nl ;
        sh:minCount 1 ;
        sh:name "storage medium"@en, "milieu de stockage"@fr, "opslagmedium"@nl ;
        sh:path premis:medium ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:PhysicalCarrier ;
