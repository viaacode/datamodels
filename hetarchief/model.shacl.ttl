        sh:name "has account manager"@en, "a gestionnaire de comptes"@fr, "heeft account manager"@nl ;
        sh:path ha:hasAccountManager ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "Indicates the unique identifier of the educational partner."@en, "Indique l'identifiant unique du partenaire éducatif."@fr, "Verwijst naar de unieke identificator van de educatieve partner."@nl ;
        sh:maxCount 1 ;
        sh:message "is missing, occurs more than once or its object is no xsd:string"@en ;
        sh:minCount 1 ;
        sh:name "identifier"@en, "identifiant"@fr, "identificator"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasIdentifier ;
    ] ;
    sh:targetClass ha:EducationalPartner ;
     .

ha:EpisodeShape a sh:NodeShape ;
    rdfs:label "episode shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class premis:IntellectualEntity ;
        sh:description "Indicates an IntellectualEntity that is part of this episode."@en, "Indique une intellectualité ou un travail créatif qui fait partie de cette episode."@fr, "Geeft aan dat deze IntellectualEntity deel uitmaakt van deze episode."@nl ;
        sh:message "schema:hasPart is not of class premis:IntellectualEntity"@en, "schema:hasPart n'est pas de la classe premis:IntellectualEntity"@fr, "schema:hasPart is niet van de klasse premis:IntellectualEntity"@nl ;
        sh:name "has part"@en, "a partie"@fr, "heeft deel"@nl ;
        sh:path ha:hasPart ;
        sh:severity sh:Violation ;
    ], ha:DescriptionNameShape, ha:DescriptionShape ;
    sh:targetClass ha:Episode ;
     .

ha:EventBrandShape a sh:NodeShape ;
    rdfs:label "event brand shape"@en ;
    sh:property _:cb6234d08acc08b31eaabdb962452ad572d98f5426a885c865d4d4204165373e1c7 ;
    sh:targetClass ha:Brand ;
     .

ha:EventObjectShape a sh:NodeShape ;
    rdfs:label "event object shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class premis:Event ;
        sh:description "The time at which the object was completely created and is available for use."@en, "Heure à laquelle l'objet a été complètement créé et est disponible pour utilisation."@fr, "De tijd waarop het object volledig is aangemaakt en beschikbaar is voor gebruik."@nl ;
        sh:maxCount 1 ;
        sh:message "prov:wasGeneratedBy occurs more than once or its value is no instance of premis:Event"@en, "prov:wasGeneratedBy apparaît plus d'une seule fois ou sa valeur n'est pas une instance de premis:Event"@fr, "prov:wasGeneratedBy komt meer dan eens voor of de waarde is geen instantie van premis:Event"@nl ;
        sh:minCount 0 ;
        sh:name "was generated by"@en, "généré par"@fr, "is gegenereerd door"@nl ;
        sh:path prov:wasGeneratedBy ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass premis:Object ;
     .

# REVIEW FIX: the outcome enum uses ha:failed/ha:succeeded/ha:warnings, but RDFS
# provides ha:fail/ha:success/ha:warning. None of the latter is explicitly typed
# premis:OutcomeStatus. Align IRIs and add the required vocabulary typing so the
# sh:in and sh:class checks can both pass.
# REVIEW PROFILE: isImplementedBy requires one Organization although RDFS allows
# ha:Agent. A person implementing an event is rejected; keep this restriction only
# if every supported event is implemented by an organization.
ha:EventShape a sh:NodeShape ;
    rdfs:label "event shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class premis:Object ;
        sh:description "The object that was used as a source for the event."@en, "L'object utilisé comme source pour l'événement (Event)"@fr, "Het object dat als bron gebruikt is voor de gebeurtenis (Event)."@nl ;
        sh:message "evtObjRole:sou occurs more than once or its value is no instance of class premis:Object"@en, "evtObjRole:sou apparaît plus d'une seule fois ou sa valeur n'est pas une instance de la classe premis:Object"@fr, "evtObjRole:sou komt meer dan eens voor of de waarde is geen instantie van de klasse premis:Object"@nl ;
        sh:name "has source"@en, "a une source"@fr, "heeft bron"@nl ;
        sh:path ha:hasEventInput ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:Object ;
        sh:description "The object that was generated by the event."@en, "L'objet généré par l'événement (Event)."@fr, "Het object dat door de gebeurtenis (Event) gegenereerd is."@nl ;
        sh:message "evtObjRole:out occurs more than once or its value is no instance of class premis:Object"@en, "evtObjRole:out apparaît plus d'une seule fois ou sa valeur n'est pas une instance de la classe premis:Object"@fr, "evtObjRole:out komt meer dan eens voor of de waarde is geen instantie van de klasse premis:Object"@nl ;
        sh:name "result"@en, "résultat"@fr, "resultaat"@nl ;
        sh:path ha:hasOutput ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:Organization ;
        sh:description "The organization that implemented the event."@en, "L'organisation qui a implementé l'événement (Event)."@fr, "De organisatie die de gebeurtenis (Event) heeft geimplementeerd."@nl ;
        sh:maxCount 1 ;
        sh:message "evtAgRole:imp is absent, occurs more than once or its value is no instance of class org:Organization"@en, "evtAgRole:imp est absent, apparaît plus d'une seule fois ou sa valeur n'est pas une instance de la classe org:Organization"@fr, "evtAgRole:imp ontbreekt, komt meer dan eens voor of de waarde is geen instantie van de klasse org:Organization"@nl ;
        sh:minCount 1 ;
        sh:name "implemented by"@en, "implementé par"@fr, "geimplementeerd door"@nl ;
        sh:path ha:isImplementedBy ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:OutcomeStatus ;
        sh:description "The outcome status of the event."@en, "Statut du résultat de l'événement (Event)."@fr, "De uitkomststatus van de gebeurtenis (Event)."@nl ;
        sh:in (
            ha:failed
            ha:succeeded
            ha:warnings
        ) ;
        sh:maxCount 1 ;
        sh:message "premis:outcome is absent, occurs more than once or its value is not in the list (evtOutcome:fai evtOutcome:suc evtOutcome:war)"@en, "premis:outcome est absent, apparaît plus d'une fois ou sa valeur n'est pas dans la liste (evtOutcome:fai evtOutcome:suc evtOutcome:war)"@fr, "premis:outcome ontbreekt, komt meer dan eens voor of de waarde maakt geen deel uit van de lijst (evtOutcome:fai evtOutcome:suc evtOutcome:war)"@nl ;
        sh:minCount 0 ;
        sh:name "has outcome"@en, "a résultat"@fr, "heeft uitkomst"@nl ;
        sh:path premis:outcome ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "A note about the outcome of the event."@en, "Une note sur le résultat de l'événement (Event)."@fr, "Een opmerking over de uitkomst van de gebeurtenis (Event)."@nl ;
        sh:maxCount 1 ;
        sh:message "premis:outcomeNote occurs more than once or its value is not of type string"@en, "premis:outcomeNote apparaît plus d'une seule fois ou sa valeur n'est pas de type string"@fr, "premis:outcomeNote komt meer dan eens voor of de waarde is niet van het type string"@nl ;
        sh:minCount 0 ;
        sh:name "has outcome note"@en, "a une note de résultat"@fr, "heeft uitkomstopmerking"@nl ;
        sh:path premis:outcomeNote ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:HardwareAgent ;
        sh:description "The hardware that was used to execute the event."@en, "Le matériel qui a été utilisé pour exécuter l'événement (Event)."@fr, "De hardware die gebruikt is voor het uitvoeren van de gebeurtenis (Event)."@nl ;
        sh:message "schema:instrument's value is no instance of classes premis:HardwareAgent"@en, "schema:instrument sa valeur n'est pas une instance de classes premis:HardwareAgent"@fr, "schema:instrument's waarde is geen instantie van de klassen premis:HardwareAgent"@nl ;
        sh:minCount 0 ;
        sh:name "instrument"@en, "instrument"@fr, "instrument"@nl ;
        sh:path ha:hasInstrument ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "A note about the event."@en, "Une note sur l'événement (Event)"@fr, "Een opmerking over de gebeurtenis (Event)."@nl ;
        sh:maxCount 1 ;
        sh:message "premis:note occurs more than once or its value is not of type string"@en, "premis:note apparaît plus d'une seule fois ou sa valeur n'est pas de type string"@fr, "premis:note komt meer dan eens voor of de waarde is niet van het type string"@nl ;
        sh:minCount 0 ;
        sh:name "has note"@en, "a une note"@fr, "heeft opmerking"@nl ;
        sh:path premis:note ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:SoftwareAgent ;
        sh:description "The software that executed the event."@en, "Le logiciel qui a exécuté l'événement (Event)."@fr, "De software die de gebeurtenis (Event) heeft uitgevoerd."@nl ;
        sh:maxCount 1 ;
        sh:message "evtAgRole:exe occurs more than once or its value is no instance of classes premis:SoftwareAgent"@en, "evtAgRole:exe apparaît plus d'une seule fois ou sa valeur n'est pas une instance de classes premis:SoftwareAgent"@fr, "evtAgRole:exe komt meer dan eens voor of de waarde is geen instantie van de klassen premis:SoftwareAgent"@nl ;
        sh:minCount 0 ;
        sh:name "executed by"@en, "exécuté par"@fr, "uitgevoerd door"@nl ;
        sh:path ha:hasExecutingSoftware ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass premis:Event ;
     .

# REVIEW FIX: sh:Nodeshape is a typo for sh:NodeShape. The existing target and
# sh:property still identify this as a shape, so this is not proof that validation
# is skipped, but tools relying on the explicit type will miss it.
# REVIEW FIX: hasMissingAudioReels and hasNumberOfMissingAudioReels are now
# ha:hasMissingSoundReels and ha:hasNumberOfMissingSoundReels. Update the paths and
# messages, and replace ha:AudioReel below with ha:SoundReel.
ha:FilmCarrierRepresentationShape a sh:Nodeshape ;
    rdfs:label "film carrier representation shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:datatype xsd:boolean ;
        sh:description "Indicates if audio reels were lost (prior to any digitization processes)."@en, "Indique si des bobines audio ont été perdues (avant tout processus de numérisation)."@fr, "Geeft aan of er beeldrollen/-spoelen verloren werden (vóór enig eventueel digitaliseringsproces)."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of haDes:hasMissingAudioReels is not of type xsd:boolean, or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "lost audio reels"@en, "bobines audio perdues"@fr, "verloren audiorollen/-spoelen"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasMissingAudioReels ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:description "The reel where the representation is stored."@en, "Le porteur physique où la représentation est stocké."@fr, "De spoel waarop de representatie is opgeslagen."@nl ;
        sh:message "premis:storedAt has more than one value, no values or not a haObj:PhysicalCarrier"@en, "premis:storedAt a plus d'une valeur, pas de valeur ou n'est pas une haObj:PhysicalCarrier"@fr, "premis:storedAt heeft meer dan één of geen waarde of is geen haObj:PhysicalCarrier"@nl ;
        sh:minCount 1 ;
        sh:name "stored at"@en, "stocké à"@fr, "opgeslagen op"@nl ;
        sh:or (
            [
                sh:class ha:ImageReel ;
            ]
            [
                sh:class ha:AudioReel ;
            ]
        ) ;
        sh:path premis:storedAt ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:boolean ;
        sh:description "Indicates if image reels were lost (prior to any digitization processes)."@en, "Indique si des bobines d'image ont été perdues (avant tout processus de numérisation)."@fr, "Geeft aan of er beeldrollen/-spoelen verloren werden (vóór enig eventueel digitaliseringsproces)."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of haDes:hasMissingImageReels is not of type xsd:boolean, or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "lost image reels"@en, "bobines d'image perdues"@fr, "verloren beeldrollen/-spoelen"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasMissingImageReels ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:description "Indicates if and how many audio reels were lost (prior to any digitization processes)."@en, "Indique si et combien de bobines audio ont été perdues (avant tout processus de numérisation)."@fr, "Geeft aan of en hoeveel geluidsrol/-spoel verloren werden (vóór enig eventueel digitaliseringsproces)."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of haDes:numberOfMissingAudioReels is not of type xsd:nonNegativeInteger, or occurs more than once"@en, "l'objet de haDes:numberOfMissingAudioReels n'est pas de type xsd:nonNegativeInteger, ou apparaît plus d'une seule fois"@fr, "het object van haDes:numberOfMissingAudioReels is niet van het type xsd:nonNegativeInteger, of komt meer dan eens voor"@nl ;
        sh:minCount 0 ;
        sh:name "number of lost audio reels"@en, "nombre de bobines audio perdues"@fr, "aantal verloren audiorollen/-spoelen"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasNumberOfMissingAudioReels ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:description "Indicates if and how many image reels were lost (prior to any digitization processes)."@en, "Indique si et combien de bobines d'image ont été perdues (avant tout processus de numérisation)."@fr, "Geeft aan of en hoeveel beeldrol/-spoel verloren werden (vóór enig eventueel digitaliseringsproces)."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of haDes:numberOfMissingImageReels is not of type xsd:nonNegativeInteger, or occurs more than once"@en, "l'objet de haDes:numberOfMissingImageReels n'est pas de type xsd:nonNegativeInteger, ou apparaît plus d'une seule fois"@fr, "het object van haDes:numberOfMissingImageReels is niet van het type xsd:nonNegativeInteger, of komt meer dan eens voor"@nl ;
        sh:minCount 0 ;
        sh:name "number of lost image reels"@en, "nombre de bobines d'image perdues"@fr, "aantal verloren beeldrollen/-spoelen"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasNumberOfMissingImageReels ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:description "Indicates the number of reels (regardless of type) that the film consists of."@en, "Indique le nombre de bobines (quel que soit le type) qui composent le film."@fr, "Geeft aan uit hoeveel rollen/spoelen (ongeacht het type) waaruit de film bestaat."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of haDes:numberOfReels is not of type xsd:nonNegativeInteger, or occurs more than once"@en, "l'objet de haDes:numberOfReels n'est pas de type xsd:nonNegativeInteger, ou apparaît plus d'une seule fois"@fr, "het object van haDes:numberOfReels is niet van het type xsd:nonNegativeInteger, of komt meer dan eens voor"@nl ;
        sh:minCount 0 ;
        sh:name "number of reels"@en, "nombre de bobines"@fr, "aantal (film)rollen/-spoelen"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasNumberOfReels ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:FilmCarrierRepresentation ;
     .

# REVIEW PROFILE: requiring exactly one physical carrier representation excludes
# born-digital films and films with several carrier copies. The RDFS definition
# does not make a physical original mandatory; scope this to the relevant workflow.
ha:FilmShape a sh:NodeShape ;
    rdfs:label "film shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class ha:FilmCarrierRepresentation ;
        sh:description "The representation stored on a physical carrier."@en, "La représentation stockée sur un porteur physique."@fr, "De representatie opgeslagen op een fysieke drager."@nl ;
        sh:maxCount 1 ;
        sh:message "haObj:hasCarrierCopy is missing, has more than one value or is not a haDes:FilmCarrierRepresentation"@en ;
        sh:minCount 1 ;
        sh:name "has carrier copy"@en, "est porteur du copie"@fr, "heeft dragerkopie"@nl ;
        sh:path ha:hasCarrierCopy ;
        sh:severity sh:Violation ;
    ], ha:BroadcasterShape ;
    sh:targetClass ha:Film ;
     .

# REVIEW ALIGN: hasCreator is a string here, but RDFS gives it a Person/
# Organization/Role resource range and an IntellectualEntity/DigitalRepresentation
# domain. A checksum creator literal conflicts with that model. Use a dedicated
# checksum-creator property or align its type and domain explicitly.
ha:FixityShape a sh:NodeShape ;
    rdfs:label "fixity shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "The entity that generated the checksum."@en, "L'entité qui a généré la somme de contrôle."@fr, "De entiteit die de checksum gegenereerd heeft."@nl ;
        sh:name "checksum creator"@en, "créateur de somme de contrôle"@fr, "checksum maker"@nl ;
        sh:path ha:hasCreator ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "The value of the checksum."@en, "La valeur de la somme de contrôle."@fr, "De waarde van de checksum."@nl ;
        sh:maxCount 1 ;
        sh:message "rdf:value is missing, occurs more than once, or is not of type string"@en ;
        sh:minCount 1 ;
        sh:name "fixity checksum"@en, "vérification de la fixation"@fr, "fixity checksum"@nl ;
        sh:path rdf:value ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass premis:Fixity ;
     .

ha:MediahavenFragmentShape a sh:NodeShape ;
    rdfs:label "fragment shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:datatype xsd:dateTime ;
        sh:description "The date on which the record was deleted."@en, "La date à laquelle le dossier a été supprimée."@fr, "De datum waarop het record is verwijderd."@nl ;
        sh:maxCount 1 ;
        sh:message "schema:dateDeleted is not of type xsd:dateTime or occurs more than once."@en ;
        sh:minCount 0 ;
        sh:name "date deleted"@en, "date supprimée"@fr, "datum verwijderd"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasDeletionDate ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:dateTime ;
        sh:description "The date on which the record was created."@en, "La date à laquelle le dossier a été créé."@fr, "De datum waarop het record is aangemaakt."@nl ;
        sh:maxCount 1 ;
        sh:message "schema:dateCreated is not of type xsd:dateTime or is missing."@en ;
        sh:minCount 1 ;
        sh:name "date created"@en, "date de création"@fr, "datum aangemaakt"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasCreationDate ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:MediahavenRecord ;
        sh:description "The Mediahaven Record to which this fragment belongs."@en, "Le dossier MediaHaven auquel appartient ce fragment."@fr, "Het Mediahaven record waartoe dit fragment behoort."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of mh:record is no mh:Record, is missing or occurs more than once"@en ;
        sh:minCount 1 ;
        sh:name "has record"@en, "a record"@fr, "heeft record"@nl ;
        sh:path ha:hasRecord ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "The unique identifier of a fragment within the Mediahaven asset management system."@en, "L'identifiant unique du fragment au sein du système de gestion d'actifs Mediahaven."@fr, "De unieke identifier van een fragment binnen het Mediahaven asset management system."@nl ;
        sh:maxCount 1 ;
        sh:message "the object of schema:identifier is no xsd:string, is missing or occurs more than once"@en ;
        sh:minCount 1 ;
        sh:name "has fragment identifier"@en, "a identifiant du fragment"@fr, "heeft fragment-ID"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasIdentifier ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:dateTime ;
        sh:description "The date on which the record was most recently modified."@en, "La date à laquelle le dossier a été récemment modifié."@fr, "De datum waarop het record het meest recent is gewijzigd."@nl ;
        sh:maxCount 1 ;
        sh:message "schema:dateModified is not of type xsd:dateTime or is missing."@en ;
        sh:minCount 1 ;
        sh:name "date modified"@en, "date modifiée"@fr, "datum gewijzigd"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasModificationDate ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:MediahavenFragment ;
     .

ha:HardwareAgentShape a sh:NodeShape ;
    rdfs:label "hardware agent shape"@en ;
    sh:property ha:EventNameShape, ha:HardwareAgentHasBrandShape, ha:ModelShape, ha:SerialNumberShape, ha:VersionShape ;
    sh:targetClass premis:HardwareAgent ;
     .

# REVIEW FIX: hasFilmColourType is now ha:hasFilmColorType in RDFS. The spelling
# change leaves the current optional path unable to check values of the new term.
ha:ImageReelShape a sh:NodeShape ;
    rdfs:label "image reel shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:description "Indication of the coloring of the image reel."@en, "Indication de la coloration de la bobine d'image."@fr, "Indicatie van de kleuring van de beeldrol/-spoel."@nl ;
        sh:in (
            <https://data.hetarchief.be/id/color-type/BandW>
            <https://data.hetarchief.be/id/color-type/Color>
            <https://data.hetarchief.be/id/color-type/Colorized>
            <https://data.hetarchief.be/id/color-type/Composite>
            <https://data.hetarchief.be/id/color-type/Tinted>
            <https://data.hetarchief.be/id/color-type/Toned>
            <https://data.hetarchief.be/id/color-type/UnknownColorType>
        ) ;
        sh:message "the object of haDes:coloringType is not of type skos:Concept"@en, "l'objet de haDes:coloringType n'est pas du type skos:Concept"@fr, "het object van haDes:coloringType is niet van het type skos:Concept"@nl ;
        sh:name "coloring type"@en, "type de coloration"@fr, "type kleuring"@nl ;
        sh:path ha:hasFilmColourType ;
        sh:severity sh:Violation ;
    ], _:cb6dfd49844fa0d974bc61143cd85cf2f7ca89309deda6861258c3cfac63a9ae8e0, [
        a sh:PropertyShape ;
        sh:class ha:OpenCaptions ;
        sh:description "Indicates the (embedded) captioning of an image reel ."@en, "Indique les sous-titres (intégrés) d'une bobine d'image."@fr, "Geeft de (ingebedde) ondertiteling aan van een beeldrol/-spoel."@nl ;
        sh:message "the object of ebucore:hasCaptioning is not of type ebucore:OpenCaptions"@en, "l'objet de ebucore:hasCaptioning n'est pas du type ebucore:OpenCaptions"@fr, "het object van ebucore:hasCaptioning is niet van het type ebucore:OpenCaptions"@nl ;
        sh:minCount 0 ;
        sh:name "has (embedded) captioning"@en, "a des sous-titres (intégrés)"@fr, "heeft (ingebedde) ondertiteling"@nl ;
        sh:path ha:hasCaptioning ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:ImageReel ;
     .

ha:ImageShape a sh:NodeShape ;
    rdfs:label "image shape"@en ;
    sh:targetClass ha:Image ;
     .

ha:LicenseShape a sh:NodeShape ;
    rdfs:label "license shape"@en ;
    sh:targetClass premis:License, skos:Concept ;
     .

ha:LocalIdentifierShape a sh:NodeShape ;
    rdfs:label "local identifier shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "The value of this identifier."@en, "La valeur de cet identifiant."@fr, "De waarde van deze identifier."@nl ;
        sh:maxCount 1 ;
        sh:message "rdf:value is missing, occurs more than once, or is not of type string"@en ;
        sh:minCount 1 ;
        sh:name "value"@en, "valeur"@fr, "waarde"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path rdf:value ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:LocalIdentifier ;
     .

