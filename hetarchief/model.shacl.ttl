# REVIEW: the PREMIS startDate/endDate constraints still describe rights periods;
# keep these distinct from the renamed ha:hasStartDate/ha:hasEndDate properties.
# Where bounded periods must be valid, also check that the start does not follow
# the end (likewise Activity timestamps and fragment offsets after migration).
ha:StartDateShape a sh:PropertyShape ;
    rdfs:label "start date shape"@en ;
    sh:datatype xsd:dateTime ;
    sh:description "The date on which this status or rule becomes active."@en, "Date à laquelle ce statut ou cette règle devient actif."@fr, "De datum waarop deze status of regel actief wordt."@nl ;
    sh:maxCount 1 ;
    sh:name "start date shape"@en, "date de début"@fr, "startdatum"@nl ;
    sh:nodeKind sh:Literal ;
    sh:path premis:startDate ;
     .

