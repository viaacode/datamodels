ha:RightsDigitalRepresentationShape a sh:NodeShape ;
    rdfs:label "rights digital representation shape"@en ;
    sh:property [
        sh:class premis:License ;
        sh:description "The condition(s) for reusing this digital representation."@en, "La(les) condition(s) de réutilisation de cette représentation numérique."@fr, "De voorwaarde(n) om deze digitale representatie te hergebruiken."@nl ;
        sh:maxCount 1 ;
        sh:name "condition for reuse"@en, "condition de réutilisation"@fr, "hergebruikvoorwaarde"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path ha:hasReuseCondition ;
    ], [
        sh:class odrl:Policy ;
        sh:description "The access policy of this digital representation that consists of permissions and restrictions."@en, "La politique d'accès de cette représentation numérique qui se compose d'autorisations et de restrictions."@fr, "Het ontsluitingsbeleid van deze digitale representatie die bestaat uit permissies en restricties."@nl ;
        sh:maxCount 1 ;
        sh:name "access policy"@en, "politique d'accès"@fr, "ontsluitingspolicy"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path odrl:hasPolicy ;
    ], [
        sh:class premis:RightsStatus ;
        sh:description "The rights status of this digital representation."@en, "Le statut des droits de cette représentation numérique."@fr, "De rechtenstatus van deze digitale representatie."@nl ;
        sh:maxCount 3 ;
        sh:minCount 1 ;
        sh:name "rights status"@en, "statut de droit"@fr, "rechtenstatus"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path premis:rightsStatus ;
    ] ;
    sh:targetClass ha:DigitalRepresentation ;
     .

# REVIEW ALIGN: hasReuseCondition is checked as skos:Concept in the description shape
# AND premis:License here. RDFS allows either via owl:unionOf. If alternatives are
# intended, use the same sh:or in both places; currently a value needs both types.
ha:RightsIntellectualEntityShape a sh:NodeShape ;
    rdfs:label "rights intellectual entity shape"@en ;
    sh:property [
        sh:class ha:RightsStatement ;
        sh:description "The statement indicating the copyright and reuse status of this intellectual entity."@en, "La déclaration indiquant le statut de droit d'auteur et de réutilisation de cette entité intellectuelle."@fr, "De verklaring die de auteursrechtelijke en hergebruikstatus van deze intellectuele entiteit duidt."@nl ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:name "rights statement"@en, "déclaration des droits"@fr, "rechtenverklaring"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path ha:hasRightsStatement ;
    ], [
        sh:class premis:License ;
        sh:description "The condition(s) for reusing this intellectual entity."@en, "La(les) condition(s) de réutilisation de cette entité intellectuelle."@fr, "De voorwaarde(n) om deze intellectuele entiteit te hergebruiken."@nl ;
        sh:maxCount 1 ;
        sh:name "condition for reuse"@en, "condition de réutilisation"@fr, "hergebruikvoorwaarde"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path ha:hasReuseCondition ;
    ], [
        sh:description "The rights status of this intellectual entity."@en, "Le statut des droits de cette entité intellectuelle."@fr, "De rechtenstatus van deze intellectuele entiteit."@nl ;
        sh:maxCount 3 ;
        sh:minCount 1 ;
        sh:name "rights status"@en, "statut de droit"@fr, "rechtenstatus"@nl ;
        sh:nodeKind sh:IRI ;
        sh:or (
            [
                sh:class premis:RightsStatus ;
            ]
            [
                sh:class ha:PublicDomainStatus ;
            ]
        ) ;
        sh:path premis:rightsStatus ;
    ] ;
    sh:targetClass premis:IntellectualEntity ;
     .

# REVIEW: targetClass skos:Concept, ha:RightsStatement is a union of targets,
# not an intersection or a subclass assertion. LicenseShape has the same issue.
# These empty shapes currently enforce nothing; narrow/remove those targets if
# the intent is documentation for rights statements/licenses only.
ha:RightsStatementShape a sh:NodeShape ;
    rdfs:label "rights statement shape"@en ;
    sh:targetClass skos:Concept, ha:RightsStatement ;
     .

ha:RightsStatusShape a sh:NodeShape ;
    rdfs:label "rights status shape"@en ;
    sh:property [
        sh:description "The rights statement or reuse condition on which this rights status is based."@en, "La déclaration de droits ou la condition de réutilisation sur laquelle se base ce statut de droits."@fr, "De rechtenverklaring of hergebruikvoorwaarde waarop deze rechtenstatus gebaseerd is."@nl ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:name "has basis"@en, "a une base"@fr, "heeft basis"@nl ;
        sh:nodeKind sh:IRI ;
        sh:or (
            [
                sh:class ha:RightsStatement ;
            ]
            [
                sh:class premis:License ;
            ]
        ) ;
        sh:path premis:basis ;
    ], ha:EndDateShape, ha:RightsNoteShape, ha:StartDateShape ;
    sh:targetClass premis:RightsStatus ;
     .

