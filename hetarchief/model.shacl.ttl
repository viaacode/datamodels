ha:CastMemberEntryShape a sh:NodeShape ;
    rdfs:label "cast member entry shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class ha:Agent ;
        sh:maxCount 1 ;
        sh:path rdf:value ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:integer ;
