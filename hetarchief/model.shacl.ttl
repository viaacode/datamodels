# REVIEW (2026-11-24): compared with model.rdfs.ttl and its three local imports.
# Comments only; no constraints were changed. FIX marks a concrete error or stale
# term; ALIGN marks a modeling difference to resolve in both files; PROFILE marks
# an application rule whose continued use needs confirmation from instance data.
# RDFS domains/ranges infer types; they do not establish mandatory fields or counts.
# A narrower SHACL profile can be intentional, so differences alone are not bugs.
#
# REVIEW: the core constraints remain useful: annotation confidence is decimal,
# annotation targets are files, durations are xsd:duration, measurements are floats,
# file size is non-negative, and LocalIdentifier has one string rdf:value. Keep
# these after resolving the term and profile issues below. Empty node shapes add
# no checks of their own; keep them only if documentation/tools need placeholders.
#
# REVIEW: load the RDFS subclass hierarchy and required vocabulary type assertions
# into the validation data/ontology context. sh:class and sh:targetClass use that
# hierarchy; rdfs:seeAlso does not link types. SHACL Core does not automatically
# apply owl:equivalentClass, owl:inverseOf or subproperty entailment. A copy link
# alone therefore does not satisfy a required ha:isRepresentedBy/ha:represents.
# Document the entailment/materialization policy and test representative records.
# Reference: https://www.w3.org/TR/shacl/#relationship-between-shacl-and-rdfs
# REVIEW: SHACL structure passes meta-validation; that does not prove these
# shapes accept the intended data. Add small conformance fixtures for the rights
# conflict, birthplace resources, renamed terms and each retained import profile
# after decisions are implemented. No production instance data was assessed here.
# REVIEW: refresh sh:message/sh:description text after the vocabulary migration.
# Many still name schema:/ebucore:/haDes:/haObj: terms instead of their ha: paths,
# claim missing values where minCount is 0/absent, or claim maxCount 1 where none
# is enforced (for example storedAt and event input/output). The material message
# says skos:Concept although its actual xsd:string check agrees with RDFS. Derive
# messages from the final constraints so users receive an actionable diagnosis.
PREFIX ha: <https://data.hetarchief.be/ns/>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX premis: <http://www.loc.gov/premis/rdf/v3/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX skosxl: <http://www.w3.org/2008/05/skos-xl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# REVIEW PROFILE: mandatory start AND end timestamps reject ongoing activities;
# prov:generated maxCount 1 rejects an activity generating two outputs. Keep these
# only for a completed, single-output workflow, or move them to that profile.
# The imported PREMIS model makes Event a subclass of prov:Activity, so these
# timestamp requirements also apply to every PREMIS event with that hierarchy.
ha:ActivityShape a sh:NodeShape ;
    rdfs:label "activity shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:datatype xsd:dateTime ;
        sh:description "The end date of the activity."@en, "La date de fin de l'activité."@fr, "De einddatum van de activiteit."@nl ;
        sh:maxCount 1 ;
        sh:message "prov:endedAtTime is absent, occurs more than once or its value is not of type xsd:dateTime"@en, "prov:endedAtTime est absent, apparaît plus d'une fois ou sa valeur n'est pas de type xsd:dateTime"@fr, "prov:endedAtTime ontbreekt, komt meer dan eens voor of de waarde is niet van het type xsd:dateTime"@nl ;
        sh:minCount 1 ;
        sh:name "has end date"@en, "a date de fin"@fr, "heeft einddatum"@nl ;
        sh:path prov:endedAtTime ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        skos:definition "An agent that had some (unspecified) responsibility for the occurrence of this activity."@en, "Un agent qui avait une responsabilité (non spécifiée) avant la survenue de cette activité."@fr, "Een agent die enige (niet-gespecificeerde) verantwoordelijkheid had voor het optreden van deze activiteit."@nl ;
        sh:message "prov:wasAssociatedWith is not an instance of classes schema:Person/org/Organization/premis:SoftwareAgent/premis:HardwareAgent"@en, "prov:wasAssociatedWith n'est pas une instance de classes schema:Person/org/Organization/premis:SoftwareAgent/premis:HardwareAgent"@fr, "prov:wasAssociatedWith is geen instantie van de klassen schema:Person/org/Organization/premis:SoftwareAgent/premis:HardwareAgent"@nl ;
        sh:name "was associated with"@en, "a été associé à"@fr, "is geassocieerd met"@nl ;
        sh:or (
            [
                sh:class ha:Person ;
            ]
            [
                sh:class ha:Organization ;
            ]
            [
                sh:class premis:SoftwareAgent ;
            ]
            [
                sh:class premis:HardwareAgent ;
            ]
        ) ;
        sh:path prov:wasAssociatedWith ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:dateTime ;
        sh:description "The start date of the activity."@en, "La date de début de l'activité."@fr, "De startdatum van de activiteit."@nl ;
        sh:maxCount 1 ;
        sh:message "prov:startedAtTime is absent, occurs more than once or its value is not of type xsd:dateTime"@en, "prov:startedAtTime est absent, apparaît plus d'une fois ou sa valeur n'est pas de type xsd:dateTime"@fr, "prov:startedAtTime ontbreekt, komt meer dan eens voor of de waarde is niet van het type xsd:dateTime"@nl ;
        sh:minCount 1 ;
        sh:name "has start date"@en, "a date de début"@fr, "heeft startdatum"@nl ;
        sh:path prov:startedAtTime ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:description "The generated object."@en, "L'objet généré."@fr, "Het gegenereerde object."@nl ;
        sh:maxCount 1 ;
        sh:message "prov:generated occurs more than once or its value is not an IRI"@en, "prov:generated apparaît plus d'une fois ou sa valeur n'est pas un IRI"@fr, "prov:generated komt meer dan eens voor of de waarde is geen IRI"@nl ;
        sh:minCount 0 ;
        sh:name "has generated"@en, "a généré"@fr, "heeft gegenereerd"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path prov:generated ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass prov:Activity ;
     .

# REVIEW ALIGN: hasAnnotationType should check ha:AnnotationType if the RDFS range
# is intended; plain skos:Concept currently admits unrelated thesaurus concepts.
# The confidence message also says integer although the actual datatype is decimal.
ha:AnnotationShape a sh:NodeShape ;
    rdfs:label "annotation shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:datatype xsd:decimal ;
        sh:description "Number to estimate the confidence in the Annotation."@en, "Nombre pour estimer la confiance dans l'annotation."@fr, "Cijfer om het vertrouwen in de annotatie te schatten."@nl ;
        sh:maxCount 1 ;
        sh:message "ha:hasAnnotationConfidence is missing, occurs more than once or its object is not a xsd:decimal"@en ;
        sh:minCount 1 ;
        sh:name "annotation confidence"@en, "confiance en annotation"@fr, "annotatie vertrouwen"@nl ;
        sh:path ha:hasAnnotationConfidence ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class premis:File ;
        sh:description "To define the target file to which the Annotation applies."@en, "Pour définir le fichier cible auquel l'annotation s'applique."@fr, "Om het doelbestand te definiëren waarop de annotatie van toepassing is."@nl ;
        sh:maxCount 1 ;
        sh:message "ha:hasAnnotationTarget is missing, occurs more than once or its object is not a premis:File"@en ;
        sh:minCount 1 ;
        sh:name "annotation target"@en, "cible d'annotation"@fr, "annotatiedoel"@nl ;
        sh:path ha:hasAnnotationTarget ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:description "The subject of the Annotation."@en, "Le sujet de l'annotation."@fr, "Het onderwerp van de annotatie."@nl ;
        sh:maxCount 1 ;
        sh:message "ha:hasAnnotationSubject is missing, occurs more than once or its object is not an IRI or a Literal"@en ;
        sh:minCount 1 ;
        sh:name "annotation subject"@en, "sujet d'annotation"@fr, "annotatie onderwerp"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path ha:hasAnnotationSubject ;
        sh:class ha:Thing ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:AnnotationType ;
        sh:in (ha:recognized-face ha:named-entity) ;
        sh:description "To define a type of Annotation, such as a recognized face or Named Entity."@en, "Pour définir un type d'annotation, comme un visage reconnu ou une entité nommée."@fr, "Om het type annotatie te definiëren, zoals een herkend gezicht of Named Entity."@nl ;
        sh:maxCount 1 ;
        sh:message "ebucore:annotationType occurs more than once or its object is not a skos:Concept"@en ;
        sh:minCount 0 ;
        sh:name "annotation type"@en, "type d'annotation"@fr, "type annotatie"@nl ;
        sh:path ha:hasAnnotationType ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:or ( [ sh:class ha:MediaFile ] [ sh:class ha:MediaFragment ] ) ;
        sh:description "The media fragment or resource that is linked to this Annotation."@en, "Le fragment multimédia lié à cette annotation."@fr, "Het media fragment of resource dat gelinkt is aan deze annotatie."@nl ;
        sh:message "ha:annotatesMediaResource must point to a media file or media fragment."@en ;
        sh:minCount 1 ;
        sh:name "annotates"@en, "annote"@fr, "annoteert"@nl ;
        sh:path ha:annotatesMediaResource ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:Annotation ;
     .

ha:ArchiveComponentShape a sh:NodeShape ;
    rdfs:label "archive component shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class ha:ArchiveComponent ;
        sh:message "schema:isPartOf is not of class schema:ArchiveComponent."@en, "schema:isPartOf n'est pas de la classe schema:ArchiveComponent."@fr, "schema:isPartOf is niet van de klasse schema:ArchiveComponent."@nl ;
        sh:name "is part of"@en, "est partie de"@fr, "is deel van"@nl ;
        sh:path ha:isPartOf ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:description "Indicates an IntellectualEntity or ArchiveComponent that is part of this archive component."@en, "Indique une intellectualité ou un travail créatif qui fait partie de cette composante d'archives."@fr, "Geeft aan dat deze IntellectualEntity of ArchiveComponent deel uitmaakt van deze archief component."@nl ;
        sh:message "schema:hasPart is not of class premis:IntellectualEntity"@en, "schema:hasPart n'est pas de la classe premis:IntellectualEntity"@fr, "schema:hasPart is niet van de klasse premis:IntellectualEntity"@nl ;
        sh:name "has part"@en, "a partie"@fr, "heeft deel"@nl ;
        sh:or (
            [
                sh:class premis:IntellectualEntity ;
            ]
            [
                sh:class ha:ArchiveComponent ;
            ]
        ) ;
        sh:path ha:hasPart ;
        sh:severity sh:Violation ;
    ], ha:DescriptionNameShape, ha:DescriptionShape ;
    sh:targetClass ha:ArchiveComponent ;
     .

# REVIEW FIX: ha:AudioReel was renamed ha:SoundReel in RDFS. Update this target
# and the storedAt alternative in FilmCarrierRepresentationShape together.
# The shared aspect-ratio rule describes image geometry; confirm why a sound-only
# reel needs it, rather than copying the ImageReel constraint to the renamed shape.
ha:SoundReelShape a sh:NodeShape ;
    rdfs:label "audio reel shape"@en ;
    sh:property _:cb6dfd49844fa0d974bc61143cd85cf2f7ca89309deda6861258c3cfac63a9ae8e0 ;
    sh:targetClass ha:SoundReel ;
     .

ha:AudioShape a sh:NodeShape ;
    rdfs:label "audio shape"@en ;
    sh:property ha:AudiovisualHasCarrierCopyShape, ha:BroadcasterShape ;
    sh:targetClass ha:Audio ;
     .

ha:AudiovisualCarrierRepresentationShape a sh:NodeShape ;
    rdfs:label "audiovisual carrier representation shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class ha:AudiovisualCarrier ;
        sh:description "The reel where the representation is stored."@en, "Le porteur physique où la représentation est stocké."@fr, "De spoel waarop de representatie is opgeslagen."@nl ;
        sh:message "premis:storedAt has more than one value, no values or not a haObj:PhysicalCarrier"@en, "premis:storedAt a plus d'une valeur, pas de valeur ou n'est pas une haObj:PhysicalCarrier"@fr, "premis:storedAt heeft meer dan één of geen waarde of is geen haObj:PhysicalCarrier"@nl ;
        sh:minCount 1 ;
        sh:name "stored at"@en, "stocké à"@fr, "opgeslagen op"@nl ;
        sh:path premis:storedAt ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
        sh:message "haDes:numberOfAudioChannels occurs more than once, or its object is not of type xsd:nonNegativeInteger." ;
        sh:minCount 0 ;
        sh:name "number of audio channels"@en, "nombre de canaux audio"@fr, "aantal audiokanalen"@nl ;
        sh:path ha:hasNumberOfAudioChannels ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
        sh:message "haDes:numberOfAudioTracks occurs more than once, or its object is not a xsd:nonNegativeInteger. " ;
        sh:minCount 0 ;
        sh:name "number of audio tracks"@en, "nombre de pistes audio"@fr, "aantal audiotracks"@nl ;
        sh:path ha:hasNumberOfAudioTracks ;
    ] ;
    sh:targetClass ha:AudiovisualCarrierRepresentation ;
     .

# REVIEW PROFILE: these closed value lists are application vocabularies, not
# RDFS requirements. Confirm their current coverage before retaining them. For
# recording speed, every listed IRI must also be typed ha:QuantitativeValue and
# satisfy its measurement/unit shapes; the message incorrectly says skos:Concept.
ha:AudiovisualCarrierShape a sh:NodeShape ;
    rdfs:label "audiovisual carrier shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        skos:definition "The technology used for noise reduction in audio."@en, "La technologie utilisée pour la réduction du bruit de l'audio."@fr, "De techniek die gebruikt wordt voor ruisonderdrukking bij audio."@nl ;
        sh:datatype xsd:string ;
        sh:in (
            "DBX"
            "Dolby A"
            "Dolby B"
            "Dolby C"
            "Dolby D"
        ) ;
        sh:maxCount 1 ;
        sh:message "haDes:audioNoiseReduction is not DBX, Dolby A, Dolby B, Dolby C, Dolby D; or occurs more than once."@en ;
        sh:minCount 0 ;
        sh:name "audio noise reduction"@en, "réduction du bruit audio"@fr, "audio ruisonderdrukking"@nl ;
        sh:path ha:hasAudioNoiseReduction ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:QuantitativeValue ;
        sh:description "The speed with which open reel audio or a gramophone record is recorded."@en, "La vitesse à laquelle l'audio à bobine ouverte ou un enregistrement gramophone est enregistré."@fr, "De snelheid waarmee openspoelaudio of een grammofoonplaat wordt opgenomen."@nl ;
        sh:in (
            <https://data.hetarchief.be/id/rotational-speed/variable>
            <https://data.hetarchief.be/id/rotational-speed/16-rpm>
            <https://data.hetarchief.be/id/rotational-speed/19-cm-s>
            <https://data.hetarchief.be/id/rotational-speed/2.375-cm-s>
            <https://data.hetarchief.be/id/rotational-speed/33-1-3-rpm>
            <https://data.hetarchief.be/id/rotational-speed/38-cm-s>
            <https://data.hetarchief.be/id/rotational-speed/4.75-cm-s>
            <https://data.hetarchief.be/id/rotational-speed/72-cm-s>
            <https://data.hetarchief.be/id/rotational-speed/78-rpm>
            <https://data.hetarchief.be/id/rotational-speed/90-rpm>
            <https://data.hetarchief.be/id/rotational-speed/9.5-cm-s>
        ) ;
        sh:maxCount 1 ;
        sh:message "haDes:audioRecordingSpeed is not a skos:Concept, or occurs more than once."@en ;
        sh:minCount 0 ;
        sh:name "audio recording speed"@en, "vitesse d'enregistrement audio"@fr, "audio-opnamesnelheid"@nl ;
        sh:path ha:hasAudioRecordingSpeed ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:description "Het iec-60094 type van de compact cassette die duidt op het magnetisch materiaal dat als bindmiddel werd gebruikt bovenop de polyester onderlaag van de cassette."@nl, "Le type IEC-60094 de la cassette compacte qui indique le matériau magnétique utilisé comme liant sur le dessus de la couche inférieure en polyester de la cassette."@nl, "The IEC-60094 Type of the compact cassette that indicates the magnetic material used as a binder on top of the polyester bottom layer of the cassette."@nl ;
        sh:in (
            <https://data.hetarchief.be/id/iec60094-type/I>
            <https://data.hetarchief.be/id/iec60094-type/II>
            <https://data.hetarchief.be/id/iec60094-type/III>
            <https://data.hetarchief.be/id/iec60094-type/IV>
        ) ;
        sh:maxCount 1 ;
        sh:message "haDes:iec60094Type is not \"I\", \"II\", \"III\", or \"IV\"."@en ;
        sh:minCount 0 ;
        sh:name "iec-60094 type"@en, "iec-60094 type"@fr, "iec-60094 type"@nl ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:path ha:hasIEC60094Type ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:AudiovisualCarrier ;
     .

ha:ConceptSchemeShape a sh:NodeShape ;
    rdfs:label "concept scheme shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:name "has top concept"@en, "a pour concept supérieur"@fr, "heeft top concept"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path skos:hasTopConcept ;
        sh:severity sh:Violation ;
    ], ha:AltLabelShape, ha:ChangeNoteShape, ha:EditorialNoteShape, ha:ExampleShape, ha:HiddenLabelShape, ha:HistoryNoteShape, ha:NotationShape, ha:PrefLabelShape, ha:ScopeNoteShape, ha:TermsNoteShape ;
    sh:targetClass skos:ConceptScheme ;
     .

# REVIEW PROFILE: requiring inScheme, definition and a language-tagged prefLabel
# on EVERY skos:Concept also reaches ha:LocalIdentifier, FileFormat, RoleType,
# OrganizationType, Issuance and controlled ODRL values when their types are loaded.
# A local identifier with only rdf:value then fails for unrelated thesaurus fields.
# Scope the completeness rules to managed thesauri, or explicitly require that
# metadata for every reused concept and include it in validation inputs.
# The skosxl:prefLabel maxCount 1 also forbids two labels in different languages;
# if multilingual SKOS-XL labels are supported, validate language uniqueness on
# the labels' literal forms instead of limiting the number of label resources.
ha:ConceptShape a sh:NodeShape ;
    rdfs:label "concept shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:name "broader"@en, "plus large"@fr, "breder"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path skos:broader ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:name "has lower priority than"@en, "a une priorité inférieure à"@fr, "heeft een lagere prioriteit dan"@nl ;
        sh:path ha:hasLowerPriorityThan ;
        sh:severity sh:Warning ;
    ], [
        a sh:PropertyShape ;
        sh:class skosxl:Label ;
        sh:maxCount 1 ;
        sh:name "pref label"@en, "label préféré"@fr, "voorkeurslabel"@nl ;
        sh:path skosxl:prefLabel ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:name "narrower"@en, "plus étroit"@fr, "nauwer"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path skos:narrower ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:name "has higher priority than"@en, "a une priorité plus grande que"@fr, "heeft een hogere prioriteit dan"@nl ;
        sh:path ha:hasHigherPriorityThan ;
        sh:severity sh:Warning ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:name "broader transitive"@en, "plus large transitive"@fr, "breder transitief"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path skos:broaderTransitive ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:name "broad match"@en, "correspondance large"@fr, "brede match"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path skos:broadMatch ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:ConceptScheme ;
        sh:minCount 1 ;
        sh:name "in scheme"@en, "dans le schéma"@fr, "in schema"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path skos:inScheme ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:name "mapping relation"@en, "relation de correspondance"@fr, "mapping relatie"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path skos:mappingRelation ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:name "semantic relation"@en, "relation sémantique"@fr, "semantische relatie"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path skos:semanticRelation ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:disjoint skos:broadMatch, skos:closeMatch, skos:narrowMatch, skos:relatedMatch ;
        sh:name "exact match"@en, "correspondance exacte"@fr, "exacte overeenkomst"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path skos:exactMatch ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:ConceptScheme ;
        sh:name "top concept of"@en, "concept supérieur de"@fr, "top concept van"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path skos:topConceptOf ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:disjoint skos:broadMatch, skos:closeMatch, skos:exactMatch, skos:relatedMatch ;
        sh:name "narrow match"@en, "correspondance étroite"@fr, "nauwe match"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path skos:narrowMatch ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:name "narrower transitive"@en, "plus étroit transitive"@fr, "nauwer transitief"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path skos:narrowerTransitive ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:disjoint skos:broadMatch, skos:exactMatch, skos:narrowMatch, skos:relatedMatch ;
        sh:name "close match"@en, "correspondance proche"@fr, "nabije match"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path skos:closeMatch ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:disjoint skos:broader, skos:broaderTransitive, skos:narrower, skos:narrowerTransitive ;
        sh:name "related"@en, "lié"@fr, "gerelateerd"@nl ;
        sh:path skos:related ;
        sh:severity sh:Warning ;
    ], [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:disjoint skos:broadMatch, skos:closeMatch, skos:exactMatch, skos:narrowMatch ;
        sh:name "related match"@en, "correspondance liée"@fr, "gerelateerde match"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path skos:relatedMatch ;
        sh:severity sh:Violation ;
    ], ha:AltLabelShape, ha:ChangeNoteShape, ha:DefinitionShape, ha:EditorialNoteShape, ha:ExampleShape, ha:HiddenLabelShape, ha:HistoryNoteShape, ha:NotationShape, ha:PrefLabelShape, ha:ScopeNoteShape, ha:TermsNoteShape ;
    sh:scopeClass skos:Concept ;
    sh:targetClass skos:Concept ;
     .

# REVIEW FIX: ha:MetadataRScope is undeclared. RDFS declares ha:MetadataScope,
# but ha:extended/ha:limited are still typed ha:MetadataRange (also undeclared).
# Align the class AND those individuals; changing this shape alone will still
# reject both metadata-scope values.
# REVIEW FIX: dateTime/absoluteTemporalPosition are allowed as left operands, but
# the right operand is restricted to eleven IRIs, so a typed date or offset always
# fails. Split alternatives by left operand and pair each with its right-value type
# and supported operators. That also prevents recipient=ha:full and scope=user-group
# combinations, which currently pass the independent lists. Consultation/download
# are actions, not UserGroup/MetadataScope/ContentScope instances; keep them on
# odrl:action unless an explicit constraint use case needs a separate branch.
ha:ConstraintShape a sh:NodeShape ;
    rdfs:label "constraint shape"@en ;
    sh:property [
        sh:in (
            odrl:eq
            odrl:lt
        ) ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:name "operator"@en, "opérateur"@fr, "operator"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path odrl:operator ;
    ], [
        sh:in (
            ha:extended
            ha:limited
            ha:full
            ha:partial
            ha:available-for-consultation
            ha:downloadable
            ha:between-partners
            ha:educational-public
            ha:intra-muros
            ha:public
            ha:research-public
        ) ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:name "constraint value"@en, "valeur de contrainte"@fr, "beperkingswaarde"@nl ;
        sh:nodeKind sh:IRI ;
        sh:or (
            [
                sh:class ha:UserGroup ;
            ]
            [
                sh:class ha:MetadataRScope ;
            ]
            [
                sh:class ha:ContentScope ;
            ]
        ) ;
        sh:path odrl:rightOperand ;
    ], [
        sh:in (
            odrl:recipient
            ha:metadataScope
            ha:contentScope
            odrl:dateTime
            odrl:absoluteTemporalPosition
        ) ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:name "constraint name"@en, "nom de la contrainte"@fr, "beperkingsnaam"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path odrl:leftOperand ;
    ] ;
    sh:targetClass odrl:Constraint ;
     .

# REVIEW PROFILE: ha:PostalAddress is a subclass of ha:ContactPoint, so every
