# REVIEW ALIGN: RDFS gives hasProductionMethod the undeclared range
# ha:BibframeProductionMethod, while it declares ha:ProductionMethod as a SKOS
# concept subclass. Resolve that apparent RDFS stale name, then check the intended
# class here instead of allowing any skos:Concept. Confirm the three enum IRIs
# and their type/label data are still the maintained production-method vocabulary.
ha:WrittenWorkCarrierRepresentationShape a sh:NodeShape ;
    rdfs:label "written work carrier representation shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class skos:Concept ;
        sh:description "The process used to produce the carrier representation of the written work (e.g. handwritten, typed, printed)."@en, "Le processus utilisé pour produire la eprésentation de porteur de l'œuvre écrite (par exemple manuscrit, dactylographié, imprimé)."@fr, "Het proces dat werd gebruikt om de dragerrepresentatie van het geschreven werk te produceren (bijv. handgeschreven, getypt, gedrukt)."@nl ;
        sh:in (
            <https://data.hetarchief.be/id/production-method/handwritten>
            <https://data.hetarchief.be/id/production-method/typed>
            <https://data.hetarchief.be/id/production-method/printed>
        ) ;
        sh:maxCount 1 ;
        sh:message "the object of bf:productionMethod is not of type skos:Concept, or occurs more than once"@en ;
        sh:minCount 0 ;
        sh:name "production method"@en, "méthode de production"@fr, "productie methode"@nl ;
        sh:path ha:hasProductionMethod ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:WrittenWorkCarrierRepresentation ;
     .

ha:DefinitionShape a sh:PropertyShape ;
    rdfs:label "definition shape"@en ;
    sh:datatype rdf:langString ;
    sh:minCount 1 ;
    sh:name "definition shape"@en, "définition"@fr, "definitie"@nl ;
    sh:nodeKind sh:Literal ;
    sh:path skos:definition ;
    sh:severity sh:Violation ;
     .

# REVIEW: this checks the types of reachable rdf:first values, but accepts a
# head with no first/rest values, multiple first values, and lists without rdf:nil
# termination. If ordered collection structure must be guaranteed, also validate
# list-cell cardinality and finite termination. Scope this check to member lists;
# the rdf:List target otherwise applies SKOS-only membership to unrelated lists.
ha:ListShape a sh:NodeShape ;
    rdfs:label "list shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:or (
            [
                sh:class skos:Concept ;
            ]
            [
                sh:class skos:Collection ;
            ]
        ) ;
        sh:path (
            [
                sh:zeroOrMorePath rdf:rest ;
            ]
            rdf:first
        ) ;
    ] ;
    sh:targetClass rdf:List ;
     .

ha:ActionShape a sh:PropertyShape ;
    rdfs:label "action shape"@en ;
    sh:class odrl:Action ;
    sh:description "The action to which the permission or restriction relates."@en, "L'action à laquelle se rapporte l'autorisation ou la restriction."@fr, "De actie waarop de permissie of restrictie betrekking heeft."@nl ;
    sh:in (
        ha:available-for-consultation
        ha:downloadable
    ) ;
    sh:minCount 1 ;
    sh:name "action shape"@en, "action d'accès"@fr, "ontsluitingsactie"@nl ;
    sh:nodeKind sh:IRI ;
    sh:path odrl:action ;
     .

ha:DurationShape a sh:PropertyShape ;
    rdfs:label "duration shape"@en ;
    sh:datatype xsd:duration ;
    sh:maxCount 1 ;
    sh:message "schema:duration is not of type xsd:duration"@en, "schema:duration n'est pas de type xsd:duration"@fr, "schema:duration is niet van het type xsd:duration"@nl ;
    sh:name "duration shape"@en, "durée"@fr, "duur"@nl ;
    sh:nodeKind sh:Literal ;
    sh:path ha:hasDuration ;
    sh:severity sh:Violation ;
     .

ha:EventNameShape a sh:PropertyShape ;
    rdfs:label "event name shape"@en ;
    sh:datatype rdf:langString ;
    sh:message "schema:name is missing or not of type string "@en, "schema:name est manquant ou n'est pas de type string"@fr, "schema:name ontbreekt of is niet van het type string"@nl ;
    sh:minCount 1 ;
    sh:name "event name shape"@en, "nom"@fr, "naam"@nl ;
    sh:nodeKind sh:Literal ;
    sh:path ha:hasName ;
    sh:severity sh:Violation ;
    sh:uniqueLang true ;
     .

ha:HardwareAgentHasBrandShape a sh:PropertyShape ;
    rdfs:label "hardware agent has brand shape"@en ;
    sh:class ha:Brand ;
    sh:description "The particular brand of the Agent."@en, "La marque particulière de l'agent."@fr, "Het specifieke merk van de agent."@nl ;
    sh:maxCount 1 ;
    sh:message "schema:brand occurs more than once or its value is no instance of schema:Brand"@en ;
    sh:minCount 0 ;
    sh:name "hardware agent has brand shape"@en, "marque"@fr, "merk"@nl ;
    sh:path ha:hasBrand ;
    sh:severity sh:Violation ;
     .

# REVIEW ALIGN: ALL hasIdentifier shapes use string literals, but RDFS now has
# range ha:LocalIdentifier while still declaring owl:DatatypeProperty. Decide how
# to distinguish platform string IDs from local identifier resources, then align
# RDFS, this shape, every inline identifier shape and shared blank-node shape.
# A resource-valued identifier valid under the current range fails all those
# string checks; changing only this reusable shape leaves the others inconsistent.
ha:IdentifierShape a sh:PropertyShape ;
    rdfs:label "identifier shape"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "schema:identifier is missing or not of type string "@en, "schema:identifier est manquant ou n'est pas de type string"@fr, "schema:identifier ontbreekt of is niet van het type string"@nl ;
    sh:minCount 1 ;
    sh:name "identifier shape"@en, "identifiant"@fr, "identificator"@nl ;
    sh:nodeKind sh:Literal ;
    sh:path ha:hasIdentifier ;
    sh:severity sh:Violation ;
     .

ha:ModelShape a sh:PropertyShape ;
    rdfs:label "model shape"@en ;
    sh:datatype xsd:string ;
    sh:description "The particular model of the Agent."@en, "La modèle particulière de l'agent."@fr, "Het specifieke model van de agent."@nl ;
    sh:maxCount 1 ;
    sh:message "schema:model occurs more than once or its value is no string"@en ;
    sh:minCount 0 ;
    sh:name "model shape"@en, "modèle"@fr, "model"@nl ;
    sh:path ha:hasModel ;
    sh:severity sh:Violation ;
     .

# REVIEW PROFILE: maxCount 5 is a fixed application limit without a matching
# RDFS requirement. Keep it only if policies with six valid constraints are truly
# unsupported. Otherwise remove the cap or keep it in that application profile.
ha:PolicyHasConstraintShape a sh:PropertyShape ;
    rdfs:label "policy has constraint shape"@en ;
    sh:class odrl:Constraint ;
    sh:description "A precondition for this permission or restriction."@en, "Une condition préalable à cette autorisation ou restriction."@fr, "Een randvoorwaarde voor deze permissie of restrictie."@nl ;
    sh:maxCount 5 ;
    sh:name "policy has constraint shape"@en, "contrainte"@fr, "beperking"@nl ;
    sh:nodeKind sh:IRI ;
    sh:path odrl:constraint ;
     .

ha:SerialNumberShape a sh:PropertyShape ;
    rdfs:label "serial number shape"@en ;
    sh:datatype xsd:string ;
    sh:description "The serial number or any alphanumeric identifier of a particular agent."@en, "Le numéro de série ou tout identifiant alphanumérique d'un agent particulier."@fr, "Het serienummer of een alfanumerieke identificatie van een bepaald middel."@nl ;
    sh:maxCount 1 ;
    sh:message "schema:serialNumber occurs more than once or its value is no string"@en ;
    sh:minCount 0 ;
    sh:name "serial number shape"@en, "numéro de série"@fr, "serienummer"@nl ;
    sh:path ha:hasSerialNumber ;
    sh:severity sh:Violation ;
     .

ha:VersionShape a sh:PropertyShape ;
    rdfs:label "version shape"@en ;
    sh:datatype xsd:string ;
    sh:description "The agent's version number or version name."@en, "Le numéro de version de l'agent ou le nom de la version."@fr, "Het versienummer of versienaam van de agent."@nl ;
    sh:maxCount 1 ;
    sh:message "schema:version occurs more than once or its value is no string"@en ;
    sh:minCount 0 ;
    sh:name "version shape"@en, "version"@fr, "versie"@nl ;
    sh:path ha:hasVersion ;
    sh:severity sh:Violation ;
     .

# REVIEW FIX: all hasCarrierCopy paths (shared audiovisual shape and inline
# Film/NewspaperIssue/IntellectualEntity shapes) are now ha:hasCarrierRepresentation.
# The inverse isCarrierCopyOf in ObjectCarrierRepresentationShape is now
# ha:isCarrierRepresentationOf. Update both directions and messages together.
ha:AudiovisualHasCarrierCopyShape a sh:PropertyShape ;
    rdfs:label "audiovisual has carrier copy shape"@en ;
    sh:class ha:AudiovisualCarrierRepresentation ;
    sh:description "The representation stored on a physical carrier."@en, "La représentation stockée sur un porteur physique."@fr, "De representatie opgeslagen op een fysieke drager."@nl ;
    sh:maxCount 1 ;
    sh:message "haObj:hasCarrierCopy has more than 1 value or is not a haDes:AudiovisualCarrierRepresentation"@en ;
    sh:name "audiovisual has carrier copy shape"@en, "est copie sur porteur"@fr, "heeft dragerkopie"@nl ;
    sh:path ha:hasCarrierCopy ;
    sh:severity sh:Violation ;
     .

ha:EndDateShape a sh:PropertyShape ;
    rdfs:label "end date shape"@en ;
    sh:datatype xsd:dateTime ;
    sh:description "The date on which this status or rule expires."@en, "La date à laquelle ce statut ou cette règle expire."@fr, "De datum waarop deze status of regel vervalt."@nl ;
    sh:maxCount 1 ;
    sh:name "end date shape"@en, "fin"@fr, "einddatum"@nl ;
    sh:nodeKind sh:Literal ;
    sh:path premis:endDate ;
     .

