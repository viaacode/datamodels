# REVIEW ALIGN: hasCollectionSize has RDFS range xsd:nonNegativeInteger; this
# xsd:integer constraint accepts -1 and rejects a nonNegativeInteger-typed count.
# Use the intended datatype consistently in ontology, shapes and producers.
ha:DescriptionCollectionShape a sh:NodeShape ;
    rdfs:label "description collection shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:datatype xsd:integer ;
        sh:description "The number of items in the Collection."@en, "Le nombre d'éléments dans la collection."@fr, "Het aantal items in de collectie."@nl ;
        sh:message "schema:collectionSize is not of type integer"@en, "schema:collectionSize n'est pas de type integer"@fr, "schema:collectionSize is niet van het type integer"@nl ;
        sh:name "collection size"@en, "nombre d'éléments"@fr, "aantal items"@nl ;
        sh:path ha:hasCollectionSize ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:description "Indicates an IntellectualEntity or PhysicalCarrier that is part of this collection."@en, "Indique un IntellectualEntity ou PhysicalCarrier qui fait partie de cette collection."@fr, "Geeft aan dat deze IntellectualEntity of PhysicalCarrier deel uitmaakt van deze collectie."@nl ;
        sh:message "schema:hasPart is not of class premis:IntellectualEntity"@en, "schema:hasPart n'est pas de la classe premis:IntellectualEntity"@fr, "schema:hasPart is niet van de klasse premis:IntellectualEntity"@nl ;
        sh:name "has part"@en, "a partie"@fr, "heeft deel"@nl ;
        sh:or (
            [
                sh:class premis:IntellectualEntity ;
            ]
            [
                sh:class ha:PhysicalCarrier ;
            ]
        ) ;
        sh:path ha:hasPart ;
        sh:severity sh:Violation ;
    ], _:cb83628a0ae31ff6ff86cb03dc6e49b5339e79a8ede7813347ed92227fcac3154c6, ha:DescriptionNameShape, ha:DescriptionShape ;
    sh:targetClass ha:Collection ;
     .

# REVIEW ALIGN: hasCreationDate has RDFS range xsd:dateTime, but this shape and
# the File/IntellectualEntity shapes only accept EDTF-level0/1/2. A dateTime value
# fails them. Choose a consistent date model (including uncertain archival dates)
# and update all three shapes plus RDFS together. MediahavenFragment already uses
# dateTime, so preserve the distinction between record and content dates if needed.
# REVIEW ALIGN: hasLanguage has range xsd:language, while this shape, the
# IntellectualEntity shape and OpenCaptionsShape use xsd:string. Align the datatype
# across producers and shapes; a literal typed xsd:language currently fails.
ha:DescriptionDigitalRepresentationShape a sh:NodeShape ;
    rdfs:label "description digital representation shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:maxCount 1 ;
        sh:message "schema:dateCreated occurs more than once or is not of type EDTF-level0, EDTF-level1, or EDTF-level2"@en ;
        sh:name "date created"@en, "date de création"@fr, "aangemaakt op"@nl ;
        sh:nodeKind sh:Literal ;
        sh:or (
            [
                sh:datatype <http://id.loc.gov/datatypes/edtf/EDTF-level0> ;
            ]
            [
                sh:datatype <http://id.loc.gov/datatypes/edtf/EDTF-level1> ;
            ]
            [
                sh:datatype <http://id.loc.gov/datatypes/edtf/EDTF-level2> ;
            ]
        ) ;
        sh:path ha:hasCreationDate ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "schema:transcript is not of type string "@en, "schema:transcript n'est pas de type string"@fr, "schema:transcript is niet van het type string"@nl ;
        sh:name "transcription"@en, "transcription"@fr, "transcriptie"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasTranscript ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "schema:caption is not of type string "@en, "schema:caption n'est pas de type string"@fr, "schema:caption is niet van het type string"@nl ;
        sh:name "caption"@en, "légende"@fr, "onderschrift"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasCaptionText ;
        sh:severity sh:Violation ;
    ], _:cb5c17fc754ae0c026196a90219aea37cde57bde5539ccbcb598dfce2f0b40cedbc, _:cb5fdf1e422ad7ed29239687ded3df55e6fd0b1626985e9619a5c2994e72f9c346a, [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:message "schema:inLanguage is not of type string"@en, "schema:inLanguage n'est pas de type string"@fr, "schema:inLanguage is niet van het type string"@nl ;
        sh:minCount 0 ;
        sh:name "in language"@en, "en langue"@fr, "in taal"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasLanguage ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:DigitalRepresentation ;
     .

# REVIEW ALIGN: hasCaptioning allows any premis:File OR ha:ClosedCaptions, whereas
# RDFS requires ha:Captioning. An arbitrary PDF passes and a captioning resource
# without either type fails. Use the captioning class, or migrate to hasSubtitling
# with the new OpenSubtitling/ClosedSubtitling classes once that RDFS decision is
# settled. ImageReelShape and OpenCaptionsShape need the same migration.
ha:DescriptionFileShape a sh:NodeShape ;
    rdfs:label "description file shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:maxCount 1 ;
        sh:message "schema:dateCreated is missing, occurs more than once or is not of type EDTF-level0, EDTF-level1, or EDTF-level2"@en ;
        sh:minCount 1 ;
        sh:name "date created"@en, "créé le"@fr, "aangemaakt op"@nl ;
        sh:nodeKind sh:Literal ;
        sh:or (
            [
                sh:datatype <http://id.loc.gov/datatypes/edtf/EDTF-level0> ;
            ]
            [
                sh:datatype <http://id.loc.gov/datatypes/edtf/EDTF-level1> ;
            ]
            [
                sh:datatype <http://id.loc.gov/datatypes/edtf/EDTF-level2> ;
            ]
        ) ;
        sh:path ha:hasCreationDate ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:MediaFragment ;
        sh:description "A fragment from this file."@en, "Un fragment de ce fichier."@fr, "Een fragment uit dit bestand."@nl ;
        sh:message "ebucore:hasMediaFragment is not a ebucore:MediaFragment"@en, "ebucore:hasMediaFragment n'est pas un ebucore:MediaFragment"@fr, "ebucore:hasMediaFragment is geen ebucore:MediaFragment"@nl ;
        sh:name "has media fragment"@en, "a un fragment multimédia"@fr, "heeft media fragment"@nl ;
        sh:path ha:hasMediaFragment ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:description "The subtitles or transcription of this file."@en, "Les sous-titres ou transcription de ce fichier."@fr, "De ondertitels of transcriptie van dit bestand."@nl ;
        sh:message "ebucore:hasCaptioning is missing, not a premis:File or not a ebucore:ClosedCaptions."@en ;
        sh:name "captioning"@en, "sous-titrage"@fr, "ondertiteling"@nl ;
        sh:or (
            [
                sh:class premis:File ;
            ]
            [
                sh:class ha:ClosedCaptions ;
            ]
        ) ;
        sh:path ha:hasCaptioning ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:description "A thumbnail image relevant to the Digital Representation."@en, "Une image miniature pertinente pour la représentation numérique."@fr, "Een miniatuurafbeelding die relevant is voor de digitale weergave."@nl ;
        sh:maxCount 1 ;
        sh:message "schema:thumbnailUrl is not an IRI"@en, "schema:thumbnailUrl n'est pas un IRI"@fr, "schema:thumbnailUrl is geen IRI"@nl ;
        sh:name "thumbnail"@en, "image miniature"@fr, "miniatuurafbeelding"@nl ;
        sh:nodeKind sh:IRI ;
        sh:path ha:hasThumbnailURL ;
        sh:severity sh:Violation ;
    ], _:cb83628a0ae31ff6ff86cb03dc6e49b5339e79a8ede7813347ed92227fcac3154c6, ha:DescriptionNameShape, ha:DescriptionShape, ha:DurationShape ;
    sh:targetClass premis:File ;
     .

# REVIEW ALIGN: hasArtform, hasArtMedium, hasTemporal, hasAbstract, hasGenre,
# hasKeywords and hasCreditText require rdf:langString here but have xsd:string
# ranges in RDFS. The shared name/alternate-name shapes have the same mismatch.
# A language-tagged string and an xsd:string are different RDF datatypes; agree
# which text fields are multilingual and update the RDFS ranges or these shapes.
# REVIEW ALIGN: hasCreator/hasPublisher/hasContributor allow Person, Organization
# or Role in RDFS; the Role-only rules here (and the shared creator rule and
# Newspaper publisher rule) reject a directly linked person. Keep Role-only checks
# only in a documented profile that always uses intermediate contribution roles.
# REVIEW FIX: isPartOf accepts only IntellectualEntity or BroadcastEvent here,
# but RDFS permits Collection too. Newspaper is a Series/Collection, not an
# IntellectualEntity in the reference: an issue pointing to its newspaper passes
# NewspaperIssueShape but fails this general rule. Include the intended Collection
# branch so those two shapes agree; this also covers Series/ArchiveComponent.
ha:DescriptionIntellectualEntityShape a sh:NodeShape ;
    rdfs:label "description intellectual entity shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:datatype rdf:langString ;
        sh:message "schema:artform is not of type language string"@en, "schema:artform n'est pas de type language string"@fr, "schema:artform is niet van het type language string"@nl ;
        sh:name "artform"@en, "forme d'art"@fr, "kunstvorm"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasArtform ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:Role ;
        sh:message "schema:publisher is not of class schema:Role"@en, "schema:publisher n'est pas de la classe schema:Role"@fr, "schema:publisher is niet van de klasse schema:Role"@nl ;
        sh:name "publisher"@en, "éditeur"@fr, "uitgever"@nl ;
        sh:path ha:hasPublisher ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:Role ;
        sh:message "haDes:executor is not of class schema:Role"@en ;
        sh:name "executor"@en, "exécuteur"@fr, "uitvoerder"@nl ;
        sh:path ha:hasExecutor ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:Role ;
        sh:message "schema:producer is not of class schema:Role"@en ;
        sh:name "producer"@en, "producteur"@fr, "producent"@nl ;
        sh:path ha:hasProducer ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:Thing ;
        sh:message "schema:mentions is not a schema:Thing"@en, "schema:mentions n'est pas un schema:Thing"@fr, "schema:mentions is geen schema:Thing"@nl ;
        sh:name "mentions"@en, "mentionne"@fr, "vermeldt"@nl ;
        sh:path ha:mentions ;
        sh:severity sh:Violation ;
