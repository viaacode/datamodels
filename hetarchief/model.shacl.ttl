# REVIEW FIX: hasSchemaUnitText/hasSchemaUnitCode are now ha:hasUnitText/
# ha:hasUnitCode. With the old mandatory code path, a measurement using the new
# terms fails even when it carries the expected code and numeric value.
ha:QuantitativeValueShape a sh:NodeShape ;
    rdfs:label "quantitative value shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "schema:unitText is not of type string "@en, "schema:unitText n'est pas de type string"@fr, "schema:unitText is niet van het type string"@nl ;
        sh:name "unit text"@en, "texte d'unité"@fr, "eenheidstekst"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasSchemaUnitText ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "schema:unitCode is not of type string "@en, "schema:unitCode n'est pas de type string"@fr, "schema:unitCode is niet van het type string"@nl ;
        sh:minCount 1 ;
        sh:name "unit code"@en, "code d'unité"@fr, "eenheidcode"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasSchemaUnitCode ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:float ;
        sh:maxCount 1 ;
        sh:message "schema:value is not of type float "@en, "schema:value n'est pas de type float"@fr, "schema:value is niet van het type float"@nl ;
        sh:minCount 1 ;
        sh:name "value"@en, "valeur"@fr, "waarde"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasMeasurementValue ;
        sh:severity sh:Violation ;
    ] ;
    sh:targetClass ha:QuantitativeValue ;
