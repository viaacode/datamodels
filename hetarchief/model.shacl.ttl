# REVIEW FIX: hasBirthPlace combines sh:class schema:Place and sh:nodeKind
# sh:Literal. No value can satisfy both: sh:class excludes literals. Use a resource
# node kind, and align the class URI: this file binds schema to http://schema.org/,
# while RDFS uses https://schema.org/. ha:Place is not a subclass of either there.
# REVIEW FIX: hasDeathPlace is a string here, but RDFS requires ha:Place. Use the
# agreed place-resource model for both birth and death locations.
# REVIEW PROFILE: requiring both given and family names excludes mononyms and
# people known only by an archival label. Keep these mandatory only for the
# account-manager/person profile that can guarantee both fields.
ha:PersonShape a sh:NodeShape ;
    rdfs:label "person shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class schema:Place ;
        sh:maxCount 1 ;
        sh:message "occurs more than once or its object is not of type xsd:string"@en ;
        sh:name "birth place"@en, "Lieu de naissance"@fr, "geboorteplaats"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasBirthPlace ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype <http://id.loc.gov/datatypes/edtf/EDTF-level1> ;
        sh:maxCount 1 ;
        sh:message "occurs more than once or its object is not of type edtf:EDTF-level1"@en ;
        sh:name "death date"@en, "date de décès"@fr, "sterfdatum"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasDeathDate ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype <http://id.loc.gov/datatypes/edtf/EDTF-level1> ;
        sh:maxCount 1 ;
        sh:message "occurs more than once or its object is not of type edtf:EDTF-level1"@en ;
        sh:name "birth date"@en, "date de naissance"@fr, "geboortedatum"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasBirthDate ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:Organization ;
        sh:description "The organization for which the person is responsible for."@en, "L'organisation pour laquelle la personne est responsable."@fr, "De organisatie waarvoor de persoon verantwoordelijk is."@nl ;
        sh:message "its object is not of type org:Organization"@en ;
        sh:name "is account manager of"@en, "est le Gestionnaire de Comptes de"@fr, "is account manager van"@nl ;
        sh:path ha:isAccountManagerOf ;
        sh:severity sh:Warning ;
    ], [
        a sh:PropertyShape ;
        sh:datatype rdf:langString ;
        sh:description "The first and last name of this person (combined into a single string)."@en, "Le prénom et le nom de cette personne (combinés en une seule string)."@fr, "De voor- en achternaam van deze persoon (gecombineerd in één string)."@nl ;
        sh:message "schema:name is missing or is not of type string"@en ;
        sh:minCount 1 ;
        sh:name "name"@en, "nom"@fr, "naam"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasName ;
        sh:severity sh:Violation ;
        sh:uniqueLang true ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:Post ;
        sh:description "The post that a person holds in the organization."@en, "Le poste que la personne occupe dans l'organisation."@fr, "De positie die de persoon binnen de organisatie bekleedt."@nl ;
        sh:message "its object is no org:Post"@en ;
        sh:name "holds"@en, "occupe"@fr, "heeft positie"@nl ;
        sh:path ha:holds ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "The family name or last name of this person."@en, "Le nom de famille de cette personne."@fr, "De achternaam van deze persoon."@nl ;
        sh:maxCount 1 ;
        sh:message "is missing, occurs more than once or its object is no xsd:string"@en ;
        sh:minCount 1 ;
        sh:name "family name"@en, "nom de famille"@fr, "familienaam"@nl ;
        sh:path ha:hasFamilyName ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "occurs more than once or its object is not of type xsd:string"@en ;
        sh:name "death place"@en, "place de décès"@fr, "sterfplaats"@nl ;
        sh:nodeKind sh:Literal ;
        sh:path ha:hasDeathPlace ;
        sh:severity sh:Violation ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "Telephone of this person."@en, "Téléphone de cette personne."@fr, "Telefoon van deze persoon."@nl ;
        sh:message "its object is no xsd:string"@en ;
        sh:name "telephone"@en, "téléphone"@fr, "telefoon"@nl ;
        sh:path ha:hasTelephone ;
        sh:severity sh:Info ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "The given name or first name of this person."@en, "Le prénom de cette personne."@fr, "De voornaam van deze persoon."@nl ;
        sh:maxCount 1 ;
        sh:message "is missing, occurs more than once or its object is no xsd:string"@en ;
        sh:minCount 1 ;
        sh:name "given name"@en, "prénom"@fr, "voornaam"@nl ;
        sh:path ha:hasGivenName ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "E-mail address of this person."@en, "Adresse e-mail de cette personne."@fr, "E-mailadres van deze persoon."@nl ;
        sh:message "its object is no xsd:string"@en ;
        sh:name "email"@en, "email"@fr, "email"@nl ;
        sh:path ha:hasEmail ;
        sh:severity sh:Info ;
    ] ;
    sh:targetClass ha:Person ;
     .

ha:PlaceShape a sh:NodeShape ;
    rdfs:label "place shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class ha:Place ;
        sh:message "schema:containedInPlace is not of class schema:Place"@en, "schema:containedInPlace n'est pas de la classe schema:Place"@fr, "schema:containedInPlace is niet van de klasse schema:Place"@nl ;
        sh:name "is contained in place"@en, "fait partie de"@fr, "is deel van plaats"@nl ;
        sh:path ha:isContainedInPlace ;
        sh:severity sh:Violation ;
    ], ha:DescriptionNameShape, ha:DescriptionShape ;
    sh:targetClass ha:Place ;
     .

ha:PolicyShape a sh:NodeShape ;
    rdfs:label "policy shape"@en ;
    sh:property [
        sh:class odrl:Prohibition ;
        sh:description "A rule that restricts meemoo in providing access to a digital representation."@en, "Une règle qui restreint meemoo pour donner accès à une représentation numérique."@fr, "Een regel die meemoo beperkt in het ontsluiten van een digitale representatie."@nl ;
        sh:name "limitation of access"@en, "limitation de l'accès"@fr, "ontsluitingsbeperking"@nl ;
        sh:path odrl:prohibition ;
    ], [
        sh:class odrl:Permission ;
        sh:description "A rule that grants meemoo permission to provide access to a digital representation."@en, "Une règle qui accorde à Meemoo l'autorisation de donner accès à une représentation numérique."@fr, "Een regel die meemoo toestemming verleent tot het ontsluiten van een digitale representatie."@nl ;
        sh:name "ontsluitingstoestemming"@en, "autorisation d'accès"@fr, "access permission"@nl ;
        sh:path odrl:permission ;
    ], [
        sh:class ha:DigitalRepresentation ;
        sh:description "The digital representation to which this access policy applies."@en, "La représentation numérique à laquelle s'applique cette stratégie d'accès."@fr, "De digitale representatie waarop dit ontsluitingsbeleid van toepassing is."@nl ;
        sh:minCount 1 ;
        sh:name "target representation"@en, "représentation cible"@fr, "doelrepresentatie"@nl ;
        sh:path odrl:target ;
    ] ;
    sh:targetClass odrl:Policy ;
     .

# REVIEW FIX: ha:hasRole is absent from RDFS, which now supplies hasRoleType
# with range ha:RoleType. Resolve whether Post still links to a separate Role or
# is a Role itself before replacing this edge; current RDFS has no Post->Role
# subclass axiom despite the comment at hasRoleType suggesting that design.
ha:PostShape a sh:NodeShape ;
    rdfs:label "post shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:class ha:Role ;
        sh:description "Indicates the role that the agent plays as a memmber of the organization."@en, "Indique le rôle de l'agent dans son engagement avec l'organisation."@fr, "Rol die de agent vervult als lid van de organisatie."@nl ;
        sh:message "is missing or its object is no org:Role"@en ;
        sh:minCount 1 ;
        sh:name "role"@en, "rôle"@fr, "rol"@nl ;
        sh:path ha:hasRole ;
    ], [
        a sh:PropertyShape ;
        sh:class ha:Organization ;
        sh:description "Indicates the organization in which the post exists."@en, "Indique l'organisation dans laquelle le poste existe."@fr, "Duidt de organisatie aan waarbinnen de positie bestaat."@nl ;
        sh:message "is missing or its object is no org:Organization"@en ;
        sh:minCount 1 ;
        sh:name "post in"@en, "poste chez"@fr, "positie in"@nl ;
        sh:path ha:isPostIn ;
    ] ;
    sh:targetClass ha:Post ;
     .

ha:PostalAddressShape a sh:NodeShape ;
    rdfs:label "postal address shape"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "The postal code. For example, 94043."@en, "Le code postal. Par exemple, 94043."@fr, "De postcode. Bijvoorbeeld, 9400."@nl ;
        sh:maxCount 1 ;
        sh:message "occurs more than once or its object is not of type xsd:string"@en ;
        sh:name "postal code"@en, "le code postal"@fr, "postcode"@nl ;
        sh:path ha:hasPostalCode ;
    ], [
        a sh:PropertyShape ;
        sh:description "The country in which the postal address is located."@en, "Le pays dans lequel se trouve l'adresse postale."@fr, "Het land waarin het postadres zich bevindt."@nl ;
        sh:maxCount 1 ;
        sh:message "its object is neither schema:Country nor xsd:string"@en ;
        sh:name "country"@en, "pays"@fr, "land"@nl ;
        sh:class ha:Country ;
        sh:path ha:hasAddressCountry ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "The post office box number for PO box addresses."@en, "Le numéro de boîte postale pour les adresses de boîte postale."@fr, "Het postbusnummer voor postbusadressen."@nl ;
        sh:maxCount 1 ;
        sh:message "occurs more than once or its object is not of type xsd:string"@en ;
        sh:name "post office box number"@en, "le numéro de boîte postale"@fr, "postbusnummer"@nl ;
        sh:path ha:hasPostOfficeBoxNumber ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "The region in which the locality is, and which is in the country. For example, California or another appropriate first-level <a href=\"https://en.wikipedia.org/wiki/List_of_administrative_divisions_by_country\">Administrative division</a>"@en, "La région dans laquelle la ville est, et qui est dans le pays. Par exemple, Californie ou une autre division administrative appropriée."@fr, "De provincie van het land waarin de stad zich bevindt. Bijvoorbeeld, Oost-Vlaanderen, Limburg, etc."@nl ;
        sh:maxCount 1 ;
        sh:message "occurs more than once or its object is not of type xsd:string"@en ;
        sh:name "region"@en, "provincie"@fr, "provincie"@nl ;
        sh:path ha:hasAddressRegion ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "The locality in which the street address is, and which is in the region. For example, Mountain View."@en, "La ville dans laquelle se trouve l'adresse postale, et qui est dans la région. Par exemple, Mountain View."@fr, "De stad waarin het straatadres zich bevindt, en deel uitmaakt van de regio. Bijvoorbeeld, Brussel, Oostende, ...."@nl ;
        sh:maxCount 1 ;
        sh:message "occurs more than once or its object is not of type xsd:string"@en ;
        sh:name "locality"@en, "ville"@fr, "gemeente"@nl ;
        sh:path ha:hasAddressLocality ;
    ], [
        a sh:PropertyShape ;
        sh:datatype xsd:string ;
        sh:description "The street address. For example, 1600 Amphitheatre Parkway."@en, "L'adresse postale. Par exemple, 1600 Amphitheatre Parkway."@fr, "Het straatadres. Bijvoorbeeld, Kerkstraat 16."@nl ;
        sh:maxCount 1 ;
        sh:message "occurs more than once or its object is not of type xsd:string"@en ;
        sh:name "address"@en, "l'adresse"@fr, "adres"@nl ;
        sh:path ha:hasStreetAddress ;
    ] ;
    sh:targetClass ha:PostalAddress ;
     .

