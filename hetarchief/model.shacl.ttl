ha:PermissionShape a sh:NodeShape ;
    rdfs:label "permission shape"@en ;
    sh:property ha:ActionShape, ha:EndDateShape, ha:PolicyHasConstraintShape, ha:RightsNoteShape, ha:StartDateShape ;
