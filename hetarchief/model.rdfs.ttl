PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ebucore: <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#>
PREFIX ebucoreplus: <http://www.ebu.ch/metadata/ontologies/ebucoreplus#>
PREFIX edtf: <http://id.loc.gov/datatypes/edtf/>
PREFIX ha: <https://data.hetarchief.be/ns/>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX pav: <http://purl.org/pav/>
PREFIX premis: <http://www.loc.gov/premis/rdf/v3/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vann: <http://purl.org/vocab/vann/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ha: a owl:Ontology ;
    owl:imports <external/odrl.rdfs.ttl>, <external/premis.rdfs.ttl>, <external/prov.rdfs.ttl> ;
    rdfs:label "hetarchief ontology"@en ;
    dct:created "2022-03-14" ;
    dct:description "Data model hetarchief."@en, "Modèle de données hetarchief."@fr, "Datamodel hetarchief."@nl ;
    dct:modified "2025-02-13" ;
    dct:title "Data model hetarchief"@en, "Modèle de données hetarchief"@fr, "Datamodel hetarchief"@nl ;
    pav:version "0.0.1" ;
    vann:preferredNamespacePrefix "ha" ;
    vann:preferredNamespaceUri "https://data.hetarchief.be/ns/" ;
    schema:author [
        a schema:Person ;
        schema:email "lennert.vandevelde@meemoo.be" ;
        schema:name "Lennert Van de Velde"@nl ;
    ], [
        a schema:Person ;
        schema:email "miel.vandersande@meemoo.be" ;
        schema:name "Miel Vander Sande"@nl ;
    ], [
        a schema:Person ;
        schema:email "milan.valadou@meemoo.be" ;
        schema:name "Luca"@nl ;
    ] ;
     .

ha:Agent a rdfs:Class ;
    rdfs:label "agent"@en, "agent"@nl, "agent"@fr ;
    skos:definition "A person or organization that acts in the creation, management, preservation or use of archival resources."@en, "Een persoon of organisatie die handelt bij de creatie, het beheer, de bewaring of het gebruik van archiefbronnen."@nl, "Une personne ou une organisation qui intervient dans la création, la gestion, la conservation ou l’utilisation de ressources archivistiques."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dct:Agent, <http://xmlns.com/foaf/0.1/Agent> ;
    # ! Should this be rdfs:subClassOf prov:Agent ?
    rdfs:subClassOf ha:Thing ; 
     .

ha:Annotation a rdfs:Class ;
    rdfs:label "annotation"@en, "annotatie"@nl, "annotation"@fr ;
    skos:definition "Information attached to an archival resource or fragment to describe, identify or interpret its content."@en, "Informatie die aan een archiefbron of fragment wordt gekoppeld om de inhoud te beschrijven, te identificeren of te interpreteren."@nl, "Une information associée à une ressource archivistique ou à un fragment pour en décrire, identifier ou interpréter le contenu."@fr ;
    rdfs:seeAlso ebucore:Annotation ;
    rdfs:subClassOf ha:Thing ;
     .

ha:AnnotationType a rdfs:Class ;
    rdfs:label "annotation type"@en, "annotatietype"@nl, "type d’annotation"@fr ;
    skos:definition "A controlled concept that classifies an annotation, for example as face recognition or named entity recognition."@en, "Een gecontroleerd begrip dat een annotatie classificeert, bijvoorbeeld als gezichtsherkenning of herkenning van benoemde entiteiten."@nl, "Un concept contrôlé qui classe une annotation, par exemple comme reconnaissance de visages ou d’entités nommées."@fr ;
    rdfs:seeAlso ebucore:Annotation_Type ;
    rdfs:subClassOf skos:Concept ;
     .

ha:ArchiveComponent a rdfs:Class ;
    rdfs:label "archive component"@en, "archiefcomponent"@nl, "composant d’archives"@fr ;
    skos:definition "A descriptive unit within an archive, such as a collection, series or archival item."@en, "Een beschrijvingseenheid binnen een archief, zoals een collectie, reeks of archiefstuk."@nl, "Une unité de description au sein d’un fonds d’archives, telle qu’une collection, une série ou une pièce."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:ArchiveComponent ;
    rdfs:subClassOf ha:CreativeWork ;
     .

ha:Audio a rdfs:Class ;
    rdfs:label "audio"@en, "audio"@nl, "audio"@fr ;
    skos:definition "An intellectual entity consisting of recorded sound, originating from a physical carrier or created digitally."@en, "Een intellectuele entiteit bestaande uit opgenomen geluid, afkomstig van een fysieke drager of digitaal gecreëerd."@nl, "Une entité intellectuelle constituée de sons enregistrés, provenant d’un support physique ou créée sous forme numérique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf premis:IntellectualEntity ;
     .

ha:SoundReel a rdfs:Class ; # ! Used to be AudioReel
    rdfs:label "audio reel"@en, "geluidsspoel"@nl, "bobine sonore"@fr ;
    skos:definition "A physical reel carrying the sound component of an archived film."@en, "Een fysieke spoel die de geluidscomponent van een gearchiveerde film bevat."@nl, "Une bobine physique contenant la composante sonore d’un film archivé."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:PhysicalCarrier ;
     .

ha:AudiovisualCarrier a rdfs:Class ;
    rdfs:label "audiovisual carrier"@en, "audiovisuele drager"@nl, "support audiovisuel"@fr ;
    skos:definition "A physical storage medium carrying recorded sound or audiovisual content, such as an audio cassette or videotape."@en, "Een fysiek opslagmedium met opgenomen geluid of audiovisuele inhoud, zoals een audiocassette of videoband."@nl, "Un support physique contenant des sons enregistrés ou du contenu audiovisuel, tel qu’une cassette audio ou une bande vidéo."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:PhysicalCarrier ;
     .

ha:AudiovisualCarrierRepresentation a rdfs:Class ;
    rdfs:label "audiovisual carrier representation"@en, "audiovisuele dragerrepresentatie"@nl, "représentation sur support audiovisuel"@fr ;
    skos:definition "A representation of an archived audio or video intellectual entity embodied on an audiovisual carrier."@en, "Een representatie van een gearchiveerde audio- of video-entiteit op een audiovisuele drager."@nl, "Une représentation d’une entité intellectuelle audio ou vidéo archivée, matérialisée sur un support audiovisuel."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:CarrierRepresentation ;
     .

ha:Brand a rdfs:Class ;
    rdfs:label "brand"@en, "merk"@nl, "marque"@fr ;
    skos:definition "A name or sign identifying the maker or commercial identity of a carrier, device, software product or service."@en, "Een naam of teken dat de maker of commerciële identiteit van een drager, toestel, softwareproduct of dienst aanduidt."@nl, "Un nom ou un signe identifiant le fabricant ou l’identité commerciale d’un support, d’un appareil, d’un logiciel ou d’un service."@fr ;
    rdfs:seeAlso schema:Brand .

ha:BroadcastEvent a rdfs:Class ;
    rdfs:label "broadcast event"@en, "uitzendgebeurtenis"@nl, "événement de diffusion"@fr ;
    skos:definition "An occurrence in which archived media content is broadcast over a transmission network or online."@en, "Een gebeurtenis waarbij gearchiveerde media-inhoud via een omroepnetwerk of online wordt uitgezonden."@nl, "Un événement au cours duquel du contenu médiatique archivé est diffusé par un réseau de transmission ou en ligne."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:BroadcastEvent ;
     .

ha:Captioning a rdfs:Class ;
    rdfs:label "accessibility captioning"@en, "toegankelijkheidsondertiteling"@nl, "sous-titrage d’accessibilité"@fr ;
    skos:definition "Subtitles conveying speech and relevant sounds to make audiovisual content accessible to deaf or hard of hearing users."@en, "Ondertiteling die spraak en relevante geluiden weergeeft om audiovisuele inhoud toegankelijk te maken voor dove en slechthorende gebruikers."@nl, "Un sous-titrage restituant les paroles et les sons pertinents pour rendre un contenu audiovisuel accessible aux personnes sourdes ou malentendantes."@fr ;
    rdfs:seeAlso ebucore:Captioning ;
     .
# ! Subtitling should replace captioning, as it is more fitting. Do we keep Captioning as reference or do we delete it?
ha:Subtitling a rdfs:Class ;
    rdfs:label "subtitling"@en, "ondertiteling"@nl, "sous-titrage"@fr ;
    skos:definition "Text synchronized with the speech of archived audiovisual content, transcribing or translating dialogue."@en, "Tekst die is gesynchroniseerd met de spraak van gearchiveerde audiovisuele inhoud en dialogen weergeeft of vertaalt."@nl, "Un texte synchronisé avec les paroles d’un contenu audiovisuel archivé, qui transcrit ou traduit les dialogues."@fr ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucoreplus#Subtitling> ;
     .
# ! ClosedSubtitling is always a file?
ha:ClosedSubtitling a rdfs:Class ;
    rdfs:label "closed subtitling"@en, "inschakelbare ondertiteling"@nl, "sous-titrage activable"@fr ;
    skos:definition "Subtitles for archived audiovisual content stored separately from the image and selectable during playback."@en, "Ondertiteling van gearchiveerde audiovisuele inhoud die afzonderlijk van het beeld wordt opgeslagen en tijdens het afspelen kan worden ingeschakeld."@nl, "Un sous-titrage de contenu audiovisuel archivé, stocké séparément de l’image et pouvant être activé pendant la lecture."@fr ;
    rdfs:subClassOf [ owl:unionOf ( ha:Subtitling premis:File) ];
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucoreplus#ClosedSubtitling> ;
     .

ha:OpenSubtitling a rdfs:Class ;
    rdfs:label "open subtitling"@en, "ingebrande ondertiteling"@nl, "sous-titrage incrusté"@fr ;
    skos:definition "Subtitles burned into the image of archived audiovisual content and continuously visible during playback."@en, "Ondertiteling die in het beeld van gearchiveerde audiovisuele inhoud is ingebrand en tijdens het afspelen voortdurend zichtbaar is."@nl, "Un sous-titrage incrusté dans l’image d’un contenu audiovisuel archivé et visible en permanence pendant la lecture."@fr ;
    rdfs:subClassOf ha:Subtitling ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucoreplus#OpenSubtitling> ;
     .

ha:CarrierRepresentation a rdfs:Class ;
    rdfs:label "carrier representation"@en, "dragerrepresentatie"@nl, "représentation sur support physique"@fr ;
    skos:definition "A representation of an archived intellectual entity embodied on a physical carrier, such as a videotape, film reel or printed page."@en, "Een representatie van een gearchiveerde intellectuele entiteit op een fysieke drager, zoals een videoband, filmspoel of gedrukte pagina."@nl, "Une représentation d’une entité intellectuelle archivée, matérialisée sur un support physique tel qu’une bande vidéo, une bobine de film ou une page imprimée."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf premis:Representation ;
     .

ha:CastMemberEntry a rdfs:Class ;
    rdfs:label "cast member entry"@en, "castvermelding"@nl, "entrée de distribution artistique"@fr ;
    skos:definition "An entry identifying a performer, its position in the cast listing and, where applicable, the character portrayed in an archived work."@en, "Een vermelding van een uitvoerder, diens plaats in de vermelding en, indien van toepassing, het personage dat die in een gearchiveerd werk vertolkt."@nl, "Une entrée identifiant un interprète, sa position dans la liste de distribution et, le cas échéant, le personnage qu’il incarne dans une œuvre archivée."@fr ;
    rdfs:seeAlso ebucore:Cast ;
    rdfs:subClassOf ha:Role ;
     .
ha:ClosedCaptions a rdfs:Class ;
    rdfs:label "closed captions"@en, "inschakelbare ondertiteling"@nl, "sous-titres activables"@fr ;
    skos:definition "Accessibility captions stored separately from the image and selectable during playback."@en, "Toegankelijkheidsondertiteling die afzonderlijk van het beeld wordt opgeslagen en tijdens het afspelen kan worden ingeschakeld."@nl, "Des sous-titres d’accessibilité stockés séparément de l’image et pouvant être activés pendant la lecture."@fr ;
    rdfs:subClassOf ha:Captioning ;
    rdfs:seeAlso ebucore:ClosedCaptions ;
     .

ha:Collection a rdfs:Class ;
    rdfs:label "collection"@en, "collectie"@nl, "collection"@fr ;
    skos:definition "A group of archival resources brought together and described as a whole."@en, "Een groep archiefbronnen die wordt samengebracht en als geheel wordt beschreven."@nl, "Un ensemble de ressources archivistiques réunies et décrites comme un tout."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:Collection ;
    rdfs:subClassOf ha:CreativeWork ;
     .

ha:ContactPoint a rdfs:Class ;
    rdfs:label "contact point"@en, "contactpunt"@nl, "point de contact"@fr ;
    skos:definition "Contact information for reaching a person, organization or service involved with the archive."@en, "Contactgegevens om een persoon, organisatie of dienst te bereiken die bij het archief betrokken is."@nl, "Des coordonnées permettant de joindre une personne, une organisation ou un service lié aux archives."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:ContactPoint ;
     .

ha:ContentPartner a rdfs:Class ;
    rdfs:label "content partner"@en, "contentpartner"@nl, "partenaire de contenu"@fr ;
    skos:definition "An organization with a collaboration agreement with meemoo for the long-term preservation and dissemination of its content."@en, "Een organisatie met een samenwerkingsovereenkomst met meemoo voor de duurzame bewaring en ontsluiting van haar materiaal."@nl, "Une organisation ayant conclu un accord de collaboration avec meemoo pour la conservation à long terme et la diffusion de ses contenus."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:Organization ;
     .

ha:ContentScope a rdfs:Class ; # ! was ContentRange
    rdfs:label "content scope"@en, "inhoudsbereik"@nl, "étendue du contenu"@fr ;
    skos:definition "A category specifying whether an access or use rule applies to the whole of a resource’s content or only part of it."@en, "Een categorie die aangeeft of een toegangs- of gebruiksregel op de volledige inhoud van een bron of slechts op een deel ervan van toepassing is."@nl, "Une catégorie précisant si une règle d’accès ou d’utilisation porte sur l’intégralité du contenu d’une ressource ou sur une partie seulement."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf odrl:RightOperand ;
     .

ha:Country a rdfs:Class ;
    rdfs:label "country"@en, "land"@nl, "pays"@fr ;
    skos:definition "A country associated with an address or geographic description in the archive."@en, "Een land dat bij een adres of geografische beschrijving in het archief hoort."@nl, "Un pays associé à une adresse ou à une description géographique dans les archives."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:Country ;
     .

ha:CreativeWork a rdfs:Class ;
    rdfs:label "creative work"@en, "creatief werk"@nl, "œuvre de création"@fr ;
    skos:definition "An intellectual or artistic creation described in the archive, such as a film, recording, photograph or publication."@en, "Een intellectuele of artistieke creatie die in het archief wordt beschreven, zoals een film, opname, foto of publicatie."@nl, "Une création intellectuelle ou artistique décrite dans les archives, telle qu’un film, un enregistrement, une photographie ou une publication."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:CreativeWork ;
    rdfs:subClassOf ha:Thing ;
     .

ha:CreativeWorkSeason a rdfs:Class ;
    rdfs:label "season"@en, "seizoen"@nl, "saison"@fr ;
    skos:definition "A group of episodes belonging to one production or broadcast season of a media series."@en, "Een groep afleveringen die tot één productie- of uitzendseizoen van een mediareeks behoren."@nl, "Un ensemble d’épisodes appartenant à une même saison de production ou de diffusion d’une série médiatique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:CreativeWorkSeason ;
    rdfs:subClassOf ha:CreativeWork ;
     .

ha:CreativeWorkSeries a rdfs:Class ;
    rdfs:label "series"@en, "reeks"@nl, "série"@fr ;
    skos:definition "A group of related published or broadcast works, usually arranged in a sequence and described collectively."@en, "Een groep samenhangende gepubliceerde of uitgezonden werken die doorgaans in een volgorde zijn gerangschikt en gezamenlijk worden beschreven."@nl, "Un ensemble d’œuvres publiées ou diffusées liées entre elles, généralement ordonnées et décrites collectivement."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:CreativeWorkSeries ;
    rdfs:subClassOf ha:CreativeWork ;
     .

ha:DVD a rdfs:Class ;
    rdfs:label "DVD content"@en, "dvd-inhoud"@nl, "contenu de DVD"@fr ;
    skos:definition "An intellectual entity representing the complete content of a DVD, distinct from its physical disc and digital representations."@en, "Een intellectuele entiteit die de volledige inhoud van een dvd voorstelt, onderscheiden van de fysieke schijf en de digitale representaties."@nl, "Une entité intellectuelle représentant l’intégralité du contenu d’un DVD, distincte du disque physique et de ses représentations numériques."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf premis:IntellectualEntity ;
     .

ha:DVDChapter a rdfs:Class ;
    rdfs:label "DVD chapter"@en, "dvd-hoofdstuk"@nl, "chapitre de DVD"@fr ;
    skos:definition "An intellectual entity representing one chapter within the content of a DVD."@en, "Een intellectuele entiteit die één hoofdstuk binnen de inhoud van een dvd voorstelt."@nl, "Une entité intellectuelle représentant un chapitre du contenu d’un DVD."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf premis:IntellectualEntity ;
     .

ha:DataType a rdfs:Class ;
    rdfs:label "data type"@en, "datatype"@nl, "type de données"@fr ;
    skos:definition "A category of values used to express archival metadata, such as text, integers or dates."@en, "Een categorie waarden waarmee archiefmetadata worden uitgedrukt, zoals tekst, gehele getallen of datums."@nl, "Une catégorie de valeurs utilisée pour exprimer les métadonnées archivistiques, telle que du texte, des nombres entiers ou des dates."@fr ;
    rdfs:seeAlso schema:DataType ;
    rdfs:subClassOf rdfs:Class ;
     .


ha:DefinedRegion a rdfs:Class ;
    rdfs:label "defined region"@en, "afgebakend gebied"@nl, "région délimitée"@fr ;
    skos:definition "A geographic area defined by boundaries or an administrative designation."@en, "Een geografisch gebied dat door grenzen of een bestuurlijke aanduiding wordt afgebakend."@nl, "Une zone géographique définie par des limites ou une désignation administrative."@fr ;
    rdfs:seeAlso schema:DefinedRegion ;
     .

ha:DigitalRepresentation a rdfs:Class ;
    rdfs:label "digital representation"@en, "digitale representatie"@nl, "représentation numérique"@fr ;
    skos:definition "A digital embodiment of an archived intellectual entity, comprising files and the structural information needed to render its content."@en, "Een digitale verschijningsvorm van een gearchiveerde intellectuele entiteit, bestaande uit bestanden en de structurele informatie die nodig is om de inhoud weer te geven."@nl, "Une matérialisation numérique d’une entité intellectuelle archivée, comprenant des fichiers et les informations structurelles nécessaires à la restitution de son contenu."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf premis:Representation ;
     .

ha:DigitizationPartner a rdfs:Class ;
    rdfs:label "digitization partner"@en, "digitaliseringspartner"@nl, "partenaire de numérisation"@fr ;
    skos:definition "An organization that provides digitization services to meemoo."@en, "Een organisatie die digitaliseringsdiensten aan meemoo levert."@nl, "Une organisation qui fournit des services de numérisation à meemoo."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:ServiceProvider ;
     .

ha:Document a rdfs:Class ;
    rdfs:label "document"@en, "document"@nl, "document"@fr ;
    skos:definition "A document containing information about an archival resource, organization, process or project."@en, "Een document met informatie over een archiefbron, organisatie, proces of project."@nl, "Un document contenant des informations sur une ressource archivistique, une organisation, un processus ou un projet."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/Document> ;
    owl:disjointWith ha:Project ;
     .

ha:EducationalPartner a rdfs:Class ;
    rdfs:label "educational partner"@en, "educatieve partner"@nl, "partenaire éducatif"@fr ;
    skos:definition "An organization that provides content for Archief voor Onderwijs under an educational collaboration agreement with meemoo."@en, "Een organisatie die onder een educatieve samenwerkingsovereenkomst met meemoo inhoud aanbiedt op Archief voor Onderwijs."@nl, "Une organisation qui fournit du contenu à Archief voor Onderwijs dans le cadre d’un accord de collaboration éducative avec meemoo."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:Organization ;
     .

ha:Episode a rdfs:Class ;
    rdfs:label "episode"@en, "aflevering"@nl, "épisode"@fr ;
    skos:definition "An individual installment of a media work that may belong to a series or season."@en, "Een afzonderlijke aflevering van een mediawerk die tot een reeks of seizoen kan behoren."@nl, "Un volet individuel d’une œuvre médiatique pouvant appartenir à une série ou à une saison."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:Episode ;
    rdfs:subClassOf ha:CreativeWork ;
     .

ha:FileFormat a rdfs:Class ;
    rdfs:label "file format"@en, "bestandsformaat"@nl, "format de fichier"@fr ;
    skos:definition "A specification of how information is encoded and structured in a digital file."@en, "Een specificatie van de codering en structuur van informatie in een digitaal bestand."@nl, "Une spécification de l’encodage et de la structure des informations dans un fichier numérique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dct:FileFormat ;
     .

ha:Film a rdfs:Class ;
    rdfs:label "film content"@en, "filminhoud"@nl, "contenu de film"@fr ;
    skos:definition "An intellectual entity representing moving-image content originating from a photographic film carrier."@en, "Een intellectuele entiteit die bewegend beeld afkomstig van een fotografische filmdrager voorstelt."@nl, "Une entité intellectuelle représentant des images animées provenant d’un support de film photographique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf premis:IntellectualEntity ;
     .

ha:FilmCarrierRepresentation a rdfs:Class ;
    rdfs:label "film carrier representation"@en, "filmdragerrepresentatie"@nl, "représentation sur support film"@fr ;
    skos:definition "A representation of an archived film embodied on a physical photographic film carrier."@en, "Een representatie van een gearchiveerde film op een fysieke fotografische filmdrager."@nl, "Une représentation d’un film archivé, matérialisée sur un support physique de film photographique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:CarrierRepresentation ;
     .

ha:FormalOrganization a rdfs:Class, owl:Class ;
    rdfs:label "formal organization"@en, "formele organisatie"@nl, "organisation formelle"@fr ;
    skos:definition "An organization recognized as having rights and responsibilities within a legal jurisdiction."@en, "Een organisatie die binnen een rechtsgebied als drager van rechten en verantwoordelijkheden wordt erkend."@nl, "Une organisation reconnue comme titulaire de droits et de responsabilités dans un cadre juridique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://www.w3.org/ns/org#FormalOrganization> ;
    rdfs:subClassOf ha:Organization ;
     .

ha:Format a rdfs:Class ;
    rdfs:label "format"@en, "formaat"@nl, "format"@fr ;
    skos:definition "A controlled concept describing a technical format of an archival resource or representation."@en, "Een gecontroleerd begrip dat een technisch formaat van een archiefbron of representatie beschrijft."@nl, "Un concept contrôlé décrivant un format technique d’une ressource archivistique ou d’une représentation."@fr ;
    rdfs:seeAlso ebucore:Format ;
    rdfs:subClassOf skos:Concept ;
     .

ha:MediahavenFragment a rdfs:Class ; # ! was mh:Fragment
    rdfs:label "Mediahaven fragment"@en, "Mediahavenfragment"@nl, "fragment Mediahaven"@fr ;
    skos:definition "A fragment record managed in Mediahaven and linked to its parent asset record."@en, "Een fragmentrecord dat in Mediahaven wordt beheerd en aan het bovenliggende assetrecord is gekoppeld."@nl, "Une notice de fragment gérée dans Mediahaven et liée à la notice de sa ressource parente."@fr ;
    rdfs:isDefinedBy ha: ;
     .

# ! equivalence with ha:MediaFragment makes all media fragments digital representations; we can probably remodel this to fit reality better. Fragments should probably not be representations
ha:FragmentRepresentation a rdfs:Class ;
    rdfs:label "fragment representation"@en, "fragmentrepresentatie"@nl, "représentation de fragment"@fr ;
    skos:definition "A spatial or temporal segment of a file serving as a partial digital representation of an archived intellectual entity."@en, "Een ruimtelijk of temporeel segment van een bestand dat als gedeeltelijke digitale representatie van een gearchiveerde intellectuele entiteit dient."@nl, "Un segment spatial ou temporel d’un fichier servant de représentation numérique partielle d’une entité intellectuelle archivée."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:DigitalRepresentation ;
    owl:equivalentClass ha:MediaFragment ;
     .

ha:GeoCoordinates a rdfs:Class ;
    rdfs:label "geographic coordinates"@en, "geografische coördinaten"@nl, "coordonnées géographiques"@fr ;
    skos:definition "Coordinates identifying the geographic position of a place described in the archive."@en, "Coördinaten die de geografische positie van een in het archief beschreven plaats aanduiden."@nl, "Des coordonnées identifiant la position géographique d’un lieu décrit dans les archives."@fr ;
    rdfs:seeAlso schema:GeoCoordinates ;
     .


ha:Image a rdfs:Class ;
    rdfs:label "image"@en, "afbeelding"@nl, "image"@fr ;
    skos:definition "An intellectual entity consisting of a still image, originating from a physical carrier or created digitally."@en, "Een intellectuele entiteit bestaande uit een stilstaand beeld, afkomstig van een fysieke drager of digitaal gecreëerd."@nl, "Une entité intellectuelle constituée d’une image fixe, provenant d’un support physique ou créée sous forme numérique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://purl.org/dc/dcmitype/Image> ;
    rdfs:subClassOf premis:IntellectualEntity ;
     .

ha:ImageReel a rdfs:Class ;
    rdfs:label "image reel"@en, "beeldspoel"@nl, "bobine image"@fr ;
    skos:definition "A physical reel of photographic film carrying the image component of an archived film."@en, "Een fysieke spoel fotografische film die de beeldcomponent van een gearchiveerde film bevat."@nl, "Une bobine physique de film photographique contenant la composante image d’un film archivé."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:PhysicalCarrier ;
     .

ha:LocalIdentifier a rdfs:Class ;
    rdfs:label "local identifier"@en, "lokale identificatie"@nl, "identifiant local"@fr ;
    skos:definition "An identifier assigned to or recognized for an archival resource within a content partner’s system, such as a barcode or catalogue number."@en, "Een identificatie die binnen het systeem van een contentpartner aan een archiefbron is toegekend of ervoor wordt herkend, zoals een barcode of catalogusnummer."@nl, "Un identifiant attribué ou reconnu pour une ressource archivistique dans le système d’un partenaire de contenu, tel qu’un code-barres ou un numéro de catalogue."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf skos:Concept, premis:Identifier ;
     .

ha:Location a rdfs:Class ;
    rdfs:label "location"@en, "locatie"@nl, "localisation"@fr ;
    skos:definition "A spatial region or named place associated with an archival resource."@en, "Een ruimtelijk gebied of benoemde plaats die met een archiefbron is verbonden."@nl, "Une région spatiale ou un lieu nommé associé à une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dct:Location ;
     .

ha:Logo a rdfs:Class ;
    rdfs:label "logo"@en, "logo"@nl, "logo"@fr ;
    skos:definition "A graphic mark or emblem identifying an organization involved with the archive."@en, "Een grafisch teken of embleem dat een bij het archief betrokken organisatie identificeert."@nl, "Un signe graphique ou un emblème identifiant une organisation liée aux archives."@fr ;
    rdfs:isDefinedBy ha: ;
     .

ha:MaterialArtwork a rdfs:Class ;
    rdfs:label "physical artwork"@en, "materieel kunstwerk"@nl, "œuvre d’art matérielle"@fr ;
    skos:definition "An intellectual entity representing a visual artwork with a physical embodiment."@en, "Een intellectuele entiteit die een beeldend kunstwerk met een fysieke verschijningsvorm voorstelt."@nl, "Une entité intellectuelle représentant une œuvre d’art visuel ayant une matérialisation physique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf premis:IntellectualEntity ;
     .

ha:MediaFragment a rdfs:Class, owl:Class ;
    rdfs:label "media fragment"@en, "mediafragment"@nl, "fragment de média"@fr ;
    skos:definition "An identifiable spatial or temporal segment of a media resource, used here as a partial digital representation of archival content."@en, "Een identificeerbaar ruimtelijk of temporeel segment van een mediabron, hier gebruikt als gedeeltelijke digitale representatie van archiefinhoud."@nl, "Un segment spatial ou temporel identifiable d’une ressource médiatique, utilisé ici comme représentation numérique partielle d’un contenu archivistique."@fr ;
    rdfs:seeAlso ebucore:MediaFragment, <http://www.w3.org/ns/ma-ont#MediaFragment> ;
     .

ha:MediaResource a rdfs:Class ;
    rdfs:label "media resource"@en, "mediabron"@nl, "ressource médiatique"@fr ;
    skos:definition "An audio or audiovisual resource whose content may be annotated or divided into media fragments."@en, "Een audio- of audiovisuele bron waarvan de inhoud kan worden geannoteerd of in mediafragmenten verdeeld."@nl, "Une ressource audio ou audiovisuelle dont le contenu peut être annoté ou divisé en fragments de média."@fr ;
    rdfs:seeAlso ebucore:MediaResource ;
     .

ha:MediaTypeOrExtent a rdfs:Class ;
    rdfs:label "media type or extent"@en, "mediatype of omvang"@nl, "type de média ou étendue"@fr ;
    skos:definition "A category of values describing the format, physical extent or duration of an archival resource."@en, "Een categorie waarden die het formaat, de fysieke omvang of de duur van een archiefbron beschrijft."@nl, "Une catégorie de valeurs décrivant le format, l’étendue physique ou la durée d’une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dct:MediaTypeOrExtent ;
     .

ha:Motivation a rdfs:Class ;
    rdfs:label "access restriction reason"@en, "reden voor toegangsbeperking"@nl, "motif de restriction d’accès"@fr ;
    skos:definition "A controlled concept stating the reason for an access prohibition on archival content."@en, "Een gecontroleerd begrip dat de reden voor een toegangsverbod op archiefinhoud aangeeft."@nl, "Un concept contrôlé indiquant le motif d’une interdiction d’accès à un contenu archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf skos:Concept ;
     .

ha:Newspaper a rdfs:Class ;
    rdfs:label "newspaper"@en, "krant"@nl, "journal"@fr ;
    skos:definition "A serial news publication described as a series of newspaper issues."@en, "Een seriële nieuwspublicatie die als een reeks krantenedities wordt beschreven."@nl, "Une publication d’information en série décrite comme un ensemble de numéros de journal."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:Newspaper ;
    rdfs:subClassOf ha:CreativeWorkSeries ;
     .

ha:NewspaperIssue a rdfs:Class ;
    rdfs:label "newspaper issue"@en, "kranteneditie"@nl, "numéro de journal"@fr ;
    skos:definition "An intellectual entity representing one complete issue of a newspaper."@en, "Een intellectuele entiteit die één volledige editie van een krant voorstelt."@nl, "Une entité intellectuelle représentant un numéro complet d’un journal."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf premis:IntellectualEntity ;
     .

ha:NewspaperIssuePage a rdfs:Class ;
    rdfs:label "newspaper issue page"@en, "kranteneditiepagina"@nl, "page de numéro de journal"@fr ;
    skos:definition "An intellectual entity representing one page within a newspaper issue."@en, "Een intellectuele entiteit die één pagina binnen een kranteneditie voorstelt."@nl, "Une entité intellectuelle représentant une page d’un numéro de journal."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf premis:IntellectualEntity ;
     .

ha:ObjectType a rdfs:Class ;
    rdfs:label "object type"@en, "objecttype"@nl, "type d’objet"@fr ;
    skos:definition "A descriptive category for the kind of archival content, such as a programme, clip, book or report."@en, "Een beschrijvende categorie voor het soort archiefinhoud, zoals een programma, fragment, boek of rapport."@nl, "Une catégorie descriptive du type de contenu archivistique, tel qu’une émission, un extrait, un livre ou un rapport."@fr ;
    rdfs:seeAlso ebucore:ObjectType ;
     .

ha:OpenCaptions a rdfs:Class ;
    rdfs:label "open captions"@en, "ingebrande ondertiteling"@nl, "sous-titres incrustés"@fr ;
    skos:definition "Accessibility captions embedded in the image and continuously visible during playback."@en, "Toegankelijkheidsondertiteling die in het beeld is ingebrand en tijdens het afspelen voortdurend zichtbaar is."@nl, "Des sous-titres d’accessibilité intégrés à l’image et visibles en permanence pendant la lecture."@fr ;
    rdfs:subClassOf ha:Captioning ;
    rdfs:seeAlso ebucore:OpenCaptions ;
     .

ha:Organization a rdfs:Class, owl:Class ;
    rdfs:label "organization"@en, "organisatie"@nl, "organisation"@fr ;
    skos:definition "A group of people with a shared purpose and an organized structure that can act in relation to archival resources or services."@en, "Een groep personen met een gemeenschappelijk doel en een georganiseerde structuur die kan handelen met betrekking tot archiefbronnen of diensten."@nl, "Un groupe de personnes ayant un objectif commun et une structure organisée, pouvant intervenir dans les ressources ou services archivistiques."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://www.w3.org/ns/org#Organization>, schema:Organization ;
    rdfs:subClassOf ha:Thing ; # ! Should this be rdfs:subClassOf ha:Agent ?
    owl:disjointWith ha:Person ; 
     .

ha:OrganizationType a rdfs:Class ;
    rdfs:label "organization type"@en, "organisatietype"@nl, "type d’organisation"@fr ;
    skos:definition "A controlled concept used to classify an organization involved with the archive."@en, "Een gecontroleerd begrip waarmee een bij het archief betrokken organisatie wordt geclassificeerd."@nl, "Un concept contrôlé servant à classer une organisation liée aux archives."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf skos:Concept ;
     .

ha:OrganizationalUnit a rdfs:Class, owl:Class ;
    rdfs:label "organizational unit"@en, "organisatie-eenheid"@nl, "unité organisationnelle"@fr ;
    skos:definition "A department or other unit recognized within a larger organization and without a separate legal identity."@en, "Een afdeling of andere eenheid die binnen een grotere organisatie wordt erkend en geen afzonderlijke rechtspersoonlijkheid heeft."@nl, "Un département ou une autre unité reconnue au sein d’une organisation plus vaste et dépourvue de personnalité juridique distincte."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://www.w3.org/ns/org#OrganizationalUnit> ;
    rdfs:subClassOf ha:Organization ;
     .

# ! Keep this or reduce to Role? 
ha:PerformanceRole a rdfs:Class ;
    rdfs:label "performance role"@en, "vertolkingsrol"@nl, "rôle d’interprétation"@fr ;
    skos:definition "A role describing a performer’s participation in a work, including the character portrayed where applicable."@en, "Een rol die de deelname van een uitvoerder aan een werk beschrijft, met indien van toepassing het vertolkte personage."@nl, "Un rôle décrivant la participation d’un interprète à une œuvre, y compris le personnage incarné le cas échéant."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:PerformanceRole ;
    rdfs:subClassOf ha:Role ;
     .

ha:PeriodOfTime a rdfs:Class ;
    rdfs:label "period of time"@en, "tijdsperiode"@nl, "période"@fr ;
    skos:definition "A named time interval or an interval defined by its start and end, used in archival descriptions."@en, "Een benoemd tijdsinterval of een door begin en einde bepaald interval dat in archiefbeschrijvingen wordt gebruikt."@nl, "Un intervalle de temps nommé ou défini par son début et sa fin, utilisé dans les descriptions archivistiques."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dct:PeriodOfTime ;
     .

ha:Person a rdfs:Class ;
    rdfs:label "person"@en, "persoon"@nl, "personne"@fr ;
    skos:definition "A real or fictional human individual described in relation to archival content, organizations or services."@en, "Een werkelijk of fictief menselijk individu dat wordt beschreven in relatie tot archiefinhoud, organisaties of diensten."@nl, "Un individu humain réel ou fictif décrit en lien avec des contenus archivistiques, des organisations ou des services."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:Person ;
    rdfs:subClassOf ha:Thing, ha:Agent ;
     .

ha:PhysicalCarrier a rdfs:Class ;
    rdfs:label "physical carrier"@en, "fysieke drager"@nl, "support physique"@fr ;
    skos:definition "A tangible medium on which archival content is stored, including any integral housing such as a cassette or cartridge."@en, "Een tastbaar medium waarop archiefinhoud is opgeslagen, met inbegrip van een eventuele bijbehorende behuizing zoals een cassette of cartridge."@nl, "Un support matériel sur lequel un contenu archivistique est stocké, y compris son éventuel boîtier intégré, tel qu’une cassette ou une cartouche."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf premis:StorageLocation ;
     .

ha:Place a rdfs:Class ;
    rdfs:label "place"@en, "plaats"@nl, "lieu"@fr ;
    skos:definition "A physical place associated with the content, creation or management of an archival resource."@en, "Een fysieke plaats die verband houdt met de inhoud, creatie of het beheer van een archiefbron."@nl, "Un lieu physique lié au contenu, à la création ou à la gestion d’une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:Place ;
    rdfs:subClassOf ha:Thing ;
     .

ha:Post a rdfs:Class, owl:Class ;
    rdfs:label "organizational post"@en, "organisatiefunctie"@nl, "poste organisationnel"@fr ;
    skos:definition "A position within an organization that exists independently of the person or persons holding it."@en, "Een functie binnen een organisatie die onafhankelijk van de persoon of personen die haar bekleden bestaat."@nl, "Un poste au sein d’une organisation qui existe indépendamment de la ou des personnes qui l’occupent."@fr ;
    rdfs:isDefinedBy ha: ;
    rdf:subClassOf ha:Role ;
    rdfs:seeAlso <http://www.w3.org/ns/org#Post> ;
     .

ha:PostalAddress a rdfs:Class ;
    rdfs:label "postal address"@en, "postadres"@nl, "adresse postale"@fr ;
    skos:definition "An address used to deliver correspondence to a person, organization or site."@en, "Een adres voor het bezorgen van correspondentie aan een persoon, organisatie of vestiging."@nl, "Une adresse utilisée pour acheminer le courrier à une personne, une organisation ou un établissement."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:PostalAddress ;
    rdfs:subClassOf ha:ContactPoint ;
     .

ha:Product a rdfs:Class ;
    rdfs:label "product"@en, "product"@nl, "produit"@fr ;
    skos:definition "A product or service described in relation to archival carriers, equipment or services."@en, "Een product of dienst dat wordt beschreven in relatie tot archiefdragers, apparatuur of dienstverlening."@nl, "Un produit ou un service décrit en lien avec des supports, des équipements ou des services archivistiques."@fr ;
    rdfs:seeAlso schema:Product ;
    rdfs:subClassOf ha:Thing ;
    
     .

ha:Project a rdfs:Class ;
    rdfs:label "project"@en, "project"@nl, "projet"@fr ;
    skos:definition "An organized undertaking with a defined purpose involving archival content, preservation, access or related research."@en, "Een georganiseerd initiatief met een bepaald doel rond archiefinhoud, bewaring, toegang of verwant onderzoek."@nl, "Une initiative organisée ayant un objectif défini concernant des contenus archivistiques, leur conservation, leur accès ou la recherche associée."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/Project> ;
     .

ha:ProjectPartner a rdfs:Class ;
    rdfs:label "project partner"@en, "projectpartner"@nl, "partenaire de projet"@fr ;
    skos:definition "An organization collaborating with meemoo on a project formalized through an agreement or decision."@en, "Een organisatie die met meemoo samenwerkt aan een project dat door een overeenkomst of besluit is geformaliseerd."@nl, "Une organisation collaborant avec meemoo à un projet formalisé par un accord ou une décision."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:Organization ;
     .

ha:PublicDomainStatus a rdfs:Class, owl:Class ;
    rdfs:label "public domain status"@en, "publiekdomeinstatus"@nl, "statut de domaine public"@fr ;
    skos:definition "A rights status indicating that the resource is in the public domain with respect to copyright in the applicable jurisdiction."@en, "Een rechtenstatus die aangeeft dat de bron in het toepasselijke rechtsgebied tot het publieke domein behoort wat het auteursrecht betreft."@nl, "Un statut de droits indiquant que la ressource relève du domaine public au regard du droit d’auteur dans le cadre juridique applicable."@fr ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/copyrightStatus/pub> ;
    owl:equivalentClass <http://id.loc.gov/vocabulary/preservation/copyrightStatus/pub> ;
    rdfs:subClassOf premis:RightsStatus ;
     .

ha:PublicationIssue a rdfs:Class ;
    rdfs:label "publication issue"@en, "publicatieaflevering"@nl, "numéro de publication"@fr ;
    skos:definition "An individual installment of a serial publication, such as a newspaper or periodical, often numbered and containing articles or other works."@en, "Een afzonderlijke aflevering van een seriële publicatie, zoals een krant of tijdschrift, vaak genummerd en met artikelen of andere werken."@nl, "Un numéro individuel d’une publication en série, telle qu’un journal ou un périodique, souvent numéroté et contenant des articles ou d’autres œuvres."@fr ;
    rdfs:seeAlso schema:PublicationIssue, <http://purl.org/ontology/bibo/Issue> ;
    rdfs:subClassOf ha:CreativeWork ;
     .

ha:QuantitativeValue a rdfs:Class ;
    rdfs:label "quantitative value"@en, "kwantitatieve waarde"@nl, "valeur quantitative"@fr ;
    skos:definition "A numeric measurement associated with a unit, used for dimensions or technical characteristics of archival resources."@en, "Een numerieke meting met een eenheid, gebruikt voor afmetingen of technische kenmerken van archiefbronnen."@nl, "Une mesure numérique associée à une unité, utilisée pour les dimensions ou les caractéristiques techniques des ressources archivistiques."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:QuantitativeValue ;
    rdfs:subClassOf ha:Thing ;
     .

ha:MediahavenRecord a rdfs:Class ;
    rdfs:label "Mediahaven record"@en, "Mediahavenrecord"@nl, "notice Mediahaven"@fr ;
    skos:definition "An asset record in Mediahaven to which fragment records can be linked."@en, "Een assetrecord in Mediahaven waaraan fragmentrecords kunnen worden gekoppeld."@nl, "Une notice de ressource dans Mediahaven à laquelle des notices de fragments peuvent être liées."@fr ;
    rdfs:isDefinedBy ha: ;
     .

ha:RightsStatement a rdfs:Class ;
    rdfs:label "rights statement"@en, "rechtenverklaring"@nl, "déclaration de droits"@fr ;
    skos:definition "A statement describing intellectual property rights, permissions or access conditions applicable to an archival resource."@en, "Een verklaring die intellectuele-eigendomsrechten, toestemmingen of toegangsvoorwaarden voor een archiefbron beschrijft."@nl, "Une déclaration décrivant les droits de propriété intellectuelle, les autorisations ou les conditions d’accès applicables à une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dct:RightsStatement ;
     .

# ! this term combines an abstract organizational function with a contextual contribution; consider separate role-type and role-assignment classes.
ha:Role a rdfs:Class, owl:Class ;
    rdfs:label "role"@en, "rol"@nl, "rôle"@fr ;
    skos:definition "A function or contextualized participation of a person or organization in an organization or in the creation, performance or publication of a work."@en, "Een functie of gecontextualiseerde deelname van een persoon of organisatie binnen een organisatie of bij de creatie, uitvoering of publicatie van een werk."@nl, "Une fonction ou une participation contextualisée d’une personne ou d’une organisation au sein d’une organisation ou dans la création, l’interprétation ou la publication d’une œuvre."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://www.w3.org/ns/org#Role>, schema:Role ;
    rdfs:subClassOf ha:Thing ;
     .

ha:RoleType a rdfs:Class ; # ! was ha:RoleName
    rdfs:label "role type"@en, "roltype"@nl, "type de rôle"@fr ;
    skos:definition "A controlled concept naming the function performed by a person or organization in a role."@en, "Een gecontroleerd begrip dat de functie benoemt die een persoon of organisatie in een rol vervult."@nl, "Un concept contrôlé nommant la fonction exercée par une personne ou une organisation dans un rôle."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf skos:Concept ;
     .

ha:Service a rdfs:Class ;
    rdfs:label "service"@en, "dienst"@nl, "service"@fr ;
    skos:definition "An activity provided by an organization, such as digitization, digital storage or access to archival content."@en, "Een activiteit die een organisatie aanbiedt, zoals digitalisering, digitale opslag of toegang tot archiefinhoud."@nl, "Une activité fournie par une organisation, telle que la numérisation, le stockage numérique ou l’accès à des contenus archivistiques."@fr ;
    rdfs:seeAlso schema:Service ;
     .

ha:ServiceConsumer a rdfs:Class ;
    rdfs:label "service consumer"@en, "dienstenafnemer"@nl, "bénéficiaire de services"@fr ;
    skos:definition "An organization with a contract to use meemoo services, such as digital storage, outside the content partner arrangement."@en, "Een organisatie die op contractuele basis meemoodiensten zoals digitale opslag afneemt buiten de regeling voor contentpartners."@nl, "Une organisation qui utilise contractuellement des services de meemoo, tels que le stockage numérique, en dehors du dispositif des partenaires de contenu."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:Organization ;
     .

ha:ServiceProvider a rdfs:Class ;
    rdfs:label "service provider"@en, "dienstenleverancier"@nl, "prestataire de services"@fr ;
    skos:definition "An organization supplying services or goods to meemoo, such as IT support or digitization."@en, "Een organisatie die diensten of goederen aan meemoo levert, zoals IT-ondersteuning of digitalisering."@nl, "Une organisation fournissant des services ou des biens à meemoo, tels que l’assistance informatique ou la numérisation."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:Organization ;
     .

ha:SilentFilm a rdfs:Class ;
    rdfs:label "silent film"@en, "stomme film"@nl, "film muet"@fr ;
    skos:definition "An intellectual entity representing a film originally produced without a synchronized soundtrack."@en, "Een intellectuele entiteit die een film voorstelt die oorspronkelijk zonder gesynchroniseerde geluidsband is geproduceerd."@nl, "Une entité intellectuelle représentant un film produit à l’origine sans bande sonore synchronisée."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:Film ;
     .

ha:Site a rdfs:Class, owl:Class ;
    rdfs:label "organizational site"@en, "vestiging"@nl, "établissement"@fr ;
    skos:definition "A physical or virtual site at which an organization has a presence or can be contacted."@en, "Een fysieke of virtuele vestiging waar een organisatie aanwezig of bereikbaar is."@nl, "Un lieu d’implantation physique ou virtuel où une organisation est présente ou peut être contactée."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://www.w3.org/ns/org#Site> ;
     .

ha:SizeOrDuration a rdfs:Class ;
    rdfs:label "size or duration"@en, "omvang of duur"@nl, "taille ou durée"@fr ;
    skos:definition "A value describing the physical size, amount of content or playback duration of an archival resource."@en, "Een waarde die de fysieke omvang, hoeveelheid inhoud of afspeelduur van een archiefbron beschrijft."@nl, "Une valeur décrivant la taille physique, la quantité de contenu ou la durée de lecture d’une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dct:SizeOrDuration ;
     .

ha:SoundFilm a rdfs:Class ;
    rdfs:label "sound film"@en, "geluidsfilm"@nl, "film sonore"@fr ;
    skos:definition "An intellectual entity representing a film originally produced with synchronized sound."@en, "Een intellectuele entiteit die een film voorstelt die oorspronkelijk met gesynchroniseerd geluid is geproduceerd."@nl, "Une entité intellectuelle représentant un film produit à l’origine avec un son synchronisé."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:Film ;
     .

ha:TextAnnotation a rdfs:Class ;
    rdfs:label "text annotation"@en, "tekstannotatie"@nl, "annotation de texte"@fr ;
    skos:definition "An annotation describing or identifying content in a text or a selected part of a text."@en, "Een annotatie die inhoud in een tekst of een geselecteerd tekstgedeelte beschrijft of identificeert."@nl, "Une annotation décrivant ou identifiant du contenu dans un texte ou une partie sélectionnée de celui-ci."@fr ;
    rdfs:seeAlso ebucore:TextAnnotation ;
    rdfs:subClassOf ha:Annotation ;
     .

ha:Thing a rdfs:Class ;
    rdfs:label "thing"@en, "ding"@nl, "chose"@fr ;
    skos:definition "Any entity described by the archival data model."@en, "Elke entiteit die door het archiefdatamodel wordt beschreven."@nl, "Toute entité décrite par le modèle de données archivistiques."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf owl:Thing ;
    rdfs:seeAlso schema:Thing ;
     .

ha:ThreeDimensionalArtwork a rdfs:Class ;
    rdfs:label "three-dimensional artwork"@en, "driedimensionaal kunstwerk"@nl, "œuvre d’art tridimensionnelle"@fr ;
    skos:definition "An intellectual entity representing a physical artwork with three-dimensional form, such as a sculpture or installation."@en, "Een intellectuele entiteit die een fysiek kunstwerk met een driedimensionale vorm voorstelt, zoals een sculptuur of installatie."@nl, "Une entité intellectuelle représentant une œuvre d’art physique de forme tridimensionnelle, telle qu’une sculpture ou une installation."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:MaterialArtwork ;
     .

ha:TwoDimensionalArtwork a rdfs:Class ;
    rdfs:label "two-dimensional artwork"@en, "tweedimensionaal kunstwerk"@nl, "œuvre d’art bidimensionnelle"@fr ;
    skos:definition "An intellectual entity representing a physical artwork with a predominantly two-dimensional form, such as a drawing, painting, print or photograph."@en, "Een intellectuele entiteit die een fysiek kunstwerk met een overwegend tweedimensionale vorm voorstelt, zoals een tekening, schilderij, prent of foto."@nl, "Une entité intellectuelle représentant une œuvre d’art physique de forme principalement bidimensionnelle, telle qu’un dessin, une peinture, une estampe ou une photographie."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:MaterialArtwork ;
     .

ha:UserGroup a rdfs:Class ;
    rdfs:label "user group"@en, "gebruikersgroep"@nl, "groupe d’utilisateurs"@fr ;
    skos:definition "A category of users to which an access or use policy for archival content applies."@en, "Een categorie gebruikers waarop een toegangs- of gebruiksbeleid voor archiefinhoud van toepassing is."@nl, "Une catégorie d’utilisateurs à laquelle s’applique une politique d’accès ou d’utilisation des contenus archivistiques."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf odrl:RightOperand ;
     .

ha:Video a rdfs:Class ;
    rdfs:label "video"@en, "video"@nl, "vidéo"@fr ;
    skos:definition "An intellectual entity consisting of moving images, with or without sound, originating from a video carrier or created digitally."@en, "Een intellectuele entiteit bestaande uit bewegend beeld, met of zonder geluid, afkomstig van een videodrager of digitaal gecreëerd."@nl, "Une entité intellectuelle constituée d’images animées, avec ou sans son, provenant d’un support vidéo ou créée sous forme numérique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf premis:IntellectualEntity ;
     .

ha:WrittenWorkCarrierRepresentation a rdfs:Class ;
    rdfs:label "written work carrier representation"@en, "dragerrepresentatie van geschreven werk"@nl, "représentation d’œuvre écrite sur support physique"@fr ;
    skos:definition "A representation of an archived written work embodied on a physical carrier, such as a printed newspaper or book."@en, "Een representatie van een gearchiveerd geschreven werk op een fysieke drager, zoals een gedrukte krant of een boek."@nl, "Une représentation d’une œuvre écrite archivée, matérialisée sur un support physique tel qu’un journal imprimé ou un livre."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf ha:CarrierRepresentation ;
     .

<https://data.hetarchief.be/id/collection/action> a skos:Collection ;
    skos:member ha:availableForConsultation, ha:downloadable ;
    skos:prefLabel "Ontsluitingsacties"@nl ;
     .

<https://data.hetarchief.be/id/collection/content-range> a skos:Collection ;
    skos:member ha:full, ha:partial ;
    skos:prefLabel "Inhoudsbereik"@nl ;
     .

<https://data.hetarchief.be/id/collection/metadata-range> a skos:Collection ;
    skos:member ha:extended, ha:limited ;
    skos:prefLabel "Metadatabereik"@nl ;
     .

<https://data.hetarchief.be/id/collection/user-group> a skos:Collection ;
    skos:member ha:betweenPartners, ha:educationalPublic, ha:intraMuros, ha:public, ha:researchPublic ;
    skos:prefLabel "Gebruikersgroepen"@nl ;
     .

ha:anonymous a owl:NamedIndividual, skos:Concept ;
    rdfs:label "anonymous"@en ;
    rdfs:isDefinedBy ha: ;
    rdfs:comment "Indicates that the identity is intentionally withheld."@en, "Indique que l'identité est volontairement masquée."@fr, "Geeft aan dat de identiteit bewust niet wordt vermeld."@nl ;
    skos:prefLabel "anonymous"@en, "anonyme"@fr, "anoniem"@nl ;
     .

ha:contentScopeOperand a owl:NamedIndividual, skos:Concept, odrl:LeftOperand ; # ! was ha:contentRangeOperand
    rdfs:label "content scope operand"@en, "Plage de contenu"@fr, "Inhoudsbereik"@nl ;
    rdfs:isDefinedBy ha: ;
    rdfs:comment "The intended reach of the object's media content. For example, whether it is about the full content or only a part."@en, "La portée prévue du contenu multimédia de l'objet du.Par exemple, qu'il s'agisse du contenu complet ou seulement une pièce."@fr, "Het beoogde bereik van de mediainhoud van het object. Bijvoorbeeld, of het over de volledige inhoud gaat of slechts een deel."@nl ;
    skos:prefLabel "Content scope"@en, "Plage de contenu"@fr, "Inhoudsbereik"@nl ;
     .

ha:documents a rdf:Property, owl:ObjectProperty ;
    rdfs:domain premis:Object; rdfs:range premis:Object;
    rdfs:label "documents"@en, "documenteert"@nl, "documente"@fr ;
    skos:definition "Relates a documentation resource, such as a manual, to the preservation environment object it describes."@en, "Verbindt een documentatiebron, zoals een handleiding, met het bewaringsomgevingsobject dat ze beschrijft."@nl, "Relie une ressource documentaire, telle qu’un manuel, à l’objet d’environnement de conservation qu’elle décrit."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/doc> ;
    owl:equivalentProperty <http://id.loc.gov/vocabulary/preservation/relationshipSubType/doc> ;
    rdfs:subPropertyOf premis:relationship ;
     .

ha:hasExecutingSoftware a rdf:Property ;
    rdfs:domain premis:Event; 
    rdfs:range premis:SoftwareAgent ;
    rdfs:label "has executing software"@en, "heeft uitvoerende software"@nl, "a pour logiciel exécutant"@fr ;
    skos:definition "Identifies the software agent that executes a preservation event."@en, "Identificeert de softwareagent die een bewaringsgebeurtenis uitvoert."@nl, "Identifie l’agent logiciel qui exécute un événement de conservation."@fr ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventRelatedAgentRole/exe> ;
     .

ha:fail a owl:NamedIndividual, skos:Concept ;
    skos:definition "The event did not succeed in producing the intended result."@en ;
    rdfs:label "fail"@en ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventOutcome/fai> ;
    skos:prefLabel "fail" ;
     .

# ! Can we replace this by Cast? local SHACL uses ha:PerformanceRole
ha:hasActor a rdf:Property ;
    rdfs:label "has actor"@en, "heeft acteur"@nl, "a pour acteur"@fr ;
    skos:definition "Identifies an actor participating in a work, directly or through a performance role describing the participation."@en, "Identificeert een acteur die aan een werk deelneemt, rechtstreeks of via een vertolkingsrol die de deelname beschrijft."@nl, "Identifie un acteur participant à une œuvre, directement ou au moyen d’un rôle d’interprétation décrivant sa participation."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Person ;
    rdfs:seeAlso schema:actor ;
     .

ha:hasAddressCountry a rdf:Property ;
    rdfs:domain ha:PostalAddress ;
    rdfs:range ha:Country ;
    rdfs:label "has address country"@en, "heeft adresland"@nl, "a pour pays d’adresse"@fr ;
    skos:definition "Specifies the country component of an address or geographic description."@en, "Geeft het landgedeelte van een adres of geografische beschrijving aan."@nl, "Indique le pays d’une adresse ou d’une description géographique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:addressCountry ;
     .

ha:hasAddressLocality a rdf:Property ;
    rdfs:label "has address locality"@en, "heeft adresplaats"@nl, "a pour localité d’adresse"@fr ;
    rdfs:domain ha:PostalAddress; 
    rdfs:range xsd:string;
    skos:definition "Specifies the town, city or other locality of a postal address."@en, "Geeft de stad, gemeente of andere plaats van een postadres aan."@nl, "Indique la ville, la commune ou une autre localité d’une adresse postale."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:addressLocality ;
     .

ha:hasAddressRegion a rdf:Property ;
    rdfs:label "has address region"@en, "heeft adresregio"@nl, "a pour région d’adresse"@fr ;
    skos:definition "Specifies the administrative region of a postal address or geographic area."@en, "Geeft de bestuurlijke regio van een postadres of geografisch gebied aan."@nl, "Indique la région administrative d’une adresse postale ou d’une zone géographique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:domain ha:PostalAddress; 
    rdfs:range xsd:string;
    rdfs:seeAlso schema:addressRegion ;
     .

ha:hasAlternateName a rdf:Property ;
    rdfs:label "has alternative name"@en, "heeft alternatieve naam"@nl, "a pour nom alternatif"@fr ;
    skos:definition "Provides an alternative name or title by which an archival resource is known."@en, "Geeft een alternatieve naam of titel waaronder een archiefbron bekend is."@nl, "Fournit un nom ou un titre alternatif sous lequel une ressource archivistique est connue."@fr ;
    rdfs:domain ha:Thing ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:alternateName, dct:alternative ;
    owl:equivalentProperty ha:hasAlternative ;
     .

ha:hasAnnotationConfidence a rdf:Property ;
    rdfs:label "has annotation confidence"@en, "heeft annotatiebetrouwbaarheid"@nl, "a pour score de confiance d’annotation"@fr ;
    skos:definition "Records a confidence score for the information asserted by an annotation."@en, "Legt een betrouwbaarheidsscore vast voor de informatie die een annotatie beweert."@nl, "Consigne un score de confiance pour les informations affirmées par une annotation."@fr ;
    rdfs:domain ha:Annotation ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso ebucore:annotationConfidence ;
     .

ha:hasAnnotationSubject a rdf:Property ; # ! merges hasAnnotationRelatedAgent and hasAnnotationRelatedArtefact
    rdfs:label "has annotation subject"@en, "heeft annotatieonderwerp"@nl, "a pour sujet d’annotation"@fr ;
    skos:definition "Identifies an agent or thing that is the subject of an annotation."@en, "Identificeert een agent of ding dat het onderwerp van een annotatie is."@nl, "Identifie un agent ou un chose qui est le sujet d’une annotation."@fr ;
    rdfs:domain ha:Annotation ;
    rdfs:range ha:Thing ;
    rdfs:seeAlso ebucore:hasAnnotationRelatedAgent, ebucoreplus:hasAnnotationAgent, ebucore:hasAnnotationRelatedArtefact, ebucoreplus:hasAnnotationArtefact ;
     .

ha:hasAnnotationTarget a rdf:Property ;
    rdfs:label "has annotation target"@en, "heeft annotatiedoelbron"@nl, "a pour cible d’annotation"@fr ;
    skos:definition "Identifies the archival resource or file to which an annotation applies."@en, "Identificeert de archiefbron of het bestand waarop een annotatie van toepassing is."@nl, "Identifie la ressource archivistique ou le fichier auquel une annotation s’applique."@fr ;
    rdfs:domain ha:Annotation ;
    rdfs:range premis:File ;
    rdfs:seeAlso ebucore:hasAnnotationTarget ;
     .

ha:hasAnnotationType a rdf:Property ;
    rdfs:label "has annotation type"@en, "heeft annotatietype"@nl, "a pour type d’annotation"@fr ;
    skos:definition "Specifies the category of an annotation, such as face recognition or named entity recognition."@en, "Geeft de categorie van een annotatie aan, zoals gezichtsherkenning of herkenning van benoemde entiteiten."@nl, "Indique la catégorie d’une annotation, telle que la reconnaissance de visages ou d’entités nommées."@fr ;
    rdfs:domain ha:Annotation ;
    rdfs:range ha:AnnotationType ;
    rdfs:seeAlso ebucore:annotationType ;
     .

ha:hasArtMedium a rdf:Property ;
    rdfs:label "has artistic medium"@en, "heeft artistiek medium"@nl, "a pour médium artistique"@fr ;
    skos:definition "Describes the material or medium used to create an artwork, such as oil paint, ink or marble."@en, "Beschrijft het materiaal of medium waarmee een kunstwerk is gemaakt, zoals olieverf, inkt of marmer."@nl, "Décrit le matériau ou le médium utilisé pour créer une œuvre d’art, tel que la peinture à l’huile, l’encre ou le marbre."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:artMedium , dct:medium
     .

ha:hasArtform a rdf:Property ;
    rdfs:label "has art form"@en, "heeft kunstvorm"@nl, "a pour forme artistique"@fr ;
    skos:definition "Specifies the artistic form of a work, such as painting, sculpture or photography."@en, "Geeft de kunstvorm van een werk aan, zoals schilderkunst, beeldhouwkunst of fotografie."@nl, "Indique la forme artistique d’une œuvre, telle que la peinture, la sculpture ou la photographie."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:artform ;
     .

ha:hasAspectRatio a rdf:Property ;
    rdfs:label "has aspect ratio"@en, "heeft beeldverhouding"@nl, "a pour rapport d’image"@fr ;
    skos:definition "Records the ratio of image width to image height for content on a film reel."@en, "Legt de verhouding tussen beeldbreedte en beeldhoogte vast voor de inhoud op een filmspoel."@nl, "Consigne le rapport entre la largeur et la hauteur de l’image pour le contenu d’une bobine de film."@fr ;
    rdfs:domain [
        owl:unionOf (
            ha:ImageReel
            ha:AudioReel
        ) ;
    ] ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
     .

ha:hasAudioNoiseReduction a rdf:Property ;
    rdfs:label "has audio noise reduction"@en, "heeft audioruisonderdrukking"@nl, "a pour réduction du bruit audio"@fr ;
    skos:definition "Specifies the noise reduction technology used for audio recorded on a physical carrier."@en, "Geeft de ruisonderdrukkingstechniek aan voor audio die op een fysieke drager is opgenomen."@nl, "Indique la technique de réduction du bruit utilisée pour l’audio enregistré sur un support physique."@fr ;
    rdfs:domain ha:PhysicalCarrier ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
     .

ha:hasAudioRecordingSpeed a rdf:Property ;
    rdfs:label "has audio recording speed"@en, "heeft audio-opnamesnelheid"@nl, "a pour vitesse d’enregistrement audio"@fr ;
    skos:definition "Records the speed at which audio was recorded on a carrier, with an appropriate unit or controlled value."@en, "Legt de snelheid vast waarmee audio op een drager is opgenomen, met een passende eenheid of gecontroleerde waarde."@nl, "Consigne la vitesse d’enregistrement audio sur un support, avec une unité appropriée ou une valeur contrôlée."@fr ;
    rdfs:domain ha:PhysicalCarrier ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:QuantitativeValue ;
     .

ha:hasAvailabilityDate a rdf:Property ;
    rdfs:label "has availability date"@en, "heeft beschikbaarheidsdatum"@nl, "a pour date de disponibilité"@fr ;
    skos:definition "Records when an archival resource became or is expected to become available."@en, "Legt vast wanneer een archiefbron beschikbaar werd of naar verwachting beschikbaar wordt."@nl, "Consigne la date à laquelle une ressource archivistique est devenue ou devrait devenir disponible."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dct:available ;
    rdfs:range edtf:EDTF-level1
     .

ha:hasBirthDate a rdf:Property ;
    rdfs:label "has birth date"@en, "heeft geboortedatum"@nl, "a pour date de naissance"@fr ;
    skos:definition "Records the date on which a person was born."@en, "Legt de datum vast waarop een persoon is geboren."@nl, "Consigne la date de naissance d’une personne."@fr ;
    rdfs:domain ha:Person ;
    rdfs:isDefinedBy ha: ;
    rdfs:range edtf:EDTF-level1 ;
    rdfs:seeAlso schema:birthDate ;
     .

ha:hasBirthPlace a rdf:Property ;
    rdfs:domain ha:Person ;
    rdfs:label "has birthplace"@en, "heeft geboorteplaats"@nl, "a pour lieu de naissance"@fr ;
    skos:definition "Specifies the place where a person was born."@en, "Geeft de plaats aan waar een persoon is geboren."@nl, "Indique le lieu de naissance d’une personne."@fr ;
    rdfs:seeAlso schema:birthPlace ;
    rdfs:range schema:Place
     .

ha:hasBrand a rdf:Property ;
    rdfs:label "has brand"@en, "heeft merk"@nl, "a pour marque"@fr ;
    skos:definition "Identifies the brand associated with a carrier, device, software product or service."@en, "Identificeert het merk van een drager, toestel, softwareproduct of dienst."@nl, "Identifie la marque associée à un support, un appareil, un logiciel ou un service."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:brand ;
    rdfs:range ha:Brand
     .

ha:hasBroadcastingOrganization a rdf:Property ;
    rdfs:label "has broadcasting organization"@en, "heeft omroeporganisatie"@nl, "a pour organisme de diffusion"@fr ;
    skos:definition "Identifies the organization responsible for broadcasting the archived audio or audiovisual content."@en, "Identificeert de organisatie die verantwoordelijk is voor het uitzenden van de gearchiveerde audio- of audiovisuele inhoud."@nl, "Identifie l’organisation responsable de la diffusion du contenu audio ou audiovisuel archivé."@fr ;
    rdfs:domain [
        owl:unionOf (
            ha:Video
            ha:Film
            ha:Audio
            ha:DVD
        ) ;
    ] ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Organization ;
     .

ha:hasCaptionText a rdf:Property ;
    rdfs:label "has caption text"@en, "heeft bijschrifttekst"@nl, "a pour texte de légende"@fr ;
    skos:definition "Provides a textual caption for an archival resource or representation."@en, "Geeft een tekstueel bijschrift bij een archiefbron of representatie."@nl, "Fournit une légende textuelle pour une ressource archivistique ou une représentation."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:caption ;
     .

ha:hasCaptioning a rdf:Property ;
    rdfs:label "has accessibility captioning"@en, "heeft toegankelijkheidsondertiteling"@nl, "a pour sous-titrage d’accessibilité"@fr ;
    skos:definition "Identifies accessibility captions associated with a media resource or carrier."@en, "Identificeert toegankelijkheidsondertiteling die bij een mediabron of drager hoort."@nl, "Identifie le sous-titrage d’accessibilité associé à une ressource médiatique ou à un support."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Captioning ;
    rdfs:seeAlso ebucore:hasCaptioning ;
     .
ha:hasSubtitling a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has subtitling"@en, "heeft ondertiteling"@nl, "a pour sous-titrage"@fr ;
    skos:definition "Identifies subtitles associated with an archived audiovisual resource or carrier."@en, "Identificeert ondertiteling die bij een gearchiveerde audiovisuele bron of drager hoort."@nl, "Identifie le sous-titrage associé à une ressource audiovisuelle archivée ou à un support."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Subtitling ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucoreplus#hasSubtitling> ;
     .

ha:hasCastMember a rdf:Property ;
    rdfs:label "has cast member"@en, "heeft castlid"@nl, "a pour membre de distribution"@fr ;
    skos:definition "Records a performer in the cast of an archived work, as a textual credit or a structured cast entry."@en, "Vermeldt een uitvoerder in de cast van een gearchiveerd werk, als tekstuele vermelding of gestructureerde castvermelding."@nl, "Mentionne un interprète dans la distribution d’une œuvre archivée, sous forme de crédit textuel ou d’entrée structurée."@fr ;
    rdfs:range ha:CastMemberEntry ;
    rdfs:seeAlso ebucore:hasCastMember ;
     .

ha:hasChapterNumber a rdf:Property ;
    rdfs:label "has chapter number"@en, "heeft hoofdstuknummer"@nl, "a pour numéro de chapitre"@fr ;
    skos:definition "Specifies the position of a DVD chapter within the chapter sequence of the same DVD."@en, "Geeft de positie van een dvd-hoofdstuk in de hoofdstukvolgorde van dezelfde dvd aan."@nl, "Indique la position d’un chapitre de DVD dans la séquence des chapitres du même DVD."@fr ;
    rdfs:domain ha:DVDChapter ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf ha:hasPosition ;
     .

ha:hasCharacterName a rdf:Property ;
    rdfs:label "has character name"@en, "heeft personagenaam"@nl, "a pour nom de personnage"@fr ;
    skos:definition "Provides the name of the character portrayed in a performance role."@en, "Geeft de naam van het personage dat in een vertolkingsrol wordt gespeeld."@nl, "Fournit le nom du personnage incarné dans un rôle d’interprétation."@fr ;
    rdfs:domain ha:PerformanceRole ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:characterName ;
     .

ha:hasClassification a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has classification"@en, "heeft classificatie"@nl, "a pour classification"@fr ;
    skos:definition "Classifies an organization using a concept from a controlled classification scheme."@en, "Classificeert een organisatie met een begrip uit een gecontroleerd classificatieschema."@nl, "Classe une organisation au moyen d’un concept issu d’un schéma de classification contrôlé."@fr ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy ha: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <http://www.w3.org/ns/org#classification> ;
     .

ha:hasCollectionSize a rdf:Property ;
    rdfs:domain ha:Collection; 
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "has collection size"@en, "heeft collectieomvang"@nl, "a pour taille de collection"@fr ;
    skos:definition "Records the number of resources in a collection."@en, "Legt het aantal bronnen in een collectie vast."@nl, "Consigne le nombre de ressources dans une collection."@fr ;
    rdfs:seeAlso schema:collectionSize ;
     .

ha:hasFilmColorType a rdf:Property ;
    rdfs:domain ha:ImageReel ;
    rdfs:isDefinedBy ha: ;
    rdfs:range skos:Concept ;
    rdfs:label "has film colour type"@en, "heeft filmkleurtype"@nl, "a pour type de couleur du film"@fr ;
    skos:definition "Specifies the colour characteristics of a film image reel, such as colour, black and white or tinting."@en, "Geeft de kleurkenmerken van een filmdrager aan, zoals kleur, zwart-wit of tinting."@nl, "Indique les caractéristiques chromatiques d’un support film, telles que la couleur, le noir et blanc ou le teintage."@fr ;
    rdfs:seeAlso <http://dbpedia.org/ontology/filmColourType> ;
     .

ha:hasContactPoint a rdf:Property ;
    rdfs:label "has contact point"@en, "heeft contactpunt"@nl, "a pour point de contact"@fr ;
    skos:definition "Identifies contact information for reaching a person or organization."@en, "Identificeert contactgegevens om een persoon of organisatie te bereiken."@nl, "Identifie les coordonnées permettant de joindre une personne ou une organisation."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:ContactPoint ;
    rdfs:seeAlso schema:contactPoint ;
     .

ha:hasContactType a rdf:Property ;
    rdfs:domain ha:ContactPoint; 
    rdfs:range xsd:string ;
    rdfs:label "has contact type"@en, "heeft contacttype"@nl, "a pour type de contact"@fr ;
    skos:definition "Describes the purpose of a contact point, such as general enquiries or technical support."@en, "Beschrijft het doel van een contactpunt, zoals algemene vragen of technische ondersteuning."@nl, "Décrit la fonction d’un point de contact, telle que les renseignements généraux ou l’assistance technique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:contactType ;
     .

ha:hasRightsHolder a rdf:Property ;
    rdfs:domain ha:CreativeWork ;
    rdfs:label "has rights holder"@en, "heeft rechthebbende"@nl, "a pour titulaire de droits"@fr ;
    skos:definition "Identifies a person or organization owning or managing rights in an archival resource."@en, "Identificeert een persoon of organisatie die rechten op een archiefbron bezit of beheert."@nl, "Identifie une personne ou une organisation détenant ou gérant des droits sur une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dct:rightsHolder, schema:copyrightHolder ;
    rdfs:range ha:Agent ;
     .

ha:hasCopyrightNotice a rdf:Property ;
    rdfs:label "has copyright notice"@en, "heeft auteursrechtvermelding"@nl, "a pour mention de droit d’auteur"@fr ;
    skos:definition "Provides the copyright notice associated with an archival work."@en, "Geeft de auteursrechtvermelding die bij een archiefwerk hoort."@nl, "Fournit la mention de droit d’auteur associée à une œuvre archivée."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:copyrightNotice ;
    owl:equivalentProperty ha:hasRights ;
     .

ha:hasCreationDate a rdf:Property ;
    rdfs:label "has creation date"@en, "heeft creatiedatum"@nl, "a pour date de création"@fr ;
    skos:definition "Records when an archival resource, representation or metadata record was created."@en, "Legt vast wanneer een archiefbron, representatie of metadatarecord is gemaakt."@nl, "Consigne la date de création d’une ressource archivistique, d’une représentation ou d’une notice de métadonnées."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:dateCreated, dct:created ;
    rdfs:subPropertyOf ha:hasDate ;
     .

ha:hasCreationLocation a rdf:Property ;
    rdfs:domain ha:CreativeWork; 
    rdfs:range ha:Place;
    rdfs:label "has creation location"@en, "heeft creatieplaats"@nl, "a pour lieu de création"@fr ;
    skos:definition "Identifies the place where a work was created, which may differ from the place depicted."@en, "Identificeert de plaats waar een werk is gemaakt, die kan verschillen van de afgebeelde plaats."@nl, "Identifie le lieu de création d’une œuvre, qui peut différer du lieu représenté."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:locationCreated ;
     .

ha:hasCreditText a rdf:Property ;
    rdfs:label "has credit text"@en, "heeft creditvermelding"@nl, "a pour texte de crédit"@fr ;
    skos:definition "Provides text acknowledging people or organizations associated with an archival work."@en, "Geeft tekst die personen of organisaties vermeldt die bij een archiefwerk betrokken zijn."@nl, "Fournit un texte mentionnant les personnes ou organisations associées à une œuvre archivée."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:creditText ;
     .

ha:hasDeathDate a rdf:Property ;
    rdfs:label "has death date"@en, "heeft overlijdensdatum"@nl, "a pour date de décès"@fr ;
    skos:definition "Records the date on which a person died."@en, "Legt de datum vast waarop een persoon is overleden."@nl, "Consigne la date de décès d’une personne."@fr ;
    rdfs:domain ha:Person ;
    rdfs:isDefinedBy ha: ;
    rdfs:range edtf:EDTF-level1 ;
    rdfs:seeAlso schema:deathDate ;
     .

ha:hasDeathPlace a rdf:Property ;
    rdfs:domain ha:Person ;
    rdfs:label "has place of death"@en, "heeft overlijdensplaats"@nl, "a pour lieu de décès"@fr ;
    skos:definition "Specifies the place where a person died."@en, "Geeft de plaats aan waar een persoon is overleden."@nl, "Indique le lieu de décès d’une personne."@fr ;
    rdfs:seeAlso schema:deathPlace ;
    rdfs:range ha:Place
     .

ha:hasDeletionDate a rdf:Property ;
    rdfs:label "has deletion date"@en, "heeft verwijderingsdatum"@nl, "a pour date de suppression"@fr ;
    skos:definition "Records when an item or metadata record was removed from a feed or asset management system."@en, "Legt vast wanneer een item of metadatarecord uit een feed of assetbeheersysteem is verwijderd."@nl, "Consigne la date de suppression d’un élément ou d’une notice de métadonnées dans un flux ou un système de gestion de ressources."@fr ;
    rdfs:domain ha:MediahavenFragment ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso schema:dateDeleted ;
     .

ha:hasDepth a rdf:Property ;
    rdfs:label "has depth"@en, "heeft diepte"@nl, "a pour profondeur"@fr ;
    skos:definition "Specifies the physical depth of a resource or carrier as a measurement with a unit."@en, "Geeft de fysieke diepte van een bron of drager aan als een meting met een eenheid."@nl, "Indique la profondeur physique d’une ressource ou d’un support sous forme de mesure avec une unité."@fr ;
    rdfs:domain [ owl:unionOf ( ha:CreativeWork ha:PhysicalCarrier ) ];
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:QuantitativeValue ;
    rdfs:seeAlso schema:depth ;
     .

# Suggested rdfs:range xsd:duration (not asserted).
# Modeling review: equivalence with ha:hasExtent conflates playback duration with physical extent or size; consider duration as a subproperty of extent instead.
ha:hasDuration a rdf:Property ;
    rdfs:label "has duration"@en, "heeft duur"@nl, "a pour durée"@fr ;
    skos:definition "Records the playback duration of archival media, expressed as a duration rather than a calendar date."@en, "Legt de afspeelduur van archiefmedia vast, uitgedrukt als tijdsduur in plaats van als kalenderdatum."@nl, "Consigne la durée de lecture d’un média archivé, exprimée comme une durée plutôt que comme une date calendaire."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:duration ;
    owl:equivalentProperty ha:hasExtent ;
     .

# Range/type review: local SHACL uses a skos:Concept for newspaper editions, but this is an owl:DatatypeProperty; choose resource or literal values and align both files.
ha:hasEdition a rdf:Property, owl:DatatypeProperty ;
    rdfs:label "has edition designation"@en, "heeft editieaanduiding"@nl, "a pour mention d’édition"@fr ;
    skos:definition "Specifies the edition designation of a publication or classification scheme."@en, "Geeft de editieaanduiding van een publicatie of classificatieschema aan."@nl, "Indique la mention d’édition d’une publication ou d’un schéma de classification."@fr ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/edition> ;
     .

# Domain review: ha:ContactPoint and ha:Person should be alternatives if either can carry an email address.
# Review domains: multiple rdfs:domain values are cumulative, not alternatives; use a class union for resource alternatives or SHACL for mixed literal/resource choices.
ha:hasEmail a rdf:Property ;
    rdfs:label "has email address"@en, "heeft e-mailadres"@nl, "a pour adresse électronique"@fr ;
    skos:definition "Specifies an email address for a person or contact point."@en, "Geeft een e-mailadres voor een persoon of contactpunt aan."@nl, "Indique une adresse électronique pour une personne ou un point de contact."@fr ;
    rdfs:domain ha:ContactPoint, ha:Person ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:email ;
     .

# Suggested rdfs:domain ha:MediaFragment; rdfs:range xsd:duration (not asserted).
# URI/range review: consider ha:hasEndOffset; local SHACL uses xsd:time, but an elapsed offset may exceed 24 hours.
ha:hasEndTime a rdf:Property ;
    rdfs:label "has media end offset"@en, "heeft media-eindpositie"@nl, "a pour position temporelle de fin"@fr ;
    skos:definition "Records the temporal end position of a media fragment relative to the start of its source media."@en, "Legt de temporele eindpositie van een mediafragment vast ten opzichte van het begin van de bronmedia."@nl, "Consigne la position temporelle de fin d’un fragment de média par rapport au début du média source."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:endTime ;
     .

ha:hasExecutor a rdf:Property ;
    rdfs:label "has performer"@en, "heeft uitvoerder"@nl, "a pour interprète"@fr ;
    skos:definition "Identifies the person or organization performing a work, directly or through a role describing the performance."@en, "Identificeert de persoon of organisatie die een werk uitvoert, rechtstreeks of via een rol die de uitvoering beschrijft."@nl, "Identifie la personne ou l’organisation qui interprète une œuvre, directement ou au moyen d’un rôle décrivant l’interprétation."@fr ;
    rdfs:domain [
        owl:unionOf (
            ha:CreativeWork
            ha:Role
        ) ;
    ] ;
    rdfs:isDefinedBy ha: ;
    rdfs:range [
        owl:unionOf (
            ha:Person
            ha:Organization
            ha:Role
        ) ;
    ] ;
     .

ha:hasFamilyName a rdf:Property ;
    rdfs:label "has family name"@en, "heeft familienaam"@nl, "a pour nom de famille"@fr ;
    skos:definition "Provides a person’s family name."@en, "Geeft de familienaam van een persoon."@nl, "Fournit le nom de famille d’une personne."@fr ;
    rdfs:domain ha:Person ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:familyName ;
     .

ha:hasGenre a rdf:Property ;
    rdfs:label "has genre"@en, "heeft genre"@nl, "a pour genre"@fr ;
    skos:definition "Specifies the genre of an archived creative work."@en, "Geeft het genre van een gearchiveerd creatief werk aan."@nl, "Indique le genre d’une œuvre de création archivée."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:genre ;
     .

# Suggested rdfs:range xsd:string (not asserted).
ha:hasGivenName a rdf:Property ;
    rdfs:label "has given name"@en, "heeft voornaam"@nl, "a pour prénom"@fr ;
    skos:definition "Provides a person’s given name."@en, "Geeft de voornaam van een persoon."@nl, "Fournit le prénom d’une personne."@fr ;
    rdfs:domain ha:Person ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:givenName ;
     .

ha:hasHeight a rdf:Property ;
    rdfs:label "has height"@en, "heeft hoogte"@nl, "a pour hauteur"@fr ;
    skos:definition "Records the height of a resource, carrier, image or spatial fragment, with a unit where needed."@en, "Legt de hoogte vast van een bron, drager, beeld of ruimtelijk fragment, waar nodig met een eenheid."@nl, "Consigne la hauteur d’une ressource, d’un support, d’une image ou d’un fragment spatial, avec une unité si nécessaire."@fr ;
    rdfs:domain [ owl:unionOF ( ha:CreativeWork ha:MediaFragment ha:PhysicalCarrier ) ];
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:QuantitativeValue ;
    rdfs:seeAlso ebucore:height, schema:height ;
     .

ha:hasHomepage a rdf:Property ;
    rdfs:label "has homepage"@en, "heeft startpagina"@nl, "a pour page d’accueil"@fr ;
    skos:definition "Identifies the main web page of an organization or other described entity."@en, "Identificeert de voornaamste webpagina van een organisatie of andere beschreven entiteit."@nl, "Identifie la page web principale d’une organisation ou d’une autre entité décrite."@fr ;
    rdfs:domain ha:Thing ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:anyURI ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/homepage> ;
     .

ha:hasIEC60094Type a rdf:Property ;
    rdfs:label "has IEC 60094 cassette type"@en, "heeft IEC 60094-cassettetype"@nl, "a pour type de cassette CEI 60094"@fr ;
    skos:definition "Classifies the magnetic tape formulation of a compact cassette according to IEC 60094."@en, "Classificeert de magneetbandsamenstelling van een compactcassette volgens IEC 60094."@nl, "Classe la formulation de la bande magnétique d’une cassette compacte selon la CEI 60094."@fr ;
    rdfs:domain ha:PhysicalCarrier ;
    rdfs:isDefinedBy ha: ;
    rdfs:range skos:Concept ;
     .

ha:hasInstrument a rdf:Property ;
    rdfs:domain premis:Event; 
    rdfs:range premis:HardwareAgent ;
    rdfs:label "has instrument"@en, "heeft instrument"@nl, "a pour instrument"@fr ;
    skos:definition "Identifies equipment used in carrying out a preservation event, such as a scanner or playback device."@en, "Identificeert apparatuur die bij een bewaringsgebeurtenis wordt gebruikt, zoals een scanner of afspeeltoestel."@nl, "Identifie un équipement utilisé lors d’un événement de conservation, tel qu’un scanner ou un appareil de lecture."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:instrument ;
     .

ha:hasIssuance a rdf:Property, owl:ObjectProperty ;
    rdfs:domain ha:PublicationIssue ;
    rdfs:label "has mode of issuance"@en, "heeft publicatiewijze"@nl, "a pour mode de parution"@fr ;
    skos:definition "Classifies how a resource is issued, updated and intended to continue or terminate."@en, "Classificeert hoe een bron verschijnt, wordt bijgewerkt en bedoeld is voort te duren of te eindigen."@nl, "Classe le mode de parution et de mise à jour d’une ressource ainsi que sa continuité ou sa fin prévue."@fr ;
    rdfs:range ha:Issuance ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/issuance> ;
     .

# Suggested rdfs:domain ha:PublicationIssue; rdfs:range rdfs:Literal (not asserted).
ha:hasIssueNumber a rdf:Property ;
    rdfs:domain ha:PublicationIssue ;
    rdfs:label "has issue number"@en, "heeft afleveringsnummer"@nl, "a pour numéro de parution"@fr ;
    skos:definition "Provides the designation identifying an issue within a serial publication, which may be numeric or textual."@en, "Geeft de numerieke of tekstuele aanduiding waarmee een aflevering binnen een seriële publicatie wordt geïdentificeerd."@nl, "Fournit la désignation numérique ou textuelle identifiant un numéro au sein d’une publication en série."@fr ;
    rdfs:seeAlso schema:issueNumber, <http://purl.org/ontology/bibo/issue> ;
    rdfs:subPropertyOf ha:hasPosition ;
    
     .

ha:hasKeywords a rdf:Property ;
    rdfs:label "has keyword"@en, "heeft trefwoord"@nl, "a pour mot-clé"@fr ;
    skos:definition "Provides a keyword or tag describing the content of an archival work."@en, "Geeft een trefwoord of tag die de inhoud van een archiefwerk beschrijft."@nl, "Fournit un mot-clé ou une étiquette décrivant le contenu d’une œuvre archivée."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:keywords ;
    owl:equivalentProperty ha:hasSubject ;
     .

# Value review: use BCP 47 tags consistently for literal language codes, including captions and transcripts.
ha:hasLanguage a rdf:Property ;
    rdfs:label "has language"@en, "heeft taal"@nl, "a pour langue"@fr ;
    skos:definition "Specifies a language used in the content, performance, transcript or captions of an archival resource."@en, "Geeft een taal aan die in de inhoud, uitvoering, transcriptie of ondertiteling van een archiefbron wordt gebruikt."@nl, "Indique une langue utilisée dans le contenu, l’interprétation, la transcription ou le sous-titrage d’une ressource archivistique."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:inLanguage ;
     .

ha:hasLicense a rdf:Property ;
    rdfs:label "has licence"@en, "heeft licentie"@nl, "a pour licence"@fr ;
    skos:definition "Identifies a licence or licensing document stating permissions for use of an archival resource."@en, "Identificeert een licentie of licentiedocument met toestemmingen voor het gebruik van een archiefbron."@nl, "Identifie une licence ou un document de licence précisant les autorisations d’utilisation d’une ressource archivistique."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range [
        owl:unionOf (
            ha:Thing
            skos:Concept
        ) ;
    ] ;
    rdfs:seeAlso dct:license, schema:license ;
    rdfs:subPropertyOf ha:hasRights ;
    owl:equivalentProperty ha:hasAccessRights ;
     .

# URI/meaning review: consider ha:hasLicensor if the value grants the licence; confirm whether a separate distributor role is needed.
ha:hasLicenseDistributor a rdf:Property ;
    rdfs:label "has licensor"@en, "heeft licentiegever"@nl, "a pour donneur de licence"@fr ;
    skos:definition "Identifies the person or organization granting a licence for an archived intellectual entity."@en, "Identificeert de persoon of organisatie die een licentie verleent voor een gearchiveerde intellectuele entiteit."@nl, "Identifie la personne ou l’organisation qui accorde une licence pour une entité intellectuelle archivée."@fr ;
    rdfs:domain premis:IntellectualEntity ;
    rdfs:isDefinedBy ha: ;
    rdfs:range [
        owl:unionOf (
            ha:Person
            ha:Organization
        ) ;
    ] ;
     .

ha:hasLogo a rdf:Property ;
    rdfs:label "has logo"@en, "heeft logo"@nl, "a pour logo"@fr ;
    skos:definition "Identifies the logo used to represent an organization."@en, "Identificeert het logo waarmee een organisatie wordt voorgesteld."@nl, "Identifie le logo utilisé pour représenter une organisation."@fr ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Logo ;
    rdfs:seeAlso schema:logo ;
    rdfs:subPropertyOf ha:hasImage ;
     .

# Suggested rdfs:range ha:Agent (not asserted).
ha:hasMaintainer a rdf:Property ;
    rdfs:label "has maintainer"@en, "heeft beheerder"@nl, "a pour responsable de gestion"@fr ;
    skos:definition "Identifies the person or organization responsible for maintaining an archival resource or managing its contributions and publication."@en, "Identificeert de persoon of organisatie die verantwoordelijk is voor het onderhoud van een archiefbron of het beheer van bijdragen en publicatie."@nl, "Identifie la personne ou l’organisation responsable de la maintenance d’une ressource archivistique ou de la gestion de ses contributions et de sa publication."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:maintainer ;
     .

# Suggested rdfs:domain ha:PhysicalCarrier; rdfs:range rdfs:Literal (not asserted).
ha:hasMaterial a rdf:Property ;
    rdfs:label "has material"@en, "heeft materiaal"@nl, "a pour matériau"@fr ;
    skos:definition "Describes the material from which a physical carrier or archival object is made."@en, "Beschrijft het materiaal waaruit een fysieke drager of archiefobject is gemaakt."@nl, "Décrit le matériau dont est constitué un support physique ou un objet archivistique."@fr ;
    rdfs:seeAlso schema:material ;
     .

# Suggested rdfs:domain ha:PhysicalCarrier; rdfs:range rdfs:Literal (not asserted).
ha:hasMaterialExtent a rdf:Property ;
    rdfs:label "has physical extent"@en, "heeft fysieke omvang"@nl, "a pour étendue matérielle"@fr ;
    skos:definition "Describes the physical extent or quantity of a carrier, such as a number of volumes, sheets or reels."@en, "Beschrijft de fysieke omvang of hoeveelheid van een drager, zoals een aantal banden, bladen of spoelen."@nl, "Décrit l’étendue ou la quantité matérielle d’un support, telle qu’un nombre de volumes, de feuilles ou de bobines."@fr ;
    rdfs:seeAlso schema:materialExtent ;
     .

# Suggested rdfs:domain ha:MediaResource (not asserted).
ha:hasMediaFragment a rdf:Property ;
    rdfs:label "has media fragment"@en, "heeft mediafragment"@nl, "a pour fragment de média"@fr ;
    skos:definition "Identifies a spatial or temporal segment within a media resource."@en, "Identificeert een ruimtelijk of temporeel segment binnen een mediabron."@nl, "Identifie un segment spatial ou temporel au sein d’une ressource médiatique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:MediaFragment ;
    rdfs:seeAlso ebucore:hasMediaFragment ;
    owl:equivalentProperty ha:hasFragment ;
    owl:inverseOf ha:isMediaFragmentOf ;
     .

ha:hasMimeType a rdf:Property ;
    rdfs:label "has MIME type"@en, "heeft MIME-type"@nl, "a pour type MIME"@fr ;
    skos:definition "Specifies the Internet media type of a digital file, such as audio/wav."@en, "Geeft het internetmediatype van een digitaal bestand aan, zoals audio/wav."@nl, "Indique le type de média Internet d’un fichier numérique, tel que audio/wav."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string;
    rdfs:seeAlso ebucore:hasMimeType ;
    rdfs:subPropertyOf ha:hasFormat ;
     .

# Suggested rdfs:range xsd:boolean (not asserted).
ha:hasMissingAudioReels a rdf:Property ;
    rdfs:label "has missing audio reels"@en, "heeft ontbrekende geluidsspoelen"@nl, "a des bobines sonores manquantes"@fr ;
    skos:definition "Indicates whether sound reels were missing from a film’s carrier representation before digitization."@en, "Geeft aan of er vóór digitalisering geluidsspoelen in de dragerrepresentatie van een film ontbraken."@nl, "Indique si des bobines sonores manquaient dans la représentation sur support d’un film avant sa numérisation."@fr ;
    rdfs:domain ha:CarrierRepresentation ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
     .

# Suggested rdfs:range xsd:boolean (not asserted).
ha:hasMissingImageReels a rdf:Property ;
    rdfs:label "has missing image reels"@en, "heeft ontbrekende beeldspoelen"@nl, "a des bobines image manquantes"@fr ;
    skos:definition "Indicates whether image reels were missing from a film’s carrier representation before digitization."@en, "Geeft aan of er vóór digitalisering beeldspoelen in de dragerrepresentatie van een film ontbraken."@nl, "Indique si des bobines image manquaient dans la représentation sur support d’un film avant sa numérisation."@fr ;
    rdfs:domain ha:CarrierRepresentation ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
     .

# Suggested rdfs:range rdfs:Literal (not asserted).
ha:hasModel a rdf:Property ;
    rdfs:label "has model"@en, "heeft model"@nl, "a pour modèle"@fr ;
    skos:definition "Specifies the model designation of equipment or software used in the preservation environment."@en, "Geeft de modelaanduiding van apparatuur of software in de bewaringsomgeving aan."@nl, "Indique la désignation du modèle d’un équipement ou d’un logiciel utilisé dans l’environnement de conservation."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:model ;
     .

ha:hasModificationDate a rdf:Property ;
    rdfs:label "has modification date"@en, "heeft wijzigingsdatum"@nl, "a pour date de modification"@fr ;
    skos:definition "Records when an archival resource or metadata record was last modified."@en, "Legt vast wanneer een archiefbron of metadatarecord voor het laatst is gewijzigd."@nl, "Consigne la date de dernière modification d’une ressource archivistique ou d’une notice de métadonnées."@fr ;
    rdfs:domain [ owl:unionOf ( ha:CreativeWork ha:MediahavenFragment )];
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso schema:dateModified ;
     .

ha:hasName a rdf:Property ;
    rdfs:label "has name"@en, "heeft naam"@nl, "a pour nom"@fr ;
    skos:definition "Provides the name of an entity described in the archive."@en, "Geeft de naam van een in het archief beschreven entiteit."@nl, "Fournit le nom d’une entité décrite dans les archives."@fr ;
    rdfs:domain ha:Thing ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:name ;
    owl:equivalentProperty ha:hasTitle ;
     .

# Suggested rdfs:range xsd:nonNegativeInteger (not asserted).
ha:hasNumberOfAudioChannels a rdf:Property ;
    rdfs:label "has number of audio channels"@en, "heeft aantal audiokanalen"@nl, "a pour nombre de canaux audio"@fr ;
    skos:definition "Records the number of parallel audio channels in a representation’s audio content."@en, "Legt het aantal parallelle audiokanalen in de audio-inhoud van een representatie vast."@nl, "Consigne le nombre de canaux audio parallèles dans le contenu sonore d’une représentation."@fr ;
    rdfs:domain ha:CarrierRepresentation ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
     .

# Suggested rdfs:range xsd:nonNegativeInteger (not asserted).
ha:hasNumberOfAudioTracks a rdf:Property ;
    rdfs:label "has number of audio tracks"@en, "heeft aantal audiosporen"@nl, "a pour nombre de pistes audio"@fr ;
    skos:definition "Records the number of audio tracks in a representation."@en, "Legt het aantal audiosporen in een representatie vast."@nl, "Consigne le nombre de pistes audio d’une représentation."@fr ;
    rdfs:domain ha:CarrierRepresentation ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
     .

# Suggested rdfs:range xsd:nonNegativeInteger (not asserted).
ha:hasNumberOfMissingAudioReels a rdf:Property ;
    rdfs:label "has number of missing audio reels"@en, "heeft aantal ontbrekende geluidsspoelen"@nl, "a pour nombre de bobines sonores manquantes"@fr ;
    skos:definition "Records how many sound reels were missing from a film’s carrier representation before digitization."@en, "Legt vast hoeveel geluidsspoelen vóór digitalisering in de dragerrepresentatie van een film ontbraken."@nl, "Consigne le nombre de bobines sonores manquant dans la représentation sur support d’un film avant sa numérisation."@fr ;
    rdfs:domain ha:CarrierRepresentation ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
     .

# Suggested rdfs:range xsd:nonNegativeInteger (not asserted).
ha:hasNumberOfMissingImageReels a rdf:Property ;
    rdfs:label "has number of missing image reels"@en, "heeft aantal ontbrekende beeldspoelen"@nl, "a pour nombre de bobines image manquantes"@fr ;
    skos:definition "Records how many image reels were missing from a film’s carrier representation before digitization."@en, "Legt vast hoeveel beeldspoelen vóór digitalisering in de dragerrepresentatie van een film ontbraken."@nl, "Consigne le nombre de bobines image manquant dans la représentation sur support d’un film avant sa numérisation."@fr ;
    rdfs:domain ha:CarrierRepresentation ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
     .

# Suggested rdfs:range xsd:nonNegativeInteger (not asserted).
ha:hasNumberOfReels a rdf:Property ;
    rdfs:label "has number of reels"@en, "heeft aantal spoelen"@nl, "a pour nombre de bobines"@fr ;
    skos:definition "Records the total number of film reels, including image and sound reels, in a film’s carrier representation."@en, "Legt het totale aantal filmspoelen vast, met inbegrip van beeld- en geluidsspoelen, in de dragerrepresentatie van een film."@nl, "Consigne le nombre total de bobines de film, y compris les bobines image et sonores, dans la représentation sur support d’un film."@fr ;
    rdfs:domain ha:CarrierRepresentation ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
     .

# Range review: choose a literal category or a ha:ObjectType controlled resource; do not assert their intersection.
# Review ranges: multiple rdfs:range values are cumulative, not alternatives; use a class union for resource alternatives or SHACL for mixed literal/resource choices.
ha:hasObjectType a rdf:Property ;
    rdfs:label "has object type"@en, "heeft objecttype"@nl, "a pour type d’objet"@fr ;
    skos:definition "Classifies the kind of archival content, such as a programme, clip, book or report."@en, "Classificeert het soort archiefinhoud, zoals een programma, fragment, boek of rapport."@nl, "Classe le type de contenu archivistique, tel qu’une émission, un extrait, un livre ou un rapport."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:anyURI, xsd:string, ha:ObjectType ;
    rdfs:seeAlso ebucore:hasObjectType ;
     .

ha:hasOutput a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has output"@en, "heeft uitvoerobject"@nl, "a pour objet produit"@fr ;
    skos:definition "Identifies a preservation object produced by an event; the event is the subject and its output object is the value."@en, "Identificeert een bewaringsobject dat door een gebeurtenis is voortgebracht; de gebeurtenis is het onderwerp en het uitvoerobject is de waarde."@nl, "Identifie un objet de conservation produit par un événement ; l’événement est le sujet et l’objet produit est la valeur."@fr ;
    rdfs:domain premis:Event ;
    rdfs:isDefinedBy ha: ;
    rdfs:range premis:Object ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventRelatedObjectRole/out> ;
    rdfs:subPropertyOf prov:generated ;
     .

# Suggested rdfs:range ha:Agent (not asserted).
ha:hasOwner a rdf:Property ;
    rdfs:label "has owner"@en, "heeft eigenaar"@nl, "a pour propriétaire"@fr ;
    skos:definition "Identifies the person or organization owning an archival resource, independently of copyright ownership."@en, "Identificeert de persoon of organisatie die eigenaar is van een archiefbron, onafhankelijk van het auteursrecht."@nl, "Identifie la personne ou l’organisation propriétaire d’une ressource archivistique, indépendamment de la titularité du droit d’auteur."@fr ;
     .

ha:hasPageNumber a rdf:Property ;
    rdfs:label "has page number"@en, "heeft paginanummer"@nl, "a pour numéro de page"@fr ;
    skos:definition "Specifies the position of a newspaper page within its newspaper issue."@en, "Geeft de positie van een krantenpagina binnen haar kranteneditie aan."@nl, "Indique la position d’une page de journal dans son numéro."@fr ;
    rdfs:domain ha:NewspaperIssuePage ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ha:hasPosition ;
     .

ha:hasPart a rdf:Property ;
    rdfs:label "has part"@en, "heeft onderdeel"@nl, "a pour partie"@fr ;
    skos:definition "Identifies a resource forming part of the described work, collection or archival unit."@en, "Identificeert een bron die deel uitmaakt van het beschreven werk, de collectie of de archiefeenheid."@nl, "Identifie une ressource faisant partie de l’œuvre, de la collection ou de l’unité archivistique décrite."@fr ;
    rdfs:seeAlso schema:hasPart ;
    
     .

# Suggested rdfs:domain ha:PostalAddress; rdfs:range xsd:string (not asserted).
ha:hasPostOfficeBoxNumber a rdf:Property ;
    rdfs:label "has post office box number"@en, "heeft postbusnummer"@nl, "a pour numéro de boîte postale"@fr ;
    skos:definition "Specifies the post office box number in a postal address."@en, "Geeft het postbusnummer in een postadres aan."@nl, "Indique le numéro de boîte postale dans une adresse postale."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:postOfficeBoxNumber ;
     .

# Suggested rdfs:domain ha:PostalAddress; rdfs:range xsd:string (not asserted).
ha:hasPostalCode a rdf:Property ;
    rdfs:label "has postal code"@en, "heeft postcode"@nl, "a pour code postal"@fr ;
    skos:definition "Specifies the postal code of a postal address."@en, "Geeft de postcode van een postadres aan."@nl, "Indique le code postal d’une adresse postale."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:postalCode ;
     .

ha:hasPreference a rdf:Property ;
    rdfs:label "has service preference"@en, "heeft dienstverleningsvoorkeur"@nl, "a pour préférence de service"@fr ;
    skos:definition "Records an organization’s preference concerning a service performed with or by meemoo."@en, "Legt de voorkeur van een organisatie vast voor een dienst die samen met of door meemoo wordt uitgevoerd."@nl, "Consigne la préférence d’une organisation concernant un service réalisé avec ou par meemoo."@fr ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy ha: ;
    rdfs:range skos:Concept ;
     .

# Suggested rdfs:domain premis:Object; rdfs:range premis:Object (not asserted).
ha:hasPreservationPart a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has preservation part"@en, "heeft bewaringsonderdeel"@nl, "a pour partie de conservation"@fr ;
    skos:definition "Relates a preservation object to a component in the same PREMIS object category, such as a DVD to one of its chapters."@en, "Verbindt een bewaringsobject met een onderdeel binnen dezelfde PREMIS-objectcategorie, zoals een dvd met een van zijn hoofdstukken."@nl, "Relie un objet de conservation à un composant de la même catégorie d’objet PREMIS, tel qu’un DVD à l’un de ses chapitres."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/hsp> ;
    rdfs:subPropertyOf premis:relationship ;
     .

# Suggested rdfs:domain ha:PhysicalCarrier; rdfs:range skos:Concept (not asserted).
ha:hasPreservationProblem a rdf:Property ;
    rdfs:label "has preservation problem"@en, "heeft bewaringsprobleem"@nl, "a pour problème de conservation"@fr ;
    skos:definition "Identifies a condition or defect of a physical carrier that affects its preservation or digitization."@en, "Identificeert een toestand of defect van een fysieke drager dat de bewaring of digitalisering beïnvloedt."@nl, "Identifie un état ou un défaut d’un support physique qui affecte sa conservation ou sa numérisation."@fr ;
    rdfs:isDefinedBy ha: ;
     .

# Suggested rdfs:domain premis:Representation; rdfs:range premis:File (not asserted).
ha:hasPreservationRoot a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has rendering root file"@en, "heeft startbestand voor weergave"@nl, "a pour fichier racine de restitution"@fr ;
    skos:definition "Identifies the file that must be processed first to render a digital representation."@en, "Identificeert het bestand dat als eerste moet worden verwerkt om een digitale representatie weer te geven."@nl, "Identifie le fichier à traiter en premier pour restituer une représentation numérique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/hsr> ;
    rdfs:subPropertyOf premis:relationship ;
     .

# Suggested rdfs:domain premis:Object; rdfs:range premis:Object (not asserted).
ha:hasPreservationSource a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has preservation source"@en, "heeft bewaringsbron"@nl, "a pour source de conservation"@fr ;
    skos:definition "Relates a preservation object to the source object from which it was derived by a transformation."@en, "Verbindt een bewaringsobject met het bronobject waarvan het door een transformatie is afgeleid."@nl, "Relie un objet de conservation à l’objet source dont il est issu par transformation."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/hss> ;
    rdfs:subPropertyOf premis:relationship ;
     .

# Suggested rdfs:domain premis:IntellectualEntity (not asserted).
# Label review: this links to a local identifier resource, whereas ha:hasIdentifier provides a literal identifier.
ha:hasPrimaryIdentifier a rdf:Property ;
    rdfs:label "has primary local identifier"@en, "heeft primaire lokale identificatie"@nl, "a pour identifiant local principal"@fr ;
    skos:definition "Identifies the primary local identifier used for an intellectual entity in a content partner’s system."@en, "Identificeert de primaire lokale identificatie voor een intellectuele entiteit in het systeem van een contentpartner."@nl, "Identifie l’identifiant local principal d’une entité intellectuelle dans le système d’un partenaire de contenu."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:LocalIdentifier ;
    rdfs:subPropertyOf premis:identifier ;
     .

ha:hasPrimarySite a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has primary site"@en, "heeft hoofdvestiging"@nl, "a pour établissement principal"@fr ;
    skos:definition "Identifies the main site used to contact an organization, which need not be its legal headquarters."@en, "Identificeert de voornaamste vestiging om een organisatie te bereiken, die niet noodzakelijk haar maatschappelijke zetel is."@nl, "Identifie l’établissement principal permettant de contacter une organisation, qui ne correspond pas nécessairement à son siège légal."@fr ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Site ;
    rdfs:seeAlso <http://www.w3.org/ns/org#hasPrimarySite> ;
    rdfs:subPropertyOf ha:hasSite ;
     .

# Range review: local SHACL uses ha:Role; consider direct ha:Person/ha:Organization values alongside qualified roles only if needed.
ha:hasProducer a rdf:Property ;
    rdfs:label "has producer"@en, "heeft producent"@nl, "a pour producteur"@fr ;
    skos:definition "Identifies the person or organization producing a work, directly or through a role describing the production responsibility."@en, "Identificeert de persoon of organisatie die een werk produceert, rechtstreeks of via een rol die de productieverantwoordelijkheid beschrijft."@nl, "Identifie la personne ou l’organisation qui produit une œuvre, directement ou au moyen d’un rôle décrivant la responsabilité de production."@fr ;
    rdfs:seeAlso schema:producer ;
     .

# Suggested rdfs:domain ha:CarrierRepresentation (not asserted).
ha:hasProductionMethod a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has production method"@en, "heeft productiemethode"@nl, "a pour méthode de production"@fr ;
    skos:definition "Identifies the process used to produce a resource or its physical representation."@en, "Identificeert het proces waarmee een bron of haar fysieke representatie is vervaardigd."@nl, "Identifie le procédé utilisé pour produire une ressource ou sa représentation physique."@fr ;
    rdfs:range ha:BibframeProductionMethod ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/productionMethod> ;
     .

# Suggested rdfs:range rdfs:Literal (not asserted).
ha:hasPublicationDate a rdf:Property ;
    rdfs:label "has first publication date"@en, "heeft eerste publicatiedatum"@nl, "a pour date de première publication"@fr ;
    skos:definition "Records when an archived work was first published or broadcast."@en, "Legt vast wanneer een gearchiveerd werk voor het eerst is gepubliceerd of uitgezonden."@nl, "Consigne la date de première publication ou diffusion d’une œuvre archivée."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:datePublished ;
    owl:equivalentProperty ha:hasIssueDate ;
     .

ha:hasRecord a rdf:Property ;
    rdfs:label "has Mediahaven record"@en, "heeft Mediahavenrecord"@nl, "a pour notice Mediahaven"@fr ;
    skos:definition "Links a Mediahaven fragment record to its parent asset record."@en, "Verbindt een Mediahavenfragmentrecord met het bovenliggende assetrecord."@nl, "Relie une notice de fragment Mediahaven à la notice de sa ressource parente."@fr ;
    rdfs:domain ha:MediahavenFragment ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:MediahavenRecord ;
     .

# Suggested rdfs:range xsd:nonNegativeInteger (not asserted).
# URI/modeling review: consider ha:hasRegionX; remove the ha:hasAnnotationPurpose parent if this is solely a coordinate, and document pixels versus relative units.
# Review ranges: multiple rdfs:range values are cumulative, not alternatives; use a class union for resource alternatives or SHACL for mixed literal/resource choices.
ha:hasRegionDelimX a rdf:Property ;
    rdfs:label "has region x coordinate"@en, "heeft x-coördinaat van beeldregio"@nl, "a pour coordonnée x de région"@fr ;
    skos:definition "Records the horizontal coordinate of the top-left corner of a spatial media fragment."@en, "Legt de horizontale coördinaat van de linkerbovenhoek van een ruimtelijk mediafragment vast."@nl, "Consigne la coordonnée horizontale du coin supérieur gauche d’un fragment spatial de média."@fr ;
    rdfs:domain ha:MediaFragment ;
    rdfs:range xsd:anyURI, xsd:string ;
    rdfs:seeAlso ebucore:regionDelimX ;
    rdfs:subPropertyOf ha:hasAnnotationPurpose ;
     .

# Suggested rdfs:range xsd:nonNegativeInteger (not asserted).
# URI/modeling review: consider ha:hasRegionY; remove the ha:hasAnnotationPurpose parent if this is solely a coordinate, and document pixels versus relative units.
# Review ranges: multiple rdfs:range values are cumulative, not alternatives; use a class union for resource alternatives or SHACL for mixed literal/resource choices.
ha:hasRegionDelimY a rdf:Property ;
    rdfs:label "has region y coordinate"@en, "heeft y-coördinaat van beeldregio"@nl, "a pour coordonnée y de région"@fr ;
    skos:definition "Records the vertical coordinate of the top-left corner of a spatial media fragment."@en, "Legt de verticale coördinaat van de linkerbovenhoek van een ruimtelijk mediafragment vast."@nl, "Consigne la coordonnée verticale du coin supérieur gauche d’un fragment spatial de média."@fr ;
    rdfs:domain ha:MediaFragment ;
    rdfs:range xsd:anyURI, xsd:string ;
    rdfs:seeAlso ebucore:regionDelimY ;
    rdfs:subPropertyOf ha:hasAnnotationPurpose ;
     .

# URI/range review: consider ha:hasContentRequestForm and xsd:anyURI for URL literals, or use a form resource IRI.
ha:hasRequestForm a rdf:Property ;
    rdfs:label "has content request form"@en, "heeft aanvraagsformulier voor inhoud"@nl, "a pour formulaire de demande de contenu"@fr ;
    skos:definition "Provides the address of a form for requesting archival content from a content partner."@en, "Geeft het adres van een formulier om archiefinhoud bij een contentpartner aan te vragen."@nl, "Fournit l’adresse d’un formulaire permettant de demander du contenu archivistique à un partenaire de contenu."@fr ;
    rdfs:domain ha:ContentPartner ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
     .

ha:hasRoleType a rdf:Property ; # ! was ha:hasRoleName
    rdfs:label "has role type"@en, "heeft roltype"@nl, "a pour type de rôle"@fr ;
    skos:definition "Classifies a role by the function performed by its person or organization."@en, "Classificeert een rol volgens de functie die de betrokken persoon of organisatie vervult."@nl, "Classe un rôle selon la fonction exercée par la personne ou l’organisation concernée."@fr ;
    # ! replaced below my making post subclass of role
    # rdfs:domain [
    #     owl:unionOf (
    #         ha:Post
    #         ha:Role
    #     ) ;
    # ] ;
    rdfs:domain ha:Role ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:RoleType ;
    rdfs:seeAlso schema:roleName, <http://www.w3.org/ns/org#role> ;
     .

ha:hasEndDate a rdf:Property ;
    rdfs:label "has end date"@en, "heeft einddatum"@nl, "a pour date de fin"@fr ;
    skos:definition "Records the calendar date, optionally with a time, at which a described period, role or series ends."@en, "Legt de kalenderdatum vast, eventueel met tijdstip, waarop een beschreven periode, rol of reeks eindigt."@nl, "Consigne la date de fin d’une période, d’un rôle ou d’une série, éventuellement accompagnée d’une heure."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:dateTime;
    rdfs:seeAlso schema:endDate ;
     .

ha:hasStartDate a rdf:Property ;
    rdfs:label "has start date"@en, "heeft begindatum"@nl, "a pour date de début"@fr ;
    skos:definition "Records the calendar date, optionally with a time, at which a described period, role or series begins."@en, "Legt de kalenderdatum vast, eventueel met tijdstip, waarop een beschreven periode, rol of reeks begint."@nl, "Consigne la date de début d’une période, d’un rôle ou d’une série, éventuellement accompagnée d’une heure."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:dateTime;
    rdfs:seeAlso schema:startDate ;
     .

ha:hasUnitCode a rdf:Property ;
    rdfs:label "has unit code"@en, "heeft eenheidscode"@nl, "a pour code d’unité"@fr ;
    skos:definition "Specifies the unit of a measurement using a UN/CEFACT common unit code."@en, "Geeft de eenheid van een meting aan met een gemeenschappelijke UN/CEFACT-eenheidscode."@nl, "Indique l’unité d’une mesure au moyen d’un code d’unité commun de l’ONU/CEFACT."@fr ;
    rdfs:domain ha:QuantitativeValue ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:unitCode ;
     .

ha:hasUnitText a rdf:Property ;
    rdfs:label "has unit text"@en, "heeft eenheidstekst"@nl, "a pour libellé d’unité"@fr ;
    skos:definition "Provides a textual designation of the unit of a measurement."@en, "Geeft een tekstuele aanduiding van de eenheid van een meting."@nl, "Fournit une désignation textuelle de l’unité d’une mesure."@fr ;
    rdfs:domain ha:QuantitativeValue ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:unitText ;
     .

ha:hasMeasurementValue a rdf:Property ;
    rdfs:label "has measurement value"@en, "heeft meetwaarde"@nl, "a pour valeur de mesure"@fr ;
    skos:definition "Records the numeric component of a quantitative measurement, with its unit specified separately."@en, "Legt de numerieke component van een kwantitatieve meting vast, met de eenheid afzonderlijk opgegeven."@nl, "Consigne la composante numérique d’une mesure quantitative, dont l’unité est indiquée séparément."@fr ;
    rdfs:domain ha:QuantitativeValue ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:float ;
    rdfs:seeAlso schema:value ;
    rdfs:subPropertyOf rdf:value 
     .

ha:hasSeasonNumber a rdf:Property ;
    rdfs:label "has season number"@en, "heeft seizoensnummer"@nl, "a pour numéro de saison"@fr ;
    skos:definition "Specifies a season’s position within the ordered seasons of a media series."@en, "Geeft de positie van een seizoen binnen de geordende seizoenen van een mediareeks aan."@nl, "Indique la position d’une saison parmi les saisons ordonnées d’une série médiatique."@fr ;
    rdfs:domain ha:CreativeWorkSeason ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:seasonNumber ;
    rdfs:range [
        owl:unionOf (
            xsd:string
            xsd:integer
        ) ;
    ]
     .

ha:hasSector a rdf:Property ;
    rdfs:label "has sector"@en, "heeft sector"@nl, "a pour secteur"@fr ;
    skos:definition "Describes the sector in which an organization is active."@en, "Beschrijft de sector waarin een organisatie actief is."@nl, "Décrit le secteur dans lequel une organisation exerce ses activités."@fr ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
     .

ha:hasSerialNumber a rdf:Property ;
    rdfs:label "has serial number"@en, "heeft serienummer"@nl, "a pour numéro de série"@fr ;
    skos:definition "Records the serial number identifying a particular device or software installation in the preservation environment."@en, "Legt het serienummer vast dat een specifiek toestel of een software-installatie in de bewaringsomgeving identificeert."@nl, "Consigne le numéro de série identifiant un appareil ou une installation logicielle dans l’environnement de conservation."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:serialNumber ;
    rdfs:subPropertyOf ha:hasIdentifier ;
    rdfs:range xsd:string
     .

ha:hasSiteAddress a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has site address"@en, "heeft vestigingsadres"@nl, "a pour adresse d’établissement"@fr ;
    skos:definition "Identifies the address through which an organizational site can be located or contacted."@en, "Identificeert het adres waarmee een vestiging kan worden gevonden of gecontacteerd."@nl, "Identifie l’adresse permettant de localiser ou de contacter un établissement."@fr ;
    rdfs:domain ha:Site ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://www.w3.org/ns/org#siteAddress> ;
    rdfs:range ha:PostalAddress
     .

ha:hasEventInput a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has event input"@en, "heeft gebeurtenisinvoer"@nl, "a pour objet utilisé par l’événement"@fr ;
    skos:definition "Identifies a preservation object that existed before an event and was used as its input."@en, "Identificeert een bewaringsobject dat vóór een gebeurtenis bestond en als invoer is gebruikt."@nl, "Identifie un objet de conservation qui existait avant un événement et a été utilisé comme entrée de celui-ci."@fr ;
    rdfs:domain premis:Event ;
    rdfs:isDefinedBy ha: ;
    rdfs:range premis:Object ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventRelatedObjectRole/sou> ;
    rdfs:subPropertyOf prov:used ;
     .

ha:hasStartOffset a rdf:Property ; # ! was startTime
    rdfs:domain ha:MediaFragment ;
    rdfs:label "has media start offset"@en, "heeft media-beginpositie"@nl, "a pour position temporelle de début"@fr ;
    skos:definition "Records the temporal start position of a media fragment in seconds relative to the start of its source media."@en, "Legt de temporele beginpositie van een mediafragment in seconden vast ten opzichte van het begin van de bronmedia."@nl, "Consigne la position temporelle de début d’un fragment de média en secondes par rapport au début du média source."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:startOffset ;
    rdfs:range xsd:integer
     .

ha:hasStreetAddress a rdf:Property ;
    rdfs:domain ha:PostalAddress ;
    rdfs:label "has street address"@en, "heeft straatadres"@nl, "a pour adresse de voirie"@fr ;
    skos:definition "Specifies the street name and house number or equivalent delivery information in a postal address."@en, "Geeft de straatnaam en het huisnummer of gelijkwaardige bezorginformatie in een postadres aan."@nl, "Indique le nom de rue et le numéro ou des informations de distribution équivalentes dans une adresse postale."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:streetAddress ;
    rdfs:range xsd:string
     .

ha:hasSynopsis a rdf:Property ;
    rdfs:label "has synopsis"@en, "heeft synopsis"@nl, "a pour synopsis"@fr ;
    skos:definition "Provides a concise account of the narrative or content of an archival work."@en, "Geeft een beknopte beschrijving van het verhaal of de inhoud van een archiefwerk."@nl, "Fournit un aperçu concis du récit ou du contenu d’une œuvre archivée."@fr ;
    rdfs:range xsd:string ;
    rdfs:seeAlso ebucore:synopsis ;
    rdfs:subPropertyOf ha:hasDescription ;
     .

ha:hasTelephone a rdf:Property ;
    rdfs:label "has telephone number"@en, "heeft telefoonnummer"@nl, "a pour numéro de téléphone"@fr ;
    skos:definition "Specifies a telephone number for contacting a person, organization, place or contact point."@en, "Geeft een telefoonnummer om een persoon, organisatie, plaats of contactpunt te bereiken."@nl, "Indique un numéro de téléphone permettant de joindre une personne, une organisation, un lieu ou un point de contact."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:telephone ;
    rdfs:range xsd:string ;
     .

ha:hasTenantName a rdf:Property ;
    rdfs:label "has Mediahaven tenant name"@en, "heeft Mediahaventenantnaam"@nl, "a pour nom de tenant Mediahaven"@fr ;
    skos:definition "Records the name of an organization’s tenant in the Mediahaven system."@en, "Legt de naam van de tenant van een organisatie in het Mediahavensysteem vast."@nl, "Consigne le nom du tenant d’une organisation dans le système Mediahaven."@fr ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
     .

ha:hasThumbnailURL a rdf:Property ;
    rdfs:label "has thumbnail URL"@en, "heeft miniatuur-URL"@nl, "a pour URL de vignette"@fr ;
    skos:definition "Identifies the web address of a small preview image for an archival resource or file."@en, "Identificeert het webadres van een kleine voorbeeldafbeelding van een archiefbron of bestand."@nl, "Identifie l’adresse web d’une petite image d’aperçu d’une ressource archivistique ou d’un fichier."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:thumbnailUrl ;
    rdfs:range xsd:anyURI ;
    .

ha:hasTranscript a rdf:Property ;
    rdfs:label "has transcript"@en, "heeft transcriptie"@nl, "a pour transcription"@fr ;
    skos:definition "Provides a written rendering of spoken content in an audio or audiovisual resource."@en, "Geeft een schriftelijke weergave van gesproken inhoud in een audio- of audiovisuele bron."@nl, "Fournit une restitution écrite du contenu parlé d’une ressource audio ou audiovisuelle."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:transcript ;
     .

ha:hasUnit a rdf:Property, owl:ObjectProperty ;
    rdfs:domain ha:Organization ;
    rdfs:label "has organizational unit"@en, "heeft organisatie-eenheid"@nl, "a pour unité organisationnelle"@fr ;
    skos:definition "Identifies a department or other organizational unit forming part of an organization."@en, "Identificeert een afdeling of andere organisatie-eenheid die deel uitmaakt van een organisatie."@nl, "Identifie un département ou une autre unité organisationnelle faisant partie d’une organisation."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:OrganizationalUnit ;
    rdfs:seeAlso <http://www.w3.org/ns/org#hasUnit> ;
    rdfs:subPropertyOf ha:hasSubOrganization ;
     .

ha:hasVATID a rdf:Property ;
    rdfs:label "has VAT number"@en, "heeft btw-nummer"@nl, "a pour numéro de TVA"@fr ;
    skos:definition "Records the value added tax registration number of an organization."@en, "Legt het btw-registratienummer van een organisatie vast."@nl, "Consigne le numéro d’identification à la taxe sur la valeur ajoutée d’une organisation."@fr ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso schema:vatID ;
     .

ha:hasVersion a rdf:Property ;
    rdfs:label "has version"@en, "heeft versie"@nl, "a pour version"@fr ;
    skos:definition "Records the version designation of an archival work, device or software product."@en, "Legt de versieaanduiding van een archiefwerk, toestel of softwareproduct vast."@nl, "Consigne la désignation de version d’une œuvre archivée, d’un appareil ou d’un logiciel."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:version ;
    rdfs:range xsd:string
     .

ha:hasWidth a rdf:Property ;
    rdfs:label "has width"@en, "heeft breedte"@nl, "a pour largeur"@fr ;
    skos:definition "Records the width of a resource, carrier, image or spatial fragment, with a unit where needed."@en, "Legt de breedte vast van een bron, drager, beeld of ruimtelijk fragment, waar nodig met een eenheid."@nl, "Consigne la largeur d’une ressource, d’un support, d’une image ou d’un fragment spatial, avec une unité si nécessaire."@fr ;
    rdfs:domain [ owl:unionOf ( ha:CreativeWork ha:MediaFragment ha:PhysicalCarrier ) ];
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:QuantitativeValue ;
    rdfs:seeAlso ebucore:width, schema:width ;
     .

# Suggested rdfs:domain premis:Event; rdfs:range ha:Organization (not asserted).
# URI/direction review: consider ha:hasImplementingOrganization; local SHACL uses Event -> Organization.
ha:implements a rdf:Property ;
    rdfs:label "has implementing organization"@en, "heeft uitvoerende organisatie"@nl, "a pour organisation chargée de la mise en œuvre"@fr ;
    skos:definition "Identifies the organization responsible for carrying out a preservation event."@en, "Identificeert de organisatie die verantwoordelijk is voor het uitvoeren van een bewaringsgebeurtenis."@nl, "Identifie l’organisation responsable de la mise en œuvre d’un événement de conservation."@fr ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventRelatedAgentRole/imp> ;
     .

# Suggested rdfs:domain premis:Object; rdfs:range premis:Object (not asserted).
ha:includes a rdf:Property, owl:ObjectProperty ;
    rdfs:label "includes preservation component"@en, "omvat bewaringscomponent"@nl, "inclut un composant de conservation"@fr ;
    skos:definition "Relates a preservation object to a component in a different PREMIS object category, such as a representation to a file."@en, "Verbindt een bewaringsobject met een onderdeel uit een andere PREMIS-objectcategorie, zoals een representatie met een bestand."@nl, "Relie un objet de conservation à un composant d’une autre catégorie d’objet PREMIS, tel qu’une représentation à un fichier."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/inc> ;
    rdfs:subPropertyOf premis:relationship ;
     .

ha:isAbout a rdf:Property ;
    rdfs:label "is about"@en, "gaat over"@nl, "porte sur"@fr ;
    skos:definition "Identifies an entity that is a subject of an archived work’s content."@en, "Identificeert een entiteit die een onderwerp van de inhoud van een archiefwerk vormt."@nl, "Identifie une entité qui constitue un sujet du contenu d’une œuvre archivée."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Thing ;
    rdfs:seeAlso schema:about ;
     .

# URI review: consider ha:annotatesMediaResource; the subject is the annotation, not the annotated resource.
# Range review: local SHACL uses ha:MediaFragment; confirm the intended hierarchy with ha:MediaResource.
ha:isAnnotatedMediaResource a rdf:Property ;
    rdfs:label "annotates media resource"@en, "annoteert mediabron"@nl, "annote une ressource médiatique"@fr ;
    skos:definition "Relates an annotation to the media resource or fragment it annotates."@en, "Verbindt een annotatie met de mediabron of het fragment dat ze annoteert."@nl, "Relie une annotation à la ressource médiatique ou au fragment qu’elle annote."@fr ;
    rdfs:domain ha:Annotation ;
    rdfs:range ha:MediaResource ;
    rdfs:seeAlso ebucore:isAnnotatedMediaResource ;
     .

ha:isContainedInPlace a rdf:Property ;
    rdfs:label "is contained in place"@en, "ligt binnen plaats"@nl, "est situé dans un lieu"@fr ;
    skos:definition "Identifies the larger place that contains the described place."@en, "Identificeert de grotere plaats waarbinnen de beschreven plaats ligt."@nl, "Identifie le lieu plus vaste qui contient le lieu décrit."@fr ;
    rdfs:domain ha:Place ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Place ;
    rdfs:seeAlso schema:containedInPlace ;
     .

# Suggested rdfs:domain premis:Object; rdfs:range premis:Object (not asserted).
ha:isIncludedIn a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is included in preservation object"@en, "is opgenomen in bewaringsobject"@nl, "est inclus dans un objet de conservation"@fr ;
    skos:definition "Relates a preservation object to its containing object in a different PREMIS object category, such as a file to a representation."@en, "Verbindt een bewaringsobject met het omvattende object uit een andere PREMIS-objectcategorie, zoals een bestand met een representatie."@nl, "Relie un objet de conservation à l’objet qui le contient dans une autre catégorie d’objet PREMIS, tel qu’un fichier à une représentation."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/isi> ;
    rdfs:subPropertyOf premis:relationship ;
     .

ha:isMotivatedBy a rdf:Property ;
    rdfs:label "has access restriction reason"@en, "heeft reden voor toegangsbeperking"@nl, "a pour motif de restriction d’accès"@fr ;
    skos:definition "Relates an ODRL prohibition to the reason for restricting access to archival content."@en, "Verbindt een ODRL-verbod met de reden om de toegang tot archiefinhoud te beperken."@nl, "Relie une interdiction ODRL au motif de restriction d’accès à un contenu archivistique."@fr ;
    rdfs:domain odrl:Prohibition ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Motivation ;
     .

# URI/direction review: consider ha:immediatelyFollows; the value is the previous resource, not the next one.
ha:isNextInSequence a rdf:Property, owl:ObjectProperty ;
    rdfs:label "immediately follows in sequence"@en, "volgt onmiddellijk in volgorde"@nl, "suit immédiatement dans la séquence"@fr ;
    skos:definition "Relates an ordered resource to the resource immediately preceding it within the same sequence."@en, "Verbindt een geordende bron met de bron die er binnen dezelfde volgorde onmiddellijk aan voorafgaat."@nl, "Relie une ressource ordonnée à celle qui la précède immédiatement dans la même séquence."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://www.europeana.eu/schemas/edm/isNextInSequence> ;
    rdfs:subPropertyOf ha:hasRelation ;
     .

# Suggested rdfs:domain premis:Object; rdfs:range premis:Object (not asserted).
ha:isPreservationPartOf a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is preservation part of"@en, "is bewaringsonderdeel van"@nl, "fait partie d’un objet de conservation"@fr ;
    skos:definition "Relates a preservation object to its containing object in the same PREMIS object category, such as a newspaper page to its issue."@en, "Verbindt een bewaringsobject met het omvattende object binnen dezelfde PREMIS-objectcategorie, zoals een krantenpagina met haar editie."@nl, "Relie un objet de conservation à l’objet qui le contient dans la même catégorie d’objet PREMIS, tel qu’une page de journal à son numéro."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/isp> ;
    rdfs:subPropertyOf premis:relationship ;
     .

ha:isSiteOf a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is site of"@en, "is vestiging van"@nl, "est un établissement de"@fr ;
    skos:definition "Identifies an organization having a presence at the described site."@en, "Identificeert een organisatie die op de beschreven vestiging aanwezig is."@nl, "Identifie une organisation présente dans l’établissement décrit."@fr ;
    rdfs:domain ha:Site ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Organization ;
    rdfs:seeAlso <http://www.w3.org/ns/org#siteOf> ;
    owl:inverseOf ha:hasSite ;
     .

# Range review: local SHACL uses ha:Organization, while the ontology narrows this to ha:FormalOrganization; confirm legal-entity requirements.
ha:isUnitOf a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is organizational unit of"@en, "is organisatie-eenheid van"@nl, "est une unité organisationnelle de"@fr ;
    skos:definition "Identifies the organization of which the described unit forms part."@en, "Identificeert de organisatie waarvan de beschreven eenheid deel uitmaakt."@nl, "Identifie l’organisation dont l’unité décrite fait partie."@fr ;
    rdfs:domain ha:OrganizationalUnit ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:FormalOrganization ;
    rdfs:seeAlso <http://www.w3.org/ns/org#unitOf> ;
    rdfs:subPropertyOf ha:isSubOrganizationOf ;
     .

# Suggested rdfs:domain ha:CreativeWork; rdfs:range ha:Thing (not asserted).
ha:mentions a rdf:Property ;
    rdfs:label "mentions"@en, "vermeldt"@nl, "mentionne"@fr ;
    skos:definition "Identifies an entity referenced in an archival work without requiring that entity to be its main subject."@en, "Identificeert een entiteit die in een archiefwerk wordt vermeld zonder dat die het hoofdonderwerp hoeft te zijn."@nl, "Identifie une entité mentionnée dans une œuvre archivée sans qu’elle doive en constituer le sujet principal."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:mentions ;
     .

ha:metadataScopeOperand a owl:NamedIndividual, skos:Concept, odrl:LeftOperand ; # ! was metadataRangeOperand
    rdfs:label "metadata scope operand"@en, "Gamme de métadonnées"@fr, "Metadatabereik"@nl ;
    rdfs:isDefinedBy ha: ;
    skos:definition "The intended reach of the object's metadata. For example, whether it is about the full set of metadata or only a part."@en, "La portée prévue des métadonnées de l'objet.Par exemple, qu'il s'agisse de l'ensemble complet de métadonnées ou seulement une pièce."@fr, "Het beoogde bereik van de metadata van het object. Bijvoorbeeld, of het over de volledige set aan metadata gaat of slechts een deel."@nl ;
    skos:prefLabel "Metadata range"@en, "Gamme de métadonnées"@fr, "Metadatabereik"@nl ;
     .

ha:none a owl:NamedIndividual, skos:Concept ;
    rdfs:label "none"@en ;
    rdfs:isDefinedBy ha: ;
    skos:definition "Indicates that no value applies."@en, "Indique qu'aucune valeur ne s'applique."@fr, "Geeft aan dat er geen waarde van toepassing is."@nl ;
    skos:prefLabel "none"@en, "aucun"@fr, "geen"@nl ;
     .

ha:success a owl:NamedIndividual, skos:Concept ;
    rdfs:label "success"@en ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventOutcome/suc> ;
    skos:prefLabel "success" ;
     .

ha:warning a owl:NamedIndividual, skos:Concept ;
    rdfs:label "warning"@en ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventOutcome/war> ;
    ha:hasAuthoritativeLabel "warning" ;
     .

# Suggested rdfs:domain premis:Object; rdfs:range premis:Object (not asserted).
ha:supersedes a rdf:Property, owl:ObjectProperty ;
    rdfs:label "supersedes"@en, "vervangt"@nl, "remplace"@fr ;
    skos:definition "Relates a preservation environment object to the earlier environment object it replaces."@en, "Verbindt een bewaringsomgevingsobject met het eerdere omgevingsobject dat het vervangt."@nl, "Relie un objet d’environnement de conservation à l’objet d’environnement antérieur qu’il remplace."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/sup> ;
    rdfs:subPropertyOf premis:relationship ;
     .

ha:unknown a owl:NamedIndividual, skos:Concept ;
    rdfs:label "unknown"@en ;
    rdfs:isDefinedBy ha: ;
    skos:definition "Indicates that the value is unknown."@en, "Indique que la valeur est inconnue."@fr, "Geeft aan dat de waarde onbekend is."@nl ;
    skos:prefLabel "unknown"@en, "inconnu"@fr, "onbekend"@nl ;
     .

# URI review: consider ha:ProductionMethod; the local term need not encode the vocabulary from which it originated.
ha:BibframeProductionMethod a rdfs:Class, owl:Class ;
    rdfs:label "production method"@en, "productiemethode"@nl, "méthode de production"@fr ;
    skos:definition "A process used to produce an archival resource, such as printing or photocopying."@en, "Een proces waarmee een archiefbron wordt vervaardigd, zoals drukken of fotokopiëren."@nl, "Un procédé utilisé pour produire une ressource archivistique, tel que l’impression ou la photocopie."@fr ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/ProductionMethod> ;
     .

ha:Issuance a rdfs:Class, owl:Class ;
    rdfs:label "mode of issuance"@en, "publicatiewijze"@nl, "mode de parution"@fr ;
    skos:definition "A category describing whether a resource is issued in one or more parts, how it is updated and whether its publication is intended to end."@en, "Een categorie die beschrijft of een bron in één of meer delen verschijnt, hoe ze wordt bijgewerkt en of de publicatie een voorzien einde heeft."@nl, "Une catégorie décrivant si une ressource paraît en une ou plusieurs parties, son mode de mise à jour et si sa publication a une fin prévue."@fr ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/Issuance> ;
    rdfs:subClassOf skos:Concept
     .

# Axiom review: the self-referential subproperty/equivalence assertion is redundant and can be removed.
ha:hasAbstract a rdf:Property ;
    rdfs:label "has abstract"@en, "heeft samenvatting"@nl, "a pour résumé"@fr ;
    skos:definition "Provides a concise summary of an archival resource’s content."@en, "Geeft een beknopte samenvatting van de inhoud van een archiefbron."@nl, "Fournit un résumé concis du contenu d’une ressource archivistique."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso dct:abstract, schema:abstract ;
    rdfs:subPropertyOf ha:description, ha:hasDescription ;
    owl:equivalentProperty ha:hasAbstract ;
     .

# Suggested rdfs:domain premis:IntellectualEntity; rdfs:range ha:DigitalRepresentation (not asserted).
# URI/label review: consider ha:hasAccessRepresentation; the value is a representation with a role, rather than a single file copy.
ha:hasAccessCopy a rdf:Property ;
    rdfs:label "has access representation"@en, "heeft toegangsrepresentatie"@nl, "a pour représentation d’accès"@fr ;
    skos:definition "Relates an intellectual entity to a digital representation prepared for consultation by users."@en, "Verbindt een intellectuele entiteit met een digitale representatie die voor raadpleging door gebruikers is voorbereid."@nl, "Relie une entité intellectuelle à une représentation numérique préparée pour la consultation par les utilisateurs."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subPropertyOf ha:isRepresentedBy ;
    owl:inverseOf ha:isAccessCopyOf ;
     .

ha:hasAccessRights a rdf:Property ;
    rdfs:label "has access conditions"@en, "heeft toegangsvoorwaarden"@nl, "a pour conditions d’accès"@fr ;
    skos:definition "States who may access an archival resource and under which conditions."@en, "Geeft aan wie toegang tot een archiefbron mag krijgen en onder welke voorwaarden."@nl, "Indique qui peut accéder à une ressource archivistique et à quelles conditions."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dct:accessRights ;
    rdfs:subPropertyOf ha:hasRights ;
     .

ha:hasAccountManager a rdf:Property ;
    rdfs:label "has account manager"@en, "heeft relatiebeheerder"@nl, "a pour gestionnaire de compte"@fr ;
    skos:definition "Identifies the person responsible for managing the relationship with an organization."@en, "Identificeert de persoon die verantwoordelijk is voor het relatiebeheer met een organisatie."@nl, "Identifie la personne responsable de la gestion de la relation avec une organisation."@fr ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Person ;
    owl:inverseOf ha:isAccountManagerOf ;
     .


ha:hasCarrierRepresentation a rdf:Property ; #! was ha:hasCarrierCopy
    rdfs:domain premis:IntellectualEntity; 
    rdfs:range ha:CarrierRepresentation ;
    rdfs:label "has carrier representation"@en, "heeft dragerrepresentatie"@nl, "a pour représentation sur support physique"@fr ;
    skos:definition "Relates an intellectual entity to a representation embodied on a physical carrier."@en, "Verbindt een intellectuele entiteit met een representatie op een fysieke drager."@nl, "Relie une entité intellectuelle à une représentation matérialisée sur un support physique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subPropertyOf ha:isRepresentedBy ;
    owl:inverseOf ha:isCarrierRepresentationOf ;
     .

ha:hasCopyrightDate a rdf:Property ;
    rdfs:domain ha:CreativeWork ;
    rdfs:label "has copyright date"@en, "heeft auteursrechtdatum"@nl, "a pour date de droit d’auteur"@fr ;
    skos:definition "Records a date associated with a copyright claim for an archival resource."@en, "Legt een datum vast die hoort bij een auteursrechtaanspraak op een archiefbron."@nl, "Consigne une date associée à une revendication de droit d’auteur sur une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso dct:dateCopyrighted,schema:copyrightYear ;
    rdfs:subPropertyOf ha:hasDate ;
     .


# Modeling review: review equivalence with ha:hasDuration before assigning size-only values.
ha:hasExtent a rdf:Property ;
    rdfs:label "has extent"@en, "heeft omvang"@nl, "a pour étendue"@fr ;
    skos:definition "Describes the size, amount of content or duration of an archival resource."@en, "Beschrijft de omvang, hoeveelheid inhoud of duur van een archiefbron."@nl, "Décrit la taille, la quantité de contenu ou la durée d’une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dct:extent ;
    rdfs:subPropertyOf ha:hasFormat ;
     .

# Suggested rdfs:domain ha:MediaResource (not asserted).
ha:hasFragment a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has media fragment"@en, "heeft mediafragment"@nl, "a pour fragment de média"@fr ;
    skos:definition "Identifies a spatial or temporal segment within a media resource."@en, "Identificeert een ruimtelijk of temporeel segment binnen een mediabron."@nl, "Identifie un segment spatial ou temporel au sein d’une ressource médiatique."@fr ;
    rdfs:range ha:MediaFragment ;
    rdfs:seeAlso <http://www.w3.org/ns/ma-ont#hasFragment> ;
    owl:inverseOf ha:isFragmentOf ;
     .

# Suggested rdfs:domain premis:IntellectualEntity; rdfs:range ha:FragmentRepresentation (not asserted).
ha:hasFragmentRepresentation a rdf:Property ;
    rdfs:label "has fragment representation"@en, "heeft fragmentrepresentatie"@nl, "a pour représentation de fragment"@fr ;
    skos:definition "Relates an intellectual entity to a spatial or temporal segment serving as its partial digital representation."@en, "Verbindt een intellectuele entiteit met een ruimtelijk of temporeel segment dat als haar gedeeltelijke digitale representatie dient."@nl, "Relie une entité intellectuelle à un segment spatial ou temporel servant de représentation numérique partielle de celle-ci."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subPropertyOf ha:isRepresentedBy ;
    owl:inverseOf ha:isFragmentRepresentationOf ;
     .

ha:hasHigherPriorityThan a rdf:Property ;
    rdfs:label "has higher priority than"@en, "heeft hogere prioriteit dan"@nl, "a une priorité supérieure à"@fr ;
    skos:definition "Relates a controlled concept to another concept that has lower priority according to the archive’s local policy."@en, "Verbindt een gecontroleerd begrip met een ander begrip dat een lagere prioriteit heeft volgens het lokale archiefbeleid."@nl, "Relie un concept contrôlé à un autre concept ayant une priorité inférieure selon la politique locale des archives."@fr ;
    skos:example "If a local policy ranks format A above format B, A has higher priority than B."@en, "Als lokaal beleid formaat A boven formaat B rangschikt, heeft A een hogere prioriteit dan B."@nl, "Si une politique locale classe le format A avant le format B, A a une priorité supérieure à B."@fr ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy ha: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    owl:inverseOf ha:hasLowerPriorityThan ;
     .

# Suggested rdfs:domain premis:IntellectualEntity; rdfs:range ha:DigitalRepresentation (not asserted).
# URI/label review: consider ha:hasIIIFRepresentation; the value is a representation with a role, rather than a single file copy.
ha:hasIIIFCopy a rdf:Property ;
    rdfs:label "has IIIF representation"@en, "heeft IIIF-representatie"@nl, "a pour représentation IIIF"@fr ;
    skos:definition "Relates an intellectual entity to a digital representation made available through the International Image Interoperability Framework (IIIF)."@en, "Verbindt een intellectuele entiteit met een digitale representatie die via het International Image Interoperability Framework (IIIF) beschikbaar is."@nl, "Relie une entité intellectuelle à une représentation numérique accessible au moyen de l’International Image Interoperability Framework (IIIF)."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subPropertyOf ha:isRepresentedBy ;
    owl:inverseOf ha:isIIIFCopyOf ;
     .

# Range review: distinguish an image resource IRI from a URL literal; do not treat an xsd:anyURI value as an image individual.
ha:hasImage a rdf:Property ;
    rdfs:label "has image"@en, "heeft afbeelding"@nl, "a pour image"@fr ;
    skos:definition "Identifies an image depicting or illustrating a described archival resource or entity."@en, "Identificeert een afbeelding die een beschreven archiefbron of entiteit weergeeft of illustreert."@nl, "Identifie une image représentant ou illustrant une ressource archivistique ou une entité décrite."@fr ;
    rdfs:seeAlso schema:image ;
     .

ha:hasIssueDate a rdf:Property ;
    rdfs:label "has issue date"@en, "heeft uitgiftedatum"@nl, "a pour date de parution"@fr ;
    skos:definition "Records the formal issue or release date of an archival resource."@en, "Legt de formele uitgifte- of verschijningsdatum van een archiefbron vast."@nl, "Consigne la date officielle de parution ou de publication d’une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso dct:issued ;
    rdfs:subPropertyOf ha:hasDate ;
     .

ha:hasLowerPriorityThan a rdf:Property ;
    rdfs:label "has lower priority than"@en, "heeft lagere prioriteit dan"@nl, "a une priorité inférieure à"@fr ;
    skos:definition "Relates a controlled concept to another concept that has higher priority in the archive’s preference ordering."@en, "Verbindt een gecontroleerd begrip met een ander begrip dat een hogere prioriteit heeft in de voorkeursvolgorde van het archief."@nl, "Relie un concept contrôlé à un autre concept ayant une priorité supérieure dans l’ordre de préférence des archives."@fr ;
    skos:example "If a local policy ranks format A above format B, B has lower priority than A."@en, "Als lokaal beleid formaat A boven formaat B rangschikt, heeft B een lagere prioriteit dan A."@nl, "Si une politique locale classe le format A avant le format B, B a une priorité inférieure à A."@fr ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy ha: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    owl:inverseOf ha:hasHigherPriorityThan ;
     .

# Suggested rdfs:domain premis:IntellectualEntity; rdfs:range ha:DigitalRepresentation (not asserted).
# URI/label review: consider ha:hasMasterRepresentation; the value is a representation with a role, rather than a single file copy.
ha:hasMasterCopy a rdf:Property ;
    rdfs:label "has preservation master representation"@en, "heeft preservatiemasterrepresentatie"@nl, "a pour représentation maître de conservation"@fr ;
    skos:definition "Relates an intellectual entity to the digital master representation retained for long-term preservation."@en, "Verbindt een intellectuele entiteit met de digitale masterrepresentatie die voor duurzame bewaring wordt behouden."@nl, "Relie une entité intellectuelle à la représentation numérique maître conservée pour la préservation à long terme."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subPropertyOf ha:isRepresentedBy ;
    owl:inverseOf ha:isMasterCopyOf ;
     .

# Suggested rdfs:domain premis:IntellectualEntity; rdfs:range ha:DigitalRepresentation (not asserted).
# URI/label review: consider ha:hasMezzanineRepresentation; the value is a representation with a role, rather than a single file copy.
ha:hasMezzanineCopy a rdf:Property ;
    rdfs:label "has mezzanine representation"@en, "heeft mezzaninerepresentatie"@nl, "a pour représentation intermédiaire"@fr ;
    skos:definition "Relates an intellectual entity to a digital representation used as an intermediate source for producing delivery or access versions."@en, "Verbindt een intellectuele entiteit met een digitale representatie die als tussenbron dient om distributie- of toegangsversies te maken."@nl, "Relie une entité intellectuelle à une représentation numérique servant de source intermédiaire pour produire des versions de diffusion ou d’accès."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subPropertyOf ha:isRepresentedBy ;
    owl:inverseOf ha:isMezzanineCopyOf ;
     .

# Suggested rdfs:range xsd:nonNegativeInteger (not asserted).
ha:hasNumberOfPages a rdf:Property ;
    rdfs:label "has number of pages"@en, "heeft aantal pagina’s"@nl, "a pour nombre de pages"@fr ;
    skos:definition "Records the total number of pages in a newspaper issue or other paginated work."@en, "Legt het totale aantal pagina’s in een kranteneditie of ander gepagineerd werk vast."@nl, "Consigne le nombre total de pages d’un numéro de journal ou d’une autre œuvre paginée."@fr ;
    rdfs:domain ha:NewspaperIssue ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso schema:numberOfPages ;
    skos:related ha:hasNumberOfPages ;
     .

ha:hasPost a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has organizational post"@en, "heeft organisatiefunctie"@nl, "a pour poste organisationnel"@fr ;
    skos:definition "Identifies a position that exists within an organization independently of its holders."@en, "Identificeert een functie die binnen een organisatie bestaat onafhankelijk van de personen die haar bekleden."@nl, "Identifie un poste existant au sein d’une organisation indépendamment des personnes qui l’occupent."@fr ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Post ;
    rdfs:seeAlso <http://www.w3.org/ns/org#hasPost> ;
    owl:inverseOf ha:isPostIn ;
     .

ha:hasRelation a rdf:Property ;
    rdfs:label "has related resource"@en, "heeft gerelateerde bron"@nl, "a pour ressource associée"@fr ;
    skos:definition "Identifies a resource related to the described archival resource without specifying the kind of relationship."@en, "Identificeert een bron die met de beschreven archiefbron is verbonden zonder het soort relatie te specificeren."@nl, "Identifie une ressource liée à la ressource archivistique décrite sans préciser la nature de la relation."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dc:relation ;
     .

# Axiom review: the self-referential subproperty/equivalence assertion is redundant and can be removed.
ha:hasSpatial a rdf:Property ;
    rdfs:label "has spatial coverage"@en, "heeft ruimtelijke dekking"@nl, "a pour couverture spatiale"@fr ;
    skos:definition "Identifies a place or geographic area that is the subject or spatial scope of an archival work."@en, "Identificeert een plaats of geografisch gebied dat het onderwerp of ruimtelijke bereik van een archiefwerk vormt."@nl, "Identifie un lieu ou une zone géographique constituant le sujet ou la portée spatiale d’une œuvre archivée."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Place ;
    rdfs:seeAlso dct:spatial, schema:spatial ;
    rdfs:subPropertyOf ha:hasCoverage ;
    owl:equivalentProperty ha:hasSpatial ;
     .

ha:hasSupplement a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has supplement"@en, "heeft supplement"@nl, "a pour supplément"@fr ;
    skos:definition "Identifies a resource that updates or complements the described publication or work."@en, "Identificeert een bron die de beschreven publicatie of het werk bijwerkt of aanvult."@nl, "Identifie une ressource qui met à jour ou complète la publication ou l’œuvre décrite."@fr ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/supplement> ;
    rdfs:subPropertyOf ha:isAccompaniedBy ;
    owl:inverseOf ha:isSupplementTo ;
     .

# Axiom review: the self-referential subproperty/equivalence assertion is redundant and can be removed.
ha:hasTemporal a rdf:Property ;
    rdfs:label "has temporal coverage"@en, "heeft temporele dekking"@nl, "a pour couverture temporelle"@fr ;
    skos:definition "Describes the period addressed by the content of an archival work."@en, "Beschrijft de periode waarop de inhoud van een archiefwerk betrekking heeft."@nl, "Décrit la période sur laquelle porte le contenu d’une œuvre archivée."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso dct:temporal, schema:temporal ;
    rdfs:subPropertyOf ha:hasCoverage ;
    owl:equivalentProperty ha:hasTemporal ;
     .

# Suggested rdfs:domain premis:IntellectualEntity; rdfs:range ha:DigitalRepresentation (not asserted).
# URI/label review: consider ha:hasTranscriptionRepresentation; the value is a representation with a role, rather than a single file copy.
ha:hasTranscriptionCopy a rdf:Property ;
    rdfs:label "has transcription representation"@en, "heeft transcriptierepresentatie"@nl, "a pour représentation de transcription"@fr ;
    skos:definition "Relates an intellectual entity to a digital representation containing a transcription of its spoken content."@en, "Verbindt een intellectuele entiteit met een digitale representatie die een transcriptie van haar gesproken inhoud bevat."@nl, "Relie une entité intellectuelle à une représentation numérique contenant une transcription de son contenu parlé."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subPropertyOf ha:isRepresentedBy ;
    owl:inverseOf ha:isTranscriptionCopyOf ;
     .

# Suggested rdfs:domain ha:Agent (not asserted).
ha:holds a rdf:Property, owl:ObjectProperty ;
    rdfs:label "holds organizational post"@en, "bekleedt organisatiefunctie"@nl, "occupe un poste organisationnel"@fr ;
    skos:definition "Relates an agent to a position it holds within an organization."@en, "Verbindt een agent met een functie die deze binnen een organisatie bekleedt."@nl, "Relie un agent à un poste qu’il occupe au sein d’une organisation."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Post ;
    rdfs:seeAlso <http://www.w3.org/ns/org#holds> ;
    owl:inverseOf ha:isHeldBy ;
     .

# Suggested rdfs:domain ha:DigitalRepresentation; rdfs:range premis:IntellectualEntity (not asserted).
# URI/label review: consider ha:isAccessRepresentationOf, keeping its name paired with the forward property.
ha:isAccessCopyOf a rdf:Property ;
    rdfs:label "is access representation of"@en, "is toegangsrepresentatie van"@nl, "est une représentation d’accès de"@fr ;
    skos:definition "Relates a digital representation prepared for user consultation to the intellectual entity it represents."@en, "Verbindt een digitale representatie voor raadpleging door gebruikers met de intellectuele entiteit die ze representeert."@nl, "Relie une représentation numérique destinée à la consultation à l’entité intellectuelle qu’elle représente."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subPropertyOf ha:represents ;
    owl:inverseOf ha:hasAccessCopy ;
     .

ha:isAccountManagerOf a rdf:Property ;
    rdfs:label "is account manager of"@en, "is relatiebeheerder van"@nl, "est gestionnaire de compte de"@fr ;
    skos:definition "Relates a person to an organization for which that person manages the relationship."@en, "Verbindt een persoon met een organisatie waarvoor die persoon het relatiebeheer verzorgt."@nl, "Relie une personne à une organisation dont elle assure la gestion de la relation."@fr ;
    rdfs:domain ha:Person ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Organization ;
    owl:inverseOf ha:hasAccountManager ;
     .

ha:isCarrierRepresentationOf a rdf:Property ; #! was ha:isCarrierCopyOf
    rdfs:domain ha:CarrierRepresentation; 
    rdfs:range premis:IntellectualEntity;
    rdfs:label "is carrier representation of"@en, "is dragerrepresentatie van"@nl, "est une représentation sur support physique de"@fr ;
    skos:definition "Relates a representation on a physical carrier to the intellectual entity it represents."@en, "Verbindt een representatie op een fysieke drager met de intellectuele entiteit die ze representeert."@nl, "Relie une représentation sur support physique à l’entité intellectuelle qu’elle représente."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subPropertyOf ha:represents ;
    owl:inverseOf ha:hasCarrierRepresentation ;
     .

# Suggested rdfs:domain ha:MediaFragment; rdfs:range ha:MediaResource (not asserted).
ha:isFragmentOf a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is media fragment of"@en, "is mediafragment van"@nl, "est un fragment de média de"@fr ;
    skos:definition "Relates a media fragment to the media resource containing that segment."@en, "Verbindt een mediafragment met de mediabron die dat segment bevat."@nl, "Relie un fragment de média à la ressource médiatique qui contient ce segment."@fr ;
    rdfs:seeAlso <http://www.w3.org/ns/ma-ont#isFragmentOf> ;
     .

# Suggested rdfs:domain ha:FragmentRepresentation; rdfs:range premis:IntellectualEntity (not asserted).
ha:isFragmentRepresentationOf a rdf:Property ;
    rdfs:label "is fragment representation of"@en, "is fragmentrepresentatie van"@nl, "est une représentation de fragment de"@fr ;
    skos:definition "Relates a partial digital representation to the intellectual entity whose content it represents."@en, "Verbindt een gedeeltelijke digitale representatie met de intellectuele entiteit waarvan ze de inhoud representeert."@nl, "Relie une représentation numérique partielle à l’entité intellectuelle dont elle représente le contenu."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subPropertyOf ha:represents ;
    owl:inverseOf ha:hasFragmentRepresentation ;
     .

ha:isHeldBy a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is held by"@en, "wordt bekleed door"@nl, "est occupé par"@fr ;
    skos:definition "Identifies an agent holding a position within an organization."@en, "Identificeert een agent die een functie binnen een organisatie bekleedt."@nl, "Identifie un agent occupant un poste au sein d’une organisation."@fr ;
    rdfs:domain ha:Post ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Agent ;
    rdfs:seeAlso <http://www.w3.org/ns/org#heldBy> ;
    owl:inverseOf ha:holds ;
     .

# Suggested rdfs:domain ha:DigitalRepresentation; rdfs:range premis:IntellectualEntity (not asserted).
# URI/label review: consider ha:isIIIFRepresentationOf, keeping its name paired with the forward property.
ha:isIIIFCopyOf a rdf:Property ;
    rdfs:label "is IIIF representation of"@en, "is IIIF-representatie van"@nl, "est une représentation IIIF de"@fr ;
    skos:definition "Relates a digital representation made available through IIIF to the intellectual entity it represents."@en, "Verbindt een digitale representatie die via IIIF beschikbaar is met de intellectuele entiteit die ze representeert."@nl, "Relie une représentation numérique accessible au moyen d’IIIF à l’entité intellectuelle qu’elle représente."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subPropertyOf ha:represents ;
    owl:inverseOf ha:hasIIIFCopy ;
     .

# Suggested rdfs:domain ha:DigitalRepresentation; rdfs:range premis:IntellectualEntity (not asserted).
# URI/label review: consider ha:isMasterRepresentationOf, keeping its name paired with the forward property.
ha:isMasterCopyOf a rdf:Property ;
    rdfs:label "is preservation master representation of"@en, "is preservatiemasterrepresentatie van"@nl, "est une représentation maître de conservation de"@fr ;
    skos:definition "Relates a digital preservation master representation to the intellectual entity it represents."@en, "Verbindt een digitale preservatiemasterrepresentatie met de intellectuele entiteit die ze representeert."@nl, "Relie une représentation numérique maître de conservation à l’entité intellectuelle qu’elle représente."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subPropertyOf ha:represents ;
    owl:inverseOf ha:hasMasterCopy ;
     .

# Range review: local SHACL uses premis:File; confirm whether files should be declared media resources or allowed as an alternative.
ha:isMediaFragmentOf a rdf:Property ;
    rdfs:label "is media fragment of"@en, "is mediafragment van"@nl, "est un fragment de média de"@fr ;
    skos:definition "Relates a media fragment to the media resource containing that segment."@en, "Verbindt een mediafragment met de mediabron die dat segment bevat."@nl, "Relie un fragment de média à la ressource médiatique qui contient ce segment."@fr ;
    rdfs:domain ha:MediaFragment ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:MediaResource ;
    rdfs:seeAlso ebucore:isMediaFragmentOf ;
     .

# Suggested rdfs:domain ha:DigitalRepresentation; rdfs:range premis:IntellectualEntity (not asserted).
# URI/label review: consider ha:isMezzanineRepresentationOf, keeping its name paired with the forward property.
ha:isMezzanineCopyOf a rdf:Property ;
    rdfs:label "is mezzanine representation of"@en, "is mezzaninerepresentatie van"@nl, "est une représentation intermédiaire de"@fr ;
    skos:definition "Relates an intermediate digital representation used to produce delivery versions to the intellectual entity it represents."@en, "Verbindt een digitale tussenrepresentatie voor het maken van distributieversies met de intellectuele entiteit die ze representeert."@nl, "Relie une représentation numérique intermédiaire utilisée pour produire des versions de diffusion à l’entité intellectuelle qu’elle représente."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subPropertyOf ha:represents ;
    owl:inverseOf ha:hasMezzanineCopy ;
     .

ha:isPartOf a rdf:Property ;
    rdfs:label "is part of"@en, "is onderdeel van"@nl, "fait partie de"@fr ;
    skos:definition "Identifies the work, collection or archival unit containing the described resource."@en, "Identificeert het werk, de collectie of de archiefeenheid waarvan de beschreven bron deel uitmaakt."@nl, "Identifie l’œuvre, la collection ou l’unité archivistique contenant la ressource décrite."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso schema:isPartOf ;
     .

ha:isPostIn a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is post in organization"@en, "is functie binnen organisatie"@nl, "est un poste dans l’organisation"@fr ;
    skos:definition "Identifies the organization in which a position exists."@en, "Identificeert de organisatie waarbinnen een functie bestaat."@nl, "Identifie l’organisation au sein de laquelle un poste existe."@fr ;
    rdfs:domain ha:Post ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Organization ;
    rdfs:seeAlso <http://www.w3.org/ns/org#postIn> ;
    owl:inverseOf ha:hasPost ;
     .

ha:isPrecededBy a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is preceded by"@en, "wordt voorafgegaan door"@nl, "est précédé de"@fr ;
    skos:definition "Identifies a publication or work that precedes the described resource chronologically or in a narrative sequence."@en, "Identificeert een publicatie of werk dat chronologisch of in een verhalende volgorde aan de beschreven bron voorafgaat."@nl, "Identifie une publication ou une œuvre qui précède la ressource décrite dans l’ordre chronologique ou narratif."@fr ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/precededBy> ;
    rdfs:subPropertyOf ha:isRelatedTo ;
    owl:inverseOf ha:isSucceededBy ;
     .

ha:isSucceededBy a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is succeeded by"@en, "wordt opgevolgd door"@nl, "est suivi de"@fr ;
    skos:definition "Identifies a publication or work that follows the described resource chronologically or in a narrative sequence."@en, "Identificeert een publicatie of werk dat chronologisch of in een verhalende volgorde op de beschreven bron volgt."@nl, "Identifie une publication ou une œuvre qui suit la ressource décrite dans l’ordre chronologique ou narratif."@fr ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/succeededBy> ;
    rdfs:subPropertyOf ha:isRelatedTo ;
    owl:inverseOf ha:isPrecededBy ;
     .

ha:isSupplementTo a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is supplement to"@en, "is supplement bij"@nl, "est un supplément de"@fr ;
    skos:definition "Identifies the publication or work that the described resource updates or complements."@en, "Identificeert de publicatie of het werk dat door de beschreven bron wordt bijgewerkt of aangevuld."@nl, "Identifie la publication ou l’œuvre que la ressource décrite met à jour ou complète."@fr ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/supplementTo> ;
    rdfs:subPropertyOf ha:accompanies ;
    owl:inverseOf ha:hasSupplement ;
     .

# Suggested rdfs:domain ha:DigitalRepresentation; rdfs:range premis:IntellectualEntity (not asserted).
# URI/label review: consider ha:isTranscriptionRepresentationOf, keeping its name paired with the forward property.
ha:isTranscriptionCopyOf a rdf:Property ;
    rdfs:label "is transcription representation of"@en, "is transcriptierepresentatie van"@nl, "est une représentation de transcription de"@fr ;
    skos:definition "Relates a digital transcription representation to the intellectual entity whose spoken content it transcribes."@en, "Verbindt een digitale transcriptierepresentatie met de intellectuele entiteit waarvan ze de gesproken inhoud transcribeert."@nl, "Relie une représentation numérique de transcription à l’entité intellectuelle dont elle transcrit le contenu parlé."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subPropertyOf ha:represents ;
    owl:inverseOf ha:hasTranscriptionCopy ;
     .

ha:isTransitiveSubOrganizationOf a rdf:Property, owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "is transitively contained in organization"@en, "valt hiërarchisch onder organisatie"@nl, "est rattaché transitivement à l’organisation"@fr ;
    skos:definition "Identifies an organization containing the described organization directly or through intermediate organizational levels."@en, "Identificeert een organisatie waaronder de beschreven organisatie rechtstreeks of via tussenliggende organisatieniveaus valt."@nl, "Identifie une organisation contenant l’organisation décrite directement ou par des niveaux organisationnels intermédiaires."@fr ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Organization ;
    rdfs:seeAlso <http://www.w3.org/ns/org#transitiveSubOrganizationOf> ;
     .

# Suggested rdfs:domain ha:Agent (not asserted).
ha:makes a rdf:Property ;
    rdfs:label "makes"@en, "maakt"@nl, "crée"@fr ;
    skos:definition "Relates an agent to a resource that the agent made."@en, "Verbindt een agent met een bron die deze heeft gemaakt."@nl, "Relie un agent à une ressource qu’il a créée."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Resource ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/made> ;
    owl:inverseOf ha:isMadeBy ;
     .

# URI review: consider ha:EncodedTimeInterval for consistent class/datatype naming; retain ha:PeriodOfTime for interval resources.
ha:period a rdfs:Class, rdfs:Datatype ;
    rdfs:label "encoded time interval"@en, "gecodeerd tijdsinterval"@nl, "intervalle de temps encodé"@fr ;
    skos:definition "A time interval expressed as a text value using the DCMI Period encoding scheme, with optional start, end, scheme and name components."@en, "Een tijdsinterval uitgedrukt als tekstwaarde volgens het DCMI Period-coderingsschema, met optionele componenten voor begin, einde, schema en naam."@nl, "Un intervalle de temps exprimé sous forme de valeur textuelle selon le schéma d’encodage DCMI Period, avec des composantes facultatives de début, de fin, de schéma et de nom."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dct:Period, <https://www.dublincore.org/specifications/dublin-core/dcmi-period/> ;
     .

ha:MetadataScope a rdfs:Class ;
    rdfs:label "metadata scope"@en, "metadatabereik"@nl, "étendue des métadonnées"@fr ;
    skos:definition "A category specifying which subset of a resource’s metadata an access or use rule covers, such as a limited or extended set."@en, "Een categorie die aangeeft op welke deelverzameling van de metadata van een bron een toegangs- of gebruiksregel betrekking heeft, zoals een beperkte of uitgebreide set."@nl, "Une catégorie précisant le sous-ensemble des métadonnées d’une ressource couvert par une règle d’accès ou d’utilisation, tel qu’un ensemble limité ou étendu."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:subClassOf odrl:RightOperand ;
     .

ha:accompanies a rdf:Property, owl:ObjectProperty ;
    rdfs:label "accompanies"@en, "begeleidt"@nl, "accompagne"@fr ;
    skos:definition "Relates a supplementary or accompanying resource to the resource with which it is issued or used."@en, "Verbindt een aanvullende of begeleidende bron met de bron waarmee ze wordt uitgegeven of gebruikt."@nl, "Relie une ressource complémentaire ou d’accompagnement à la ressource avec laquelle elle est publiée ou utilisée."@fr ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/accompanies> ;
    rdfs:subPropertyOf ha:isRelatedTo ;
    owl:inverseOf ha:isAccompaniedBy ;
     .

ha:availableForConsultation a owl:NamedIndividual, skos:Concept, odrl:Action ;
    rdfs:label "available for consultation"@en ;
    skos:altLabel "listen"@en, "view"@en, "bekijken"@nl, "beluisteren"@nl ;
    rdfs:comment "To make a digital copy available for consultation by third-parties."@en, "Om een ​​digitale kopie beschikbaar te stellen voor raadpleging door derden."@nl ;
    skos:exactmatch odrl:display ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Make available for consultation"@en, "Raadpleegbaar maken"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:betweenPartners a owl:NamedIndividual, skos:Concept, ha:UserGroup ;
    rdfs:label "between partners"@en ;
    skos:definition "Anyone who has an collaboration agreement with meemoo that includes key use as permission (meemoo collaboration agreement 6.7.3 or 5.7.3)"@en, "Iedereen die een samenwerkingsovereenkomst met meemoo heeft waarin sleutelgebruik als toestemming is opgenomen (meemoo samenwerkingsovereenkomst 6.7.3 of 5.7.3)"@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Between partners"@en, "Tussen partners"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

# URI review: prefer ha:hasDescription for consistency with other property names; the existing equivalence is retained.
ha:description a rdf:Property ;
    rdfs:label "description"@en, "beschrijving"@nl, "description"@fr ;
    skos:definition "Provides a textual account of an archival resource’s content or characteristics."@en, "Geeft een tekstuele beschrijving van de inhoud of kenmerken van een archiefbron."@nl, "Fournit une description textuelle du contenu ou des caractéristiques d’une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dct:description ;
     .

ha:downloadable a owl:NamedIndividual, skos:Concept, odrl:Action ;
    rdfs:label "downloadable"@en ;
    skos:altLabel "download"@en, "kopie downloaden"@nl ;
    skos:definition "To make the digital copy downloadable by third-parties."@en, "Om de digitale kopie downloadbaar te maken voor derden."@nl ;
    skos:exactmatch odrl:distribute ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Make downloadable"@en, "Downloadbaar maken"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:educationalPublic a owl:NamedIndividual, skos:Concept, ha:UserGroup ;
    rdfs:label "educational public"@en ;
    skos:definition "Anyone subject to the conditions for access to the Archive for Education platform (e.g., lecturers, learners, educational support staff, etc.), see Appendix 2 of the meemoo collaboration agreement."@en, "Iedereen die valt onder de voorwaarden van toegang tot het Archief voor Onderwijsplatform (bv lesgevers, lerenden, onderwijsondersteunend personeel...), zie bijlage 2 van de meemoo samenwerkingsovereenkomst."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Educational public"@en, "Onderwijs"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:extended a owl:NamedIndividual, skos:Concept, ha:MetadataRange ;
    rdfs:label "extended"@en ;
    skos:definition "The metadata will be displayed in the form of limited set, according to the agreements."@en, "Een uitgebreide set metadata, bepaald volgens afspraken en documentatie, wordt ontsloten."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Extended"@en, "Étendu"@fr, "Uitgebreid"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:full a owl:NamedIndividual, skos:Concept, ha:ContentScope ;
    rdfs:label "full"@en ;
    skos:definition "The material can be displayed in full, according to the agreements made."@en, "De toestemming is van toepassing op het materiaal in zijn geheel."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Full"@en, "Complet"@fr, "Volledig"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

# Axiom review: the self-referential subproperty/equivalence assertion is redundant and can be removed.
ha:hasCreator a rdf:Property ;
    rdfs:label "has creator"@en, "heeft maker"@nl, "a pour créateur"@fr ;
    skos:definition "Identifies the person or organization primarily responsible for creating an archival resource, directly or through a role."@en, "Identificeert de persoon of organisatie die hoofdzakelijk verantwoordelijk is voor de creatie van een archiefbron, rechtstreeks of via een rol."@nl, "Identifie la personne ou l’organisation principalement responsable de la création d’une ressource archivistique, directement ou au moyen d’un rôle."@fr ;
    rdfs:domain [
        owl:unionOf (
            ha:CreativeWork
            ha:Role
        ) ;
    ] ;
    rdfs:isDefinedBy ha: ;
    rdfs:range [
        owl:unionOf (
            ha:Person
            ha:Organization
            ha:Role
        ) ;
    ] ;
    rdfs:seeAlso dc:creator, dct:creator, schema:creator ;
    rdfs:subPropertyOf ha:hasCreator ;
    owl:equivalentProperty ha:hasCreator, ha:isMadeBy ;
     .

# Axiom review: the self-referential subproperty/equivalence assertion is redundant and can be removed.
ha:hasPublisher a rdf:Property ;
    rdfs:label "has publisher"@en, "heeft uitgever"@nl, "a pour éditeur"@fr ;
    skos:definition "Identifies the person or organization responsible for publishing an archival resource, directly or through a role."@en, "Identificeert de persoon of organisatie die verantwoordelijk is voor het publiceren van een archiefbron, rechtstreeks of via een rol."@nl, "Identifie la personne ou l’organisation responsable de la publication d’une ressource archivistique, directement ou au moyen d’un rôle."@fr ;
    rdfs:domain [
        owl:unionOf (
            ha:CreativeWork
            ha:Role
        ) ;
    ] ;
    rdfs:isDefinedBy ha: ;
    rdfs:range [
        owl:unionOf (
            ha:Person
            ha:Organization
            ha:Role
        ) ;
    ] ;
    rdfs:seeAlso dc:publisher, dct:publisher, schema:publisher ;
    rdfs:subPropertyOf ha:hasPublisher ;
    owl:equivalentProperty ha:hasPublisher ;
     .

ha:hasSite a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has site"@en, "heeft vestiging"@nl, "a pour établissement"@fr ;
    skos:definition "Identifies a physical or virtual site at which an organization has a presence."@en, "Identificeert een fysieke of virtuele vestiging waar een organisatie aanwezig is."@nl, "Identifie un établissement physique ou virtuel où une organisation est présente."@fr ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Site ;
    rdfs:seeAlso <http://www.w3.org/ns/org#hasSite> ;
     .

ha:hasSubOrganization a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has suborganization"@en, "heeft deelorganisatie"@nl, "a pour sous-organisation"@fr ;
    skos:definition "Identifies an organization directly contained within the described organization’s hierarchy."@en, "Identificeert een organisatie die rechtstreeks onder de beschreven organisatie in de hiërarchie valt."@nl, "Identifie une organisation directement rattachée à l’organisation décrite dans sa hiérarchie."@fr ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Organization ;
    rdfs:seeAlso <http://www.w3.org/ns/org#hasSubOrganization> ;
    owl:inverseOf ha:isSubOrganizationOf ;
     .

# Axiom review: the self-referential subproperty/equivalence assertion is redundant and can be removed.
ha:hasSubject a rdf:Property ;
    rdfs:label "has subject"@en, "heeft onderwerp"@nl, "a pour sujet"@fr ;
    skos:definition "Specifies a topic addressed by the content of an archival resource."@en, "Geeft een onderwerp aan dat in de inhoud van een archiefbron aan bod komt."@nl, "Indique un sujet traité dans le contenu d’une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dc:subject, dct:subject ;
    rdfs:subPropertyOf ha:hasSubject ;
     .

ha:intraMuros a owl:NamedIndividual, skos:Concept, ha:UserGroup ;
    rdfs:label "intra muros"@en ;
    skos:definition "Anyone who is within the institution's buildings for the purpose of digital consultation."@en, "Iedereen die zich binnen de gebouwen van de instelling bevindt met het oog op digitale raadpleging."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Intra muros"@en, "Intra muros"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:isAccompaniedBy a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is accompanied by"@en, "wordt begeleid door"@nl, "est accompagné de"@fr ;
    skos:definition "Identifies a resource that accompanies the described resource when issued or used."@en, "Identificeert een bron die de beschreven bron bij uitgifte of gebruik begeleidt."@nl, "Identifie une ressource accompagnant la ressource décrite lors de sa publication ou de son utilisation."@fr ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/accompaniedBy> ;
    rdfs:subPropertyOf ha:isRelatedTo ;
    owl:inverseOf ha:accompanies ;
     .

ha:isMadeBy a rdf:Property ;
    rdfs:label "is made by"@en, "is gemaakt door"@nl, "est créé par"@fr ;
    skos:definition "Identifies the agent that made the described resource."@en, "Identificeert de agent die de beschreven bron heeft gemaakt."@nl, "Identifie l’agent qui a créé la ressource décrite."@fr ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Agent ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/maker> ;
    owl:inverseOf ha:makes ;
     .

ha:isSubOrganizationOf a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is suborganization of"@en, "is deelorganisatie van"@nl, "est une sous-organisation de"@fr ;
    skos:definition "Identifies the organization that directly contains the described organization in its hierarchy."@en, "Identificeert de organisatie waaronder de beschreven organisatie rechtstreeks in de hiërarchie valt."@nl, "Identifie l’organisation à laquelle l’organisation décrite est directement rattachée dans la hiérarchie."@fr ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy ha: ;
    rdfs:range ha:Organization ;
    rdfs:seeAlso <http://www.w3.org/ns/org#subOrganizationOf> ;
    rdfs:subPropertyOf ha:isTransitiveSubOrganizationOf ;
    owl:inverseOf ha:hasSubOrganization ;
     .

ha:limited a owl:NamedIndividual, skos:Concept, ha:MetadataRange ;
    rdfs:label "limited"@en ;
    rdfs:comment "The metadata will be displayed in the form of a limited set, according to the agreements."@en, "Een beperkte set metadata, bepaald volgens afspraken en documentatie, wordt ontsloten."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Limited"@en, "Limité"@fr, "Beperkt"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:partial a owl:NamedIndividual, skos:Concept, ha:ContentScope ;
    rdfs:label "partial"@en ;
    rdfs:comment "The material can be displayed in part, according to the agreements made."@en, "De toestemming is van toepassing op het materiaal in de vorm van één of meerdere fragmenten, volgens een aangegeven tijdsstempel of volgens de bilaterale afspraken (zodanig dat de duur van het fragment minder dan de helft van de totale duur van het materiaal is)."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Partial"@en, "Partiel"@fr, "Deels"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:public a owl:NamedIndividual, skos:Concept, ha:UserGroup ;
    rdfs:label "public"@en ;
    rdfs:comment "Anyone with internet access."@en, "Iedereen met toegang tot internet."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "public"@en, "Publiek"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:researchPublic a owl:NamedIndividual, skos:Concept, ha:UserGroup ;
    rdfs:label "research public"@en ;
    rdfs:comment "Anyone who falls under the Scientific Research user group as described in Appendix 2 of the meemoo collaboration agreement."@en, "Iedereen die valt onder de gebruikersgroep Wetenschappelijk Onderzoek zoals beschreven in bijlage 2 van de meemoo samenwerkingsovereenkomst."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Research public"@en, "Onderzoek"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:hasContributor a rdf:Property ;
    rdfs:label "has contributor"@en, "heeft bijdrager"@nl, "a pour contributeur"@fr ;
    skos:definition "Identifies a person or organization contributing to an archival resource, directly or through a role describing the contribution."@en, "Identificeert een persoon of organisatie die aan een archiefbron bijdraagt, rechtstreeks of via een rol die de bijdrage beschrijft."@nl, "Identifie une personne ou une organisation contribuant à une ressource archivistique, directement ou au moyen d’un rôle décrivant sa contribution."@fr ;
    rdfs:domain [
        owl:unionOf (
            ha:CreativeWork
            ha:Role
        ) ;
    ] ;
    rdfs:isDefinedBy ha: ;
    rdfs:range [
        owl:unionOf (
            ha:Person
            ha:Organization
            ha:Role
        ) ;
    ] ;
    rdfs:seeAlso dc:contributor, dct:contributor, schema:contributor ;
     .

# Axiom review: the self-referential subproperty/equivalence assertion is redundant and can be removed.
ha:hasCoverage a rdf:Property ;
    rdfs:label "has coverage"@en, "heeft dekkingsgebied"@nl, "a pour couverture"@fr ;
    skos:definition "Describes the spatial or temporal scope, applicability or jurisdiction of an archival resource."@en, "Beschrijft de ruimtelijke of temporele reikwijdte, toepasselijkheid of het rechtsgebied van een archiefbron."@nl, "Décrit la portée spatiale ou temporelle, le champ d’application ou le cadre juridique d’une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dc:coverage, dct:coverage ;
    rdfs:subPropertyOf ha:hasCoverage ;
     .

# Axiom review: the self-referential subproperty/equivalence assertion is redundant and can be removed.
ha:hasDescription a rdf:Property, owl:DatatypeProperty ;
    rdfs:label "has description"@en, "heeft beschrijving"@nl, "a pour description"@fr ;
    skos:definition "Provides a textual account of an archival resource’s content or characteristics."@en, "Geeft een tekstuele beschrijving van de inhoud of kenmerken van een archiefbron."@nl, "Fournit une description textuelle du contenu ou des caractéristiques d’une ressource archivistique."@fr ;
    rdfs:domain ha:Thing ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso dc:description, ebucore:description, <http://www.w3.org/ns/ma-ont#description>, schema:description ;
    owl:equivalentProperty ha:description, ha:hasDescription ;
     .

# Review ranges: multiple rdfs:range values are cumulative, not alternatives; use a class union for resource alternatives or SHACL for mixed literal/resource choices.
# Axiom review: the self-referential subproperty/equivalence assertion is redundant and can be removed.
ha:hasFormat a rdf:Property ;
    rdfs:label "has format"@en, "heeft formaat"@nl, "a pour format"@fr ;
    skos:definition "Describes the file format, physical medium or dimensions of an archival resource."@en, "Beschrijft het bestandsformaat, het fysieke medium of de afmetingen van een archiefbron."@nl, "Décrit le format de fichier, le support physique ou les dimensions d’une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:string, ha:Format, ha:MediaTypeOrExtent ;
    rdfs:seeAlso dc:format, dct:format, ebucore:hasFormat ;
    rdfs:subPropertyOf ha:hasFormat ;
     .

# Domain review: identifiers are used for many resource types; the ha:Organization domain would classify every identified resource as an organization.
# Review domains: multiple rdfs:domain values are cumulative, not alternatives; use a class union for resource alternatives or SHACL for mixed literal/resource choices.
# Review ranges: multiple rdfs:range values are cumulative, not alternatives; use a class union for resource alternatives or SHACL for mixed literal/resource choices.
# Axiom review: the self-referential subproperty/equivalence assertion is redundant and can be removed.
ha:hasIdentifier a rdf:Property, owl:DatatypeProperty ;
    rdfs:label "has identifier"@en, "heeft identificatie"@nl, "a pour identifiant"@fr ;
    skos:definition "Provides a reference that identifies a resource unambiguously within a specified system or context."@en, "Geeft een referentie die een bron ondubbelzinnig identificeert binnen een bepaald systeem of een bepaalde context."@nl, "Fournit une référence identifiant une ressource sans ambiguïté dans un système ou un contexte donné."@fr ;
    rdfs:domain ha:Organization, ha:Thing ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal, xsd:string ;
    rdfs:seeAlso dc:identifier, dct:identifier, <http://www.w3.org/ns/org#identifier>, schema:identifier ;
    rdfs:subPropertyOf skos:notation, ha:hasIdentifier ;
    owl:equivalentProperty ha:hasIdentifier ;
     .

ha:hasPosition a rdf:Property ;
    rdfs:label "has position"@en, "heeft positie"@nl, "a pour position"@fr ;
    skos:definition "Records an item’s ordinal position within an ordered series or sequence."@en, "Legt de rangpositie van een item binnen een geordende reeks of volgorde vast."@nl, "Consigne la position ordinale d’un élément dans une série ou une séquence ordonnée."@fr ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy ha: ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso schema:position ;
     .

# Axiom review: the self-referential subproperty/equivalence assertion is redundant and can be removed.
ha:hasTitle a rdf:Property ;
    rdfs:label "has title"@en, "heeft titel"@nl, "a pour titre"@fr ;
    skos:definition "Provides a title given to an archival resource."@en, "Geeft een titel die aan een archiefbron is toegekend."@nl, "Fournit un titre attribué à une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso dc:title, dct:title ;
    rdfs:subPropertyOf ha:hasTitle ;
     .

# Axiom review: the self-referential subproperty/equivalence assertion is redundant and can be removed.
ha:hasDate a rdf:Property ;
    rdfs:label "has date"@en, "heeft datum"@nl, "a pour date"@fr ;
    skos:definition "Records a date or period associated with the lifecycle of an archival resource."@en, "Legt een datum of periode vast die bij de levenscyclus van een archiefbron hoort."@nl, "Consigne une date ou une période associée au cycle de vie d’une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso dc:date, dct:date ;
     .

# Axiom review: the self-referential subproperty/equivalence assertion is redundant and can be removed.
ha:hasRights a rdf:Property ;
    rdfs:label "has rights information"@en, "heeft rechteninformatie"@nl, "a pour informations sur les droits"@fr ;
    skos:definition "Provides or identifies information about rights and use conditions applicable to an archival resource."@en, "Geeft of identificeert informatie over rechten en gebruiksvoorwaarden die op een archiefbron van toepassing zijn."@nl, "Fournit ou identifie des informations sur les droits et les conditions d’utilisation applicables à une ressource archivistique."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso dc:rights, dct:rights ;
    rdfs:subPropertyOf ha:hasRights ;
     .

ha:isRelatedTo a rdf:Property, owl:SymmetricProperty ;
    rdfs:label "is related to"@en, "is gerelateerd aan"@nl, "est lié à"@fr ;
    skos:definition "Relates two archival resources without specifying the kind of relationship; the relationship is symmetric."@en, "Verbindt twee archiefbronnen zonder het soort relatie te specificeren; de relatie is symmetrisch."@nl, "Relie deux ressources archivistiques sans préciser la nature de la relation ; cette relation est symétrique."@fr ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/relatedTo> ;
     .

# Review ranges: multiple rdfs:range values are cumulative, not alternatives; use a class union for resource alternatives or SHACL for mixed literal/resource choices.
ha:hasAnnotationPurpose a rdf:Property ;
    rdfs:label "has annotation purpose"@en, "heeft annotatiedoel"@nl, "a pour finalité d’annotation"@fr ;
    skos:definition "Describes the purpose or focus of an annotation of archival content."@en, "Beschrijft het doel of de focus van een annotatie van archiefinhoud."@nl, "Décrit la finalité ou le sujet d’une annotation de contenu archivistique."@fr ;
    rdfs:domain ha:Annotation ;
    rdfs:range xsd:anyURI, xsd:string ;
    rdfs:seeAlso ebucore:hasAnnotationPurpose ;
     .

# Domain/range review: the generic relationship also covers software environments, so avoid restricting it to intellectual entities and digital representations.
ha:isRepresentedBy a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is represented by"@en, "wordt gerepresenteerd door"@nl, "est représenté par"@fr ;
    skos:definition "Relates an intellectual entity to a file or representation embodying its content, or a software agent to its environment object."@en, "Verbindt een intellectuele entiteit met een bestand of representatie die haar inhoud belichaamt, of een softwareagent met zijn omgevingsobject."@nl, "Relie une entité intellectuelle à un fichier ou une représentation matérialisant son contenu, ou un agent logiciel à son objet d’environnement."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/isr> ;
    rdfs:subPropertyOf premis:relationship, <http://id.loc.gov/vocabulary/preservation/relationshipSubType/isr> ;
     .

# Domain/range review: the generic relationship also covers software environments; use the narrower copy subproperties for archival representation roles.
ha:represents a rdf:Property, owl:ObjectProperty ;
    rdfs:label "represents"@en, "representeert"@nl, "représente"@fr ;
    skos:definition "Relates a file or representation to the intellectual entity whose content it embodies, or an environment object to the software agent it represents."@en, "Verbindt een bestand of representatie met de intellectuele entiteit waarvan het de inhoud belichaamt, of een omgevingsobject met de softwareagent die het voorstelt."@nl, "Relie un fichier ou une représentation à l’entité intellectuelle dont il matérialise le contenu, ou un objet d’environnement à l’agent logiciel qu’il représente."@fr ;
    rdfs:isDefinedBy ha: ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/rep> ;
    rdfs:subPropertyOf premis:relationship, <http://id.loc.gov/vocabulary/preservation/relationshipSubType/rep> ;
     .

<https://data.hetarchief.be/id/constraint-operand> a skos:ConceptScheme ;
