PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcam: <http://purl.org/dc/dcam/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ha: <https://data.hetarchief.be/ns/>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX pav: <http://purl.org/pav/>
PREFIX premis: <http://www.loc.gov/premis/rdf/v3/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vann: <http://purl.org/vocab/vann/>
PREFIX vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ha: a owl:Ontology ;
    owl:imports <external/odrl.rdfs.ttl>, <external/premis.rdfs.ttl>, <external/prov.rdfs.ttl> ;
    rdfs:label "hetarchief ontology"@en ;
    dct:created "2022-03-14" ;
    dct:description "Data model hetarchief."@en, "Modèle de données hetarchief."@fr, "Datamodel hetarchief."@nl ;
    dct:modified "2025-02-13" ;
    dct:title "Data model hetarchief"@en, "Modèle de données hetarchief"@fr, "Datamodel hetarchief"@nl ;
    pav:version "0.0.1" ;
    vann:preferredNamespacePrefix "ha" ;
    vann:preferredNamespaceUri "https://data.hetarchief.be/ns/" ;
    schema:author [
        a schema:Person ;
        schema:email "lennert.vandevelde@meemoo.be" ;
        schema:name "Lennert Van de Velde"@nl ;
    ], [
        a schema:Person ;
        schema:email "miel.vandersande@meemoo.be" ;
        schema:name "Miel Vander Sande"@nl ;
    ], [
        a schema:Person ;
        schema:email "milan.valadou@meemoo.be" ;
        schema:name "Luca"@nl ;
    ] ;
     .

ha:Agent a rdfs:Class, ha:AgentClass ;
    rdfs:label "agent"@en ;
    dct:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A person or Organisation."@en, "A resource that acts or has the power to act."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:Agent, <http://xmlns.com/foaf/0.1/Agent> ;
    rdfs:subClassOf owl:Thing ;
     .

ha:AgentClass a rdfs:Class ;
    rdfs:label "agent class"@en ;
    dct:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A group of agents."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:AgentClass ;
    rdfs:subClassOf rdfs:Class ;
     .

ha:Annotation a rdfs:Class ;
    rdfs:label "annotation"@en, "Annotation"@fr, "Annotatie"@nl ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Annotation> ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "A class used to annotate Assets."@en, "Une classe utilisée pour annoter les éléments."@fr, "Een klasse die wordt gebruikt om items te annoteren."@nl ;
     .

ha:AnnotationType a rdfs:Class ;
    rdfs:label "annotation type"@en ;
    rdfs:comment "To define a type of Annotation."@en ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Annotation_Type> ;
    rdfs:subClassOf skos:Concept ;
     .

ha:ArchiveComponent a rdfs:Class ;
    rdfs:label "archive component"@en, "Composant d'archive"@fr, "Archiefcomponent"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:ArchiveComponent ;
    rdfs:subClassOf ha:CreativeWork ;
    rdfs:comment "An intangible type to be applied to any archive content, carrying with it a set of properties required to describe archival items and collections."@en, "Un type intangible à appliquer à tout contenu d'archives, portant avec lui un ensemble de propriétés nécessaires pour la description d'éléments d'archives et de collections."@fr, "Een immaterieel type dat toegepast moet worden op elke inhoud van het archief, met daarbij een set van eigenschappen die nodig zijn om archiefitems en -collecties te beschrijven."@nl ;
     .

ha:Audio a rdfs:Class ;
    rdfs:label "audio"@en, "Audio"@fr, "Audio"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf premis:IntellectualEntity ;
    rdfs:comment "This class applies to media in meemoo's archive that is originally derived from digital born audio or an analog carrier of type audio."@en, "Cette classe s'applique aux médias dans les archives de meemoo qui proviennent à l'origine de l'audio né numérique ou à l'origine d'un support analogue du type audio."@fr, "Deze klasse is van toepassing op media in meemoo's archief dat oorspronkelijk afkomstig is van digitaal geboren audio of dat oorspronkelijk afkomstig is van een analoge drager van het type audio."@nl ;
     .

ha:AudioReel a rdfs:Class ;
    rdfs:label "audio reel"@en, "Bobine audio"@fr, "Geluidsspoel"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:PhysicalCarrier ;
    rdfs:comment "A reel of an analog film carrier that contains audio."@en, "Une bobine d'un porte-film analogique qui contient de l'audio."@fr, "Een band van een analoge film drager die audio bevat."@nl ;
     .

ha:AudiovisualCarrier a rdfs:Class ;
    rdfs:label "audiovisual carrier"@en, "Porteur audiovisuel"@fr, "Audiovisuele drager"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:PhysicalCarrier ;
    rdfs:comment "A physical carrier that stores audio or audiovisual content."@en, "Un porteur physique qui stocke du contenu audio ou audiovisuel."@fr, "Een fysieke drager waarop audio of audiovisueel materiaal is opgeslagen."@nl ;
     .

ha:AudiovisualCarrierRepresentation a rdfs:Class ;
    rdfs:label "audiovisual carrier representation"@en, "Représentation de porteur audiovisuel"@fr, "Audiovisuele drager representatie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:CarrierRepresentation ;
    rdfs:comment "A physical or digital representation of an archived audio or video entity that is stored on an audiovisual physical carrier such as a video tape."@en, "Une représentation physique ou numérique d'une entité audio ou audiovisuel archivée qui est stockée sur un porteur physique tel qu'une bande vidéo."@fr, "Een fysieke of digitale weergave van een gearchiveerde audio of video entiteit die is opgeslagen op een fysieke audiovisuele drager zoals een videoband."@nl ;
     .

ha:Authority a rdfs:Class ;
    rdfs:label "authority"@en ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
    rdfs:seeAlso <http://www.loc.gov/mads/rdf/v1#Authority> ;
     .

ha:Book a rdfs:Class ;
    rdfs:label "Book", "book"@en ;
    rdfs:comment "A book." ;
    rdfs:seeAlso schema:Book ;
    rdfs:subClassOf ha:CreativeWork ;
     .

ha:Brand a rdfs:Class ;
    rdfs:label "Brand", "brand"@en ;
    rdfs:comment "A brand is a name used by an organization or business person for labeling a product, product group, or similar." ;
    rdfs:seeAlso schema:Brand ;
    ha:hasContributor <https://schema.org/docs/collab/GoodRelationsClass> ;
     .

ha:BroadcastEvent a rdfs:Class ;
    rdfs:label "broadcast event"@en, "Événement de radiodiffusion"@fr, "Uitzendingsevenement"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:BroadcastEvent ;
    rdfs:comment "An over the air or online broadcast event."@en, "Un événement diffusé par voie hertzienne ou en ligne."@fr, "Een evenement dat via de ether of online wordt uitgezonden."@nl ;
     .

ha:Captioning a rdfs:Class ;
    rdfs:label "captioning"@en, "Sous-titrage"@fr, "Ondertitels"@nl ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Captioning> ;
    rdfs:comment "To signal the presence of hard of hearing captioning."@en, "Pour signaler la présence de sous-titres pour le durcissement dur."@fr, "Om de aanwezigheid van ondertitels voor hardhorigen te signaleren."@nl ;
     .

ha:CarrierRepresentation a rdfs:Class ;
    rdfs:label "carrier representation"@en, "Représentation de porteur"@fr, "Drager representatie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf premis:Representation ;
    rdfs:comment "A physical or digital representation of an archived intellectual entity that is stored on a physical carrier such as a video tape, film reel, paper or canvas."@en, "Une représentation physique ou numérique d'une entité intellectuelle (Intellectual Entity) archivée qui est stockée sur un porteur physique tel qu'une bande vidéo, une bobine de film, du papier ou une toile."@fr, "Een fysieke of digitale weergave van een gearchiveerde intellectuele entiteit (Intellectual Entity) die is opgeslagen op een fysieke drager zoals een videoband, filmrol, papier of canvas."@nl ;
     .

ha:Cast a rdfs:Class ;
    rdfs:label "cast"@en ;
    rdfs:comment """A member of the cast list (a list of performers/actors and associated fictitious
            characters)."""@en ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Cast> ;
     .

ha:ChangeEvent a rdfs:Class, owl:Class ;
    rdfs:label "change event"@en, "evento de cambio"@es, "Évènement"@fr, "Evento di cambiamento"@it ;
    rdfs:comment "Represents an event which resulted in a major change to an organization such as a merger or complete restructuring. It is intended for situations where the resulting organization is sufficient distinct from the original organizations that it has a distinct identity and distinct URI. Extension vocabularies should define sub-classes of this to denote particular categories of event. The instant or interval at which the event occurred should be given by `prov:startAtTime` and `prov:endedAtTime`, a description should be given by `dct:description`. "@en, "Evento que da como resultado un cambio sustancial en la organización, por ejemplo, una fusión o una reestructuración total. Está pensado para situaciones en las que la organización resultante es lo suficientemente distinta de las organizaciones originales, tiene una identidad distinta y una URI también distinta. Se deberían definir subtipos de eventos mediante vocabularios específicos (Extension vocabularies) para referirse a categorías de eventos específicos. El momento o periodo en el que el evento ocurre se debería expresar mediante las propiedades `prov:startAtTime` y `prov:endedAtTime`, y una descripción del mismo se debería incluir mediante el uso de la propiedad `dct:description`."@es, "Représente un Évènement impliquant un changement majeur dans l'Organisation, comme une fusion ou une restructuration. Prévu pour des situations ou l'organisation finale est suffisamment différente des Organisations originales pour qu'elle ait une identité et une URI distinctes. Des vocabulaires d'extension devraient définir des sous-classes de celle-ci pour annoter les différentes catégories d'Évènemenents. Le moment ou l'intervalle de l'Évènement devrait être indiqué avec `prov:startAtTime` et `prov:endedAtTime`, et une description avec la classe `dct:description`. "@fr, "Rappresenta un evento risultato essere un importante cambiamento per un'organizzazione come ad esempio una fusione o una riorganizzazione. È pensato per quelle situazioni in cui l'organizzazione risultante si distingue da quella originale sufficientemente da essere rappresentata con una URI differente. Le estensioni del vocabolario dovrebbero definire le sotto-classi per esprimere particolari categorie di eventi. L'istante o l'intervallo in cui l'evento accade dovrebbe essere espresso tramite `prov:startAtTime` e`prov:endedAtTime`. Una descrizione dovrebbe essere fornita attraverso `dct:description`."@it, "合併や完全な再編などの組織に大きな変化をもたらした出来事を表わします。これは、結果として作成される組織と元の組織とが、別のアイデンティティーと別のURIを持つに足るほど異なる状況を対象としています。"@ja ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://www.w3.org/ns/org#ChangeEvent> ;
    rdfs:subClassOf prov:Activity ;
     .

ha:ClosedCaptions a rdfs:Class ;
    rdfs:label "closed captions"@en, "Légende fermée"@fr, "Gesloten ondertitels"@nl ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ClosedCaptions> ;
    rdfs:comment "Closed captioning is provided as separate content."@en, "Le sous-titrage fermé est fourni en tant que contenu distinct."@fr, "Gesloten bijschrift wordt verstrekt als afzonderlijke inhoud."@nl ;
     .

ha:Collection a rdfs:Class ;
    rdfs:label "collection"@en, "Collection"@fr, "Collectie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:Collection ;
    rdfs:subClassOf ha:CreativeWork ;
    rdfs:comment "A collection of items, e.g. creative works or products, typically but not necessarily of the same kind."@en, "Une collection d'articles, par exemple des œuvres créatives (creative works) ou des produits, généralement mais pas nécessairement de même type."@fr, "Een collectie van items, bv. creatieve werken (creative works) of producten, gewoonlijk maar niet altijd van dezelfde soort."@nl ;
     .

ha:ContactPoint a rdfs:Class ;
    rdfs:label "contact point"@en, "Point de contact"@fr, "Aanspreek-/meldpunt"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:ContactPoint ;
    rdfs:comment "A contact point, for example a Customer Complaints department."@en, "Un point de contact, par exemple un département des plaintes clients."@fr, "Een aanspreekpunt, zoals een afdeling voor klachten van klanten."@nl ;
     .

ha:ContentPartner a rdfs:Class ;
    rdfs:label "content partner"@en, "Partenaire de contenus"@fr, "Contentpartner"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:Organization ;
    rdfs:comment "A content partner is an organization that has signed a collaboration agreement with meemoo for the long-term preservation and dissemination of their content."@en, "Un partenaire de contenu est une organisation qui a signé une convention de collaboration avec meemoo pour la préservation à long terme et la diffusion de leur contenu."@fr, "Een contentpartner is een organisatie die een samenwerkingovereenkomst heeft ondertekend met meemoo voor de langetermijnpreservatie en ontsluiting van hun materiaal."@nl ;
     .

ha:ContentRange a rdfs:Class ;
    rdfs:label "content range"@en, "Plage de contenu"@fr, "Inhoudsbereik"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:comment "The intended reach of the object's media content of the. For example, whether it is about the full content or only a part."@en, "La portée prévue du contenu multimédia de l'objet du.Par exemple, qu'il s'agisse du contenu complet ou seulement une pièce."@fr, "Het beoogde bereik van de mediainhoud van het object. Bijvoorbeeld, of het over de volledige inhoud gaat of slechts een deel."@nl ;
     .

ha:Country a rdfs:Class ;
    rdfs:label "country"@en, "Pays"@fr, "Land"@nl ;
    rdfs:comment "A country."@en, "Un pays."@fr, "Een land."@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:Country ;
     .

ha:CreativeWork a rdfs:Class ;
    rdfs:label "creative work"@en, "Travail créatif"@fr, "Creatief werk"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:CreativeWork ;
    rdfs:subClassOf ha:Thing ;
    rdfs:comment "The most generic kind of creative work, including books, movies, photographs, software programs, etc."@en, "La plus générique des types de travail créatif (CreativeWork), y compris les livres, les films, les photos, les logiciels, etc."@fr, "De meest generieke soort van creatief werk (CreativeWork), zoals boeken, films, foto's, programma's, enz."@nl ;
     .

ha:CreativeWorkSeason a rdfs:Class ;
    rdfs:label "creative work season"@en, "Saison du travail créatif"@fr, "Creatief werk seizoen"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:CreativeWorkSeason ;
    rdfs:subClassOf ha:CreativeWork ;
    rdfs:comment "A media season e.g. tv, radio, video game etc."@en, "Une saison médiatique, par exemple tv, radio, jeu vidéo etc."@fr, "Een mediaseizoen, bijvoorbeeld tv, radio, videogame etc."@nl ;
     .

ha:CreativeWorkSeries a rdfs:Class ;
    rdfs:label "creative work series"@en, "Série du travail créatif"@fr, "Serie van het creatief werk"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:CreativeWorkSeries ;
    rdfs:subClassOf ha:CreativeWork ;
    rdfs:comment "A CreativeWorkSeries in schema.org is a group of related items, typically but not necessarily of the same kind. CreativeWorkSeries are usually organized into some order, often chronological. Unlike ItemList which is a general purpose data structure for lists of things, the emphasis with CreativeWorkSeries is on published materials (written e.g. books and periodicals, or media such as tv, radio and games)."@en, "Un CreativeWorkSeries dans schema.org est une série d'objets, typiquement mais pas forcément du même type. CreativeWorkSeries sont généralement organisées dans un certain ordre, souvent chronologique. Contrairement à ItemList, l'importance des CreativeWorkSeries est sur les matériaux publiés (par exemple des livres et des périodiques, ou des médias tels que tv, radio et jeux vidéo)."@fr, "Een CreativeWorkSeries in schema.org is een groep vergelijkbare items, meestal maar niet altijd van dezelfde soort. CreativeWorkSeries zijn meestal gegroepeerd in een bepaalde volgorde, vaak chronologisch. In tegenstelling tot ItemList, ligt de nadruk van CreativeWorkSeries op gepubliceerd materiaal (bijvoorbeeld boeken en periodieken, of media zoals tv, radio en games)."@nl ;
     .

ha:DVD a rdfs:Class ;
    rdfs:label "DVD"@en, "DVD"@fr, "Dvd"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf premis:IntellectualEntity ;
    rdfs:comment "This class applies to media in meemoo's archive that is originally derived from an analog carrier of type DVD, and represents the DVD as a whole."@en, "Cette classe s'applique aux médias dans les archives de meemoo qui proviennent à l'origine d'un support analogue du type DVD, et représentent le DVD dans son ensemble."@fr, "Deze klasse is van toepassing op media in meemoo's archief dat oorspronkelijk afkomstig is van een analoge drager van het type dvd, en de dvd als geheel voorstelt."@nl ;
     .

ha:DVDChapter a rdfs:Class ;
    rdfs:label "DVD chapter"@en, "Chapitre DVD"@fr, "Dvd-hoofdstuk"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf premis:IntellectualEntity ;
    rdfs:comment "This class applies to media in meemoo's archive that is originally derived from an analog carrier of type DVD, and represents a specific DVD chapter."@en, "Cette classe s'applique aux médias des archives de meemoo qui proviennent à l'origine d'un support analogue du type DVD, et représentent un chapitre DVD spécifique."@fr, "Deze klasse is van toepassing op media in meemoo's archief dat oorspronkelijk afkomstig is van een analoge drager van het type dvd, en een specifiek dvd-hoofdstuk voorstelt."@nl ;
     .

ha:DataFeedItem a rdfs:Class ;
    rdfs:label "DataFeedItem", "data feed item"@en ;
    rdfs:comment "A single item within a larger data feed." ;
    rdfs:seeAlso schema:DataFeedItem ;
     .

ha:DataType a rdfs:Class ;
    rdfs:label "DataType", "data type"@en ;
    rdfs:comment "The basic data types such as Integers, Strings, etc." ;
    rdfs:seeAlso schema:DataType ;
    rdfs:subClassOf rdfs:Class ;
     .

ha:Date a rdfs:Class, ha:DataType ;
    rdfs:label "Date", "date"@en ;
    rdfs:comment "A date value in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601)." ;
    rdfs:seeAlso schema:Date ;
     .

ha:DatedMoneySpecification a rdfs:Class ;
    rdfs:label "DatedMoneySpecification", "dated money specification"@en ;
    rdfs:comment "A DatedMoneySpecification represents monetary values with optional start and end dates. For example, this could represent an employee's salary over a specific period of time. __Note:__ This type has been superseded by [[MonetaryAmount]], use of that type is recommended." ;
    rdfs:seeAlso schema:DatedMoneySpecification ;
    schema:supersededBy ha:MonetaryAmount ;
     .

ha:DefinedRegion a rdfs:Class ;
    rdfs:label "defined region"@en ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
    rdfs:seeAlso schema:DefinedRegion ;
     .

ha:DigitalRepresentation a rdfs:Class ;
    rdfs:label "digital representation"@en, "Représentation digitale"@fr, "Digitale representatie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf premis:Representation ;
    rdfs:comment "Digital representation of an archived intellectual entity."@en, "Représentation digitale d'une entité intellectuelle (Intellectual Entity) archivée."@fr, "Digitale representatie van een gearchiveerde intellectuele entiteit (Intellectual Entity)."@nl ;
     .

ha:DigitizationPartner a rdfs:Class ;
    rdfs:label "digitization partner"@en, "Partenaire de digitalisation"@fr, "Digitaliseringspartner"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:ServiceProvider ;
    rdfs:comment "An organization that provides digitisation services to meemoo."@en, "Une organisation qui fournit des services de digitalisation à meemoo."@fr, "Een organisatie die aan meemoo digitaliseringsdiensten levert."@nl ;
     .

ha:Document a rdfs:Class ;
    rdfs:label "Document", "document"@en ;
    rdfs:comment "A document." ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/Document> ;
    owl:disjointWith ha:Project ;
    vs:term_status "testing" ;
     .

ha:EducationalPartner a rdfs:Class ;
    rdfs:label "educational partner"@en, "Partenaire éducatif"@fr, "Educatieve partner"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:Organization ;
    rdfs:comment "An educational partner is an organization that provides content on the 'Archief voor Onderwijs' platform and has signed the 'educational partner' collaboration agreement with meemoo (e.g. an educational publisher, KlasCement, Mediawijs, etc.)."@en, "Un partenaire éducatif est une organisation qui fournit du contenu sur la plateforme 'Archief voor Onderwijs' et a signé avec meemoo l'accord de collaboration 'partenaire éducatif' (par exemple, un éditeur scolaire, KlasCement, Mediawijs, etc.)."@fr, "Een educatieve partner is een organisatie die content aanbiedt op het 'Archief voor Onderwijs'-platform en met meemoo de samenwerkingsovereenkomst 'educatieve partner' heeft ondertekend (bv. een educatieve uitgeverij, KlasCement, Mediawijs, enz.)."@nl ;
     .

ha:Episode a rdfs:Class ;
    rdfs:label "episode"@en, "Épisode"@fr, "Aflevering"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:Episode ;
    rdfs:subClassOf ha:CreativeWork ;
    rdfs:comment "A media episode (e.g. TV, radio, video game) which can be part of a series or season."@en, "Un épisode médiatique (par exemple tv, radio, jeu vidéo) qui peut faire partie d'une série ou d'une saison."@fr, "Een media aflevering (bijvoorbeeld tv, radio, videogame) die deel uitmaakt van een serie of seizoen."@nl ;
     .

ha:FileFormat a rdfs:Class ;
    rdfs:label "file format"@en, "Format de fichier"@fr, "Bestandsformaat"@nl ;
    dct:description "Examples include the formats defined by the list of Internet Media Types."@en ;
    dct:hasVersion <http://dublincore.org/usage/terms/history/#FileFormat-001> ;
    dct:issued "2008-01-14"^^xsd:date ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:FileFormat ;
    rdfs:comment "A digital resource format."@en, "Un format de ressource numérique."@fr, "Een formaat van een digitale bron."@nl ;
     .

ha:Film a rdfs:Class ;
    rdfs:label "film"@en, "Film"@fr, "Film"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf premis:IntellectualEntity ;
    rdfs:comment "This class applies to media in meemoo's archive that is originally derived from an analog carrier of type film."@en, "Cette classe s'applique aux médias dans les archives de meemoo qui proviennent à l'origine d'un support analogue du type film."@fr, "Deze klasse is van toepassing op media in meemoo's archief dat oorspronkelijk afkomstig is van een analoge drager van het type film."@nl ;
     .

ha:FilmCarrierRepresentation a rdfs:Class ;
    rdfs:label "film carrier representation"@en, "Représentation de porteur de films"@fr, "Filmdrager representatie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:CarrierRepresentation ;
    rdfs:comment "A representation of an archived film that is stored on a analog film carrier such as a film stock."@en, "Une représentation d'un film archivé qui est stocké sur un porte-film analogique tel que bouton de cinéma."@fr, "Een weergave van een gearchiveerde film die is opgeslagen op een analoge filmdrager zoals pelicule."@nl ;
     .

ha:FormalOrganization a rdfs:Class, owl:Class ;
    rdfs:label "formal organization"@en, "organización formal"@es, "Organisation Formelle"@fr, "Organizzazione formale"@it ;
    rdfs:comment "An Organization which is recognized in the world at large, in particular in legal jurisdictions, with associated rights and responsibilities. Examples include a Corporation, Charity, Government or Church. Note that this is a super class of `gr:BusinessEntity` and it is recommended to use the GoodRelations vocabulary to denote Business classifications such as DUNS or NAICS."@en, "Organización reconocida a nivel mundial, en particular en jurisdicciones legales, con derechos y responsabilidades asociadas. Algunos ejemplos son: organización corporativa, organización benéfica, organización gubernamental, organización religiosa. Se debe tener en cuenta que ésta es una superclase de `gr:BusinessEntity` y que se recomienda el uso del vocabulario GoodRelations para referirse a clasificaciones de negocios tales como DUNS o NAICS."@es, "Une Organisation reconnue, en particulier par les juridictions locales, ayant des droits et des responsabilités. Exemples : entreprises, association à but non-lucratif, collectivité, église. Notez que c'est une super-classe de `gr:BusinessEntity` et qu'il est recommandé d'utiliser le vocabulaire GoodRelations pour indiquer les classifications économiques comme le code NACE."@fr, "Un'organizzazione che è riconosciuta a livello mondiale o, in generale, all'interno di una qualche giurisdizione, e che quindi possiede diritti e responsabilità. Ad esempio aziende, enti governativi, associazioni di volontariato. Si noti che questa è una superclasse di `gr:BusinessEntity` e che quindi è raccomandabile usare il vocabolario GoodRelations per esprimere classificazioni di tipo industriale e commerciale come DUNS e NAICS."@it, "関連する権利と責任を有する（特に法的管轄区域において）世界中に広く認識されている組織。例には、企業、慈善団体、政府や教会が含まれます。"@ja ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://www.w3.org/ns/org#FormalOrganization> ;
    rdfs:subClassOf ha:Organization ;
     .

ha:Format a rdfs:Class ;
    rdfs:label "format"@en ;
    rdfs:comment """The format provides technical information on
            the format of a Resource. A BusinessObject can be instantiated in a variety of Resources
            each in a particular Format. Other specific data formats may be defined as subclasses of
            format."""@en ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> ;
    rdfs:subClassOf skos:Concept ;
     .

ha:Fragment a rdfs:Class ;
    rdfs:label "fragment"@en, "Fragment Mediahaven"@fr, "Mediahavenfragment"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:comment "A fragment in the Mediahaven asset management system."@en, "Un fragment dans le système de gestion d'actifs Mediahaven."@fr, "Een fragment in het Mediahaven asset management systeem."@nl ;
     .

ha:FragmentRepresentation a rdfs:Class ;
    rdfs:label "fragment representation"@en, "Représentation fragment"@fr, "Fragment representatie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:DigitalRepresentation ;
    owl:equivalentClass ha:MediaFragment ;
    rdfs:comment "A spatial or temporal segment of a file that serves as a partial digital representation of an archived Intellectual Entity."@en, "Un segment spatial ou temporel d'un fichier qui sert de représentation numérique partielle d'une entité intellectuelle archivée."@fr, "Een spatiaal of temporeel segment van een bestand die fungeert als een partiële digitale representatie van een gearchiveerde intellectuele entiteit (Intellectual Entity)."@nl ;
     .

ha:GeoCoordinates a rdfs:Class ;
    rdfs:label "GeoCoordinates", "geo coordinates"@en ;
    rdfs:comment "The geographic coordinates of a place or event." ;
    rdfs:seeAlso schema:GeoCoordinates ;
     .

ha:GeoShape a rdfs:Class ;
    rdfs:label "GeoShape", "geo shape"@en ;
    rdfs:comment "The geographic shape of a place. A GeoShape can be described using several properties whose values are based on latitude/longitude pairs. Either whitespace or commas can be used to separate latitude and longitude; whitespace should be used when writing a list of several such points." ;
    rdfs:seeAlso schema:GeoShape ;
    ha:hasContributor <https://schema.org/docs/collab/rNews> ;
     .

ha:HealthInsurancePlan a rdfs:Class ;
    rdfs:label "health insurance plan"@en ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
    rdfs:seeAlso schema:HealthInsurancePlan ;
     .

ha:Image a rdfs:Class ;
    rdfs:label "image"@en, "Image"@fr, "Afbeelding"@nl ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://purl.org/dc/dcmitype/Image> ;
    rdfs:subClassOf premis:IntellectualEntity ;
    rdfs:comment "This class applies to media in meemoo's archive that is originally derived from a digital born image or an analog carrier of type image."@en, "Cette classe s'applique aux médias dans les archives de meemoo qui proviennent à l'origine d'une image née numérique ou d'un support analogue du type vidéo."@fr, "Deze klasse is van toepassing op media in meemoo's archief dat oorspronkelijk afkomstig is van een digitaal geboren afbeelding of van een analoge drager van het type afbeelding."@nl ;
     .

ha:ImageObject a rdfs:Class ;
    rdfs:label "ImageObject", "image object"@en ;
    rdfs:comment "An image file." ;
    rdfs:seeAlso schema:ImageObject ;
    owl:equivalentClass ha:Image ;
     .

ha:ImageReel a rdfs:Class ;
    rdfs:label "image reel"@en, "Bobine d'image"@fr, "Beeldspoel"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:PhysicalCarrier ;
    rdfs:comment "A reel of an analog film carrier that contains video."@en, "Une bobine d'un porte-film analogique qui contient une vidéo."@fr, "Een speo van een analoge film drager die beeld bevat."@nl ;
     .

ha:Integer a rdfs:Class ;
    rdfs:label "Integer", "integer"@en ;
    rdfs:comment "Data type: Integer." ;
    rdfs:seeAlso schema:Integer ;
     .

ha:Issue a rdfs:Class ;
    rdfs:label "issue"@en ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
    rdfs:seeAlso <http://purl.org/ontology/bibo/Issue> ;
     .

ha:Jurisdiction a rdfs:Class ;
    rdfs:label "jurisdiction"@en ;
    dct:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "The extent or range of judicial, law enforcement, or other authority."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:Jurisdiction ;
     .

ha:LocalIdentifier a rdfs:Class ;
    rdfs:label "local identifier"@en, "Identifiant local"@fr, "Lokale identificatie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment "A local identifier for an object defined by or known to the content partner, such as a barcode, an identifier from an external database or the identifier in the contentpartner's collection registration system."@en, "Un identifiant local pour un objet défini par ou connu par le partenaire de contenu, par exemple un code barre, un identifiant d'une base de données externe ou l'identifiant dans le système d'enregistrement de collection du partenaire de contenu."@fr, "Een lokale identificatie voor een object gedefinieerd door of bekend bij de contentpartner, bijvoorbeeld een barcode, een identificatie uit een externe database of de identificatie in het registratiesysteem van de collectie van de contentpartner."@nl ;
     .

ha:Location a rdfs:Class ;
    rdfs:label "location"@en ;
    dct:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A spatial region or named place."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:Location ;
     .

ha:Logo a rdfs:Class ;
    rdfs:label "logo"@en, "Logo"@fr, "Logo"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:comment "A logo is a graphic mark, emblem, or symbol of an organization."@en, "Un logo est une marque, un emblème ou un symbole graphique d'une organisation."@fr, "Een logo is een grafisch teken, embleem of symbool van een organisatie."@nl ;
     .

ha:MaterialArtwork a rdfs:Class ;
    rdfs:label "material artwork"@en, "Œuvres d'art matérielles"@fr, "Materieel kunstwerk"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf premis:IntellectualEntity ;
    rdfs:comment "This class applies to media in meemoo's archive that is originally derived from any form of visual art that entirely exists in physical reality, in space and time."@en, "Cette classe s'applique aux médias dans les archives de Meemoo qui dérivent à l'origine de toute forme d'art visuel qui existe entièrement dans la réalité physique, dans l'espace et le temps."@fr, "Deze klasse is van toepassing op media in meemoo's archief dat oorspronkelijk afkomstig is van elke vorm van visuele kunst dat volledig in de fysieke realiteit bestaat, in ruimte en tijd."@nl ;
     .

ha:MediaFragment a rdfs:Class, owl:Class ;
    rdfs:label "media fragment"@en ;
    rdfs:comment "A media fragment (spatial, temporal, track...) composing a media resource. In other ontologies fragment is sometimes referred to as a 'part' or 'segment'.", "A MediaFragment is a temporal or spatial segment of a resource identified by a MediaGragment URI (http://www.w3.org/2008/WebVideo/Fragments/WD-media-fragments-spec/)."@en ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaFragment>, <http://www.w3.org/ns/ma-ont#MediaFragment> ;
     .

ha:MediaResource a rdfs:Class ;
    rdfs:label "media resource"@en ;
    rdfs:comment """The use of MediaResource is reserved to
            audiovisual content. In a production process, several MediaResources can be edited and assembled to realsie an Essence ready for distribution (see IMF package and OPL)"""@en ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ;
     .

ha:MediaTypeOrExtent a rdfs:Class ;
    rdfs:label "media type or extent"@en ;
    dct:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A media type or extent."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:MediaTypeOrExtent ;
     .

ha:MerchantReturnPolicySeasonalOverride a rdfs:Class ;
    rdfs:label "merchant return policy seasonal override"@en ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
    rdfs:seeAlso schema:MerchantReturnPolicySeasonalOverride ;
     .

ha:MimeType a rdfs:Class ;
    rdfs:label "mime type"@en ;
    rdfs:comment """The definition of the container if available as
            a MIME type. This is provided as free text in an annotation label or as an identifier
            pointing to a term in a classification scheme. For more information:
            http://www.iana.org/assignments/media-types/index.html."""@en ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MimeType> ;
     .

ha:MonetaryAmount a rdfs:Class ;
    rdfs:label "MonetaryAmount", "monetary amount"@en ;
    rdfs:comment "A monetary value or range. This type can be used to describe an amount of money such as $50 USD, or a range as in describing a bank account being suitable for a balance between £1,000 and £1,000,000 GBP, or the value of a salary, etc. It is recommended to use [[PriceSpecification]] Types to describe the price of an Offer, Invoice, etc." ;
    rdfs:seeAlso schema:MonetaryAmount ;
    ha:hasContributor <https://schema.org/docs/collab/FIBO> ;
     .

ha:Motivation a rdfs:Class ;
    rdfs:label "motivation"@en, "Motivation"@fr, "Motivatie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment "Motivation for an access limitation."@en, "Motivation pour une limitation d'accès."@fr, "Motivatie voor een ontsluitingsbeperking."@nl ;
     .

ha:Newspaper a rdfs:Class ;
    rdfs:label "newspaper"@en, "Journal"@fr, "Krant"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:Newspaper ;
    rdfs:subClassOf ha:CreativeWorkSeries ;
    rdfs:comment "A publication containing information about varied topics that are pertinent to general information, a geographic area, or a specific subject matter (i.e. business, culture, education). Often published daily."@en, "Publication contenant des informations sur des sujets variés relatifs à l'information générale, à une zone géographique ou à un sujet spécifique (par exemple, les affaires, la culture, l'éducation). Souvent publié quotidiennement."@fr, "Een publicatie met informatie over gevarieerde onderwerpen die relevant zijn voor algemene informatie, een geografisch gebied of een specifiek onderwerp (bijv. zaken, cultuur, onderwijs). Wordt vaak dagelijks gepubliceerd."@nl ;
     .

ha:NewspaperIssue a rdfs:Class ;
    rdfs:label "newspaper issue"@en, "Edition de journal"@fr, "Kranteneditie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf premis:IntellectualEntity ;
    rdfs:comment "This class applies to media in meemoo's archive that is originally derived from an analog carrier of type newspaper, and represents the newspaper edition as a whole."@en, "Cette classe s'applique aux médias dans les archives de meemoo qui proviennent à l'origine d'un support analogue du type journal, et représentent l'édition du journal dans son ensemble."@fr, "Deze klasse is van toepassing op media in meemoo's archief dat oorspronkelijk afkomstig is van een analoge drager van het type krant, en de kranteneditie als geheel voorstelt."@nl ;
     .

ha:NewspaperIssuePage a rdfs:Class ;
    rdfs:label "newspaper issue page"@en, "Page d'édition de journal"@fr, "Kranteneditiepagina"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf premis:IntellectualEntity ;
    rdfs:comment "This class applies to media in meemoo's archive that is originally derived from an analog carrier of type newspaper, and represents a specific newspaper page."@en, "Cette classe s'applique aux médias des archives de meemoo qui proviennent à l'origine d'un support analogue du type journal, et représentent une page de journal spécifique."@fr, "Deze klasse is van toepassing op media in meemoo's archief dat oorspronkelijk afkomstig is van een analoge drager van het type krant, en een specifieke krantenpagina voorstelt."@nl ;
     .

ha:ObjectType a rdfs:Class ;
    rdfs:label "object type"@en ;
    rdfs:comment """To specify the type of BusinessObject e.g. and
            EditorialObject of type "programme" or clip". This is
            provided as free text in an annotation label or as an identifier pointing to a term in a
            classification scheme e.g.
            http://www.ebu.ch/metadata/ontologies/skos/ebu_ObjectTypeCodeCS.rdf."""@en ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ObjectType> ;
     .

ha:OpenCaptions a rdfs:Class ;
    rdfs:label "open captions"@en, "Sous-titres ouverts"@fr, "Open ondertitels"@nl ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#OpenCaptions> ;
    rdfs:comment "Open Captions are burned in the image."@en, "Open bijschriften worden in de afbeelding gebrand."@en, "Les légendes ouvertes sont brûlées dans l'image."@fr ;
     .

ha:Organization a rdfs:Class, owl:Class ;
    rdfs:label "organization"@en, "Organisation"@fr, "Organisatie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://www.w3.org/ns/org#Organization>, schema:Organization ;
    rdfs:subClassOf ha:Thing ;
    owl:disjointWith ha:Person ;
    rdfs:comment "An organization such as a school, NGO, corporation, club, etc."@en, "Represents a collection of people organized together into a community or other social, commercial or political structure. The group has some common purpose or reason for existence which goes beyond the set of people belonging to it and can act as an Agent. Organizations are often decomposable into hierarchical structures.  It is recommended that SKOS lexical labels should be used to label the Organization. In particular `skos:prefLabel` for the primary (possibly legally recognized name), `skos:altLabel` for alternative names (trading names, colloquial names) and `skos:notation` to denote a code from a code list. Alternative names: _Collective_ _Body_ _Org_ _Group_"@en, "Représente un groupe de personnes organisées en communauté où tout autre forme de structure sociale, commerciale ou politique. Le groupe a un but commun ou une raison d'être qui va au-delà de la somme des personnes qui en font partie et peut agir en tant que `Agent`. Les organisations sont souvent décomposables en structures hiérarchisées. Il est recommandé d'utiliser des labels lexicaux SKOS pour nommer l'Organisation. En particulier `skos:prefLabel` pour le nom principal (en général le nom légal), `skos:altLabel` pour les noms alternatifs (marques, sigles, appellations familières) et `skos:notation` pour indiquer un code provenant d'une liste de codes."@fr, "Une organisation telle que une école, une ONG, une société, un club, etc."@fr, "Een organisatie zoals een school, NGO, corporatie, club, enz."@nl, "Stelt een groep personen voor, georganiseerd in een gemeenschap of een andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of reden van bestaan dat verder gaat dan de som van de mensen die ertoe behoren en kan handelen als `Agent`. De organisaties zijn vaak onder te verdelen in hiërarchische structuren. Het wordt aanbevolen om SKOS labels te gebruiken om de organisatie te benoemen. In het bijzonder `skos:prefLabel` voor de primaire (mogelijks juridisch geldende) naam, `skos:altLabel` voor alternatieve namen (handelsnamen, colloquialismen) en `skos:notation` om een code aan te duiden uit een codelijst."@nl ;
     .

ha:OrganizationType a rdfs:Class ;
    rdfs:label "organization type"@en, "Type de organisation"@fr, "Organisatietype"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment "The type or classification of an organization."@en, "Le type ou la classification d'une organisation."@fr, "Het type of de classificatie van een organisatie."@nl ;
     .

ha:OrganizationalUnit a rdfs:Class, owl:Class ;
    rdfs:label "organizational unit"@en, "Unité opérationnelle"@fr, "Organisatie-eenheid"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://www.w3.org/ns/org#OrganizationalUnit> ;
    rdfs:subClassOf ha:Organization ;
    rdfs:comment "An Organization such as a University Support Unit which is part of some larger FormalOrganization and only has full recognition within the context of that FormalOrganization, it is not a Legal Entity in its own right. Units can be large and complex containing other Units and even FormalOrganizations. Alternative names: _OU_ _Unit_ _Department_"@en, "Une organisation (par exemple le support informatique d'une université) qui fait partie d'une Organisation Formelle plus importante et qui ne peut être reconnue qu'en tant que membre de cette organisation supérieure, ce n'est pas une entité légale en elle-même. Les unités opérationnelles peuvent être étendues, complexes et inclure elles-mêmes d'autres branches ou Unités Opérationnelles, voire des Organisations Formelles."@fr, "Een organisatie zoals een afdeling of dienst die deel uitmaakt van de grotere organisatie en zijn bestaansreden daaraan ontleent. Heeft geen juridische status op zich."@nl ;
     .

ha:PerformanceRole a rdfs:Class ;
    rdfs:label "performance role"@en, "Rôle de performance"@fr, "Uitvoeringsrol"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:PerformanceRole ;
    rdfs:subClassOf ha:Role ;
    rdfs:comment "A PerformanceRole is a Role that some entity places with regard to a theatrical performance, e.g. in a Movie, TVSeries etc."@en, "Un PerformanceRole est un rôle qu'une entité remplit dans le cadre d'une représentation théâtrale, par exemple dans un film, une série télévisée etc."@fr, "Een PerformanceRole is een rol die een entiteit vertolkt met betrekking tot een theatrale uitvoering, bijvoorbeeld in een film, televisieserie etc."@nl ;
     .

ha:PeriodOfTime a rdfs:Class ;
    rdfs:label "period of time"@en ;
    dct:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "An interval of time that is named or defined by its start and end dates."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:PeriodOfTime ;
     .

ha:Person a rdfs:Class ;
    rdfs:label "person"@en, "Personne"@fr, "Persoon"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:Person ;
    rdfs:subClassOf ha:Thing ;
    rdfs:comment "A person (alive, dead, undead, or fictional)."@en, "Une personne (vivante, morte, non-morte ou fictive)."@fr, "Een persoon (levend, dood, ondood, of fictief)."@nl ;
     .

ha:PhysicalCarrier a rdfs:Class ;
    rdfs:label "physical carrier"@en, "Porteur physique"@fr, "Fysieke drager"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf premis:StorageLocation ;
    rdfs:comment "A physical carrier in which data, sound, images, etc., are stored.  For certain categories of material, the physical carrier consists of a storage medium (e.g., tape, film) sometimes encased in a plastic, metal, etc., housing (e.g., cassette, cartridge) that is an integral part of the item."@en, "Un porteur physique dans lequel les données, le son, les images, etc., sont stockées.Pour certaines catégories de matériaux, le support physique se compose d'un support de stockage (par exemple, du ruban adhésif, du film) parfois enfermé dans un boîtier en plastique, en métal, etc., (par exemple, cassette, cartouche) qui fait partie intégrante de l'article."@fr, "Een fysieke drager waarop data, geluid, beeld etc. zijn opgeslagen. Voor bepaalde materiaalcategorieën bestaat de fysieke drager uit een opslagmedium (bijv. tape, film), soms verpakt in een plastic, metalen, enz. behuizing (bijv. cassette, cartridge) die een integraal onderdeel vormt van het item."@nl ;
     .

ha:Place a rdfs:Class ;
    rdfs:label "place"@en, "Lieu"@fr, "Plaats"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:Place ;
    rdfs:subClassOf ha:Thing ;
    rdfs:comment "Entities that have a somewhat fixed, physical extension."@en, "Entités qui ont une extension physique quelque peu fixée."@fr, "Entiteiten die een enigszins vastliggende, fysieke uitbreiding hebben."@nl ;
     .

ha:Post a rdfs:Class, owl:Class ;
    rdfs:label "post"@en, "Poste"@fr, "Positie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://www.w3.org/ns/org#Post> ;
    rdfs:comment "A Post represents some position within an organization that exists independently of the person or persons filling it. Posts may be used to represent situations where a person is a member of an organization ex officio (for example the Secretary of State for Scotland is part of UK Cabinet by virtue of being Secretary of State for Scotland, not as an individual person). A post can be held by multiple people and hence can be treated as a organization in its own right."@en, "Un Poste représente une position au sein d'une Organisation qui existe indépendamment de la personne ou des personnes qui le remplissent. Les postes peuvent être utilisés pour représenter des situations où une personne est membre d'une Organisation d'office (par exemple, le Secrétaire d'Etat pour l'Ecosse fait partie du Cabinet du Royaume-Uni du fait d'être Secrétaire d'Etat pour l'Ecosse, non pas comme une personne physique). Un poste après peut être occupé par plusieurs personnes et peut donc être considéré comme une Organisation à part entière."@fr, "Functie binnen een organisatie, kan bestaan los van de persoon/personen die ze invult/invullen."@nl ;
     .

ha:PostalAddress a rdfs:Class ;
    rdfs:label "postal address"@en, "Adresse postale"@fr, "Postadres"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:PostalAddress ;
    rdfs:subClassOf ha:ContactPoint ;
    rdfs:comment "The mailing address."@en, "L'adresse postale."@fr, "Het postadres."@nl ;
     .

ha:Product a rdfs:Class ;
    rdfs:label "Product", "product"@en ;
    rdfs:comment "Any offered product or service. For example: a pair of shoes; a concert ticket; the rental of a car; a haircut; or an episode of a TV show streamed online." ;
    rdfs:seeAlso schema:Product ;
    rdfs:subClassOf ha:Thing ;
    ha:hasContributor <https://schema.org/docs/collab/GoodRelationsTerms> ;
     .

ha:Project a rdfs:Class ;
    rdfs:label "Project", "project"@en ;
    rdfs:comment "A project (a collective endeavour of some kind)." ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/Project> ;
    vs:term_status "unstable" ;
     .

ha:ProjectPartner a rdfs:Class ;
    rdfs:label "project partner"@en, "Partenaire de projet"@fr, "Projectpartner"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:Organization ;
    rdfs:comment "An organization that collaborates with meemoo on projects formalized in an agreement or decision, such as projects within the Flemish cultural heritage decree, projects funded by the European Union, or other innovation and research projects."@en, "Une organisation qui collabore avec meemoo sur des projets formalisés dans un accord ou une décision, tels que des projets relevant du décret flamand sur le patrimoine culturel, des projets financés par l'Union européenne ou d'autres projets d'innovation et de recherche."@fr, "Een organisatie die samenwerkt met meemoo aan projecten die geformaliseerd zijn in een overeenkomst of besluit, zoals bijvoorbeeld projecten binnen het Vlaamse cultureelerfgoeddecreet, projecten onder financiering van de Europese Unie, of andere innovatie- en onderzoeksprojecten."@nl ;
     .

ha:Pub a rdfs:Class, owl:Class ;
    rdfs:label "pub"@en, "domaine public"@fr, "publiek domein"@nl ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/copyrightStatus/pub> ;
    rdfs:subClassOf premis:RightsStatus ;
    rdfs:comment "In the public domain and may used without copyright restriction."@en, "Dans le domaine public et peut être utilisé sans restriction du droit d'auteur."@fr, "In het publieke domein en kan zonder auteursrechtbeperking worden gebruikt."@nl ;
     .

ha:PublicationIssue a rdfs:Class ;
    rdfs:label "PublicationIssue", "publication issue"@en ;
    rdfs:comment "A part of a successively published publication such as a periodical or publication volume, often numbered, usually containing a grouping of works such as articles.\\n\\nSee also [blog post](http://blog.schema.org/2014/09/schemaorg-support-for-bibliographic_2.html)." ;
    rdfs:seeAlso schema:PublicationIssue ;
    rdfs:subClassOf ha:CreativeWork ;
    owl:equivalentClass ha:Issue ;
    ha:hasContributor <https://schema.org/docs/collab/bibex> ;
     .

ha:QuantitativeValue a rdfs:Class ;
    rdfs:label "quantitative value"@en, "Valeur quantitative"@fr, "Kwantitatieve waarde"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:QuantitativeValue ;
    rdfs:subClassOf ha:Thing ;
    rdfs:comment "A point value or interval for product characteristics and other purposes."@en, "Une valeur ponctuelle ou un intervalle pour les caractéristiques d'un produit et d'autres fins."@fr, "Een puntwaarde of interval voor producteigenschappen en andere doeleinden."@nl ;
     .

ha:Record a rdfs:Class ;
    rdfs:label "record"@en, "Enregistrement Mediahaven"@fr, "Mediahavenrecord"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:comment "A record in the Mediahaven asset management system."@en, "Un enregistrement dans le système de gestion d'actifs Mediahaven."@fr, "Een record in het Mediahaven asset management systeem."@nl ;
     .

ha:RightsStatement a rdfs:Class ;
    rdfs:label "rights statement"@en, "Déclaration des droits"@fr, "Rechtenverklaring"@nl ;
    dct:issued "2008-01-14"^^xsd:date ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:RightsStatement ;
    rdfs:comment "A statement about the intellectual property rights (IPR) held in or over a resource, a legal document giving official permission to do something with a resource, or a statement about access rights."@en, "Une déclaration sur les droits de propriété intellectuelle (DPI) a été maintenue dans ou au-dessus d'une ressource, un document légal donnant l'autorisation officielle de faire quelque chose avec une ressource ou une déclaration sur les droits d'accès."@fr, "Een verklaring over de intellectuele eigendomsrechten (IPR) van toepassing op of over een entiteit, een juridisch document dat officiële toestemming geeft om iets te doen met een entiteit, of een verklaring over toegangsrechten."@nl ;
     .

ha:Role a rdfs:Class, owl:Class ;
    rdfs:label "role"@en, "Rôle"@fr, "Rol"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://www.w3.org/ns/org#Role>, schema:Role ;
    rdfs:subClassOf skos:Concept, ha:Thing ;
    rdfs:comment "Denotes a role that a Person or other Agent can take in an organization. Instances of this class describe the abstract role; to denote a specific instance of a person playing that role in a specific organization use an instance of `org:Membership`. It is common for roles to be arranged in some taxonomic structure and we use SKOS to represent that. The normal SKOS lexical properties should be used when labelling the Role. Additional descriptive properties for the Role, such as a Salary band, may be added by extension vocabularies."@en, """Represents additional information about a relationship or property.
        For example a Role can be used to say that a 'member' role linking some SportsTeam to a player occurred during a particular time period.
        Or that a Person's 'actor' role in a Movie was for some particular characterName.
        Such properties can be attached to a Role entity, which is then associated with the main entities using ordinary properties like 'member' or 'actor'.
        """@en, "Indique le rôle qu'une Personne ou un autre Agent peut avoir dans une Organisation. Les instances de cette classe décrivent le rôle dans l'absolu; pour indiquer une personne ayant ce rôle spécifique dans une Organisation, utilisez une instance de `org:Membership`. Il est courant que les rôles soient organisés dans une sorte de taxonomie, ce qui peut être représenté avec SKOS. Les propriétés de libellés standards de SKOS devraient être utilisées pour libeller le Rôle. D'autres propriétés additionnelles pour ce rôle, comme une fourchette de Salaire peuvent être ajoutées par une extension de ce vocabulaire."@fr, """Représente des informations supplémentaires sur une relation ou une propriété.
        Par exemple, un rôle peut être utilisé pour indiquer que une rôle 'membre' (member role) qui lie une équipe sportive à un joueur, a eu lieu durant une période particulière.
        Ou que le rôle d''acteur' (actor role) d'une personne dans un film correspond à un nom de personnage particulier.
        Ces propriétés peuvent être attachées à un rôle d'entité (entity role), qui est ensuite associée aux entités principales en utilisant des propriétés ordinaires comme 'membre' (member) ou 'acteur' (actor).
        """@fr, "Rol die een persoon of agent kan vervullen in een organisatie."@nl, """Stelt bijkomende informatie voor over een relatie of eigenschap.
        Bijvoorbeeld: een rol kan worden gebruikt om aan te geven dat een 'lid'rol (member role) die een sportteam aan een speler verbond, tijdens een bepaalde periode voorviel.
        Of dat een persoons 'acteur'rol (actor role) in een film voor een bepaalde karakternaam was.
        Deze eigenschappen kunnen worden toegevoegd aan een rolentiteit, die dan geassocieerd wordt met de hoofdentiteiten via normale eigenschappen zoals 'lid' (member) of 'acteur' (actor).
        """@nl ;
     .

ha:RoleName a rdfs:Class ;
    rdfs:label "role name"@en, "Nom de rôle"@fr, "Rolnaam"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment "The role played, performed or filled by a thing, person or organization."@en, "Le rôle joué, joué ou rempli par une chose, une personne ou une organisation."@fr, "De rol gespeeld, uitgevoerd of gevuld door een ding, persoon of organisatie."@nl ;
     .

ha:SchemaDateTime a rdfs:Class, ha:DataType ;
    rdfs:label "DateTime", "schema date time"@en ;
    rdfs:comment "A combination of date and time of day in the form [-]CCYY-MM-DDThh:mm:ss[Z|(+|-)hh:mm] (see Chapter 5.4 of ISO 8601)." ;
    rdfs:seeAlso schema:DateTime ;
     .

ha:SchemaEvent a rdfs:Class ;
    rdfs:label "schema event"@en, "Événement"@fr, "Gebeurtenis"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:Event ;
    rdfs:subClassOf ha:Thing ;
    rdfs:comment "An event happening at a certain time and location, such as a concert, lecture, or festival."@en, "Un événement qui se déroule à un moment et dans un lieu donnés, comme un concert, une conférence ou un festival."@fr, "Een gebeurtenis die plaatsvindt op een gegeven moment en locatie, zoals een concert, een lezing of een festival."@nl ;
     .

ha:Service a rdfs:Class ;
    rdfs:label "Service", "service"@en ;
    rdfs:comment "A service provided by an organization, e.g. delivery service, print services, etc." ;
    rdfs:seeAlso schema:Service ;
     .

ha:ServiceConsumer a rdfs:Class ;
    rdfs:label "service consumer"@en, "Consomatteur de services"@fr, "Dienstenafnemer"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:Organization ;
    rdfs:comment "An organization that consumes services from meemoo, with a contractual relationship with meemoo. This is not a content partner, but a private organization that stores digital content at meemoo (e.g. Plantentuin Meise)."@en, "Une organisation qui consomme des services de meemoo, avec une relation contractuelle avec meemoo. Ce n'est pas un partenaire de contenu, mais une organisation privée qui stocke du contenu numérique chez meemoo (par exemple Plantentuin Meise)."@fr, "Een organisatie die diensten bij meemoo afneemt, met contractuele relatie met meemoo. Het gaat hier niet over een contentpartner, maar over een particuliere organisatie die digitale opslag doet bij meemoo (bv. Plantentuin Meise)."@nl ;
     .

ha:ServiceProvider a rdfs:Class ;
    rdfs:label "service provider"@en, "Fournisseur de services"@fr, "Dienstenleverancier"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:Organization ;
    rdfs:comment "An organization that provides services or goods to meemoo, for example related to IT, digitization, etc."@en, "Une organisation qui fournit des services ou des biens à meemoo, par exemple dans le domaine de l'informatique, de la numérisation, etc."@fr, "Een organisatie die aan meemoo diensten of goederen levert, bijvoorbeeld op het gebied van IT, digitalisering, enz."@nl ;
     .

ha:SilentFilm a rdfs:Class ;
    rdfs:label "silent film"@en, "Film muet"@fr, "Stomme film"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:Film ;
    rdfs:comment "This class applies to media in meemoo's archive that is originally derived from an analog carrier for silent film."@en, "Cette classe s'applique aux médias dans les archives de meemoo qui proviennent à l'origine d'un support analogue pour le film muet."@fr, "Deze klasse is van toepassing op media in meemoo's archief dat oorspronkelijk afkomstig is van een analoge drager voor stomme film."@nl ;
     .

ha:Site a rdfs:Class, owl:Class ;
    rdfs:label "site"@en, "Site"@fr, "Vestiging"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://www.w3.org/ns/org#Site> ;
    rdfs:comment "An office or other premise at which the organization is located. Many organizations are spread across multiple sites and many sites will host multiple locations. In most cases a Site will be a physical location. However, we don't exclude the possibility of non-physical sites such as a virtual office with an associated post box and phone reception service. Extensions may provide subclasses to denote particular types of site."@en, "Un établissement ou tout autre lieu dans lequel une Organisation est localisé. Beaucoup d'organisations sont dispersées à travers plusieurs sites. Dans la plupart des cas un Site sera un lieu physique. Toutefois, nous n'excluons pas la possibilité de sites non-physiques comme un bureau virtuel avec une boîte postale et un service de secrétariat mutualisé. Des extensions pourraient fournir des sous-classes pour décrire des types de sites particuliers."@fr, "Een kantoor of ander pand waar een organisatie gevestigd is. Organisaties kunnen over meerdere vestigingen verspreid zijn en vestigingen kunnen op meerdere locaties betrekking hebben."@nl ;
     .

ha:SizeOrDuration a rdfs:Class ;
    rdfs:label "size or duration"@en ;
    dct:description "Examples include a number of pages, a specification of length, width, and breadth, or a period in hours, minutes, and seconds."@en ;
    dct:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A dimension or extent, or a time taken to play or execute."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:SizeOrDuration ;
     .

ha:SoundFilm a rdfs:Class ;
    rdfs:label "sound film"@en, "Film sonore"@fr, "Geluidsfilm"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:Film ;
    rdfs:comment "This class applies to media in meemoo's archive that is originally derived from an analog carrier for sound film."@en, "Cette classe s'applique aux médias dans les archives de meemoo qui proviennent à l'origine d'un support analogue pour le film sonore."@fr, "Deze klasse is van toepassing op media in meemoo's archief dat oorspronkelijk afkomstig is van een analoge drager voor geluidsfilm."@nl ;
     .

ha:Text a rdfs:Class, ha:DataType ;
    rdfs:label "Text", "text"@en ;
    rdfs:comment "Data type: Text." ;
    rdfs:seeAlso schema:Text ;
     .

ha:TextAnnotation a rdfs:Class ;
    rdfs:label "text annotation"@en, "Annotation texte"@fr, "Tekstannotatie"@nl ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#TextAnnotation> ;
    rdfs:subClassOf ha:Annotation ;
    rdfs:comment "A class specific to the annotation of a text or portions of text."@en, "Une classe spécifique à l'annotation d'un texte ou de portions de texte."@fr, "Een klasse die specifiek is voor de annotatie van een tekst of delen van tekst."@nl ;
     .

ha:Thing a rdfs:Class ;
    rdfs:label "thing"@en, "Chose"@fr, "Ding"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:Thing ;
    rdfs:comment "The most generic type of item."@en, "Le type d'élément le plus générique."@fr, "Het meest generieke type item."@nl ;
     .

ha:ThreeDimensionalArtwork a rdfs:Class ;
    rdfs:label "three dimensional artwork"@en, "Œuvres d'art tridimensionnelles"@fr, "Driedimensionaal kunstwerk"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:MaterialArtwork ;
    rdfs:comment "This class applies to media in meemoo's archive that is originally derived from any form of visual art that exists in three dimensions. Two-dimensional artforms can include sculptures, installations, and three-dimensional paintings. It does not include two-dimensional artworks such as drawings, paintings, prints, and photographs."@en, "Cette classe s'applique aux médias des archives de Meemoo qui dérivent à l'origine de toute forme d'art visuel qui existe en trois dimensions.Les formes d'art bidimensionnelles peuvent inclure des sculptures, des installations et des peintures tridimensionnelles.Il n'inclut pas les œuvres bidimensionnelles telles que les dessins, les peintures, les imprimés et les photographies."@fr, "Deze klasse is van toepassing op media in meemoo's archief dat oorspronkelijk afkomstig is van elke vorm van visuele kunst die in drie dimensies bestaat. Driedimensionale kunstvormen kunnen sculpturen, installaties en driedimensionale schilderijen bevatten. Het omvat geen tweedimensionale kunstwerken zoals tekeningen, schilderijen, prints en foto's."@nl ;
     .

ha:TwoDimensionalArtwork a rdfs:Class ;
    rdfs:label "two dimensional artwork"@en, "Œuvres d'art bidimensionnel"@fr, "Tweedimensionaal kunstwerk"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:MaterialArtwork ;
    rdfs:comment "This class applies to media in meemoo's archive that is originally derived from any form of visual art that exists in two dimensions. Two-dimensional artforms can include drawings, paintings, prints, and photographs. It does not include three-dimensional artworks such as sculptures, installations, and three-dimensional paintings."@en, "Cette classe s'applique aux médias dans les archives de meemoo qui dérivent à l'origine de toute forme d'art visuel qui existe en deux dimensions. Les formes d'art bidimensionnelles peuvent inclure des dessins, des peintures, des imprimés et des photographies. Il n'inclut pas les œuvres d'art tridimensionnelles telles que les sculptures, les installations et les peintures tridimensionnelles."@fr, "Deze klasse is van toepassing op media in meemoo's archief dat oorspronkelijk afkomstig is van elke vorm van visuele kunst die in twee dimensies bestaat. Tweedimensionale kunstvormen kunnen tekeningen, schilderijen, prints en foto's bevatten. Het omvat geen driedimensionale kunstwerken zoals sculpturen, installaties en driedimensionale schilderijen."@nl ;
     .

ha:URL a rdfs:Class ;
    rdfs:label "URL", "URL"@en ;
    rdfs:comment "Data type: URL." ;
    rdfs:seeAlso schema:URL ;
     .

ha:UserGroup a rdfs:Class ;
    rdfs:label "user group"@en, "Groupe d'utilisateurs"@fr, "Gebruikersgroep"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:comment "Group of web platform users."@en, "Groupe d'utilisateurs de la plate-forme Web."@fr, "Groep van web platform gebruikers."@nl ;
     .

ha:Video a rdfs:Class ;
    rdfs:label "video"@en, "Vidéo"@fr, "Video"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf premis:IntellectualEntity ;
    rdfs:comment "This class applies to media in meemoo's archive that is originally derived from digital born video or an analog carrier of type video."@en, "Cette classe s'applique aux médias dans les archives de meemoo qui proviennent à l'origine de la vidéo née numérique ou à l'origine d'un support analogue du type vidéo."@fr, "Deze klasse is van toepassing op media in meemoo's archief dat oorspronkelijk afkomstig is van digitaal geboren video of dat oorspronkelijk afkomstig is van een analoge drager van het type video."@nl ;
     .

ha:WrittenWorkCarrierRepresentation a rdfs:Class ;
    rdfs:label "written work carrier representation"@en, "Représentation de porteur d'un travail écrit'"@fr, "Geschreven werk drager representatie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subClassOf ha:CarrierRepresentation ;
    rdfs:comment "A physical or digital representation of an archived written work that is stored on a physical carrier such as a printed newspaper or book."@en, "Une représentation physique ou numérique d'une œuvre écrite archivée qui est stockée sur un transporteur physique tel qu'un journal ou un livre."@fr, "Een fysieke of digitale weergave van een gearchiveerd geschreven werk dat is opgeslagen op een fysieke drager zoals een gedrukte krant of boek."@nl ;
     .

<https://data.hetarchief.be/id/collection/action> a skos:Collection ;
    skos:member ha:availableForConsultation, ha:downloadable ;
    skos:prefLabel "Ontsluitingsacties"@nl ;
     .

<https://data.hetarchief.be/id/collection/content-range> a skos:Collection ;
    skos:member ha:full, ha:partial ;
    skos:prefLabel "Inhoudsbereik"@nl ;
     .

<https://data.hetarchief.be/id/collection/metadata-range> a skos:Collection ;
    skos:member ha:extended, ha:limited ;
    skos:prefLabel "Metadatabereik"@nl ;
     .

<https://data.hetarchief.be/id/collection/user-group> a skos:Collection ;
    skos:member ha:betweenPartners, ha:educationalPublic, ha:intraMuros, ha:public, ha:researchPublic ;
    skos:prefLabel "Gebruikersgroepen"@nl ;
     .

ha:anonymous a owl:NamedIndividual, skos:Concept ;
    rdfs:label "anonymous"@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:comment "Indicates that the identity is intentionally withheld."@en, "Indique que l'identité est volontairement masquée."@fr, "Geeft aan dat de identiteit bewust niet wordt vermeld."@nl ;
    skos:prefLabel "anonymous"@en, "anonyme"@fr, "anoniem"@nl ;
     .

ha:contentRangeOperand a owl:NamedIndividual, skos:Concept, odrl:LeftOperand ;
    rdfs:label "content range operand"@en, "Plage de contenu"@fr, "Inhoudsbereik"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:comment "The intended reach of the object's media content of the. For example, whether it is about the full content or only a part."@en, "La portée prévue du contenu multimédia de l'objet du.Par exemple, qu'il s'agisse du contenu complet ou seulement une pièce."@fr, "Het beoogde bereik van de mediainhoud van het object. Bijvoorbeeld, of het over de volledige inhoud gaat of slechts een deel."@nl ;
    skos:prefLabel "Content range"@en, "Plage de contenu"@fr, "Inhoudsbereik"@nl ;
     .

ha:documents a owl:ObjectProperty ;
    rdfs:label "documents"@en, "généralise"@fr, "documenteert"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/doc> ;
    rdfs:subPropertyOf premis:relationship ;
    rdfs:comment "A relationship between information about an environment object and the environment object itself. For instance, a user manual has a “documents” relationship to the Open Office software application. Has a reciprocal relationship of isDocumentedIn."@en, "Une relation entre les informations sur un objet d'environnement et l'objet d'environnement lui-même. Par exemple, un manuel d'utilisation a une relation 'documents' avec l'application logicielle Open Office. A une relation réciproque avec isDocumentedIn."@fr, "Een relatie tussen informatie over een omgevingsobject en het omgevingsobject zelf. Bijvoorbeeld, een gebruikershandleiding heeft een 'documents'-relatie met de Open Office-softwareapplicatie. Heeft een wederkerige relatie met isDocumentedIn."@nl ;
     .

ha:executes a rdf:Property ;
    rdfs:label "executes"@en ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventRelatedAgentRole/exe> ;
     .

ha:fai a ha:Authority ;
    rdfs:label "fai"@en ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventOutcome/fai> ;
    ha:hasAuthoritativeLabel "fail" ;
     .

ha:hardwareAgentType a rdfs:Resource ;
    rdfs:label "hardware agent type"@en ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/agentType/har> ;
     .

ha:hasActor a rdf:Property ;
    rdfs:label "has actor"@en, "acteur"@fr, "acteur"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Person ;
    rdfs:seeAlso schema:actor ;
    rdfs:comment "An actor, e.g. in tv, radio, movie, video games etc., or in an event. Actors can be associated with individual items or with a series, episode, clip."@en, "Un acteur, par exemple à la télévision, à la radio, au cinéma, dans les jeux vidéo, etc. ou dans un événement. Les acteurs peuvent être associés à des éléments individuels ou à une série, un épisode, un clip."@fr, "Een acteur, bv. in tv, radio, film, videogames etc. of in een evenement. Acteurs kunnen geassocieerd worden met met individuele items of met een serie, aflevering, clip."@nl ;
     .

ha:hasAddressCountry a rdf:Property ;
    rdfs:label "has address country"@en, "partie de l'adresse concernant le pays"@fr, "deel van het adres met betrekking tot het land"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:addressCountry ;
    rdfs:comment "The country. For example, USA. You can also provide the two-letter [ISO 3166-1 alpha-2 country code](http://en.wikipedia.org/wiki/ISO_3166-1)."@en, "Le pays."@fr, "Het land."@nl ;
    schema:domainIncludes ha:DefinedRegion, ha:GeoCoordinates, ha:GeoShape, ha:PostalAddress ;
    schema:rangeIncludes ha:Country, ha:Text ;
     .

ha:hasAddressLocality a rdf:Property ;
    rdfs:label "has address locality"@en, "localitéAdresse"@fr, "adresPlaats"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:addressLocality ;
    rdfs:comment "The locality in which the street address is, and which is in the region. For example, Mountain View."@en, "La localité dans laquelle se trouve l'adresse de rue, et qui se trouve dans la région."@fr, "De plaats waar het straatadres zich bevindt, en de plaats van de regio."@nl ;
    schema:domainIncludes ha:PostalAddress ;
    schema:rangeIncludes ha:Text ;
     .

ha:hasAddressRegion a rdf:Property ;
    rdfs:label "has address region"@en, "addresseRegion"@fr, "adresRegio"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:addressRegion ;
    rdfs:comment "The region in which the locality is, and which is in the country. For example, California or another appropriate first-level [Administrative division](https://en.wikipedia.org/wiki/List_of_administrative_divisions_by_country)."@en, "La région dans laquelle se trouve la localité, et qui se trouve dans le pays. Par exemple, la Californie ou [une autre division administrative appropriée de premier niveau](https://fr.wikipedia.org/wiki/Liste_des_subdivisions_par_pays)."@fr, "De regio waarin de plaats zich bevindt, en die in het land ligt. Bijvoorbeeld, Californië of een ander geschikte [administratieve afdeling van het eerste niveau](https://nl.wikipedia.org/wiki/Bestuurslagen_per_land)."@nl ;
    schema:domainIncludes ha:DefinedRegion, ha:PostalAddress ;
    schema:rangeIncludes ha:Text ;
     .

ha:hasAlternateName a rdf:Property ;
    rdfs:label "has alternate name"@en, "nom alternatif"@fr, "alternatieve naam"@nl ;
    rdfs:domain ha:Thing ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:alternateName ;
    owl:equivalentProperty ha:hasAlternative ;
    rdfs:comment "An alias for the item"@en, "Un alias pour l'élément"@fr, "Een alias voor het item"@nl ;
     .

ha:hasAnnotationConfidence a rdf:Property ;
    rdfs:label "has annotation confidence"@en, "fiabilité des annotations"@fr, "annotatievertrouwen"@nl ;
    rdfs:domain ha:Annotation ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#annotationConfidence> ;
    rdfs:comment "To estimate the confidence in an Annotation."@en, "Pour estimer la confiance dans une annotation."@fr, "Om het vertrouwen in een annotatie te schatten."@nl ;
     .

ha:hasAnnotationRelatedAgent a rdf:Property ;
    rdfs:label "has annotation related agent"@en, "agent lié à l'Annotation"@fr, "agent verbonden aan de Annotatie"@nl ;
    rdfs:domain ha:Annotation ;
    rdfs:range xsd:anyURI, xsd:string ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasAnnotationRelatedAgent> ;
    rdfs:subPropertyOf ha:hasAnnotationPurpose ;
    rdfs:comment "To identify an Agent subject of the Annotation."@en, "Pour identifier un Agent de l'annotation."@fr, "Om een Agent van de annotatie te identificeren."@nl ;
     .

ha:hasAnnotationRelatedArtefact a rdf:Property ;
    rdfs:label "has annotation related artefact"@en, "artefact lié à l'Annotation"@fr, "artefact verbonden aan de Annotatie"@nl ;
    rdfs:domain ha:Annotation ;
    rdfs:range xsd:anyURI, xsd:string ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasAnnotationRelatedArtefact> ;
    rdfs:subPropertyOf ha:hasAnnotationPurpose ;
    rdfs:comment "To identify an Artefact subject of the Annotation."@en, "Pour identifier un objet d'artefact de l'annotation."@fr, "Om een artefactonderwerp van de annotatie te identificeren."@nl ;
     .

ha:hasAnnotationTarget a rdf:Property ;
    rdfs:label "has annotation target"@en, "cible d'annotation"@fr, "annotatiedoel"@nl ;
    rdfs:domain ha:Annotation ;
    rdfs:range xsd:anyURI ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasAnnotationTarget> ;
    rdfs:comment "To define the target object to which the Annotation applies."@en, "Pour définir l'objet cible auquel s'applique l'annotation."@fr, "Om het doelobject te definiëren waarop de annotatie van toepassing is."@nl ;
     .

ha:hasAnnotationType a rdf:Property ;
    rdfs:label "has annotation type"@en, "type d'annotation"@fr, "annotatietype"@nl ;
    rdfs:domain ha:Annotation ;
    rdfs:range xsd:anyURI, xsd:string, ha:AnnotationType ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#annotationType> ;
    rdfs:comment "Range: string, anyURI or Concept."@en, "To define a type of Annotation."@en, "Pour définir un type d'annotation."@fr, "Om een type annotatie te definiëren."@nl ;
     .

ha:hasArtMedium a rdf:Property ;
    rdfs:label "has art medium"@en, "médium artistique"@fr, "kunst medium"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:artMedium ;
    owl:equivalentProperty ha:hasDublinCoreMedium ;
    rdfs:comment "The material used. (e.g. Oil, Watercolour, Acrylic, Linoprint, Marble, Cyanotype, Digital, Lithograph, DryPoint, Intaglio, Pastel, Woodcut, Pencil, Mixed Media, etc.)"@en, "Le matériau utilisé. (par exemple Huile, Aquarelle, Acrylique, Linoprint, Marbre, Cyanotype, Numérique, Lithographie, Point sec, Intaglio, Pastel, Gravure sur bois, Crayon, Médias mixtes, etc.)"@fr, "Het gebruikte materiaal. (bv. Olie, Aquarel, Acryl, Linoprint, Marmer, Cyanotype, Digitaal, Lithografie, Droogpunt, Intaglio, Pastel, Houtsnede, Potlood, Gemengde media, etc.)"@nl ;
     .

ha:hasArtform a rdf:Property ;
    rdfs:label "has artform"@en, "forme artistique"@fr, "kunstvorm"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:artform ;
    rdfs:comment "The artform, medium, or mode of this creative work for example Painting, Drawing, Sculpture, Print, Photograph, Assemblage, Collage, etc."@en, "La forme artistique, le support ou le mode de ce travail créatif, par exemple Peinture, Dessin, Sculpture, Impression, Photographie, Assemblage, Collage, etc."@fr, "De kunstvorm, het medium of de vorm van dit creatieve werk, bijvoorbeeld Schilderij, Tekening, Beeldhouwwerk, Print, Foto, Assemblage, Collage, etc."@nl ;
     .

ha:hasAspectRatio a rdf:Property ;
    rdfs:label "has aspect ratio"@en, "rapport hauteur/largeur"@fr, "beelverhouding"@nl ;
    rdfs:domain [
        owl:unionOf (
            ha:ImageReel
            ha:AudioReel
        ) ;
    ] ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "Proportional relationship between an image's width and its height."@en, "Rapport proportionnel entre la largeur et la hauteur d'une image."@fr, "Proportionele verhouding tussen de breedte en de hoogte van een afbeelding."@nl ;
     .

ha:hasAudioNoiseReduction a rdf:Property ;
    rdfs:label "has audio noise reduction"@en, "réduction du bruit audio"@fr, "audio ruisonderdrukking"@nl ;
    rdfs:domain ha:PhysicalCarrier ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdf:Literal ;
    rdfs:comment "The technology used for noise reduction in audio."@en, "La technologie utilisée pour la réduction du bruit de l'audio."@fr, "De techniek die gebruikt wordt voor ruisonderdrukking bij audio."@nl ;
     .

ha:hasAudioRecordingSpeed a rdf:Property ;
    rdfs:label "has audio recording speed"@en, "vitesse d'enregistrement audio"@fr, "audio-opnamesnelheid"@nl ;
    rdfs:domain ha:PhysicalCarrier ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range skos:Concept ;
    rdfs:comment "The speed with which open reel audio or a gramophone record is recorded."@en, "La vitesse à laquelle l'audio à bobine ouverte ou un enregistrement de gramophone est enregistré."@fr, "De snelheid waarmee openspoelaudio of een grammofoonplaat wordt opgenomen."@nl ;
     .

ha:hasAuthoritativeLabel a rdf:Property ;
    rdfs:label "has authoritative label"@en ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
    rdfs:seeAlso <http://www.loc.gov/mads/rdf/v1#authoritativeLabel> ;
     .

ha:hasAvailabilityDate a rdf:Property ;
    rdfs:label "has availability date"@en, "date de disponibilité"@fr, "beschikbaarheidsdatum"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:available ;
    rdfs:comment "Date that the resource became or will become available."@en, "Date à laquelle la ressource devient ou deviendra disponible."@fr, "Datum waarop de bron beschikbaar is of zal zijn."@nl ;
     .

ha:hasBirthDate a rdf:Property ;
    rdfs:label "has birth date"@en, "date de naissance"@fr, "geboortedatum"@nl ;
    rdfs:domain ha:Person ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:date ;
    rdfs:seeAlso schema:birthDate ;
    rdfs:comment "Date of birth"@en, "Date de naissance"@fr, "Geboortedatum"@nl ;
     .

ha:hasBirthPlace a rdf:Property ;
    rdfs:label "birthPlace", "has birth place"@en ;
    rdfs:comment "The place where the person was born." ;
    rdfs:seeAlso schema:birthPlace ;
    schema:domainIncludes ha:Person ;
    schema:rangeIncludes ha:Place ;
     .

ha:hasBrand a rdf:Property ;
    rdfs:label "has brand"@en, "marque"@fr, "merk"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:brand ;
    rdfs:comment "The brand(s) associated with a product or service, or the brand(s) maintained by an organization or business person."@en, "La (s) marque (s) associée à un produit ou à un service, ou la (s) marque (s) entretenue par une organisation ou un homme d'affaires."@fr, "Het merk (en) geassocieerd met een product of service, of het merk (en) dat wordt onderhouden door een organisatie of ondernemer."@nl ;
     .

ha:hasBroadcastingOrganization a rdf:Property ;
    rdfs:label "has broadcasting organization"@en, "organisation de diffusion"@fr, "omroeporganisatie"@nl ;
    rdfs:domain [
        owl:unionOf (
            ha:Video
            ha:Film
            ha:Audio
            ha:DVD
        ) ;
    ] ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Organization ;
    rdfs:comment "The entity primarily responsible for distributing and making accessible an audiovisual item to third parties through broadcasting, sale, rental, etc."@en, "L'entité principalement responsable de la distribution et de la réalisation d'un élément audiovisuel à des tiers par le biais de la diffusion, de la vente, de la location, etc."@fr, "De entiteit in hoofdzaak verantwoordelijk voor het verdelen en het toegankelijk maken van een audiovisueel item voor derden door omroep, verkoop, verhuur, etc."@nl ;
     .

ha:hasCaption a rdf:Property ;
    rdfs:label "has caption"@en, "sous-titrage"@fr, "ondertiteling"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:caption ;
    rdfs:comment "The caption for this object."@en, "Les sous-titres de cet objet."@fr, "De ondertiteling voor dit object."@nl ;
     .

ha:hasCaptioning a rdf:Property ;
    rdfs:label "has captioning"@en, "sous-titrage"@fr, "ondertiteling"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Captioning ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasCaptioning> ;
    rdfs:comment "To signal the presence of Captioning."@en, "Pour signaler la présence du sous-titrage."@fr, "Om de aanwezigheid van ondertiteling aan te duiden."@nl ;
     .

ha:hasCastMember a rdf:Property ;
    rdfs:label "has cast member"@en, "membre de la distribution"@fr, "cast lid"@nl ;
    rdfs:comment "A member of the cast."@en, "A member of the cast."@fr, "Een lid van de cast."@nl ;
    rdfs:range xsd:string, ha:Cast ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasCastMember> ;
     .

ha:hasChapterNumber a rdf:Property ;
    rdfs:label "has chapter number"@en, "Numéro de chapitre DVD"@fr, "Dvd-hoofdstuknummer"@nl ;
    rdfs:domain ha:DVDChapter ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf ha:hasPosition ;
    rdfs:comment "The sequence number of the DVD chapter in relation to the other chapters that are part of the same DVD."@en, "Le numéro de série du chapitre du DVD par rapport aux autres chapitres qui font partie du même DVD."@fr, "Het volgnummer van het dvd-hoofdstuk ten opzichte van de andere hoofstukken die deel uitmaken van dezelfde dvd."@nl ;
     .

ha:hasCharacterName a rdf:Property ;
    rdfs:label "has character name"@en, "nom du personnage"@fr, "karakternaam"@nl ;
    rdfs:domain ha:PerformanceRole ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:characterName ;
    rdfs:comment "The name of a character played in some acting or performing role, i.e. in a PerformanceRole."@en, "Le nom d'un personnage joué dans un rôle d'acteur ou d'interprète, c'est-à-dire dans un PerformanceRole."@fr, "De naam van een personage dat wordt gespeeld in een acteer- of uitvoerende rol, d.w.z. in een PerformanceRole."@nl ;
     .

ha:hasClassification a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has classification"@en, "classification"@fr, "classificatie"@nl ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <http://www.w3.org/ns/org#classification> ;
    rdfs:comment "Indicates a classification for this Organization within some classification scheme. Extension vocabularies may wish to specialize this property to have a range corresponding to a specific `skos:ConceptScheme`. This property is under discussion and may be revised or removed - in many cases organizations are best categorized by defining a sub-class hierarchy in an extension vocabulary."@en, "Indique une classification pour cette Organisation dans le cadre d'un schéma de classification. Il est possible de spécialiser cette propriété en utilisant un vocabulaire spécialisé pour que le champ corresponde à un concept spécifique `skos:ConceptScheme`. Cette propriété est en discussion est pourrait être révisée ou supprimée - dans de nombreux cas, les organisations sont mieux catégorisées par une hiérarchie de sous-classe dans un vocabulaire externe."@fr, "Duidt een classificatie van deze organisatie aan met een classificatieschema. Het is mogelijk om deze eigenschap verder te specificiëren met behulp van een gespecialiseerd vocabularium opdat het veld overeenkomt met een specifiek concept `skos:ConceptScheme`. In veel gevallen kunnen organisaties beter gecategoriseerd worden aan de hand van een hiërarchie met subklassen in een extern vocabularium."@nl ;
     .

ha:hasCollectionSize a rdf:Property ;
    rdfs:label "has collection size"@en ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
    rdfs:seeAlso schema:collectionSize ;
     .

ha:hasColoringType a rdf:Property ;
    rdfs:label "has coloring type"@en, "type de coloration bobine d'image"@fr, "type kleuring filmspoel"@nl ;
    rdfs:domain ha:ImageReel ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf ha:hasFilmColourType ;
    rdfs:comment "The type of coloring of the image reel."@en, "Le type de coloration de la bobine d’image."@fr, "Het soort kleuring van de beeldrol/-spoel."@nl ;
     .

ha:hasContactPoint a rdf:Property ;
    rdfs:label "has contact point"@en, "pointDeContact"@fr, "aanspreekpunt"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:contactPoint ;
    rdfs:comment "A contact point for a person or organization."@en, "Un point de contact pour une personne ou une organisation."@fr, "Een aanspreekpunt voor een persoon of een organisatie."@nl ;
    schema:domainIncludes ha:HealthInsurancePlan, ha:Organization, ha:Person ;
    schema:rangeIncludes ha:ContactPoint ;
     .

ha:hasContactType a rdf:Property ;
    rdfs:label "has contact type"@en, "typePointContact"@fr, "contactType"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:contactType ;
    rdfs:comment "A person or organization can have different contact points, for different purposes. For example, a sales contact point, a PR contact point and so on. This property is used to specify the kind of contact point."@en, "Une personne ou une organisation peut avoir différents points de contact, à des fins différentes. Par exemple, un point de contact pour les ventes, un point de contact pour les relations publiques, etc. Cette propriété est utilisée pour spécifier le type de point de contact."@fr, "Een persoon of organisatie kan verschillende contactpunten hebben, voor verschillende doeleinden. Bijvoorbeeld een verkoopcontactpunt, een PR-contactpunt enzovoort. Deze eigenschap wordt gebruikt om het soort contactpunt te specificeren."@nl ;
    schema:domainIncludes ha:ContactPoint ;
    schema:rangeIncludes ha:Text ;
     .

ha:hasCopyrightHolder a rdf:Property ;
    rdfs:label "has copyright holder"@en, "titulaire du droit d'auteur"@fr, "auteursrechthebbende"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range [
        owl:unionOf (
            ha:Person
            ha:Organization
            ha:Role
        ) ;
    ] ;
    rdfs:seeAlso schema:copyrightHolder ;
    owl:equivalentProperty ha:hasRightsHolder ;
    rdfs:comment "The party holding the legal copyright to the CreativeWork."@en, "La partie qui détient le droit d'auteur légal de l'œuvre créative (CreativeWork)."@fr, "De partij die de auteursrechten heeft op het CreativeWork."@nl ;
     .

ha:hasCopyrightNotice a rdf:Property ;
    rdfs:label "has copyright notice"@en, "avis de droit d'auteur"@fr, "auteursrechtvermelding"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:copyrightNotice ;
    owl:equivalentProperty ha:hasRights ;
    rdfs:comment "Text of a notice appropriate for describing the copyright aspects of this Creative Work, ideally indicating the owner of the copyright for the Work."@en, "Texte d'une notice appropriée pour décrire les aspects du droit d'auteur de cette CreativeWork, indiquant idéalement le propriétaire du droit d'auteur de l'oeuvre."@fr, "Tekst van een mededeling die geschikt is om de auteursrechtelijke aspecten van dit CreativeWork te beschrijven, idealiter met vermelding van de auteursrechthebbende van het werk."@nl ;
     .

ha:hasCopyrightYear a rdf:Property ;
    rdfs:label "has copyright year"@en, "année des droits d'auteur"@fr, "auteursrechtjaar"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:copyrightYear ;
    owl:equivalentProperty ha:hasCopyrightDate ;
    rdfs:comment "The year during which the claimed copyright for the CreativeWork was first asserted."@en, "L'année durant laquelle le droit d'auteur revendiqué pour l'œuvre créative a été revendiqué pour la première fois."@fr, "Het jaar waarin het auteursrecht voor het CreativeWork voor het eerst gold/geldend gemaakt werd."@nl ;
     .

ha:hasCreationDate a rdf:Property ;
    rdfs:label "has creation date"@en, "date de création"@fr, "creatiedatum"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:dateCreated ;
    owl:equivalentProperty ha:hasDublinCoreCreationDate ;
    rdfs:comment "The date on which the CreativeWork was created."@en, "La date à laquelle le CreativeWork a été créé."@fr, "De datum waarin het CreativeWork werd gemaakt."@nl ;
     .

ha:hasCreationLocation a rdf:Property ;
    rdfs:label "locationCreated", "has creation location"@en ;
    rdfs:comment "The location where the CreativeWork was created, which may not be the same as the location depicted in the CreativeWork." ;
    rdfs:seeAlso schema:locationCreated ;
    schema:domainIncludes ha:CreativeWork ;
    schema:rangeIncludes ha:Place ;
     .

ha:hasCreditText a rdf:Property ;
    rdfs:label "has credit text"@en, "texte du crédit"@fr, "credittekst"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:creditText ;
    rdfs:comment "Text that can be used to credit person(s) and/or organization(s) associated with a published Creative Work."@en, "Texte qui peut être utilisé pour créditer la ou les personne(s) et/ou organisation(s) associée(s) à une oeuvre créative (CreativeWork) publiée."@fr, "Tekst die gebruikt kan worden om personen en/of organisaties aan te geven die met een gepubliceerd CreativeWork zijn verbonden."@nl ;
     .

ha:hasDeathDate a rdf:Property ;
    rdfs:label "has death date"@en, "date de décès"@fr, "sterfdatum"@nl ;
    rdfs:domain ha:Person ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:date ;
    rdfs:seeAlso schema:deathDate ;
    rdfs:comment "Date of death."@en, "Date de décès."@fr, "Datum van overlijden."@nl ;
     .

ha:hasDeathPlace a rdf:Property ;
    rdfs:label "deathPlace", "has death place"@en ;
    rdfs:comment "The place where the person died." ;
    rdfs:seeAlso schema:deathPlace ;
    schema:domainIncludes ha:Person ;
    schema:rangeIncludes ha:Place ;
     .

ha:hasDeletionDate a rdf:Property ;
    rdfs:label "date deleted", "has deletion date"@en ;
    rdfs:domain ha:DataFeedItem ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso schema:dateDeleted ;
    rdfs:comment "The datetime the item was removed from the DataFeed."@en, "De DateTime Het item is verwijderd uit de DataFeed."@fr, "L'élément DateTime a été supprimé du DataFeed."@nl ;
     .

ha:hasDepth a rdf:Property ;
    rdfs:label "has depth"@en, "profondeur"@fr, "diepte"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:QuantitativeValue ;
    rdfs:seeAlso schema:depth ;
    rdfs:comment "The depth of the item."@en, "La profondeur de l'objet."@fr, "De diepte van het item."@nl ;
     .

ha:hasDuration a rdf:Property ;
    rdfs:label "has duration"@en, "durée"@fr, "duur"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:duration ;
    owl:equivalentProperty ha:hasExtent ;
    rdfs:comment "The duration of the item (movie, audio recording, event, etc.) in ISO 8601 date format."@en, "La durée de l'objet (film, enregistrement audio, événement, etc.) au format de date ISO 8601."@fr, "De duur van het item (film, opname audio, evenement, enz.) in ISO 8601 datumformaat."@nl ;
     .

ha:hasEdition a owl:DatatypeProperty ;
    rdfs:label """
   Classification scheme edition
  """, "has edition"@en ;
    dct:modified """
   2016-04-21 (New)
  """ ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/edition> ;
    rdfs:comment """
   Edition of the classification scheme, such as full, abridged or a number, when a classification scheme designates editions.
  """ ;
     .

ha:hasEmail a rdf:Property ;
    rdfs:label "has email"@en, "adresse e-mail"@fr, "e-mailadres"@nl ;
    rdfs:domain ha:ContactPoint, ha:Person ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:email ;
    rdfs:comment "Email address."@en, "Adresse e-mail."@fr, "E-mailadres."@nl ;
     .

ha:hasEndTime a rdf:Property ;
    rdfs:label "has end time"@en, "heure de fin"@fr, "eindtijd"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:endTime ;
    rdfs:comment """
    The endTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to end. For actions that span a period of time, when the action was performed. E.g. John wrote a book from January to *December*. For media, including audio and video, it's the time offset of the end of a clip within a larger file.
    Note that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions."""@en, "La fin de quelque chose.Pour un événement ou un service réservé (par exemple.Pour les actions qui s'étendent sur un certain temps, lorsque l'action a été effectuée.Par exemple.John a écrit un livre de janvier à * décembre *.Pour les médias, y compris l'audio et la vidéo, c'est le décalage de temps de la fin d'un clip dans un fichier plus grand."@fr, "De eindtijd van iets. Voor een gereserveerd evenement of service (bijvoorbeeld FoodestablishmentReservation), de tijd dat het naar verwachting zal eindigen. Voor acties die een periode van tijd omvatten, wanneer de actie werd uitgevoerd. Bijv.John schreef een boek van januari tot *december*.Voor media, inclusief audio en video, is dit de tijdoffset van het einde van een clip binnen een groter bestand."@nl ;
     .

ha:hasExecutor a rdf:Property ;
    rdfs:label "has executor"@en, "exécutrice"@fr, "uitvoerder"@nl ;
    rdfs:domain [
        owl:unionOf (
            ha:CreativeWork
            ha:Role
        ) ;
    ] ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range [
        owl:unionOf (
            ha:Person
            ha:Organization
            ha:Role
        ) ;
    ] ;
    rdfs:comment "The executor of the CreativeWork."@en, "L'interprète du travail créatif."@fr, "De uitvoerder van het CreativeWork."@nl ;
     .

ha:hasFamilyName a rdf:Property ;
    rdfs:label "has family name"@en, "nom de famille"@fr, "familienaam"@nl ;
    rdfs:domain ha:Person ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:familyName ;
    rdfs:comment "Family name. In the U.S., the last name of a Person."@en, "Nom de famille. Aux États-Unis, le dernier nom d'une Personne."@fr, "Familienaam. In de V.S., de achternaam van een Persoon."@nl ;
     .

ha:hasGenre a rdf:Property ;
    rdfs:label "has genre"@en, "genre"@fr, "genre"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:genre ;
    rdfs:comment "Genre of the creative work, broadcast channel or group."@en, "Genre de l'œuvre créative (CreativeWork), de la chaîne de télévision/diffusion ou du groupe."@fr, "Genre van het CreativeWork, uitzendkanaal of groep."@nl ;
     .

ha:hasGivenName a rdf:Property ;
    rdfs:label "has given name"@en, "prénom"@fr, "voornaam"@nl ;
    rdfs:domain ha:Person ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:givenName ;
    rdfs:comment "Given name. In the U.S., the first name of a Person."@en, "Prénom. Aux États-Unis, le premier nom d'une Personne."@fr, "Voornaam. In de V.S., de eerste naam van een Persoon."@nl ;
     .

ha:hasHeight a rdf:Property ;
    rdfs:label "has height"@en, "hauteur"@fr, "hoogte"@nl ;
    rdfs:domain ha:CreativeWork, ha:MediaFragment ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:anyURI, xsd:string, ha:QuantitativeValue ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#height>, schema:height ;
    rdfs:subPropertyOf ha:hasAnnotationPurpose ;
    rdfs:comment "The Height of e.g. a video frame typically expressed as a number of pixels, or picture/image in millimeters."@en, "The height of the item."@en, "La Hauteur d'un cadre vidéo, par exemple, est généralement exprimée en nombre de pixels, ou d'une image en millimètres."@fr, "La hauteur de l'objet."@fr, "De Hoogte van bijvoorbeeld een videoframe wordt doorgaans uitgedrukt in aantal pixels, of van een afbeelding in millimeters."@nl, "De hoogte van het item."@nl ;
     .

ha:hasHomepage a rdf:Property ;
    rdfs:label "has homepage"@en, "page d'accueil"@fr, "homepagina"@nl ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Document ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/homepage> ;
    rdfs:comment "A homepage for some thing. "@en, "Une page d'accueil pour quelque chose"@fr, "Een homepagina van/voor iets"@nl ;
     .

ha:hasIEC60094Type a rdf:Property ;
    rdfs:label "has IEC 60094 type"@en, "iec-60094 type"@fr, "iec-60094 type"@nl ;
    rdfs:domain ha:PhysicalCarrier ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range skos:Concept ;
    rdfs:comment "The IEC-60094 Type of the compact cassette that indicates the magnetic material used as a binder on top of the polyester bottom layer of the cassette."@en, "Le type IEC-60094 de la cassette compacte qui indique le matériau magnétique utilisé comme liant sur le dessus de la couche inférieure en polyester de la cassette."@fr, "Het iec-60094 type van de compact cassette die duidt op het magnetisch materiaal dat als bindmiddel werd gebruikt bovenop de polyester onderlaag van de cassette."@nl ;
     .

ha:hasInstrument a rdf:Property ;
    rdfs:label "has instrument"@en, "instrument"@fr, "instrument"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:instrument ;
    rdfs:comment "The object that helped the agent perform the action. E.g. John wrote a book with *a pen*."@en, "L'objet qui a aidé l'agent à effectuer l'action. Par exemple: John a écrit un livre avec *un stylo*."@fr, "Het object dat de agent heeft geholpen de actie uit te voeren. Bijv. John schreef een boek met *een pen*."@nl ;
     .

ha:hasIssuance a owl:ObjectProperty ;
    rdfs:label """
   Mode of issuance
  """, "has issuance"@en ;
    dct:modified """
   2016-04-21 (New)
  """ ;
    rdfs:comment """
   Suggested use - With Work or Instance
  """ ;
    rdfs:range ha:Issuance ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/issuance> ;
    rdfs:comment """
   Categorization reflecting whether a resource is issued in one or more parts, the way it is updated, and its intended termination.
  """ ;
     .

ha:hasIssueNumber a rdf:Property ;
    rdfs:label "issueNumber", "has issue number"@en ;
    rdfs:comment "Identifies the issue of publication; for example, \"iii\" or \"2\"." ;
    rdfs:seeAlso schema:issueNumber ;
    rdfs:subPropertyOf ha:hasPosition ;
    owl:equivalentProperty ha:hasIssue ;
    ha:hasContributor <https://schema.org/docs/collab/bibex> ;
    schema:domainIncludes ha:PublicationIssue ;
    schema:rangeIncludes ha:Integer, ha:Text ;
     .

ha:hasKeywords a rdf:Property ;
    rdfs:label "has keywords"@en, "mots-clés"@fr, "trefwoorden"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:keywords ;
    owl:equivalentProperty ha:hasSubject ;
    rdfs:comment "Keywords or tags used to describe some item. Multiple textual entries in a keywords list are typically delimited by commas, or by repeating the property."@en, "Mots-clés ou balises utilisés pour décrire un élément. Des entrées textuelles multiples dans une liste de mots-clés sont généralement séparées par des virgules, ou par répétition de la propriété (Property)."@fr, "Trefwoorden of tags die gebruikt worden om een item te beschrijven. Meerdere tekstuele elementen in een trefwoordenlijst worden meestal gescheiden door komma's, of door het herhaling van de eigenschap (Property)."@nl ;
     .

ha:hasLanguage a rdf:Property ;
    rdfs:label "has language"@en, "en langue"@fr, "in taal"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:inLanguage ;
    rdfs:comment "The language of the content or performance or used in an action. Please use one of the language codes from the IETF BCP 47 standard."@en, "La langue du contenu ou de la performance ou utilisée dans une action. Veuillez utiliser l'un des codes de langue de la norme IETF BCP 47."@fr, "De taal van de inhoud of de uitvoering of gebruikt in een actie. Gebruik bij voorkeur één van de taalcodes uit de IETF BCP 47 standaard."@nl ;
     .

ha:hasLicense a rdf:Property ;
    rdfs:label "has license"@en, "Licence"@fr, "licence"@fr, "Licentie"@nl, "licentie"@nl ;
    dct:description "Recommended practice is to identify the license document with a URI. If this is not possible or feasible, a literal value that identifies the license may be provided."@en ;
    dct:issued "2004-06-14"^^xsd:date ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range [
        owl:unionOf (
            ha:Thing
            skos:Concept
        ) ;
    ] ;
    rdfs:seeAlso dct:license, schema:license ;
    rdfs:subPropertyOf ha:hasRights ;
    owl:equivalentProperty ha:hasAccessRights ;
    rdfs:comment "A legal document giving official permission to do something with the resource."@en, "A license document that applies to this content, typically indicated by URL."@en, "Un document de licence qui s'applique à ce contenu, généralement indiqué par URL."@fr, "Un document juridique permettant à l'autorisation officielle de faire quelque chose avec la ressource."@fr, "Een juridisch document dat officiële toestemming geeft om iets met de entiteit te doen."@nl, "Een licentiedocument dat geldig is voor deze inhoud, meestal gekenmerkt door een URL."@nl ;
     .

ha:hasLicenseDistributor a rdf:Property ;
    rdfs:label "has license distributor"@en, "distributeur de licence"@fr, "licentiegever"@nl ;
    rdfs:domain premis:IntellectualEntity ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range [
        owl:unionOf (
            ha:Person
            ha:Organization
        ) ;
    ] ;
    rdfs:comment "The license distributor of the intellectual entity."@en, "Le distributeur de licences de l'entité intellectuelle."@fr, "De licentiedistributeur van de intellectuele entiteit."@nl ;
     .

ha:hasLogo a rdf:Property ;
    rdfs:label "logo", "has logo"@en, "a un logo"@fr, "heeft een logo"@nl ;
    rdfs:comment "An associated logo." ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Logo ;
    rdfs:seeAlso schema:logo ;
    rdfs:subPropertyOf ha:hasImage ;
    rdfs:comment "A logo for an organization."@en, "Un logo pour une organisation."@fr, "Een logo voor een organisatie."@nl ;
    schema:domainIncludes ha:Brand, ha:Organization, ha:Place, ha:Product, ha:Service ;
    schema:rangeIncludes ha:ImageObject, ha:URL ;
     .

ha:hasMaintainer a rdf:Property ;
    rdfs:label "has maintainer"@en, "mainteneur/responsable"@fr, "beheerder"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:maintainer ;
    rdfs:comment "A maintainer is a Person or Organization that manages contributions to, and/or publication of, some (typically complex) artifact."@en, "Un mainteneur est une personne ou une organisation qui gère les contributions à, et/ou la publication de, un (généralement complexe) artefact."@fr, "Een beheerder is een Persoon of Organisatie die bijdragen beheert aan, en/of publicatie van, een (meestal complex) artefact."@nl ;
     .

ha:hasMaterial a rdf:Property ;
    rdfs:label "material", "has material"@en ;
    rdfs:comment "A material that something is made from, e.g. leather, wool, cotton, paper." ;
    rdfs:seeAlso schema:material ;
    schema:domainIncludes ha:CreativeWork, ha:Product ;
    schema:rangeIncludes ha:Product, ha:Text, ha:URL ;
     .

ha:hasMaterialExtent a rdf:Property ;
    rdfs:label "has material extent"@en ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
    rdfs:seeAlso schema:materialExtent ;
     .

ha:hasMediaFragment a rdf:Property ;
    rdfs:label "has media fragment"@en, "a un fragment (de média)"@fr, "heeft (media)fragment"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:MediaFragment ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasMediaFragment> ;
    owl:equivalentProperty ha:hasFragment ;
    owl:inverseOf ha:isMediaFragmentOf ;
    rdfs:comment "To define relation to MediaFragments within a MediaResource."@en, "Pour définir une relation entre des MediaFragments dans une MediaResource."@fr, "Om een relatie te definiëren tussen MediaFragments binnenin een MediaResource."@nl ;
     .

ha:hasMimeType a rdf:Property ;
    rdfs:label "has mime type"@en, "mime type"@fr, "mime type"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string, ha:MimeType ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasMimeType> ;
    rdfs:subPropertyOf ha:hasFormat ;
    rdfs:comment "To specify the Mime type of a Resource."@en, "Pour spécifier le type MIME d'une ressource."@fr, "Om het MIME type van een resource te specificeren."@nl ;
     .

ha:hasMissingAudioReels a rdf:Property ;
    rdfs:label "has missing audio reels"@en, "bobines audio manquantes"@fr, "ontbrekende audiospoelen"@nl ;
    rdfs:domain ha:CarrierRepresentation ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "Indicates for a film if audio reels are missing, preceding any digitization process."@en, "Indique pour un film si des bobines audio sont manquantes, avant toute opération de numérisation."@fr, "Duidt aan voor een film of er audiorollen/-spoelen ontbreken, voorafgaand aan enig digitaliseringsproces."@nl ;
     .

ha:hasMissingImageReels a rdf:Property ;
    rdfs:label "has missing image reels"@en, "bobines d'image manquantes"@fr, "ontbrekende beeldspoelen"@nl ;
    rdfs:domain ha:CarrierRepresentation ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "Indicates for a film if image reels are missing, preceding any digitization process."@en, "Indique pour un film si des bobines d'image sont manquantes, avant toute opération de numérisation."@fr, "Duidt aan voor een film of er beeldrollen/-spoelen ontbreken, voorafgaand aan enig digitaliseringsproces."@nl ;
     .

ha:hasModel a rdf:Property ;
    rdfs:label "has model"@en, "modèle"@fr, "model"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:model ;
    rdfs:comment "The model of the product. Use with the URL of a ProductModel or a textual representation of the model identifier. The URL of the ProductModel can be from an external source. It is recommended to additionally provide strong product identifiers via the gtin8/gtin13/gtin14 and mpn properties."@en, "Le modèle du produit.Utilisez avec l'URL d'un produit de produit ou une représentation textuelle de l'identifiant du modèle. L'URL du ProductModel peut provenir d'une source externe.Il est recommandé de fournir en outre des identificateurs de produits solides via les propriétés GTIN8 / GTIN13 / GTIN14 et MPN."@fr, "Het model van het product.Gebruik met de URL van een productmodel of een tekstuele weergave van de model-ID. De URL van het productmodel kan uit een externe bron zijn.Het wordt aanbevolen om bovendien sterke productidentifiers te bieden via de eigenschappen GTIN8/GTIN13/GTIN14 en MPN."@nl ;
     .

ha:hasModificationDate a rdf:Property ;
    rdfs:label "date modified", "has modification date"@en ;
    rdfs:domain ha:CreativeWork, ha:DataFeedItem ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso schema:dateModified ;
    rdfs:comment "The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed."@en, "La date à laquelle le Creativework a été récemment modifié ou lorsque l'entrée de l'élément a été modifiée dans une DataFeed."@fr, "De datum waarop het creatieve werk het meest recent werd gewijzigd of wanneer de invoer van het item binnen een DataFeed werd gewijzigd."@nl ;
     .

ha:hasName a rdf:Property ;
    rdfs:label "has name"@en, "nom"@fr, "naam"@nl ;
    rdfs:domain ha:Thing ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:name ;
    owl:equivalentProperty ha:hasTitle ;
    rdfs:comment "The name of the item."@en, "Le nom de l'article."@fr, "De naam van het item."@nl ;
     .

ha:hasNumberOfAudioChannels a rdf:Property ;
    rdfs:label "has number of audio channels"@en, "nombre de canaux audio"@fr, "aantal audiokanalen"@nl ;
    rdfs:domain ha:CarrierRepresentation ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "The number of parallel audio channels that the audio track contains."@en, "Le nombre de canaux audio parallèles que contient la piste audio."@fr, "Het aantal audiokanalen die een audiospoor bevat."@nl ;
     .

ha:hasNumberOfAudioTracks a rdf:Property ;
    rdfs:label "has number of audio tracks"@en, "nombre de pistes audio"@fr, "aantal audiosporen"@nl ;
    rdfs:domain ha:CarrierRepresentation ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "The number of audio tracks that the representation contains."@en, "Le nombre de pistes audio que la représentation contient."@fr, "Het aantal audio sporen die de representatie bevat."@nl ;
     .

ha:hasNumberOfMissingAudioReels a rdf:Property ;
    rdfs:label "has number of missing audio reels"@en, "nombre de bobines audio manquantes"@fr, "aantal ontbrekende audiospoelen"@nl ;
    rdfs:domain ha:CarrierRepresentation ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "Indicates for a film how many audio reels are missing, preceding any digitization process."@en, "Indique pour un film combien des bobines audio sont manquantes, avant toute opération de numérisation."@fr, "Duidt aan voor een film hoeveel audiorollen/-spoelen ontbreken, voorafgaand aan enig digitaliseringsproces."@nl ;
     .

ha:hasNumberOfMissingImageReels a rdf:Property ;
    rdfs:label "has number of missing image reels"@en, "nombre de bobines d'image manquantes"@fr, "aantal ontbrekende beeldspoelen"@nl ;
    rdfs:domain ha:CarrierRepresentation ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "Indicates for a film how many image reels are missing, preceding any digitization process."@en, "Indique pour un film combien des bobines d'image sont manquantes, avant toute opération de numérisation."@fr, "Duidt aan voor een film hoeveel beeldrollen/-spoelen ontbreken, voorafgaand aan enig digitaliseringsproces."@nl ;
     .

ha:hasNumberOfReels a rdf:Property ;
    rdfs:label "has number of reels"@en, "nombre de bobines de film"@fr, "aantal filmrollen/-spoelen"@nl ;
    rdfs:domain ha:CarrierRepresentation ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "The number of film reels (regardless of type) that make up a digitized film."@en, "Le nombre de bobines de film (quel que soit le type) qui composent un film numérisé."@fr, "Het aantal filmrollen/-spoelen (ongeacht het type) waaruit een gedigitaliseerde film bestaat."@nl ;
     .

ha:hasObjectType a rdf:Property ;
    rdfs:label "has object type"@en, "type d'objet/de bien"@fr, "type object/activum"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:anyURI, xsd:string, ha:ObjectType ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasObjectType> ;
    rdfs:comment "To define an ObjectType for the BusinessObject (e.g. book, report, programme, clip) if not defined as a subClass of BusinessObject."@en, "Pour définir un ObjectType pour un BusinessObject (par exemple un livre, rapport, programme, clip) s'il n'est pas défini comme une sous-classe de BusinessObject."@fr, "Om een ObjectType te definiëren voor een BusinessObject (bv. boek, rapport, programma, clip) indien dit niet gedefinieerd is als een subklasse van BusinessObject."@nl ;
     .

ha:hasOutput a owl:ObjectProperty ;
    rdfs:label "has output"@en, "résultat"@fr, "uitkomst"@nl ;
    rdfs:domain premis:Event ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range premis:Object ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventRelatedObjectRole/out> ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:comment "The object in relation to the described event is the outcome of that event."@en, "L'objet dans la relation à l'événement (Event) décrit est le résultat de cet événement (Event)."@fr, "Het object in relatie tot de beschreven gebeurtenis (Event) is het resultaat van die gebeurtenis (Event)."@nl ;
     .

ha:hasOwner a rdf:Property ;
    rdfs:label "has owner"@en ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
     .

ha:hasPageNumber a rdf:Property ;
    rdfs:label "has page number"@en, "numéro de page"@fr, "paginanummer"@nl ;
    rdfs:domain ha:NewspaperIssuePage ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ha:hasPosition ;
    rdfs:comment "The sequence number of a page within its larger whole (e.g. a newspaper edition, a book, etc.)."@en, "Le numéro de séquence d'une page dans son ensemble plus grand (par exemple, une édition de journal, un livre, etc.)."@fr, "Het volgnummer van een pagina binnen zijn groter geheel (bv. een kranteneditie, een boek, etc.)."@nl ;
     .

ha:hasPart a rdf:Property ;
    rdfs:label "hasPart", "has part"@en ;
    rdfs:comment "Indicates an item or CreativeWork that is part of this item, or CreativeWork (in some sense)." ;
    rdfs:seeAlso schema:hasPart ;
    ha:hasContributor <https://schema.org/docs/collab/bibex> ;
    schema:domainIncludes ha:CreativeWork ;
    schema:inverseOf ha:isPartOf ;
    schema:rangeIncludes ha:CreativeWork ;
     .

ha:hasPostOfficeBoxNumber a rdf:Property ;
    rdfs:label "has post office box number"@en, "numéroBoîtePostale"@fr, "postbusnummer"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:postOfficeBoxNumber ;
    rdfs:comment "The post office box number for PO box addresses."@en, "Le numéro de la boîte postale pour les adresses de type boîte postale."@fr, "Het postbusnummer voor postbusadressen."@nl ;
    schema:domainIncludes ha:PostalAddress ;
    schema:rangeIncludes ha:Text ;
     .

ha:hasPostalCode a rdf:Property ;
    rdfs:label "has postal code"@en, "codePostale"@fr, "postCode"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:postalCode ;
    rdfs:comment "The postal code. For example, 94043."@en, "Le code postale."@fr, "De postcode."@nl ;
    schema:domainIncludes ha:DefinedRegion, ha:GeoCoordinates, ha:GeoShape, ha:PostalAddress ;
    schema:rangeIncludes ha:Text ;
     .

ha:hasPreference a rdf:Property ;
    rdfs:label "has preference"@en, "préfère"@fr, "verkiest"@nl ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range skos:Concept ;
    rdfs:comment "Expresses the wish of an organization regarding whether or not to perform a certain service in collaboration with/by meemoo."@en, "Exprime le souhait d'une organisation quant à la réalisation ou non d'un certain service en collaboration avec/par meemoo."@fr, "Drukt de wens uit van een organisatie met betrekking tot het al dan niet uitvoeren van een bepaalde service in samenwerking met/door meemoo."@nl ;
     .

ha:hasPreservationPart a owl:ObjectProperty ;
    rdfs:label "has preservation part"@en, "a partie"@fr, "heeft onderdeel"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/hsp> ;
    rdfs:subPropertyOf premis:relationship ;
    rdfs:comment "The object contains the related object when these are the same object category. For instance, a larger Intellectual Entity has another Intellectual Entity as a part, or a compound file (e.g. archive.tar) contains another file (e.g. text.xml). Has the reciprocal relationship of isPartOf."@en, "L'objet contient l'objet lié lorsqu'il s'agit de la même catégorie d'objet. Par exemple, une entité intellectuelle plus grande a une autre entité intellectuelle comme partie, ou un fichier composé (par exemple archive.tar) contient un autre fichier (par exemple text.xml). A une relation réciproque avec isPartOf."@fr, "Het object bevat het gerelateerde object wanneer ze tot dezelfde objectcategorie behoren. Bv. een grotere intellectuele entiteit bevat een andere intellectuele entiteit, of een samengesteld bestand (bv. archive.tar) bevat een ander bestand (bv. text.xml). Heeft een wederkerige relatie met isPartOf."@nl ;
     .

ha:hasPreservationProblem a rdf:Property ;
    rdfs:label "has preservation problem"@en, "problème de préservation"@fr, "preservatieprobleem"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
     .

ha:hasPreservationRoot a owl:ObjectProperty ;
    rdfs:label "has preservation root"@en, "est à la base de"@fr, "ligt aan de basis van"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/hsr> ;
    rdfs:subPropertyOf premis:relationship ;
    rdfs:comment "For a representation only, the related object is the file that must be processed first in order to render the representation. It implies that a compound object (i.e. one made up of multiple files) requires that one file be picked up first as its root to render it."@en, "Uniquement pour une représentation (representation), l'objet lié est le fichier (file) qui doit être traité en premier afin de rendre la représentation comme il faut. Cela implique qu'un objet composé (c'est-à-dire composé de plusieurs fichiers (files)) nécessite qu'un fichier (file) soit pris en premier comme racine/base pour le rendre."@fr, "Alleen voor een representatie (representation) is het gerelateerde object het bestand (file) dat als eerste moet worden verwerkt om de representatie (representation) te kunnen renderen. Dit impliceert dat een samengesteld object (d.w.z. een object dat uit meerdere bestanden (file) bestaat) vereist dat één bestand (file) als eerste als root/basis wordt verwerkt om het te renderen."@nl ;
     .

ha:hasPreservationSource a owl:ObjectProperty ;
    rdfs:label "has preservation source"@en, "a une source"@fr, "heeft een bron"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/hss> ;
    rdfs:subPropertyOf premis:relationship ;
    rdfs:comment "A relationship in which the object is derived from the related object as a result of a transformation. For instance, an HTML file that is the product of a migration from a file encoded in the WordStar format has that Wordstar file as its source. Also applies to the relationship between the original and a disk image. Has a reciprocal relationship of isSourceOf."@en, "Une relation dans laquelle l'objet est dérivé de l'objet lié à la suite d'une transformation. Par exemple, un fichier HTML qui est le produit d'une migration à partir d'un fichier codé au format WordStar a ce fichier Wordstar comme source. S'applique également à la relation entre l'original et une image disque. A une relation réciproque avec isSourceOf."@fr, "Een relatie waarbij het object is afgeleid van het verwante object als resultaat van een transformatie. Bijvoorbeeld, een HTML-bestand dat het product is van een migratie van een bestand dat gecodeerd is in het WordStar-formaat, heeft dat Wordstar-bestand als zijn bron. Geldt ook voor de relatie tussen het origineel en een schijfbestand. Heeft een wederkerige relatie met isSourceOf."@nl ;
     .

ha:hasPrimaryIdentifier a rdf:Property ;
    rdfs:label "has primary identifier"@en, "a identifiant principal"@fr, "heeft primaire identificatiecode"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:LocalIdentifier ;
    rdfs:subPropertyOf premis:identifier ;
     .

ha:hasPrimarySite a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has primary site"@en, "site principal"@fr, "hoofdzetel"@nl ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Site ;
    rdfs:seeAlso <http://www.w3.org/ns/org#hasPrimarySite> ;
    rdfs:subPropertyOf ha:hasSite ;
    rdfs:comment "Indicates a primary site for the Organization, this is the default means by which an Organization can be contacted and is not necessarily the formal headquarters."@en, "Indique le site principal d'une Organisation, le moyen par défaut par lequel l'Organisation peut être contactée et pas nécessairement le siège social légal."@fr, "Duidt de hoofdzetel van een organisatie aan, dit is de standaard manier waarop de organisatie gecontacteerd kan worden en niet noodzakelijk de juridische zetel."@nl ;
     .

ha:hasProducer a rdf:Property ;
    rdfs:label "producer", "has producer"@en ;
    rdfs:comment "The person or organization who produced the work (e.g. music album, movie, TV/radio series etc.)." ;
    rdfs:seeAlso schema:producer ;
    schema:domainIncludes ha:CreativeWork ;
    schema:rangeIncludes ha:Organization, ha:Person ;
     .

ha:hasProductionMethod a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has production method"@en, "méthode de production"@fr, "productiemethode"@nl ;
    dc:modified "2016-04-21 (New)" ;
    rdfs:range ha:BibframeProductionMethod ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/productionMethod> ;
    rdfs:comment "Process used to produce a resource."@en, "Processus utilisé pour produire une ressource."@fr, "Proces dat wordt gebruikt om een bron te produceren."@nl ;
     .

ha:hasPublicationDate a rdf:Property ;
    rdfs:label "has publication date"@en, "date de publication"@fr, "publicatiedatum"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:datePublished ;
    owl:equivalentProperty ha:hasIssueDate ;
    rdfs:comment "Date of first broadcast/publication."@en, "La date de la première diffusion ou publication."@fr, "De datum waarop de eerste uitzending/publicatie plaatsvond."@nl ;
     .

ha:hasRecord a rdf:Property ;
    rdfs:label "has record"@en, "enregistrement"@fr, "record"@nl ;
    rdfs:domain ha:Fragment ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Record ;
    rdfs:comment "The record in the Mediahaven asset management system."@en, "L'enregistrement dans le système de gestion d'actifs Mediahaven."@fr, "Het fragment in het Mediahaven asset management systeem."@nl ;
     .

ha:hasRegionDelimX a rdf:Property ;
    rdfs:label "has region delim x"@en, "regio-afbakening (x-as)"@fr, "délimiteur de région (axe des x)"@nl ;
    rdfs:domain ha:MediaFragment ;
    rdfs:range xsd:anyURI, xsd:string ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#regionDelimX> ;
    rdfs:subPropertyOf ha:hasAnnotationPurpose ;
    rdfs:comment "To define the top left corner of a zone on the x-axis."@en, "Définir le coin supérieur gauche d'une zone sur l'axe des x."@fr, "Het definiëren van de linkerbovenhoek van een zone op de x-as."@nl ;
     .

ha:hasRegionDelimY a rdf:Property ;
    rdfs:label "has region delim y"@en, "regio-afbakening (y-as)"@fr, "délimiteur de région (axe des y)"@nl ;
    rdfs:domain ha:MediaFragment ;
    rdfs:range xsd:anyURI, xsd:string ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#regionDelimY> ;
    rdfs:subPropertyOf ha:hasAnnotationPurpose ;
    rdfs:comment "To define the top left corner of a zone on the y-axis."@en, "Définir le coin supérieur gauche d'une zone sur l'axe des y."@fr, "Het definiëren van de linkerbovenhoek van een zone op de y-as."@nl ;
     .

ha:hasRequestForm a rdf:Property ;
    rdfs:label "has request form"@en, "formulaire de demande"@fr, "aanvraagformulier"@nl ;
    rdfs:domain ha:ContentPartner ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "A link to a form with which a user can request content from the content partner."@en, "Un lien vers un formulaire avec lequel un utilisateur peut demander du contenu au partenaire de contenu."@fr, "Een link naar een formulier waarmee een gebruiker materiaal kan aanvragen bij de contentpartner "@nl ;
     .

ha:hasRole a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has role"@en, "rôle"@fr, "rol"@nl ;
    rdfs:domain ha:Post ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Role ;
    rdfs:seeAlso <http://www.w3.org/ns/org#role> ;
    rdfs:comment "Indicates the Role that the Agent plays in a Membership relationship with an Organization."@en, "Indique le Rôle de l'Agent dans son Engagement avec l'Organisation."@fr, "Duidt de rol aan die een Agent uitvoert in relatie met een organisatie."@nl ;
     .

ha:hasRoleName a rdf:Property ;
    rdfs:label "has role name"@en, "nom du rôle"@fr, "rolnaam"@nl ;
    rdfs:domain ha:Role ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso schema:roleName ;
    rdfs:comment "A role played, performed or filled by a person or organization."@en, "Un rôle joué ou rempli par une personne ou une organisation."@fr, "Een rol gespeeld of vertolkt door een persoon of organisatie."@nl ;
     .

ha:hasSchemaEndDate a rdf:Property ;
    rdfs:label "has schema end date"@en, "date de fin"@fr, "einddatum"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:endDate ;
    rdfs:comment "The end date and time of the item (in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))."@en, "La date de fin et l'heure de l'article (en [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))."@fr, "De einddatum en tijd van het item (in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))."@nl ;
    schema:domainIncludes ha:CreativeWorkSeason, ha:CreativeWorkSeries, ha:DatedMoneySpecification, ha:MerchantReturnPolicySeasonalOverride, ha:Role, ha:SchemaEvent ;
    schema:rangeIncludes ha:Date, ha:SchemaDateTime ;
     .

ha:hasSchemaStartDate a rdf:Property ;
    rdfs:label "has schema start date"@en, "date de début"@fr, "begindatum"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:startDate ;
    rdfs:comment "The start date and time of the item (in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))."@en, "La date et l'heure de la date de la statistique par l'item (en [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))"@fr, "De startdatum en tijd van de status van het item (in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))"@nl ;
    schema:domainIncludes ha:CreativeWorkSeason, ha:CreativeWorkSeries, ha:DatedMoneySpecification, ha:MerchantReturnPolicySeasonalOverride, ha:Role, ha:SchemaEvent ;
    schema:rangeIncludes ha:Date, ha:SchemaDateTime ;
     .

ha:hasSchemaUnitCode a rdf:Property ;
    rdfs:label "has schema unit code"@en, "code d'unité"@fr, "eenheid code"@nl ;
    rdfs:domain ha:QuantitativeValue ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:unitCode ;
    rdfs:comment "The unit of measurement given using the UN/CEFACT Common Code (3 characters)."@en, "L'unité de mesure donnée en utilisant le code commun UN/CEFACT (3 caractères)."@fr, "De eenheid van de meting, gegeven met behulp van de UN/CEFACT Common Code (3 karakters)."@nl ;
     .

ha:hasSchemaUnitText a rdf:Property ;
    rdfs:label "has schema unit text"@en, "texte d'unité"@fr, "eenheid tekst"@nl ;
    rdfs:domain ha:QuantitativeValue ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:unitText ;
    rdfs:comment "A string or text indicating the unit of measurement. Useful if you cannot provide a standard unit code for `schema:unitCode`."@en, "Une chaîne de caractères ou un texte indiquant l'unité de mesure. Utile si vous ne pouvez pas fournir de code d'unité standard pour `schema:unitCode`."@fr, "Een string of tekst die de eenheid van de meting aangeeft. Handig als je geen standaard eenheidcode kunt geven voor `schema:unitCode`."@nl ;
     .

ha:hasSchemaValue a rdf:Property ;
    rdfs:label "has schema value"@en, "valeur"@fr, "waarde"@nl ;
    rdfs:domain ha:QuantitativeValue ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:float ;
    rdfs:seeAlso schema:value ;
    rdfs:comment "The value of the quantitative value."@en, "La valeur de la valeur quantitative."@fr, "De waarde van de kwantitatieve waarde."@nl ;
     .

ha:hasSeasonNumber a rdf:Property ;
    rdfs:label "has season number"@en, "numéro de saison"@fr, "seizoen nummer"@nl ;
    rdfs:domain ha:CreativeWorkSeason ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:seasonNumber ;
    rdfs:comment "Position of the season within an ordered group of seasons."@en, "Position de la saison dans un groupe ordonné de saisons."@fr, "Positie van het seizoen in een geordende groep van seizoenen."@nl ;
     .

ha:hasSector a rdf:Property ;
    rdfs:label "has sector"@en, "secteur"@fr, "sector"@nl ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "The sector the organisation is active in."@en, "Le secteur dans lequel l'organisation est active."@fr, "De sector waarin de organisatie actief is."@nl ;
     .

ha:hasSerialNumber a rdf:Property ;
    rdfs:label "has serial number"@en, "numéro de série"@fr, "serienummer"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:serialNumber ;
    rdfs:subPropertyOf ha:hasIdentifier ;
    rdfs:comment "The serial number or any alphanumeric identifier of a particular product. When attached to an offer, it is a shortcut for the serial number of the product included in the offer."@en, "Le numéro de série ou tout identifiant alphanumérique d'un produit particulier. Lorsqu'il est attaché à une offre, il s'agit d'un raccourci pour le numéro de série du produit inclus dans l'offre."@fr, "Het serienummer of een alfanumerieke identificatie van een bepaald product. Wanneer het wordt bevestigd aan een aanbieding, is het een snelkoppeling voor het serienummer van het product dat in het aanbod is opgenomen."@nl ;
     .

ha:hasSiteAddress a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has site address"@en, "adresse du Site"@fr, "adres van de zetel"@nl ;
    rdfs:domain ha:Site ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://www.w3.org/ns/org#siteAddress> ;
    rdfs:comment "Indicates an address for the site in a suitable encoding. Use of vCard (using the http://www.w3.org/TR/vcard-rdf/ vocabulary) is encouraged but the range is left open to allow other encodings to be used. The address may include email, telephone, and geo-location information and is not restricted to a physical address."@en, "Indique une adresse pour le site dans un encodage approprié. L'usage du vocabulaire vCard ( http://www.w3.org/TR/vcard-rdf/) est encouragé, mais le range est ouvert pour permettre l'utilisation d'autres vocabulaires. L'adresse peut comporter le courriel, le téléphone, et l'information de géolocalisation; et n'est donc pas seulement limitée à une adresse physique."@fr, "Duidt het adres aan van de zetel in een geschikte encoding. Het gebruik van vCard (met de http://www.w3.org/TR/vcard-rdf/ vocabulary) wordt aangemoedigd, maar de range wordt open gelaten om andere encodings mogelijk te maken. Het adres kan de e-mail, het telefoonnummer en geo-locatie informatie bevatten. Het is niet beperkt tot een fysiek adres."@nl ;
     .

ha:hasSource a owl:ObjectProperty ;
    rdfs:label "has source"@en, "source"@fr, "bron"@nl ;
    rdfs:domain premis:Event ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range premis:Object ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventRelatedObjectRole/sou> ;
    rdfs:subPropertyOf prov:used ;
    rdfs:comment "The object in relation to the described event that existed prior to that event and was used by it."@en, "L'objet dans la relation à l'événement (Event) décrit et qui existait avant cet événement (Event) et qui a été utilisé par celui-ci."@fr, "Het object in relatie tot de beschreven gebeurtenis (Event) dat bestond voor die gebeurtenis (Event) en die erdoor gebruikt werd."@nl ;
     .

ha:hasStartTime a rdf:Property ;
    rdfs:label "has start time"@en, "heure de départ"@fr, "starttijd"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:startTime ;
    rdfs:comment "The startTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to start. For actions that span a period of time, when the action was performed. E.g. John wrote a book from *January* to December. For media, including audio and video, it's the time offset of the start of a clip within a larger file.\\n\\nNote that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions."@en, "Le début du temps de quelque chose. Pour un événement ou un service réservé (par exemple.Pour les actions qui s'étendent sur un certain temps, lorsque l'action a été effectuée.Par exemple. John a écrit un livre de * janvier * à décembre.Pour les médias, y compris l'audio et la vidéo, c'est le décalage de temps du début d'un clip dans un fichier plus grand. \\ n \\ nnote que l'événement utilise StartDate / EndDate au lieu de démarrage / fin de fin, même lors de la description des dates avec les temps. Cette situation peut être clarifiée dans les révisions futures."@fr, "De starttijd van iets. Voor een gereserveerd evenement of service (bijvoorbeeld FoodestablishmentReservation), de tijd die naar verwachting zal beginnen.Voor acties die een periode van tijd omvatten, wanneer de actie werd uitgevoerd.Bijv.John schreef een boek van * januari * tot december.Voor media, inclusief audio en video, is dit de tijdoffset van het begin van een clip binnen een groter bestand. \\ n \\ nnote die gebeurtenis gebruikt startdate/enddate in plaats van starttijd/eindtijd, zelfs bij het beschrijven van datums met tijden. Deze situatie kan worden verduidelijkt in toekomstige herzieningen."@nl ;
     .

ha:hasStreetAddress a rdf:Property ;
    rdfs:label "has street address"@en, "adresseDeRue"@fr, "straatAdres"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:streetAddress ;
    rdfs:comment "The street address. For example, 1600 Amphitheatre Pkwy."@en, "L'adresse de rue."@fr, "Het adres van de straat."@nl ;
    schema:domainIncludes ha:PostalAddress ;
    schema:rangeIncludes ha:Text ;
     .

ha:hasSynopsis a rdf:Property ;
    rdfs:label "has synopsis"@en, "synopsis"@fr, "korte inhoud"@nl ;
    rdfs:comment "To provide a summary."@en, "To provide a summary."@fr, "Om een samenvatting te geven."@nl ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#synopsis> ;
    rdfs:subPropertyOf ha:hasDescription ;
     .

ha:hasTelephone a rdf:Property ;
    rdfs:label "has telephone"@en, "téléphone"@fr, "telefoon"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:telephone ;
    rdfs:comment "The telephone number."@en, "Le numéro de téléphone."@fr, "Het telefoonnummer."@nl ;
    schema:domainIncludes ha:ContactPoint, ha:Organization, ha:Person, ha:Place ;
    schema:rangeIncludes ha:Text ;
     .

ha:hasTenantName a rdf:Property ;
    rdfs:label "has tenant name"@en, "nom du locataire"@fr, "tenant naam"@nl ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:comment "The Mediahaven tenant name of the organization."@en, "Le nom du locataire Mediahaven de l'organisation."@fr, "De Mediahaven tenant naam van de organisatie."@nl ;
     .

ha:hasThumbnailURL a rdf:Property ;
    rdfs:label "has thumbnail URL"@en, "URL miniature"@fr, "miniatuur-url"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:thumbnailUrl ;
    rdfs:comment "A thumbnail image relevant to the Thing."@en, "Une image miniature pertinente pour la chose."@fr, "Een miniatuurafbeelding relevant voor het ding."@nl ;
     .

ha:hasTranscript a rdf:Property ;
    rdfs:label "has transcript"@en, "transcription"@fr, "transcriptie"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso schema:transcript ;
    rdfs:comment "If this MediaObject is an AudioObject or VideoObject, the transcript of that object."@en, "Si cet MediaObject est un AudioObject ou VideoObject, la transcription de cet objet."@fr, "Als dit MediaObject een AudioObject of VideoObject is, de transcriptie van dat object."@nl ;
     .

ha:hasUnit a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has unit"@en, "possède une Unité"@fr, "heeft een eenheid"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:OrganizationalUnit ;
    rdfs:seeAlso <http://www.w3.org/ns/org#hasUnit> ;
    rdfs:subPropertyOf ha:hasSubOrganization ;
    rdfs:comment "Indicates a unit which is part of this Organization, e.g. a Department within a larger FormalOrganization. Inverse of `org:unitOf`."@en, "Indique une Unité qui fait partie d'une Organisation, par exemple un Départment au sein d'une Organisation Formelle plus large. Inverse de `org:unitOf`."@fr, "Duidt een eenheid aan die deel uitmaakt van een organisatie, zoals een departement in een grotere formele organisatie. Is het omgekeerde van `org:unitOf`."@nl ;
     .

ha:hasVATID a rdf:Property ;
    rdfs:label "has vatid"@en, "numéro de TVA"@fr, "btw-nummer"@nl ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso schema:vatID ;
    rdfs:comment "Indicates the VAT number of the organization."@en, "Indique le numéro de TVA de l'organisation."@fr, "Verwijst naar het btw-nummer van de organisatie."@nl ;
     .

ha:hasVersion a rdf:Property ;
    rdfs:label "has version"@en, "version"@fr, "versie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:version ;
    rdfs:comment "The version of the CreativeWork embodied by a specified resource."@en, "La version du Creativework incarné par une ressource spécifiée."@fr, "De versie van het Creative Work dat is belichaamd door een opgegeven item."@nl ;
     .

ha:hasWidth a rdf:Property ;
    rdfs:label "has width"@en, "largeur"@fr, "breedte"@nl ;
    rdfs:domain ha:CreativeWork, ha:MediaFragment ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:anyURI, xsd:string, ha:QuantitativeValue ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#width>, schema:width ;
    rdfs:subPropertyOf ha:hasAnnotationPurpose ;
    rdfs:comment "The width of e.g. a video frame typically expressed as a number of pixels, or picture/image in millimeters."@en, "The width of the item."@en, "La largeur d'un cadre vidéo, par exemple, est généralement exprimée en nombre de pixels, ou d'une image en millimètres."@fr, "La largeur de l'élément."@fr, "De breedte van bijvoorbeeld een videoframe wordt doorgaans uitgedrukt in aantal pixels, of van een afbeelding in millimeters."@nl, "De breedte van het item."@nl ;
     .

ha:implements a rdf:Property ;
    rdfs:label "implements"@en ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventRelatedAgentRole/imp> ;
     .

ha:includes a owl:ObjectProperty ;
    rdfs:label "includes"@en, "inclut"@fr, "bevat"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/inc> ;
    rdfs:subPropertyOf premis:relationship ;
    rdfs:comment "A relationship in which the described object includes the referenced object, when objects have different object categories. For instance, a representation includes files. Has a reciprocal relationship of isIncludedIn."@en, "Une relation dans laquelle l'objet décrit inclut l'objet référencé, lorsque les objets ont des catégories d'objets différentes. Par exemple, une représentation (representation) inclut des fichiers (files). A une relation réciproque avec isIncludedIn."@fr, "Een relatie waarbij het beschreven object het object bevat waarnaar wordt verwezen, wanneer objecten verschillende objectcategorieën hebben. Bijvoorbeeld, een representatie (representation) bevat bestanden (files). Heeft een wederkerige relatie met isIncludedIn."@nl ;
     .

ha:isAbout a rdf:Property ;
    rdfs:label "is about"@en, "sur"@fr, "over"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Thing ;
    rdfs:seeAlso schema:about ;
    rdfs:comment "The subject matter of the content."@en, "Le sujet du contenu."@fr, "Het onderwerp van de inhoud."@nl ;
     .

ha:isAnnotatedMediaResource a rdf:Property ;
    rdfs:label "is annotated media resource"@en, "media resource"@fr, "media resource"@nl ;
    rdfs:domain ha:Annotation ;
    rdfs:range ha:MediaResource ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isAnnotatedMediaResource> ;
    rdfs:comment "To link an Annotation to a MediaResource."@en, "Pour lier une annotation à un MediaResource."@fr, "Om een annotatie te koppelen aan een mediaresource."@nl ;
     .

ha:isContainedInPlace a rdf:Property ;
    rdfs:label "is contained in place"@en, "contenuEnPlace"@fr, "opgenomenInPlaats"@nl ;
    rdfs:domain ha:Place ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Place ;
    rdfs:seeAlso schema:containedInPlace ;
    rdfs:comment "The basic containment relation between a place and one that contains it."@en, "La relation de confinement de base entre un lieu et une qui le contient."@fr, "De basis verbindingsrelatie tussen een plaats en een die deze bevat."@nl ;
     .

ha:isIncludedIn a owl:ObjectProperty ;
    rdfs:label "is included in"@en, "est inclus dans"@fr, "is inbegrepen in"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/isi> ;
    rdfs:subPropertyOf premis:relationship ;
    rdfs:comment "A relationship in which the described object is included in the referenced object, when the objects have different object categories, for instance, a bitstream to a file, a file to a representation. Has a reciprocal relationship of includes."@en, "Une relation dans laquelle l'objet décrit est inclus dans l'objet référencé, lorsque les objets ont des catégories d'objets différentes, par exemple, un flux binaire (bitstream) dans un fichier (file), un fichier (file) dans une représentation (representation). A une relation réciproque avec includes."@fr, "Een relatie waarbij het beschreven object is inbegrepen in het object waarnaar wordt verwezen, wanneer de objecten verschillende objectcategorieën hebben, bijvoorbeeld een bitstream in een bestand (file), een bestand (file) in een representatie (representation). Heeft een wederkerige relatie met includes."@nl ;
     .

ha:isMotivatedBy a rdf:Property ;
    rdfs:label "is motivated by"@en, "est motivé par"@fr, "wordt gemotiveerd door"@nl ;
    rdfs:domain odrl:Prohibition ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Motivation ;
     .

ha:isNextInSequence a owl:ObjectProperty ;
    rdfs:label "is next in sequence"@en, "est le prochain dans la séquence de"@fr, "is de volgende in de reeks van"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://www.europeana.eu/schemas/edm/isNextInSequence> ;
    rdfs:subPropertyOf ha:hasRelation ;
    rdfs:comment "edm:isNextInSequence relates two resources S and R that are ordered parts of the same resource A, and such that S comes immediately after R in the order created by their being parts of A."@en, "edm:isNextInSequence met en relation deux ressources S et R qui sont des parties ordonnées de la même ressource A, et telles que S vient immédiatement après R dans l'ordre créé par leur appartenance à A."@fr, "edm:isNextInSequence relateert twee resources S en R die geordende onderdelen zijn van dezelfde resource A, en wel zodanig dat S onmiddellijk na R komt in de volgorde die ontstaat doordat zij onderdelen zijn van A."@nl ;
     .

ha:isPreservationPartOf a owl:ObjectProperty ;
    rdfs:label "is preservation part of"@en, "fait partie de"@fr, "maakt onderdeel uit van"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/isp> ;
    rdfs:subPropertyOf premis:relationship ;
    rdfs:comment "A relationship in which the object is contained in the related object when these are the same object category. For instance a Web page intellectual entity is part of a larger Web site intellectual entity. Has a reciprocal relationship of hasPart."@en, "Une relation dans laquelle l'objet est contenu dans l'objet lié lorsque ceux-ci sont de la même catégorie d'objet. Par exemple, une entité intellectuelle de site Web fait partie d'une entité intellectuelle de site Web plus grande. A une relation réciproque avec hasPart."@fr, "Een relatie waarbij het object deel uitmaakt van het gerelateerde object wanneer ze behoren tot dezelfde objectcategorie. Bv. een webpagina intellectuele entiteit maakt onderdeel uit van een grotere webpagina intellectuele entiteit. Heeft een wederkerige relatie met hasPart."@nl ;
     .

ha:isSiteOf a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is site of"@en, "es sede de"@es, "site de"@fr, "sede di"@it ;
    rdfs:comment "Indicates an Organization which has some presence at the given site. This is the inverse of `org:hasSite`."@en, "Organización que tiene ubicación en un lugar. Es la relación inversa de `org:hasSite`."@es, "Indique une Organisation qui a une présence sur le site en question. Inverse de `org:hasSite`."@fr, "Indica un'Organization che ha una qualche presenza nella data sede. È l'inverso di `org:hasSite`."@it, "あるサイトである存在感を持っている組織を示します。"@ja ;
    rdfs:domain ha:Site ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Organization ;
    rdfs:seeAlso <http://www.w3.org/ns/org#siteOf> ;
    owl:inverseOf ha:hasSite ;
     .

ha:isUnitOf a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is unit of"@en, "unité de"@fr, "organisatie-eenheid van"@nl ;
    rdfs:domain ha:OrganizationalUnit ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:FormalOrganization ;
    rdfs:seeAlso <http://www.w3.org/ns/org#unitOf> ;
    rdfs:subPropertyOf ha:isSubOrganizationOf ;
    rdfs:comment "Indicates an Organization of which this Unit is a part, e.g. a Department within a larger FormalOrganization. This is the inverse of `org:hasUnit`."@en, "Indique l'Organisation dont cette Organisation ou Unité fait partie, par exemple un Départment au sein d'une Organisation Formelle plus large. Inverse de `org:hasUnit`."@fr, "Duidt de Organisatie aan waarvan deze Organisatie of eenheid deel uitmaakt, bv. een departement binnen een grotere formele Organisatie. Omgekeerde van `org:hasUnit`."@nl ;
     .

ha:mentions a rdf:Property ;
    rdfs:label "mentions"@en, "mentionne"@fr, "vermeldt"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:mentions ;
    rdfs:comment "Indicates that the CreativeWork contains a reference to, but is not necessarily about a concept."@en, "Indique que le Creative Work contient une référence à, mais ne concerne pas nécessairement un concept."@fr, "Geeft aan dat het Creative Work een verwijzing bevat naar, maar niet noodzakelijkerwijs over een concept."@nl ;
     .

ha:metadataRangeOperand a owl:NamedIndividual, skos:Concept, odrl:LeftOperand ;
    rdfs:label "metadata range operand"@en, "Gamme de métadonnées"@fr, "Metadatabereik"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    skos:definition "The intended reach of the object's metadata. For example, whether it is about the full set of metadata or only a part."@en, "La portée prévue des métadonnées de l'objet.Par exemple, qu'il s'agisse de l'ensemble complet de métadonnées ou seulement une pièce."@fr, "Het beoogde bereik van de metadata van het object. Bijvoorbeeld, of het over de volledige set aan metadata gaat of slechts een deel."@nl ;
    skos:prefLabel "Metadata range"@en, "Gamme de métadonnées"@fr, "Metadatabereik"@nl ;
     .

ha:none a owl:NamedIndividual, skos:Concept ;
    rdfs:label "none"@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    skos:definition "Indicates that no value applies."@en, "Indique qu'aucune valeur ne s'applique."@fr, "Geeft aan dat er geen waarde van toepassing is."@nl ;
    skos:prefLabel "none"@en, "aucun"@fr, "geen"@nl ;
     .

ha:suc a ha:Authority ;
    rdfs:label "suc"@en ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventOutcome/suc> ;
    ha:hasAuthoritativeLabel "success" ;
     .

ha:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes"@en, "remplace"@fr, "vervangt"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/sup> ;
    rdfs:subPropertyOf premis:relationship ;
    rdfs:comment "A relationship between an environment object and another where the described object replaces another. This allows for an audit trail of environments to be maintained. Has a reciprocal relationship of isSupersededBy."@en, "Une relation entre un objet d'environnement et un autre objet où l'objet décrit en remplace un autre. Cela permet de conserver une piste d'audit des environnements. A une relation réciproque avec isSupersededBy."@fr, "Een relatie tussen een omgevingsobject en een ander object waarbij het beschreven object een ander object vervangt. Hierdoor kan een controlespoor van omgevingen worden bijgehouden. Heeft een wederkerige relatie met isSupersededBy."@nl ;
     .

ha:unknown a owl:NamedIndividual, skos:Concept ;
    rdfs:label "unknown"@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    skos:definition "Indicates that the value is unknown."@en, "Indique que la valeur est inconnue."@fr, "Geeft aan dat de waarde onbekend is."@nl ;
    skos:prefLabel "unknown"@en, "inconnu"@fr, "onbekend"@nl ;
     .

ha:war a ha:Authority ;
    rdfs:label "war"@en ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventOutcome/war> ;
    ha:hasAuthoritativeLabel "warning" ;
     .

ha:BibframeProductionMethod a owl:Class ;
    rdfs:label """
   Production method
  """, "bibframe production method"@en ;
    dct:modified """
   2016-04-21 (New)
  """ ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/ProductionMethod> ;
    rdfs:comment """
   Process used to produce a resource
  """ ;
     .

ha:Issuance a owl:Class ;
    rdfs:label """
   Mode of issuance
  """, "issuance"@en ;
    dct:modified """
   2016-04-21 (New)
  """ ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/Issuance> ;
    rdfs:comment """
   Information about whether a resource is issued in one or more parts, the way it is updated, and its intended termination.
  """ ;
     .

ha:hasAbstract a rdf:Property ;
    rdfs:label "has abstract"@en, "résumé"@fr, "abstract"@nl ;
    dct:issued "2000-07-11"^^xsd:date ;
    rdfs:comment "A summary of the resource."@en ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso dct:abstract, schema:abstract ;
    rdfs:subPropertyOf ha:description, ha:hasDescription ;
    owl:equivalentProperty ha:hasAbstract ;
    rdfs:comment "An abstract is a short description that summarizes a CreativeWork."@en, "Un résumé est une description courte qui résume un CreativeWork."@fr, "Een abstract is een korte beschrijving die een CreativeWork samenvat."@nl ;
     .

ha:hasAccessCopy a rdf:Property ;
    rdfs:label "has access copy"@en, "a copie d'accès"@fr, "heeft toegangskopie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subPropertyOf ha:isRepresentedBy ;
    owl:inverseOf ha:isAccessCopyOf ;
     .

ha:hasAccessRights a rdf:Property ;
    rdfs:label "has access rights"@en ;
    dcam:rangeIncludes ha:RightsStatement ;
    dct:description "Access Rights may include information regarding access or restrictions based on privacy, security, or other policies."@en ;
    dct:issued "2003-02-15"^^xsd:date ;
    rdfs:comment "Information about who access the resource or an indication of its security status."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:accessRights ;
    rdfs:subPropertyOf ha:hasRights ;
     .

ha:hasAccountManager a rdf:Property ;
    rdfs:label "has account manager"@en, "a un gestionnaire de comptes"@fr, "heeft een accountmanager"@nl ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Person ;
    owl:inverseOf ha:isAccountManagerOf ;
    rdfs:comment "A person that is the account manager of an organization."@en, "Une personne qui est le gestionnaire de comptes d'une organisation."@fr, "Een persoon die de accountmanager is van een organisatie."@nl ;
     .

ha:hasAlternative a rdf:Property ;
    rdfs:label "has alternative"@en ;
    dct:description "The distinction between titles and alternative titles is application-specific."@en ;
    dct:issued "2000-07-11"^^xsd:date ;
    rdfs:comment "An alternative name for the resource."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso dct:alternative ;
    rdfs:subPropertyOf ha:hasTitle ;
     .

ha:hasCarrierCopy a rdf:Property ;
    rdfs:label "has carrier copy"@en, "a copie sur porteur"@fr, "heeft dragerkopie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subPropertyOf ha:isRepresentedBy ;
    owl:inverseOf ha:isCarrierCopyOf ;
     .

ha:hasCopyrightDate a rdf:Property ;
    rdfs:label "has copyright date"@en ;
    dct:description "Typically a year.  Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en ;
    dct:issued "2002-07-13"^^xsd:date ;
    rdfs:comment "Date of copyright of the resource."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso dct:dateCopyrighted ;
    rdfs:subPropertyOf ha:hasDate ;
     .

ha:hasDublinCoreCreationDate a rdf:Property ;
    rdfs:label "has dublin core creation date"@en ;
    dct:description "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en ;
    dct:issued "2000-07-11"^^xsd:date ;
    rdfs:comment "Date of creation of the resource."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso dct:created ;
    rdfs:subPropertyOf ha:hasDate ;
     .

ha:hasDublinCoreMedium a rdf:Property ;
    rdfs:label "has dublin core medium"@en, "médium"@fr, "medium"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso dct:medium ;
    rdfs:comment "The material or physical carrier of the resource"@en, "Le support matériel ou physique de la ressource"@fr, "Het materiaal of fysieke drager van de bron"@nl ;
     .

ha:hasExtent a rdf:Property ;
    rdfs:label "has extent"@en ;
    dcam:rangeIncludes ha:SizeOrDuration ;
    dct:description "Recommended practice is to specify the file size in megabytes and duration in ISO 8601 format."@en ;
    dct:issued "2000-07-11"^^xsd:date ;
    rdfs:comment "The size or duration of the resource."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:extent ;
    rdfs:subPropertyOf ha:hasFormat ;
     .

ha:hasFilmColourType a rdf:Property ;
    rdfs:label "has film colour type"@en ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
    rdfs:seeAlso <http://dbpedia.org/ontology/filmColourType> ;
     .

ha:hasFragment a owl:ObjectProperty ;
    rdfs:label "has fragment"@en ;
    rdfs:comment "Corresponds to 'fragment' in the Ontology for Media Resources. Subproperties can be used to distinguish different values of 'fragment.role'." ;
    rdfs:range ha:MediaFragment ;
    rdfs:seeAlso <http://www.w3.org/ns/ma-ont#hasFragment> ;
    owl:inverseOf ha:isFragmentOf ;
     .

ha:hasFragmentRepresentation a rdf:Property ;
    rdfs:label "has fragment representation"@en, "a un fragment"@fr, "heeft fragment"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subPropertyOf ha:isRepresentedBy ;
    owl:inverseOf ha:isFragmentRepresentationOf ;
     .

ha:hasHigherPriorityThan a rdf:Property ;
    rdfs:label "has higher priority than"@en, "a une priorité plus grande que"@fr, "heeft een hogere prioriteit dan"@nl ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    owl:inverseOf ha:hasLowerPriorityThan ;
    rdfs:comment "Relates a concept to a concept that has a higher priority."@en, "Relie un concept à un concept qui a une priorité plus élevée."@fr, "Relateert een concept aan een ander concept dat een hogere prioriteit heeft."@nl ;
    skos:example "File format XML1.1 is a more recent and thus preferable format over XML1.0; XML1.1 thus holds a higher priority than XML1.0."@en, "Le format de fichier XML1.1 est un format plus récent et donc préférable à XML1.0; XML1.1 a donc une priorité plus élevée que XML1.0."@fr, "Het bestandsformaat XML1.1 is een recenter en dus verkieslijker formaat dan XML1.0; XML1.1 heeft dus een hogere prioriteit dan XML1.0."@nl ;
     .

ha:hasIIIFCopy a rdf:Property ;
    rdfs:label "has IIIF copy"@en, "a copie IIIF"@fr, "heeft IIIF-kopie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subPropertyOf ha:isRepresentedBy ;
    owl:inverseOf ha:isIIIFCopyOf ;
     .

ha:hasImage a rdf:Property ;
    rdfs:label "image", "has image"@en ;
    rdfs:comment "An image of the item. This can be a [[URL]] or a fully described [[ImageObject]]." ;
    rdfs:seeAlso schema:image ;
    schema:domainIncludes ha:Thing ;
    schema:rangeIncludes ha:ImageObject, ha:URL ;
     .

ha:hasIssue a rdf:Property ;
    rdfs:label "has issue"@en ;
    rdfs:comment "Explicit minimal declaration for an unresolved source reference; no domain, range or equivalence is asserted."@en ;
    rdfs:seeAlso <http://purl.org/ontology/bibo/issue> ;
     .

ha:hasIssueDate a rdf:Property ;
    rdfs:label "has issue date"@en ;
    dct:description "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en ;
    dct:issued "2000-07-11"^^xsd:date ;
    rdfs:comment "Date of formal issuance of the resource."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso dct:issued ;
    rdfs:subPropertyOf ha:hasDate ;
     .

ha:hasLowerPriorityThan a rdf:Property ;
    rdfs:label "has lower priority than"@en, "a une priorité inférieure à"@fr, "heeft een lagere prioriteit dan"@nl ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    owl:inverseOf ha:hasHigherPriorityThan ;
    rdfs:comment "Relates a concept to a concept that has a lower priority."@en, "Relie un concept à un concept qui a une priorité inférieure."@fr, "Relateert een concept aan een ander concept dat een lagere prioriteit heeft."@nl ;
    skos:example "File format XML1.1 is a more recent and thus preferable format over XML1.0; XML1.0 thus holds a lower priority than XML1.1."@en, "Le format de fichier XML1.1 est un format plus récent et donc préférable à XML1.0; XML1.0 a donc une priorité inférieure à XML1.1."@fr, "Het bestandsformaat XML1.1 is een recenter en dus verkieslijker formaat dan XML1.0; XML1.0 heeft dus een lagere prioriteit dan XML1.1."@nl ;
     .

ha:hasMasterCopy a rdf:Property ;
    rdfs:label "has master copy"@en, "a copie principale"@fr, "heeft archiefmaster"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subPropertyOf ha:isRepresentedBy ;
    owl:inverseOf ha:isMasterCopyOf ;
     .

ha:hasMezzanineCopy a rdf:Property ;
    rdfs:label "has mezzanine copy"@en, "a format mezzanine"@fr, "heeft mezzanineformaat"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subPropertyOf ha:isRepresentedBy ;
    owl:inverseOf ha:isMezzanineCopyOf ;
     .

ha:hasNumberOfPages a rdf:Property ;
    rdfs:label "numberOfPages", "has number of pages"@en, "nombre de pages"@fr, "aantal pagina's"@nl ;
    rdfs:comment "The number of pages in the book." ;
    rdfs:domain ha:NewspaperIssue ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso schema:numberOfPages ;
    rdfs:comment "The number of pages that a particular work consists of."@en, "Le nombre de pages qui composent une œuvre particulière."@fr, "Het aantal pagina's waaruit een bepaald werk bestaat."@nl ;
    skos:related ha:hasNumberOfPages ;
    schema:domainIncludes ha:Book ;
    schema:rangeIncludes ha:Integer ;
     .

ha:hasOriginalOrganization a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has original organization"@en, "es organización original"@es, "organisation originelle"@fr, "organizzazione originale"@it ;
    rdfs:comment "Indicates one or more organizations that existed before the change event. Depending on the event they may or may not have continued to exist after the event. Inverse of `org:changedBy`."@en, "Una o más organizaciones que existían antes de que sucediera el cambio en la organización. Dependiendo del tipo de cambio, dichas organizaciones pueden haber dejado de existir o no. Es la relación inversa de `org:changedBy`."@es, "Indique une ou plusieurs organisations qui ont existé avant un évènement de changement. Selon l'évènement, ces organisations ont pu continuer à exister ou non. Inverse de `org:changedBy`. "@fr, "Indica una o più organizzazioni pregresse rispetto a un evento di cambiamento. A seconda dell'evento, queste organizzazioni potrebbero essere esistenti dopo l'evento o  aver cessato la loro esistenza. È l'inverso di `org:changedBy`."@it, "変更のきっかけとなった出来事以前に存在した1つ以上の組織を示します。出来事によって、出来事の後にそれらは存在し続けたかも、存在し続けなかったかもしれません。"@ja ;
    rdfs:domain ha:ChangeEvent ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Organization ;
    rdfs:seeAlso <http://www.w3.org/ns/org#originalOrganization> ;
    rdfs:subPropertyOf prov:used ;
    owl:inverseOf ha:isChangedBy ;
     .

ha:hasPost a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has post"@en, "possède un poste"@fr, "positie"@nl ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Post ;
    rdfs:seeAlso <http://www.w3.org/ns/org#hasPost> ;
    owl:inverseOf ha:isPostIn ;
    rdfs:comment "Indicates a Post which exists within the Organization."@en, "Indique un Poste qui existe dans l'Organisation."@fr, "Duidt een positie aan die bestaat binnen de organisatie."@nl ;
     .

ha:hasRelation a rdf:Property ;
    rdfs:label "has relation"@en ;
    dct:description "Recommended practice is to identify the related resource by means of a URI. If this is not possible or feasible, a string conforming to a formal identification system may be provided."@en ;
    dct:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "A related resource."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dc:relation ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/relation) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en ;
     .

ha:hasResultingOrganization a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has resulting organization"@en, "resulta en"@es, "a donné naissance à"@fr, "risultato in"@it ;
    rdfs:comment "Indicates an organization which was created or changed as a result of the event. Inverse of `org:resultedFrom`."@en, "Organización que ha sido creada o modificada tras un evento específico.  Es la relación inversa de `org:resultedFrom`."@es, "Indique une organisation qui a été créée ou a été modifiée à la suite d'un Évènement de changement. Inverse de `org:resultedFrom`."@fr, "Indica l'organizzazione che è stata creata o mutata a seguito dell'evento. È l'inverso di `org:resultedFrom`."@it, "出来事の結果、作成、変更された組織を示します。"@ja ;
    rdfs:domain ha:ChangeEvent ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Organization ;
    rdfs:seeAlso <http://www.w3.org/ns/org#resultingOrganization> ;
    owl:inverseOf ha:resultsFrom ;
     .

ha:hasRightsHolder a rdf:Property ;
    rdfs:label "has rights holder"@en ;
    dcam:rangeIncludes ha:Agent ;
    dct:description "Recommended practice is to refer to the rights holder with a URI. If this is not possible or feasible, a literal value that identifies the rights holder may be provided."@en ;
    dct:issued "2004-06-14"^^xsd:date ;
    rdfs:comment "A person or organization owning or managing rights over the resource."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:rightsHolder ;
     .

ha:hasSpatial a rdf:Property ;
    rdfs:label "has spatial"@en, "couverture spatiale/géographique"@fr, "geografische dekking; aflijning binnen de ruimte"@nl ;
    dcam:rangeIncludes ha:Location ;
    dct:issued "2000-07-11"^^xsd:date ;
    rdfs:comment "Spatial characteristics of the resource."@en ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Place ;
    rdfs:seeAlso dct:spatial, schema:spatial ;
    rdfs:subPropertyOf ha:hasCoverage ;
    owl:equivalentProperty ha:hasSpatial ;
    rdfs:comment "The spatialCoverage of a CreativeWork indicates the place(s) which are the focus of the content."@en, "La couverture spatiale d'un travail créatif (CreativeWork) indique où se situe le contenu."@fr, "De geografische dekking van een CreativeWork geeft aan waar de focus van de inhoud ligt."@nl ;
     .

ha:hasSupplement a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has supplement"@en, "supplément"@fr, "supplement"@nl ;
    dc:modified "2016-04-21 (New)", "2016-04-29 (added inverse, updated range)" ;
    rdfs:comment "Suggested use - With Work or Instance", "Suggested value - Work or Instance" ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/supplement> ;
    rdfs:subPropertyOf ha:isAccompaniedBy ;
    owl:inverseOf ha:isSupplementTo ;
    rdfs:comment "Resource that updates or otherwise complements the predominant resource."@en, "Ressource qui met à jour ou complète autrement la ressource prédominante."@fr, "Bron die de overheersende bron bijwerkt of anderszins aanvult."@nl ;
     .

ha:hasTemporal a rdf:Property ;
    rdfs:label "has temporal"@en, "couverture temporelle"@fr, "temporele dekking; aflijning binnen de tijd"@nl ;
    dcam:rangeIncludes ha:PeriodOfTime ;
    dct:issued "2000-07-11"^^xsd:date ;
    rdfs:comment "Temporal characteristics of the resource."@en ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso dct:temporal, schema:temporal ;
    rdfs:subPropertyOf ha:hasCoverage ;
    owl:equivalentProperty ha:hasTemporal ;
    rdfs:comment "The temporalCoverage of a CreativeWork indicates the period that the content applies to, i.e. that it describes, either as a `DateTime` or as a textual string indicating a time period in ISO 8601 time interval format."@en, "La couverture temporelle d'un travail créatif (CreativeWork) indique la période à laquelle s'applique le contenu, c'est-à-dire qu'il décrit soit par une date et heure (`DateTime`), soit par une série de caractères indiquant une période de temps en format ISO 8601."@fr, "De dekking in de tijd van een CreativeWork geeft aan over welke periode de inhoud handelt, bijvoorbeeld als een `xsd:dateTime` of als een tekstuele string die een tijdsinterval in ISO 8601 formaat aanduidt."@nl ;
     .

ha:hasTranscriptionCopy a rdf:Property ;
    rdfs:label "has transcription copy"@en, "a copie de transcription"@fr, "heeft transcriptiekopie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subPropertyOf ha:isRepresentedBy ;
    owl:inverseOf ha:isTranscriptionCopyOf ;
     .

ha:holds a rdf:Property, owl:ObjectProperty ;
    rdfs:label "holds"@en, "occupe"@fr, "heeft positie"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Post ;
    rdfs:seeAlso <http://www.w3.org/ns/org#holds> ;
    owl:inverseOf ha:isHeldBy ;
    rdfs:comment "Indicates a Post held by some Agent."@en, "Indicate un Poste occupé par un Agent."@fr, "Duidt een positie aan die ingevuld wordt door een Agent."@nl ;
     .

ha:isAccessCopyOf a rdf:Property ;
    rdfs:label "is access copy of"@en, "est copie d'accès de"@fr, "is toegangskopie van"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subPropertyOf ha:represents ;
    owl:inverseOf ha:hasAccessCopy ;
     .

ha:isAccountManagerOf a rdf:Property ;
    rdfs:label "is account manager of"@en, "est gestionnaire de comptes de"@fr, "is account manager van"@nl ;
    rdfs:domain ha:Person ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Organization ;
    owl:inverseOf ha:hasAccountManager ;
    rdfs:comment "An organization that a person is the account manager of."@en, "Une organisation dont une personne est le gestionnaire de comptes."@fr, "Een organisatie waarvan een persoon de accountmanager is."@nl ;
     .

ha:isCarrierCopyOf a rdf:Property ;
    rdfs:label "is carrier copy of"@en, "est copie sur porteur de"@fr, "is dragerkopie van"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subPropertyOf ha:represents ;
    owl:inverseOf ha:hasCarrierCopy ;
     .

ha:isChangedBy a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is changed by"@en, "es modificada por"@es, "es modificado por"@es, "modifiée par"@fr, "cambiata da"@it ;
    rdfs:comment "Indicates a change event which resulted in a change to this organization. Depending on the event the organization may or may not have continued to exist after the event. Inverse of `org:originalOrganization`."@en, "Evento de cambio que resulta en una modificación en la organización. Dependiendo del evento, la organización puede dejar de existir tras el cambio. Es la relación inversa de `org:originalOrganization`."@es, "Indique un évènement qui a impliqué un changement dans l'Organisation. Selon l'évènement, l'Organisation a continué à exister après l'évènement, ou pas. Inverse de `org:originalOrganization`."@fr, "Indica un evento che ha contribuito al cambiamento di questa organizzazione. A seconda dell'evento, l'organizzazione potrebbe essere esistente dopo l'evento o aver cessato la propria esistenza. È l'inverso di `org:originalOrganization`."@it, "この組織の変更のきっかけとなった出来事を示します。"@ja ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:ChangeEvent ;
    rdfs:seeAlso <http://www.w3.org/ns/org#changedBy> ;
    owl:inverseOf ha:hasOriginalOrganization ;
     .

ha:isFragmentOf a owl:ObjectProperty ;
    rdfs:label "is fragment of"@en ;
    rdfs:seeAlso <http://www.w3.org/ns/ma-ont#isFragmentOf> ;
     .

ha:isFragmentRepresentationOf a rdf:Property ;
    rdfs:label "is fragment representation of"@en, "est fragment de"@fr, "is fragment van"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subPropertyOf ha:represents ;
    owl:inverseOf ha:hasFragmentRepresentation ;
     .

ha:isHeldBy a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is held by"@en, "occupé par"@fr, "bezet door"@nl ;
    rdfs:domain ha:Post ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Agent ;
    rdfs:seeAlso <http://www.w3.org/ns/org#heldBy> ;
    owl:inverseOf ha:holds ;
    rdfs:comment "Indicates an Agent which holds a Post."@en, "Indique un Agent qui occupe le Poste."@fr, "Duidt een Agent aan die een positie heeft."@nl ;
     .

ha:isIIIFCopyOf a rdf:Property ;
    rdfs:label "is IIIF copy of"@en, "est copie IIIF de"@fr, "is IIIF-kopie van"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subPropertyOf ha:represents ;
    owl:inverseOf ha:hasIIIFCopy ;
     .

ha:isMasterCopyOf a rdf:Property ;
    rdfs:label "is master copy of"@en, "est la copie principale de"@fr, "is archiefmaster van"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subPropertyOf ha:represents ;
    owl:inverseOf ha:hasMasterCopy ;
     .

ha:isMediaFragmentOf a rdf:Property ;
    rdfs:label "is media fragment of"@en, "source du fragment de média (MediaFragment)"@fr, "bron van het mediafragment (MediaFragment)"@nl ;
    rdfs:domain ha:MediaFragment ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:MediaResource ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isMediaFragmentOf> ;
    rdfs:comment "To identify the Media Resource to which a Media Fragment belongs to."@en, "Pour identifier la MediaResource à laquelle appartient un MediaFragment."@fr, "Om de MediaResource te identificeren waartoe een MediaFragment behoort."@nl ;
     .

ha:isMezzanineCopyOf a rdf:Property ;
    rdfs:label "is mezzanine copy of"@en, "est format mezzanine de"@fr, "is mezzanineformaat van"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subPropertyOf ha:represents ;
    owl:inverseOf ha:hasMezzanineCopy ;
     .

ha:isPartOf a rdf:Property ;
    rdfs:label "is part of"@en, "fait partie de"@fr, "is onderdeel van"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso schema:isPartOf ;
    rdfs:comment "Indicates an item or CreativeWork that this item, or CreativeWork (in some sense), is part of."@en, "Indique un élément ou un CreativeWork qui fait partie de cet élément, ou de ce CreativeWork (dans un certain sens)."@fr, "Geeft een item of CreativeWork aan waarvan dit item, of CreativeWork (in een bepaald opzicht), een onderdeel is."@nl ;
     .

ha:isPostIn a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is post in"@en, "poste chez"@fr, "positie in"@nl ;
    rdfs:domain ha:Post ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Organization ;
    rdfs:seeAlso <http://www.w3.org/ns/org#postIn> ;
    owl:inverseOf ha:hasPost ;
    rdfs:comment "Indicates the Organization in which the Post exists."@en, "Indicate l'Organisation dans laquelle le Poste existe."@fr, "Duidt de organisatie aan waarbij de positie bestaat."@nl ;
     .

ha:isPrecededBy a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is preceded by"@en, "précédé par"@fr, "voorafgegaan door"@nl ;
    dc:modified "2016-04-21 (New)", "2016-04-29 (added inverse)" ;
    rdfs:comment "Suggested use - With Work or Instance", "Suggested value - Work or Instance" ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/precededBy> ;
    rdfs:subPropertyOf ha:isRelatedTo ;
    owl:inverseOf ha:isSucceededBy ;
    rdfs:comment "Resource that precedes the resource being described, e.g., is earlier in time or before in narrative."@en, "La ressource qui précède la ressource décrite, par exemple, est plus tôt dans le temps ou avant dans le récit."@fr, "Bron die voorafgaat aan de beschreven bron, bijvoorbeeld, is eerder in de tijd of eerder in het verhaal."@nl ;
     .

ha:isSucceededBy a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is succeeded by"@en, "succédé par"@fr, "opgevolgd door"@nl ;
    dc:modified "2016-04-21 (New)", "2016-04-29 (added inverse)" ;
    rdfs:comment "Suggested use - With Work or Instance", "Suggested value - Work or Instance" ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/succeededBy> ;
    rdfs:subPropertyOf ha:isRelatedTo ;
    owl:inverseOf ha:isPrecededBy ;
    rdfs:comment "Resource that succeeds the resource being described, e.g., later in time or after in a narrative."@en, "Ressource qui succède à la ressource décrite, par exemple, plus tard dans le temps ou après dans un récit."@fr, "Resource die de bron die wordt beschreven opvolgt, bijvoorbeeld later in de tijd of daarna in een verhaal."@nl ;
     .

ha:isSupplementTo a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is supplement to"@en, "compléter"@fr, "supplement aan"@nl ;
    dc:modified "2016-04-21 (New)", "2016-04-29 (added inverse, updated range)" ;
    rdfs:comment "Suggested use - With Work or Instance", "Suggested value - Work or Instance" ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/supplementTo> ;
    rdfs:subPropertyOf ha:accompanies ;
    owl:inverseOf ha:hasSupplement ;
    rdfs:comment "Resource that is updated or otherwise complemented by the augmenting resource."@en, "Ressource mise à jour ou complétée par la ressource augmentante."@fr, "Bron die wordt bijgewerkt of anderszins wordt aangevuld met de aanvullende bron."@nl ;
     .

ha:isTranscriptionCopyOf a rdf:Property ;
    rdfs:label "is transcription copy of"@en, "est copie transcription de"@fr, "is transcriptiekopie van"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:subPropertyOf ha:represents ;
    owl:inverseOf ha:hasTranscriptionCopy ;
     .

ha:isTransitiveSubOrganizationOf a rdf:Property, owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "is transitive sub organization of"@en, "es suborganización de (transitiva)"@es, "es suborganización de manera transitiva de"@es, "sous-Organization transitive de"@fr, "sotto-Organization transitiva"@it ;
    rdfs:comment "The transitive closure of subOrganizationOf, giving a representation of all organizations that contain this one. Note that technically this is a super property of the transitive closure so it could contain additional assertions but such usage is discouraged."@en, "La versión transitiva de la propiedad “subOrganizationOf”, es decir, la representación de todas las organizaciones en las que esta está contenida. Téngase en cuenta que desde el punto de vista técnico esta es una propiedad que contiene a todas las propiedades transitivas, de forma que podría contener afirmaciones adicionales, aunque su uso no está aconsejado."@es, "La version transitive de la propriété subOrganizationOf, renvoie une représentation de toutes les organisations qui contiennent celle-ci. Notez que ceci est une super-propriété de la relation transitive donc elle pourrait contenir des assertions additionnelles mais cet usage n'est pas recommandé."@fr, "È la chiusura transitiva di subOrganizationOf, quindi rappresenta tutte le organizzazioni che la contengono. Tecnicamente, essendo una chiusura transitiva, può contenere asserzioni che non la riguardano e quindi il suo uso è sconsigliato."@it, "subOrganizationOfの推移閉包で、これを含むすべての組織の表現を与える。技術的に、これが推移閉包のスーパープロパティーであるため、追加の言明を含むことができますが、そのような使用法はお勧めできないことに注意してください。"@ja ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Organization ;
    rdfs:seeAlso <http://www.w3.org/ns/org#transitiveSubOrganizationOf> ;
     .

ha:makes a rdf:Property ;
    rdfs:label "made", "makes"@en ;
    rdfs:comment "Something that was made by this agent." ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Resource ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/made> ;
    owl:inverseOf ha:isMadeBy ;
    vs:term_status "testing" ;
     .

ha:period a rdfs:Datatype ;
    rdfs:label "period"@en ;
    dct:issued "2000-07-11"^^xsd:date ;
    rdfs:comment "The set of time intervals defined by their limits according to the DCMI Period Encoding Scheme."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:Period, <https://www.dublincore.org/specifications/dublin-core/dcmi-period/> ;
     .

ha:resultsFrom a rdf:Property, owl:ObjectProperty ;
    rdfs:label "results from"@en, "es el resultado de"@es, "issue de"@fr, "risultato da"@it ;
    rdfs:comment "Indicates an event which resulted in this organization. Inverse of `org:resultingOrganization`."@en, "Evento que tiene como resultado la creación de una organización."@es, "Indique un évènement dont est issue l'Organisation. Inverse de `org:resultingOrganization`."@fr, "Indica l'evento che ha permesso all'organizzazione di instaurarsi. È l'inverso di `org:resultingOrganization`."@it, "この組織になった（導いた、作成された）きっかけとなった出来事を示します。"@ja ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:ChangeEvent ;
    rdfs:seeAlso <http://www.w3.org/ns/org#resultedFrom> ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    owl:inverseOf ha:hasResultingOrganization ;
     .

ha:MetadataRange a rdf:Class ;
    rdfs:label "metadata range"@en, "Gamme de métadonnées"@fr, "Metadatabereik"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:comment "The intended reach of the object's metadata. For example, whether it is about the full set of metadata or only a part."@en, "La portée prévue des métadonnées de l'objet.Par exemple, qu'il s'agisse de l'ensemble complet de métadonnées ou seulement une pièce."@fr, "Het beoogde bereik van de metadata van het object. Bijvoorbeeld, of het over de volledige set aan metadata gaat of slechts een deel."@nl ;
     .

ha:accompanies a rdf:Property, owl:ObjectProperty ;
    rdfs:label "accompanies"@en, "accompagne"@fr, "begeleidt"@nl ;
    dc:modified "2016-04-21 (New)", "2016-04-29 (added inverse)" ;
    rdfs:comment "Suggested use - With Work, Instance or Item", "Suggested value - Work, Instance or Item" ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/accompanies> ;
    rdfs:subPropertyOf ha:isRelatedTo ;
    owl:inverseOf ha:isAccompaniedBy ;
    rdfs:comment "Resource that adds to or is issued with the described resource."@en, "Ressource qui ajoute ou est émise avec la ressource décrite."@fr, "Bron die bijdraagt aan of wordt uitgegeven met de beschreven bron."@nl ;
     .

ha:availableForConsultation a owl:NamedIndividual, skos:Concept, odrl:Action ;
    rdfs:label "available for consultation"@en ;
    skos:altLabel "listen"@en, "view"@en, "bekijken"@nl, "beluisteren"@nl ;
    rdfs:comment "To make a digital copy available for consultation by third-parties."@en, "Om een ​​digitale kopie beschikbaar te stellen voor raadpleging door derden."@nl ;
    skos:exactmatch odrl:display ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Make available for consultation"@en, "Raadpleegbaar maken"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:betweenPartners a owl:NamedIndividual, skos:Concept, ha:UserGroup ;
    rdfs:label "between partners"@en ;
    skos:definition "Anyone who has an collaboration agreement with meemoo that includes key use as permission (meemoo collaboration agreement 6.7.3 or 5.7.3)"@en, "Iedereen die een samenwerkingsovereenkomst met meemoo heeft waarin sleutelgebruik als toestemming is opgenomen (meemoo samenwerkingsovereenkomst 6.7.3 of 5.7.3)"@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Between partners"@en, "Tussen partners"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:description a rdfs:Property ;
    rdfs:label "description"@en, "description"@fr, "beschrijving"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dct:description ;
    rdfs:comment "An account of the resource."@en, "Un compte rendu de la ressource."@fr, "Een verslag van de resource"@nl ;
     .

ha:downloadable a owl:NamedIndividual, skos:Concept, odrl:Action ;
    rdfs:label "downloadable"@en ;
    skos:altLabel "download"@en, "kopie downloaden"@nl ;
    skos:definition "To make the digital copy downloadable by third-parties."@en, "Om de digitale kopie downloadbaar te maken voor derden."@nl ;
    skos:exactmatch odrl:distribute ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Make downloadable"@en, "Downloadbaar maken"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:educationalPublic a owl:NamedIndividual, skos:Concept, ha:UserGroup ;
    rdfs:label "educational public"@en ;
    skos:definition "Anyone subject to the conditions for access to the Archive for Education platform (e.g., lecturers, learners, educational support staff, etc.), see Appendix 2 of the meemoo collaboration agreement."@en, "Iedereen die valt onder de voorwaarden van toegang tot het Archief voor Onderwijsplatform (bv lesgevers, lerenden, onderwijsondersteunend personeel...), zie bijlage 2 van de meemoo samenwerkingsovereenkomst."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Educational public"@en, "Onderwijs"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:extended a owl:NamedIndividual, skos:Concept, ha:MetadataRange ;
    rdfs:label "extended"@en ;
    skos:definition "The metadata will be displayed in the form of limited set, according to the agreements."@en, "Een uitgebreide set metadata, bepaald volgens afspraken en documentatie, wordt ontsloten."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Extended"@en, "Étendu"@fr, "Uitgebreid"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:full a owl:NamedIndividual, skos:Concept, ha:ContentRange ;
    rdfs:label "full"@en ;
    skos:definition "The material can be displayed in full, according to the agreements made."@en, "De toestemming is van toepassing op het materiaal in zijn geheel."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Full"@en, "Complet"@fr, "Volledig"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:hasCreator a rdf:Property ;
    rdfs:label "has creator"@en, "créateur"@fr, "maker"@nl ;
    dcam:rangeIncludes ha:Agent ;
    dct:description "Examples of a Creator include a person, an organization, or a service. Typically, the name of a Creator should be used to indicate the entity."@en, "Recommended practice is to identify the creator with a URI.  If this is not possible or feasible, a literal value that identifies the creator may be provided."@en ;
    dct:issued "1999-07-02"^^xsd:date, "2008-01-14"^^xsd:date ;
    rdfs:comment "An entity primarily responsible for making the resource."@en, "An entity responsible for making the resource."@en ;
    rdfs:domain [
        owl:unionOf (
            ha:CreativeWork
            ha:Role
        ) ;
    ] ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range [
        owl:unionOf (
            ha:Person
            ha:Organization
            ha:Role
        ) ;
    ] ;
    rdfs:seeAlso dc:creator, dct:creator, schema:creator ;
    rdfs:subPropertyOf ha:hasContributor, ha:hasCreator ;
    owl:equivalentProperty ha:hasCreator, ha:isMadeBy ;
    rdfs:comment "The creator/author of this CreativeWork."@en, "Le créateur / auteur de ce travail créatif."@fr, "De maker/auteur van dit creatief werk."@nl ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/creator) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en ;
     .

ha:hasPublisher a rdf:Property ;
    rdfs:label "has publisher"@en, "éditeur"@fr, "uitgever"@nl ;
    dcam:rangeIncludes ha:Agent ;
    dct:description "Examples of a Publisher include a person, an organization, or a service. Typically, the name of a Publisher should be used to indicate the entity."@en ;
    dct:issued "1999-07-02"^^xsd:date, "2008-01-14"^^xsd:date ;
    rdfs:comment "An entity responsible for making the resource available."@en ;
    rdfs:domain [
        owl:unionOf (
            ha:CreativeWork
            ha:Role
        ) ;
    ] ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range [
        owl:unionOf (
            ha:Person
            ha:Organization
            ha:Role
        ) ;
    ] ;
    rdfs:seeAlso dc:publisher, dct:publisher, schema:publisher ;
    rdfs:subPropertyOf ha:hasPublisher ;
    owl:equivalentProperty ha:hasPublisher ;
    rdfs:comment "The publisher of the creative work."@en, "L'éditeur du travail créatif."@fr, "De uitgever van het creatief werk."@nl ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/publisher) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en ;
     .

ha:hasSite a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has site"@en, "a un site"@fr, "heeft een zetel"@nl ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Site ;
    rdfs:seeAlso <http://www.w3.org/ns/org#hasSite> ;
    rdfs:comment "Indicates a site at which the Organization has some presence even if only indirect (e.g. virtual office or a professional service which is acting as the registered address for a company). Inverse of `org:siteOf`."@en, "Indique un site sur lequel l'Organisation possède une présence, même indirecte (domiciliation, boite postale). Inverse de `org:siteOf`."@fr, "Duidt de zetel aan waarop de organisatie aanwezig is, zelfs indien indirect (bv. via domiciliëring of postbus). Omgekeerde van `org:siteOf`."@nl ;
     .

ha:hasSubOrganization a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has sub organization"@en, "tiene suborganización"@es, "a une Sous-Organization"@fr, "ha sotto-Organization"@it ;
    rdfs:comment "Represents hierarchical containment of Organizations or Organizational Units; indicates an organization which is a sub-part or child of this organization.  Inverse of `org:subOrganizationOf`."@en, "Organización jerárquica de organizaciones o unidades. Indica que una organización es parte de otra organización más amplia o pertenece a ella. Es la relación inversa de `org:subOrganizationOf`."@es, "Indique le statut de dépendance hiérarchique pour des Organisations ou des Unités Opérationnelles; indique une Organisation qui est une sous-partie ou une branche d'une Organisation plus large. C'est la propriété inverse de `org:subOrganizationOf`."@fr, "Rappresenta un contenimento gerarchico di una Organization o di una OrganizationalUnit. Indica una organizzazione che è parte di una organizzazione più grande. È l'inverso di `org:subOrganizationOf`."@it, "組織または組織単位の階層的包含を表わします。この組織のサブパートまたは子である組織を示します。"@ja ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Organization ;
    rdfs:seeAlso <http://www.w3.org/ns/org#hasSubOrganization> ;
    owl:inverseOf ha:isSubOrganizationOf ;
     .

ha:hasSubject a rdf:Property ;
    rdfs:label "has subject"@en ;
    dct:description "Recommended practice is to refer to the subject with a URI. If this is not possible or feasible, a literal value that identifies the subject may be provided. Both should preferably refer to a subject in a controlled vocabulary."@en, "Typically, the subject will be represented using keywords, key phrases, or classification codes.  Recommended best practice is to use a controlled vocabulary."@en ;
    dct:issued "1999-07-02"^^xsd:date, "2008-01-14"^^xsd:date ;
    rdfs:comment "A topic of the resource."@en, "The topic of the resource."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dc:subject, dct:subject ;
    rdfs:subPropertyOf ha:hasSubject ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/subject) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en ;
     .

ha:intraMuros a owl:NamedIndividual, skos:Concept, ha:UserGroup ;
    rdfs:label "intra muros"@en ;
    skos:definition "Anyone who is within the institution's buildings for the purpose of digital consultation."@en, "Iedereen die zich binnen de gebouwen van de instelling bevindt met het oog op digitale raadpleging."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Intra muros"@en, "Intra muros"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:isAccompaniedBy a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is accompanied by"@en, "accompagné par"@fr, "vergezeld van"@nl ;
    dc:modified "2016-04-21 (New)", "2016-04-29 (added inverse)" ;
    rdfs:comment "Suggested use - With Work, Instance or Item", "Suggested value - Work, Instance or Item" ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/accompaniedBy> ;
    rdfs:subPropertyOf ha:isRelatedTo ;
    owl:inverseOf ha:accompanies ;
    rdfs:comment "Resource that accompanies the described resource."@en, "Ressource qui accompagne la ressource décrite."@fr, "Bron die bij de beschreven bron hoort."@nl ;
     .

ha:isMadeBy a rdf:Property ;
    rdfs:label "maker", "is made by"@en ;
    rdfs:comment "An agent that made this thing." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Agent ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/maker> ;
    owl:inverseOf ha:makes ;
    vs:term_status "testing" ;
     .

ha:isSubOrganizationOf a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is sub organization of"@en, "es suborganización de"@es, "sous-Organization de"@fr, "sotto-Organization di"@it ;
    rdfs:comment "Represents hierarchical containment of Organizations or OrganizationalUnits; indicates an Organization which contains this Organization. Inverse of `org:hasSubOrganization`."@en, "Distribución jerárquica de organizaciones o unidades. Indica que una organización contiene a otra organización. Es la relación inversa de `org:hasSubOrganization`"@es, "Représente une relation hierarchique des Organisations ou des Unités Opérationnelles; indique une Organisation sujet qui contient cette Organisation. Inverse de `org:hasSubOrganization`."@fr, "Rappresenta un contenimento gerarchico di una Organization o di una OrganizationalUnit. È l'inverso di `org:hasSubOrganization`. Ha nome come nome alternativo hasSubOrg."@it, "組織または組織単位の階層的包含を表わします。この組織を含む組織を示します。"@ja ;
    rdfs:domain ha:Organization ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range ha:Organization ;
    rdfs:seeAlso <http://www.w3.org/ns/org#subOrganizationOf> ;
    rdfs:subPropertyOf ha:isTransitiveSubOrganizationOf ;
    owl:inverseOf ha:hasSubOrganization ;
     .

ha:limited a owl:NamedIndividual, skos:Concept, ha:MetadataRange ;
    rdfs:label "limited"@en ;
    rdfs:comment "The metadata will be displayed in the form of a limited set, according to the agreements."@en, "Een beperkte set metadata, bepaald volgens afspraken en documentatie, wordt ontsloten."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Limited"@en, "Limité"@fr, "Beperkt"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:partial a owl:NamedIndividual, skos:Concept, ha:ContentRange ;
    rdfs:label "partial"@en ;
    rdfs:comment "The material can be displayed in part, according to the agreements made."@en, "De toestemming is van toepassing op het materiaal in de vorm van één of meerdere fragmenten, volgens een aangegeven tijdsstempel of volgens de bilaterale afspraken (zodanig dat de duur van het fragment minder dan de helft van de totale duur van het materiaal is)."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Partial"@en, "Partiel"@fr, "Deels"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:public a owl:NamedIndividual, skos:Concept, ha:UserGroup ;
    rdfs:label "public"@en ;
    rdfs:comment "Anyone with internet access."@en, "Iedereen met toegang tot internet."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "public"@en, "Publiek"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:researchPublic a owl:NamedIndividual, skos:Concept, ha:UserGroup ;
    rdfs:label "research public"@en ;
    rdfs:comment "Anyone who falls under the Scientific Research user group as described in Appendix 2 of the meemoo collaboration agreement."@en, "Iedereen die valt onder de gebruikersgroep Wetenschappelijk Onderzoek zoals beschreven in bijlage 2 van de meemoo samenwerkingsovereenkomst."@nl ;
    skos:inScheme <https://data.hetarchief.be/id/constraint-operand> ;
    skos:prefLabel "Research public"@en, "Onderzoek"@nl ;
    skos:topConceptOf <https://data.hetarchief.be/id/constraint-operand> ;
     .

ha:hasContributor a rdf:Property ;
    rdfs:label "has contributor"@en, "contributeur"@fr, "bijdrager"@nl ;
    dcam:rangeIncludes ha:Agent ;
    dct:description "The guidelines for using names of persons or organizations as creators also apply to contributors.  Typically, the name of a Contributor should be used to indicate the entity."@en, "The guidelines for using names of persons or organizations as creators apply to contributors."@en ;
    dct:issued "1999-07-02"^^xsd:date, "2008-01-14"^^xsd:date ;
    rdfs:comment "An entity responsible for making contributions to the resource."@en ;
    rdfs:domain [
        owl:unionOf (
            ha:CreativeWork
            ha:Role
        ) ;
    ] ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range [
        owl:unionOf (
            ha:Person
            ha:Organization
            ha:Role
        ) ;
    ] ;
    rdfs:seeAlso dc:contributor, dct:contributor, schema:contributor ;
    rdfs:subPropertyOf ha:hasContributor ;
    owl:equivalentProperty ha:hasContributor ;
    rdfs:comment "A secondary contributor to the CreativeWork or Event."@en, "Un contributeur secondaire à la CreativeWork ou à le Event."@fr, "Een tweede bijdrager aan het CreativeWork of Event."@nl ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/contributor) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en ;
     .

ha:hasCoverage a rdf:Property ;
    rdfs:label "has coverage"@en ;
    dcam:rangeIncludes ha:Jurisdiction, ha:Location, ha:period ;
    dct:description "Spatial topic and spatial applicability may be a named place or a location specified by its geographic coordinates. Temporal topic may be a named period, date, or date range. A jurisdiction may be a named administrative entity or a geographic place to which the resource applies. Recommended practice is to use a controlled vocabulary such as the Getty Thesaurus of Geographic Names [[TGN](https://www.getty.edu/research/tools/vocabulary/tgn/index.html)]. Where appropriate, named places or time periods may be used in preference to numeric identifiers such as sets of coordinates or date ranges."@en, "Spatial topic and spatial applicability may be a named place or a location specified by its geographic coordinates. Temporal topic may be a named period, date, or date range. A jurisdiction may be a named administrative entity or a geographic place to which the resource applies. Recommended practice is to use a controlled vocabulary such as the Getty Thesaurus of Geographic Names [[TGN](https://www.getty.edu/research/tools/vocabulary/tgn/index.html)]. Where appropriate, named places or time periods may be used in preference to numeric identifiers such as sets of coordinates or date ranges.  Because coverage is so broadly defined, it is preferable to use the more specific subproperties Temporal Coverage and Spatial Coverage."@en ;
    dct:issued "1999-07-02"^^xsd:date, "2008-01-14"^^xsd:date ;
    rdfs:comment "The spatial or temporal topic of the resource, spatial applicability of the resource, or jurisdiction under which the resource is relevant."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dc:coverage, dct:coverage ;
    rdfs:subPropertyOf ha:hasCoverage ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/coverage) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en ;
     .

ha:hasDescription a rdf:Property, owl:DatatypeProperty ;
    rdfs:label "has description"@en, "description"@fr, "beschrijving"@nl ;
    dct:description "Description may include but is not limited to: an abstract, a table of contents, a graphical representation, or a free-text account of the resource."@en ;
    dct:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "Corresponds to 'description' in the Ontology for Media Resources. This can be specialised by using sub-properties e.g. 'summary' or 'script'.", "An account of the resource."@en, """This can be specialised by using sub-properties
            like defined in http://www.ebu.ch/metadata/cs/web/ebu_DescriptionTypeCodeCS_p.xml.htm
            implemented as examples as e.g. 'summary' or
            'script'."""@en ;
    rdfs:domain ha:Thing ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso dc:description, <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description>, <http://www.w3.org/ns/ma-ont#description>, schema:description ;
    owl:equivalentProperty ha:description, ha:hasDescription ;
    rdfs:comment "A description of the item."@en, "Une description de l'objet."@fr, "Een beschrijving van het item."@nl ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en ;
     .

ha:hasFormat a rdf:Property ;
    rdfs:label "has format"@en, "format"@fr, "formaat"@nl ;
    dct:description "Examples of dimensions include size and duration. Recommended best practice is to use a controlled vocabulary such as the list of Internet Media Types [MIME]."@en, "Recommended practice is to use a controlled vocabulary where available. For example, for file formats one could use the list of Internet Media Types [[MIME](https://www.iana.org/assignments/media-types/media-types.xhtml)]."@en ;
    dct:hasVersion <http://dublincore.org/usage/terms/history/#formatT-001> ;
    dct:issued "1999-07-02"^^xsd:date, "2008-01-14"^^xsd:date ;
    dct:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Range: string, Format or any Format-related Concept"@en, "The file format, physical medium, or dimensions of the resource."@en, "To identify a Format"@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:string, ha:Format, ha:MediaTypeOrExtent ;
    rdfs:seeAlso dc:format, dct:format, <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> ;
    rdfs:subPropertyOf ha:hasFormat ;
    rdfs:comment "The file format, physical medium, or dimensions of the resource."@en, "Le format du fichier, le support physique ou les dimensions de la ressource."@fr, "Het bestandsformaat, fysiek medium of afmetingen van de bron."@nl ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/format) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en ;
     .

ha:hasIdentifier a rdf:Property, owl:DatatypeProperty ;
    rdfs:label "has identifier"@en, "identifiant"@fr, "ID"@nl, "identificator"@nl ;
    dct:description "Recommended practice is to identify the resource by means of a string conforming to an identification system."@en, "Recommended practice is to identify the resource by means of a string conforming to an identification system. Examples include International Standard Book Number (ISBN), Digital Object Identifier (DOI), and Uniform Resource Name (URN).  Persistent identifiers should be provided as HTTP URIs."@en ;
    dct:issued "1999-07-02"^^xsd:date, "2008-01-14"^^xsd:date ;
    rdfs:comment "An unambiguous reference to the resource within a given context."@en ;
    rdfs:domain ha:Organization, ha:Thing ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal, xsd:string ;
    rdfs:seeAlso dc:identifier, dct:identifier, <http://www.w3.org/ns/org#identifier>, schema:identifier ;
    rdfs:subPropertyOf skos:notation, ha:hasIdentifier ;
    owl:equivalentProperty ha:hasIdentifier ;
    rdfs:comment "Gives an identifier, such as a company registration number, that can be used to used to uniquely identify the organization."@en, "The identifier property represents any kind of identifier for any kind of Thing, such as ISBNs, GTIN codes, UUIDs etc."@en, "Donne un identifiant, comme par exemple le numéro d'enregistrement d'une entreprise, qui peut être utilisé comme identifiant unique pour l'Organisation."@fr, "La propriété 'identifier' représente n'importe quel type d'identifiant pour n'importe quel type d'objet (Thing), tels que les ISBNs, les codes GTIN, les UUIDs etc."@fr, "De identifier-eigenschap representeert elk soort identifier voor elk soort ding (Thing), zoals ISBNs, GTIN codes, UUIDs enz."@nl, "Geeft een ID, zoals een bedrijfsregistratienummer, dat gebruikt kan worden om de organisatie uniek te identificeren."@nl ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/identifier) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en ;
     .

ha:hasPosition a rdf:Property ;
    rdfs:label "has position"@en, "position"@fr, "positie"@nl ;
    rdfs:domain ha:CreativeWork ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso schema:position ;
    rdfs:comment "The position of an item in a series or sequence of items."@en, "La position d'un élément dans une série ou une séquence d'éléments."@fr, "De positie van een item in een reeks of opeenvolging van items."@nl ;
     .

ha:hasTitle a rdf:Property ;
    rdfs:label "has title"@en ;
    dct:issued "1999-07-02"^^xsd:date, "2008-01-14"^^xsd:date ;
    rdfs:comment "A name given to the resource."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso dc:title, dct:title ;
    rdfs:subPropertyOf ha:hasTitle ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en ;
     .

ha:hasDate a rdf:Property ;
    rdfs:label "has date"@en ;
    dct:description "Date may be used to express temporal information at any level of granularity.  Recommended practice is to express the date, date/time, or period of time according to ISO 8601-1 [[ISO 8601-1](https://www.iso.org/iso-8601-date-and-time-format.html)] or a published profile of the ISO standard, such as the W3C Note on Date and Time Formats [[W3CDTF](https://www.w3.org/TR/NOTE-datetime)] or the Extended Date/Time Format Specification [[EDTF](http://www.loc.gov/standards/datetime/)].  If the full date is unknown, month and year (YYYY-MM) or just year (YYYY) may be used. Date ranges may be specified using ISO 8601 period of time specification in which start and end dates are separated by a '/' (slash) character.  Either the start or end date may be missing."@en ;
    dct:issued "1999-07-02"^^xsd:date, "2008-01-14"^^xsd:date ;
    rdfs:comment "A point or period of time associated with an event in the lifecycle of the resource."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:range rdfs:Literal ;
    rdfs:seeAlso dc:date, dct:date ;
    rdfs:subPropertyOf ha:hasDate ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/date) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en ;
     .

ha:hasRights a rdf:Property ;
    rdfs:label "has rights"@en, "Droits"@fr, "Rechten"@nl ;
    dct:description "Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights."@en, "Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights.  Recommended practice is to refer to a rights statement with a URI.  If this is not possible or feasible, a literal value (name, label, or short text) may be provided."@en, "En règle générale, les informations sur les droits comprennent une déclaration sur les différents droits de propriété associés à la ressource, y compris les droits de propriété intellectuelle.La pratique recommandée est de se référer à une déclaration de droits avec un URI.Si cela n'est pas possible ou possible, une valeur littérale (nom, étiquette ou texte court) peut être fourni."@fr, "Doorgaans bevat rechteninformatie een verklaring over verschillende eigendomsrechten die verband houden met de bron, inclusief intellectuele eigendomsrechten.Aanbevolen praktijk is om te verwijzen naar een rechtenverklaring met een URI.Als dit niet mogelijk of haalbaar is, kan een letterlijke waarde (naam, label of korte tekst) worden verstrekt."@nl ;
    dct:issued "1999-07-02"^^xsd:date, "2008-01-14"^^xsd:date ;
    rdfs:comment "Information about rights held in and over the resource."@en ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso dc:rights, dct:rights ;
    rdfs:subPropertyOf ha:hasRights ;
    rdfs:comment "Information about rights held in and over the resource."@en, "Informations sur les droits maintenus dans et au-dessus de la ressource."@fr, "Informatie over rechten in en over de bron."@nl ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/rights) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en ;
     .

ha:isRelatedTo a owl:SymmetricProperty ;
    rdfs:label """
   Related resource
  """, "is related to"@en ;
    dct:modified """
   2016-04-21 (New)
  """, """
   2021-06-09 (Modified definition [GH2])
  """ ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    rdfs:seeAlso <http://id.loc.gov/ontologies/bibframe/relatedTo> ;
    rdfs:comment """
   Any relationship between Work, Instance, Item, and Event resources.
  """ ;
     .

ha:hasAnnotationPurpose a rdf:Property ;
    rdfs:label "has annotation purpose"@en ;
    rdfs:comment "To define the purpose of an Annotation."@en ;
    rdfs:domain ha:Annotation ;
    rdfs:range xsd:anyURI, xsd:string ;
    rdfs:seeAlso <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasAnnotationPurpose> ;
     .

ha:isRepresentedBy a owl:ObjectProperty ;
    rdfs:label "is represented by"@en, "est représenté par"@fr, "wordt gerepresenteerd door"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/isr> ;
    rdfs:subPropertyOf premis:relationship ;
    rdfs:comment "A relationship in which an abstract intellectual entity is represented as a file or representation or a software agent is represented by an environment object. Has a reciprocal relationship of represents."@en, "Relation dans laquelle une entité intellectuelle (intellectual entity) abstraite est représentée par un fichier (file) ou une représentation (representation) ou un logiciel est représenté par un objet d'environnement. A une relation réciproque avec represents."@fr, "Een relatie waarin een abstracte intellectuele entiteit (intellectual entity) wordt gerepresenteerd als een bestand (file) of representatie (representatie), of een software-agent wordt gerepresenteerd door een omgevingsobject. Heeft een wederkerige relatie met represents."@nl ;
     .

ha:represents a owl:ObjectProperty ;
    rdfs:label "represents"@en, "représente"@fr, "representeert"@nl ;
    rdfs:isDefinedBy <model.rdfs.ttl> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType/rep> ;
    rdfs:subPropertyOf premis:relationship ;
    rdfs:comment "A relationship in which a file or representation is captured in an abstract intellectual entity description that it represents. It is a statement of what can depict or stand for the Intellectual Entity. Has a reciprocal relationship of isRepresentedBy."@en, "Une relation dans laquelle un fichier (file) ou une représentation (representation) est capturé dans une description abstraite de l'entité intellectuelle (intellectual entity) qu'elle représente. Il s'agit d'une déclaration de ce qui peut dépeindre ou représenter l'entité intellectuelle (intellectual entity). A une relation réciproque avec isRepresentedBy."@fr, "Een relatie waarin een bestand (file) of representatie (representation) wordt vastgelegd in een abstracte intellectuele entiteitsbeschrijving die het representeert. Het is een verklaring van wat de Intellectuele Entiteit kan afbeelden of vertegenwoordigen. Heeft een wederkerige relatie met isRepresentedBy."@nl ;
     .

<https://data.hetarchief.be/id/constraint-operand> a skos:ConceptScheme ;
    skos:hasTopConcept ha:availableForConsultation, ha:betweenPartners, ha:downloadable, ha:educationalPublic, ha:extended, ha:full, ha:intraMuros, ha:limited, ha:partial, ha:public, ha:researchPublic ;
    skos:prefLabel "Thesaurus rechteroperanden"@nl, "Thesaurus rightoperands"@nl ;
     .